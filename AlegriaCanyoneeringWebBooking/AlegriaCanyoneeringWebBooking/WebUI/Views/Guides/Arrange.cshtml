@model List<AlegriaCanyoneeringWebBooking.WebUI.ViewModel.GuideQueueItem>
@{
    ViewData["Title"] = "Arrange Guide Queue";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');
    .aq-wrap * {
        font-family: 'Outfit', sans-serif;
    }

    /* ── Page header ──────────────────────────────────────── */
    .aq-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 1.25rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

        .aq-header h2 {
            font-size: 1.35rem;
            font-weight: 700;
            color: #0f3460;
            margin: 0 0 0.2rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .aq-header p {
            font-size: 0.82rem;
            color: #64748b;
            margin: 0;
        }

    .aq-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .btn-aq {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.55rem 1rem;
        border-radius: 10px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.15s, transform 0.12s;
        border: none;
    }

        .btn-aq:hover:not(:disabled) {
            opacity: 0.88;
            transform: translateY(-1px);
        }

        .btn-aq:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }

    .btn-aq-back {
        background: #f1f5f9;
        color: #475569;
        text-decoration: none;
    }

    .btn-aq-auto {
        background: rgba(22,163,74,0.1);
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .btn-aq-save {
        background: linear-gradient(135deg, #1a6ef5, #0f3460);
        color: #fff;
        box-shadow: 0 3px 12px rgba(26,110,245,0.3);
    }

    /* ── Info banner ──────────────────────────────────────── */
    .aq-info {
        background: rgba(26,110,245,0.05);
        border: 1px solid #bfdbfe;
        border-radius: 12px;
        padding: 0.7rem 1rem;
        font-size: 0.82rem;
        color: #1e40af;
        margin-bottom: 1rem;
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
    }

        .aq-info i {
            flex-shrink: 0;
            margin-top: 1px;
        }

    /* ── Unsaved banner ───────────────────────────────────── */
    .aq-unsaved {
        background: rgba(240,165,0,0.08);
        border: 1px solid #fde68a;
        border-radius: 12px;
        padding: 0.6rem 1rem;
        font-size: 0.82rem;
        color: #b45309;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    /* ── Table card ───────────────────────────────────────── */
    .aq-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 20px rgba(15,52,96,0.08);
        border: 1px solid #e8edf5;
        overflow: hidden;
        margin-bottom: 1.25rem;
    }

    #queueTable {
        width: 100%;
        border-collapse: collapse;
    }

        #queueTable thead th {
            background: #f8faff;
            color: #0f3460;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            padding: 0.7rem 1rem;
            border-bottom: 2px solid #e8edf5;
            white-space: nowrap;
        }

        #queueTable tbody td {
            padding: 0.7rem 1rem;
            font-size: 0.875rem;
            color: #334155;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

    .queue-row:last-child td {
        border-bottom: none;
    }

    .queue-row:hover {
        background: #f0f6ff;
    }

    /* Drag handle */
    .drag-handle {
        cursor: grab;
        color: #cbd5e1;
        font-size: 1rem;
        padding: 0 0.5rem;
    }

        .drag-handle:hover {
            color: #1a6ef5;
        }

    .sortable-ghost {
        opacity: 0.4;
        background: #d1fae5 !important;
    }

    /* Queue number */
    .q-num {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: rgba(26,110,245,0.08);
        color: #1a6ef5;
        font-size: 0.82rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    /* Avatar */
    .q-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #e8edf5;
    }

    .q-avatar-ph {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #f1f5f9;
        border: 2px solid #e8edf5;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
    }

    /* TPosition badge */
    .tpos-ok {
        background: rgba(26,110,245,0.08);
        color: #1a6ef5;
        border: 1px solid #bfdbfe;
    }

    .tpos-warn {
        background: rgba(240,165,0,0.1);
        color: #b45309;
        border: 1px solid #fde68a;
    }

    .tpos-badge {
        font-size: 0.68rem;
        font-family: monospace;
        font-weight: 700;
        padding: 0.2rem 0.55rem;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

    /* Move buttons */
    .btn-move {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: #f1f5f9;
        color: #64748b;
        border: 1px solid #e2e8f0;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        transition: background 0.15s, color 0.15s;
    }

        .btn-move:hover {
            background: #d1fae5;
            color: #1a6ef5;
            border-color: #bfdbfe;
        }

    /* Footer */
    .aq-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
</style>

<form id="__AjaxAntiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<div class="aq-wrap">

    <!-- Header -->
    <div class="aq-header">
        <div>
            <h2>
                <i class="bi bi-sort-numeric-up" style="color:#1a6ef5;"></i>
                Guide Queue Order
            </h2>
            <p>Drag rows or use ↑↓ buttons to reorder. Click <strong>Save Order</strong> to apply.</p>
        </div>
        <div class="aq-actions">
            <a href="/Guides" class="btn-aq btn-aq-back">
                <i class="bi bi-arrow-left"></i> Back
            </a>
            <button id="btnAutoQueue" class="btn-aq btn-aq-auto" onclick="autoQueue()">
                <i class="bi bi-magic"></i> Auto Queue Missing
            </button>
            <button id="btnSaveOrder" class="btn-aq btn-aq-save" onclick="saveOrder()">
                <i class="bi bi-save"></i> Save Order
            </button>
        </div>
    </div>

    <!-- Info -->
    <div class="aq-info">
        <i class="bi bi-info-circle-fill"></i>
        <div>
            <strong>FIFO Queue</strong> — #1 is assigned first. Each guide receives a
            <strong>TPosition</strong> spaced <strong>10 seconds</strong> apart when saved.
            Guides with lower TPosition are assigned earlier. &nbsp;|&nbsp;
            <span style="color:#16a34a;font-weight:600;">
                <i class="bi bi-magic me-1"></i>Auto Queue Missing
            </span>
            assigns a Unix timestamp only to guides who don't have one yet.
        </div>
    </div>

    <!-- Unsaved changes -->
    <div id="unsavedBanner" class="aq-unsaved" style="display:none;">
        <i class="bi bi-exclamation-triangle-fill"></i>
        You have <strong>unsaved changes</strong>. Click <strong>Save Order</strong> to apply.
    </div>

    <!-- Queue Table -->
    <div class="aq-card">
        <table id="queueTable">
            <thead>
                <tr>
                    <th style="width:44px;"></th>
                    <th style="width:56px;text-align:center;">#</th>
                    <th style="width:56px;">Photo</th>
                    <th>Full Name</th>
                    <th style="width:160px;">RFID</th>
                    <th style="width:150px;text-align:center;">TPosition</th>
                    <th style="width:90px;text-align:center;">Move</th>
                </tr>
            </thead>
            <tbody id="queueBody">
                @for (int i = 0; i < Model.Count; i++)
                {
                    var g = Model[i];
                    bool hasTs = g.TPosition >= 1_000_000_000;
                    <tr data-id="@g.GuideId" class="queue-row">

                        <!-- Drag handle -->
                        <td class="drag-handle text-center">
                            <i class="bi bi-grip-vertical"></i>
                        </td>

                        <!-- Queue # -->
                        <td class="text-center">
                            <span class="q-num queue-num">@(i + 1)</span>
                        </td>

                        <!-- Photo -->
                        <td>
                            @if (!string.IsNullOrEmpty(g.Image))
                            {
                                <img src="@g.Image" class="q-avatar"
                                     onerror="this.style.display='none'" />
                            }
                            else
                            {
                                <div class="q-avatar-ph">
                                    <i class="bi bi-compass"></i>
                                </div>
                            }
                        </td>

                        <!-- Name -->
                        <td style="font-weight:600;">@g.FullName</td>

                        <!-- RFID -->
                        <td style="font-size:0.82rem;color:#94a3b8;">
                            <i class="bi bi-upc me-1"></i>@g.Rfid
                        </td>

                        <!-- TPosition -->
                        <td class="text-center">
                            <span class="tpos-badge tpos-@(hasTs ? "ok" : "warn") tpos-preview">
                                @g.TPosition
                                @if (!hasTs)
                                {
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                }
                            </span>
                        </td>

                        <!-- Move buttons -->
                        <td class="text-center">
                            <div style="display:flex;gap:0.3rem;justify-content:center;">
                                <button class="btn-move" title="Move Up" onclick="moveRow(this,-1)">
                                    <i class="bi bi-chevron-up"></i>
                                </button>
                                <button class="btn-move" title="Move Down" onclick="moveRow(this,1)">
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                            </div>
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Footer -->
    <div class="aq-footer">
        <a href="/Guides" class="btn-aq btn-aq-back">
            <i class="bi bi-x-lg"></i> Cancel
        </a>
        <button id="btnSaveOrder2" class="btn-aq btn-aq-save" onclick="saveOrder()">
            <i class="bi bi-save"></i> Save Order
        </button>
    </div>

</div>

<!-- Toast container -->
<div id="tqToastContainer"
     class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090;"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script>
        var isDirty = false;

        // ── Drag-and-drop ──────────────────────────────────────
        Sortable.create(document.getElementById('queueBody'), {
            handle: '.drag-handle', animation: 150,
            ghostClass: 'sortable-ghost',
            onEnd: function () { refreshNumbers(); markDirty(); }
        });

        // ── ↑↓ move ───────────────────────────────────────────
        function moveRow(btn, dir) {
            var row = $(btn).closest('tr');
            if (dir === -1) { var prev = row.prev('tr'); if (prev.length) row.insertBefore(prev); }
            else            { var next = row.next('tr'); if (next.length) row.insertAfter(next); }
            refreshNumbers(); markDirty();
        }

        // ── Refresh numbers ────────────────────────────────────
        function refreshNumbers() {
            $('#queueBody tr').each(function (i) {
                $(this).find('.queue-num').text(i + 1);
            });
        }

        function markDirty() { isDirty = true; $('#unsavedBanner').show(); }

        // ── Auto Queue ─────────────────────────────────────────
        function autoQueue() {
            var $btn = $('#btnAutoQueue');
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Checking...');
            $.ajax({
                url: "/Guides/AutoQueue", type: 'POST',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function (res) {
                    if (res.success) {
                        showToast(res.message, res.count > 0 ? 'success' : 'info');
                        if (res.count > 0) setTimeout(() => location.reload(), 1200);
                    } else showToast(res.message, 'error');
                },
                error: () => showToast('Error running auto queue.', 'error'),
                complete: () => $btn.prop('disabled', false).html('<i class="bi bi-magic me-1"></i>Auto Queue Missing')
            });
        }

        // ── Save Order ─────────────────────────────────────────
        function saveOrder() {
            var ids = [];
            $('#queueBody tr').each(function () { ids.push(parseInt($(this).data('id'))); });

            var $btns = $('#btnSaveOrder, #btnSaveOrder2');
            $btns.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');

            $.ajax({
                url: "/Guides/Arrange", type: 'POST',
                contentType: 'application/json', data: JSON.stringify(ids),
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function (res) {
                    if (res.success) {
                        isDirty = false; $('#unsavedBanner').hide();
                        showToast(res.message, 'success');
                        var base = Math.floor(Date.now() / 1000);
                        $('#queueBody tr').each(function (i) {
                            $(this).find('.tpos-preview')
                                   .text(base + (i * 10))
                                   .removeClass('tpos-warn').addClass('tpos-ok');
                        });
                    } else showToast(res.message, 'error');
                },
                error: () => showToast('Error saving queue order.', 'error'),
                complete: () => $btns.prop('disabled', false).html('<i class="bi bi-save me-1"></i>Save Order')
            });
        }

        // ── Unsaved changes warning ────────────────────────────
        window.addEventListener('beforeunload', e => { if (isDirty) { e.preventDefault(); e.returnValue = ''; } });

        // ── Toast ──────────────────────────────────────────────
        function showToast(message, type = 'info') {
            const map = {
                success: { bg: '#22c55e', icon: 'bi-check-circle-fill',        title: 'Success' },
                error:   { bg: '#ef4444', icon: 'bi-exclamation-triangle-fill', title: 'Error'   },
                warning: { bg: '#f0a500', icon: 'bi-exclamation-circle-fill',   title: 'Warning' },
                info:    { bg: '#1a6ef5', icon: 'bi-info-circle-fill',          title: 'Info'    }
            };
            const { bg, icon, title } = map[type] || map.info;
            const id = 'tqt-' + Date.now();
            const html = `
                <div id="${id}" class="toast border-0 text-white"
                     style="background:${bg};border-radius:12px;box-shadow:0 4px 16px rgba(0,0,0,0.15);"
                     role="alert" aria-atomic="true" data-bs-delay="3500">
                    <div class="toast-header border-0 text-white" style="background:transparent;">
                        <i class="bi ${icon} me-2"></i>
                        <strong class="me-auto">${title}</strong>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                    </div>
                    <div class="toast-body" style="padding-top:0;">${message}</div>
                </div>`;
            const c = document.getElementById('tqToastContainer');
            c.insertAdjacentHTML('beforeend', html);
            const el = document.getElementById(id);
            new bootstrap.Toast(el).show();
            el.addEventListener('hidden.bs.toast', () => el.remove());
        }
    </script>
}
