@model AlegriaCanyoneeringWebBooking.Models.Guide
@{
    var action = ViewData["Action"]?.ToString() ?? "Create";
    var formAction = action == "Edit" ? "/Guides/Edit" : "/Guides/Create";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');
    .gf-form * {
        font-family: 'Outfit',sans-serif;
    }

    .gf-body {
        padding: 1.4rem 1.5rem 1rem;
    }

    .gf-section {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #16a34a;
        border-bottom: 1.5px solid #e8edf5;
        padding-bottom: 0.4rem;
        margin-bottom: 1rem;
        margin-top: 1.25rem;
    }

        .gf-section:first-child {
            margin-top: 0;
        }

    .gf-field {
        margin-bottom: 1rem;
    }

    .gf-label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #0f3460;
        display: block;
        margin-bottom: 0.35rem;
    }

        .gf-label .req {
            color: #ef4444;
            margin-left: 2px;
        }

    .gf-input, .gf-textarea {
        width: 100%;
        padding: 0.65rem 0.9rem;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        font-family: 'Outfit',sans-serif;
        font-size: 0.9rem;
        color: #1e293b;
        background: #fafbff;
        outline: none;
        transition: border-color 0.2s,box-shadow 0.2s;
    }

        .gf-input:focus, .gf-textarea:focus {
            border-color: #16a34a;
            box-shadow: 0 0 0 3px rgba(22,163,74,0.1);
            background: #fff;
        }

        .gf-input[readonly] {
            background: #f1f5f9;
            color: #94a3b8;
            cursor: not-allowed;
        }

    .gf-textarea {
        resize: vertical;
        min-height: 72px;
    }

    .photo-current {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.75rem;
        background: #f8faff;
        border: 1px solid #e8edf5;
        border-radius: 10px;
        margin-bottom: 0.75rem;
    }

        .photo-current img {
            width: 64px;
            height: 64px;
            border-radius: 10px;
            object-fit: cover;
            border: 2px solid #e8edf5;
        }

    .photo-label {
        font-size: 0.78rem;
        color: #64748b;
    }

    .photo-path {
        font-size: 0.68rem;
        color: #94a3b8;
        word-break: break-all;
    }

    .photo-preview-wrap {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.75rem;
        background: rgba(22,163,74,0.04);
        border: 1px dashed #bbf7d0;
        border-radius: 10px;
        margin-top: 0.75rem;
    }

        .photo-preview-wrap img {
            width: 64px;
            height: 64px;
            border-radius: 10px;
            object-fit: cover;
        }

    .gf-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        padding: 0.9rem 1.5rem;
        border-top: 1.5px solid #f1f5f9;
        background: #fafbff;
    }

    .btn-gf-cancel {
        padding: 0.6rem 1.25rem;
        background: #f1f5f9;
        color: #475569;
        border: none;
        border-radius: 10px;
        font-family: 'Outfit',sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-gf-cancel:hover {
            background: #e2e8f0;
        }

    .btn-gf-save {
        padding: 0.6rem 1.5rem;
        background: linear-gradient(135deg,#1a6ef5,#0f3460);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: 'Outfit',sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s,transform 0.15s;
        box-shadow: 0 3px 12px rgba(26,110,245,0.3);
    }

        .btn-gf-save:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

        .btn-gf-save:disabled {
            opacity: 0.6;
            transform: none;
            cursor: not-allowed;
        }
</style>

<form action="@formAction" method="post" enctype="multipart/form-data" novalidate class="gf-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="GuideId" value="@Model.GuideId" />
    <input type="hidden" name="TPosition" value="@Model.TPosition" />
    <input type="hidden" name="Image" value="@Model.Image" />

    <div class="gf-body">

        <!-- Identity -->
        <div class="gf-section">Identity</div>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="gf-field">
                    <label class="gf-label">RFID / Reference</label>
                    <input class="gf-input" name="Rfid" value="@Model.Rfid" readonly />
                </div>
            </div>
            <div class="col-md-4">
                <div class="gf-field">
                    <label class="gf-label">Position ID</label>
                    <input class="gf-input" value="@Model.TPosition" readonly />
                    <input type="hidden" name="TPosition" value="@Model.TPosition" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="gf-field">
                    <label class="gf-label">Nickname</label>
                    <input class="gf-input" name="Nickname" value="@Model.Nickname" placeholder="Optional" />
                </div>
            </div>
        </div>

        <!-- Name -->
        <div class="gf-section">Name</div>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="gf-field">
                    <label class="gf-label">First Name<span class="req">*</span></label>
                    <input class="gf-input" name="FName" value="@Model.FName" required />
                </div>
            </div>
            <div class="col-md-4">
                <div class="gf-field">
                    <label class="gf-label">Middle Name</label>
                    <input class="gf-input" name="MName" value="@Model.MName" placeholder="Optional" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="gf-field">
                    <label class="gf-label">Last Name<span class="req">*</span></label>
                    <input class="gf-input" name="LName" value="@Model.LName" required />
                </div>
            </div>
        </div>

        <!-- Contact -->
        <div class="gf-section">Contact</div>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="gf-field">
                    <label class="gf-label">Contact Number</label>
                    <input class="gf-input" name="CNumber" value="@Model.CNumber"
                           inputmode="numeric" oninput="this.value=this.value.replace(/\D/g,'')" />
                </div>
            </div>
            <div class="col-12">
                <div class="gf-field">
                    <label class="gf-label">Address</label>
                    <textarea class="gf-textarea" name="Address">@Model.Address</textarea>
                </div>
            </div>
        </div>

        <!-- Photo -->
        <div class="gf-section">Photo</div>

        @if (!string.IsNullOrEmpty(Model?.Image))
        {
            <div class="photo-current">
                <img src="@Model.Image" id="currentPhoto" alt="Current photo"
                     onerror="this.style.display='none'" />
                <div>
                    <div class="photo-label">Current photo</div>
                    <div class="photo-path">@Model.Image</div>
                    <div class="photo-label mt-1">Upload a new image to replace</div>
                </div>
            </div>
        }

        <div class="gf-field">
            <label class="gf-label">Upload Photo</label>
            <input class="gf-input" type="file" name="PhotoFile" id="photoFileInput"
                   accept="image/jpeg,image/png,image/webp,image/jpg"
                   onchange="previewGuidePhoto(this)"
                   style="padding:0.5rem 0.9rem;cursor:pointer;" />
        </div>

        <div class="photo-preview-wrap" id="previewContainer" style="display:none;">
            <img id="photoPreview" src="#" alt="Preview" />
            <div>
                <div class="photo-label" style="color:#16a34a;font-weight:600;">New photo preview</div>
                <div class="photo-label">This will replace the current photo on save</div>
            </div>
        </div>

    </div>

    <div class="gf-footer">
        <button type="button" class="btn-gf-cancel" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i>Cancel
        </button>
        <button type="submit" class="btn-gf-save">
            <i class="bi bi-@(action == "Edit" ? "pencil" : "save") me-1"></i>
            @(action == "Edit" ? "Update" : "Save")
        </button>
    </div>
</form>

<script>
    function previewGuidePhoto(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('photoPreview').src = e.target.result;
                document.getElementById('previewContainer').style.display = 'flex';
                var cur = document.getElementById('currentPhoto');
                if (cur) cur.style.opacity = '0.35';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
