@{
    ViewData["Title"] = "Batch Assignments";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');
    .ba-wrap * { font-family: 'Outfit', sans-serif; }

    .ba-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

        .ba-header h2 {
            font-size: 1.35rem;
            font-weight: 700;
            color: #0f3460;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .btn-create {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.6rem 1.25rem;
        background: linear-gradient(135deg, #1a6ef5, #0f3460);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s;
        box-shadow: 0 3px 12px rgba(26,110,245,0.3);
    }

        .btn-create:hover { opacity: 0.9; transform: translateY(-1px); }

    .ba-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 20px rgba(15,52,96,0.08);
        border: 1px solid #e8edf5;
        overflow: hidden;
    }

    .ba-card-body { padding: 1.25rem; }

    #batchTable thead th {
        background: #f8faff;
        color: #0f3460;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-bottom: 2px solid #e8edf5;
        white-space: nowrap;
        padding: 0.75rem 1rem;
    }

    #batchTable tbody td {
        vertical-align: middle;
        font-size: 0.875rem;
        color: #334155;
        padding: 0.7rem 1rem;
    }

    #batchTable tbody tr:hover { background: #f0f4ff; }

    .badge-internal {
        display: inline-block;
        padding: 0.18rem 0.6rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 700;
        background: rgba(22,163,74,0.1);
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .badge-outside {
        display: inline-block;
        padding: 0.18rem 0.6rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 700;
        background: rgba(99,102,241,0.1);
        color: #4338ca;
        border: 1px solid #c7d2fe;
    }

    .badge-code {
        display: inline-block;
        padding: 0.18rem 0.65rem;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 700;
        font-family: 'Courier New', monospace;
        background: #f1f5f9;
        color: #0f3460;
        border: 1px solid #e2e8f0;
        letter-spacing: 0.05em;
    }

    #batchModal .modal-content {
        border-radius: 16px;
        border: 0;
        box-shadow: 0 8px 40px rgba(15,52,96,0.18);
        overflow: hidden;
    }

    .ba-modal-header {
        background: linear-gradient(135deg, #1a6ef5, #0f3460);
        color: #fff;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .ba-modal-header h5 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0;
        }
</style>

<form id="__AjaxAntiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<div class="ba-wrap">
    <div class="ba-header">
        <h2>
            <i class="bi bi-layers-fill" style="color:#1a6ef5;"></i>
            Batch Assignments
        </h2>
    </div>

    <div class="ba-card">
        <div class="ba-card-body">
            <div class="table-responsive">
                <table id="batchTable" class="table table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Batch Code</th>
                            <th>Operator</th>
                            <th>Assigned Guide</th>
                            <th>Type</th>
                            <th>Driver</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Form Modal -->
<div class="modal fade" id="batchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="ba-modal-header">
                <h5 id="batchModalLabel"><i class="bi bi-layers me-2"></i>Batch Assignment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" id="modalContent" style="min-height:300px;"></div>
        </div>
    </div>
</div>

<div id="baToastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090;"></div>

@section Scripts {
<script>
    function showToast(message, type = 'success') {
        const map = {
            success: { bg: '#22c55e', icon: 'bi-check-circle-fill', title: 'Success' },
            error:   { bg: '#ef4444', icon: 'bi-exclamation-triangle-fill', title: 'Error' },
            warning: { bg: '#f0a500', icon: 'bi-exclamation-circle-fill', title: 'Warning' }
        };
        const { bg, icon, title } = map[type] || map.success;
        const id = 'bat-' + Date.now();
        const html = `
            <div id="${id}" class="toast border-0 text-white"
                 style="background:${bg};border-radius:12px;box-shadow:0 4px 16px rgba(0,0,0,0.15);"
                 role="alert" aria-atomic="true" data-bs-delay="4000">
                <div class="toast-header border-0 text-white" style="background:transparent;">
                    <i class="bi ${icon} me-2"></i>
                    <strong class="me-auto">${title}</strong>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                </div>
                <div class="toast-body" style="padding-top:0;">${message}</div>
            </div>`;
        const c = document.getElementById('baToastContainer');
        c.insertAdjacentHTML('beforeend', html);
        const el = document.getElementById(id);
        new bootstrap.Toast(el).show();
        el.addEventListener('hidden.bs.toast', () => el.remove());
    }

    $(function () {
        var table = $('#batchTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '@Url.Action("GetBatchAssignmentsData", "BatchAssignments")',
                type: 'POST',
                data: d => {
                    d.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();
                },
                error: function (xhr) {
                    let msg = 'Error loading batch assignments.';
                    try { const r = JSON.parse(xhr.responseText); if (r.error) msg = r.error; } catch (e) {}
                    showToast(msg, 'error');
                }
            },
            columns: [
                {
                    data: 'batchCode',
                    render: d => `<span class="badge-code">${d ?? '—'}</span>`
                },
                { data: 'operatorName', defaultContent: '—' },
                {
                    data: 'assignedGuide',
                    render: d => `<span class="fw-semibold">${d ?? '—'}</span>`
                },
                {
                    data: 'guideType',
                    render: d => {
                        if (d === 'Internal') return `<span class="badge-internal"><i class="bi bi-person-badge me-1"></i>Internal</span>`;
                        if (d === 'Outside') return `<span class="badge-outside"><i class="bi bi-person-lines-fill me-1"></i>Outside</span>`;
                        return `<span class="text-muted">—</span>`;
                    }
                },
                { data: 'driverName', defaultContent: '—' }
            ],
            responsive: true,
            language: { emptyTable: 'No batch assignments found.' }
        });

        function openModal(url, title) {
            var existing = bootstrap.Modal.getInstance(document.getElementById('batchModal'));
            if (existing) existing.dispose();

            $('#modalContent').html(`
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <div style="font-size:0.875rem;">Loading form...</div>
                </div>`);

            $('#batchModalLabel').html(`<i class="bi bi-layers me-2"></i>${title}`);

            $.get(url, res => {
                $('#modalContent').html(res);
                new bootstrap.Modal(document.getElementById('batchModal')).show();
            }).fail(xhr => {
                $('#modalContent').html(`<div class="alert alert-danger m-3"><strong>HTTP ${xhr.status}:</strong> ${xhr.statusText}</div>`);
                showToast('Error loading form.', 'error');
            });
        }

        $('#btnCreate').click(() => openModal('@Url.Action("Create", "BatchAssignments")', 'New Batch Assignment'));

        $('#batchTable').on('click', '.btn-edit', function (e) {
            e.preventDefault();
            openModal($(this).attr('href'), 'Edit Batch Assignment');
        });

        $('#batchModal').on('submit', 'form', function (e) {
            e.preventDefault();
            const form = $(this);
            const formData = new FormData(form[0]);
            const token = $('input[name="__RequestVerificationToken"]').val();
            if (token) formData.set('__RequestVerificationToken', token);

            const $btn = form.find('[type="submit"]');
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        bootstrap.Modal.getInstance(document.getElementById('batchModal'))?.hide();
                        table.ajax.reload(null, false);
                        showToast(res.message, 'success');
                    } else {
                        form.find('.ba-alert').remove();
                        if (res.errors?.length) {
                            const errHtml = `<div class="alert alert-danger ba-alert m-3 mb-0">
                                <strong>${res.message}</strong>
                                <ul class="mb-0 mt-1">${res.errors.map(e => `<li>${e}</li>`).join('')}</ul>
                            </div>`;
                            form.find('.bf-body').prepend(errHtml);
                        } else {
                            showToast(res.message || 'Validation error.', 'error');
                        }
                        $btn.prop('disabled', false).html(
                            form.data('action') === 'Edit'
                                ? '<i class="bi bi-pencil me-1"></i>Update'
                                : '<i class="bi bi-save me-1"></i>Save'
                        );
                    }
                },
                error: function (xhr) {
                    $btn.prop('disabled', false).html('<i class="bi bi-save me-1"></i>Save');
                    showToast(`Error saving (HTTP ${xhr.status}).`, 'error');
                }
            });
        });
    });
</script>
}