@{
    ViewData["Title"] = "About Us";
    Layout = "Layout_Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Alegria Canyoneering</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            900: '#1e3a8a'
                        },
                        accent: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

        body {
            font-family: 'Inter', sans-serif;
        }

        .gradient-text {
            background: linear-gradient(135deg, #2563eb 0%, #16a34a 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .card-hover {
            transition: all 0.3s ease;
        }

            .card-hover:hover {
                transform: translateY(-4px);
                box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            }

        @@keyframes fade {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fade {
            animation: fade 0.8s ease-out forwards;
        }

        .animate-rise {
            animation: fade 1s ease-out forwards;
        }

        .delay-1 {
            animation-delay: 0.2s;
        }

        .delay-2 {
            animation-delay: 0.4s;
        }

        .delay-3 {
            animation-delay: 0.6s;
        }

        .delay-4 {
            animation-delay: 0.8s;
        }

        .delay-5 {
            animation-delay: 1s;
        }

        /* Floating Buttons Container */
        .floating-container {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            z-index: 9999;
        }

        /* Common floating button styles */
        .floating-btn {
            background-color: #2563eb; /* primary-600 */
            color: white;
            border-radius: 9999px; /* fully rounded */
            width: 56px;
            height: 56px;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.4);
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

            .floating-btn:hover {
                background-color: #1d4ed8; /* primary-700 */
            }

            /* Messenger icon (Bootstrap Icons) */
            .floating-btn i {
                font-size: 1.5rem;
            }

        /* Map container for embedded map */
        #floatingMap {
            position: fixed;
            bottom: 80px;
            right: 2rem;
            width: 300px;
            height: 200px;
            border-radius: 1rem;
            overflow: hidden;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.25);
            display: none;
            z-index: 9998;
        }

        /* Responsive adjustments */
        @@media (max-width: 640px) {
            #floatingMap

        {
            width: 90vw;
            right: 5%;
            bottom: 90px;
            height: 180px;
        }

        }
    </style>

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
</head>

<body class="bg-gray-50">

    <!-- Top Bar with Logo and Button -->
    <div class="flex justify-between items-center w-full px-6 pt-6 mb-8">
        <!-- Logo -->
        <div class="flex items-center gap-4">
            <img src="~/images/alegrialogo2025.jpeg" alt="Alegria Logo" class="h-32 w-auto object-contain" />
        </div>


        <!-- Back/Login Button -->
        @if (User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Operator"))
        {
            <a asp-area="" asp-controller="Dashboard" asp-action="Index"
               class="btn btn-outline-secondary btn-lg rounded-pill px-4 flex items-center gap-2 shadow-sm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        }
        else
        {
            <a href="/Authentication/Login"
               class="btn btn-outline-primary btn-lg rounded-pill px-4 flex items-center gap-2 shadow-sm">
                <i class="bi bi-box-arrow-in-right"></i> Login
            </a>
        }
    </div>

    <!-- Main Content -->
    <div class="container mx-auto px-6 py-6">
        <!-- Hero Section -->
        <div class="text-center mb-12">
            <h1 class="text-5xl font-extrabold gradient-text mb-4 animate-fade">
                Transforming Guest Booking — One Click at a Time.
            </h1>
            <p class="text-gray-600 text-lg max-w-3xl mx-auto animate-fade delay-1">
                Simplifying guest management through seamless online booking — designed for operators, made for convenience.
            </p>
        </div>

        <!-- How to Use This App -->
        <div class="bg-white p-6 rounded-xl shadow card-hover animate-rise mb-10">
            <h4 class="text-xl font-semibold text-primary-600 mb-3 flex items-center">
                <i class="bi bi-list-ol me-2 text-primary-600"></i> How to Use This App
            </h4>

            <ol class="list-decimal list-inside space-y-3 text-gray-700 text-lg leading-relaxed">
                <li>
                    <strong>Sign In or Register:</strong> The <em>Super Admin</em> creates operator accounts and provides the login credentials to each operator.
                    Operators can then <strong>sign in</strong> using those credentials to access their booking dashboard.
                </li>

                <li>
                    <strong>Add New Bookings:</strong> Use the <em>“New Booking”</em> feature to record guest details, dates, and preferences.
                </li>
                <li>
                    <strong>Save Guest:</strong> After adding a new booking, go to the <em>“Save Guest”</em> section.
                    Here, you can <strong>add another guest</strong> under the same booking or <strong>cancel</strong> if you don’t want to save the guest information.
                </li>
                <li>
                    <strong>Open Reserve Booking:</strong> Go to the <em>Reserve Booking</em> section to manage guests arriving or confirming their reservations.
                </li>
                <li>
                    <strong>Scan Guest QR Code:</strong> Each guest has a unique QR code — scan it to quickly retrieve their booking details.
                </li>
                <li>
                    <strong>Confirm Booking:</strong> After scanning, a confirmation popup will appear. Choose <em>“Yes”</em> to confirm the reservation or <em>“No”</em> to cancel.
                </li>
                <li>
                    <strong>View Booked Guests:</strong> Go to the <em>Booked Guest</em> page. You can <strong>search by date</strong> to see who has booked for the current day and
                    <strong>print the batch list</strong> for easy reference or record-keeping.
                </li>
            </ol>

            <div class="bg-primary-100 text-black mt-5 p-4 rounded-lg flex items-start">
                <i class="bi bi-lightbulb me-2 text-primary-600 text-xl"></i>
                <p>
                    <strong>Tip:</strong> Always confirm and save guest information properly to ensure accurate booking records and smooth QR confirmation during check-in.
                </p>
            </div>
        </div>



        <!-- Mission and Vision -->
  @*       <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
            <div class="bg-white p-6 rounded-xl shadow card-hover animate-rise delay-1">
                <h4 class="text-xl font-semibold text-red-600 mb-3 flex items-center">
                    <i class="bi bi-bullseye me-2"></i> Our Mission
                </h4>
                <p class="text-gray-700 text-lg">
                    To deliver a seamless and efficient booking system that empowers operators and enhances the guest journey through technology and reliability.
                </p>
            </div>
            <div class="bg-white p-6 rounded-xl shadow card-hover animate-rise delay-2">
                <h4 class="text-xl font-semibold text-cyan-600 mb-3 flex items-center">
                    <i class="bi bi-eye me-2"></i> Our Vision
                </h4>
                <p class="text-gray-700 text-lg">
                    To be the most trusted web booking solution across the tourism and hospitality industry — connecting guests and operators effortlessly.
                </p>
            </div>
        </div>
 *@
        <!-- Testimonials -->
        <div class="bg-white p-6 rounded-xl shadow card-hover animate-rise delay-3 mb-10 text-center">
            <h4 class="text-xl font-semibold text-green-600 mb-4">
                <i class="bi bi-chat-square-quote me-2"></i> What Our Users Say
            </h4>
            <div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner text-center">
                    <div class="carousel-item active">
                        <blockquote class="text-gray-600 text-lg italic">“This app streamlined our entire booking process. It’s so intuitive!”</blockquote>
                        <footer class="mt-2 text-sm text-gray-500">Nikk Alvin Barrioquinto</footer>
                    </div>
                    <div class="carousel-item">
                        <blockquote class="text-gray-600 text-lg italic">“Our response time improved by 50%. Highly recommended!”</blockquote>
                        <footer class="mt-2 text-sm text-gray-500">Jude Lequido </footer>
                    </div>
                    <div class="carousel-item">
                        <blockquote class="text-gray-600 text-lg italic">“A guest-friendly platform that actually works. Simple and effective.”</blockquote>
                        <footer class="mt-2 text-sm text-gray-500">Bryan Montemayor</footer>
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon bg-dark rounded-circle"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon bg-dark rounded-circle"></span>
                </button>
            </div>
        </div>

        <!-- Contact -->
        <div class="bg-white p-6 rounded-xl shadow card-hover animate-rise delay-4 mb-10">
            <h4 class="text-xl font-semibold text-green-700 mb-3 flex items-center">
                <i class="bi bi-chat-dots me-2"></i> Get in Touch
            </h4>
            <p class="text-gray-700 text-lg mb-3">
                Have an idea to make our app even better? We’d love to hear from you!
            </p>
            <ul class="text-gray-700 text-lg space-y-2">
                <li><i class="bi bi-envelope me-2 text-success"></i>Email: <a href="mailto:lelis.markanthony@gmail.com" class="text-primary-600 font-semibold hover:underline">lelis.markanthony@gmail.com</a></li>
                <li><i class="bi bi-telephone me-2 text-success"></i>Phone: <a href="tel:+6324175154" class="text-primary-600 font-semibold hover:underline">(032) 417-5154</a></li>
            </ul>
            <a href="https://mail.google.com/mail/?view=cm&fs=1&to=lelis.markanthony@gmail.com&su=Inquiry&body=Hello, I would like to get in touch with you."
               target="_blank"
               class="mt-4 inline-block bg-primary-600 text-white px-6 py-3 rounded-full shadow hover:bg-primary-700 transition">
                <i class="bi bi-chat-dots-fill me-2"></i> Let's Talk
            </a>
        </div>

        <!-- Imprint -->
        <div class="bg-white p-6 rounded-xl shadow card-hover animate-rise delay-5">
            <h4 class="text-xl font-semibold text-yellow-600 mb-3 flex items-center">
                <i class="bi bi-building me-2"></i> Imprint
            </h4>
            <p class="text-gray-700 text-lg leading-relaxed">
                Published by <strong>JustClick Integrated Solutions Inc.</strong><br />
                171 N. Bacalso Avenue, Cebu City<br />
                Developed by <strong>Dendo Pulgo</strong> and <strong>Darius Cumpio</strong><br />
                Responsible: <strong>Mark Anthony P. Lelis</strong><br />
                On behalf of: <strong>Municipality of Alegria, Cebu</strong>
            </p>
        </div>
    </div>

    <!-- Floating Buttons Container -->
    <div class="floating-container">
        <!-- Messenger button: opens Messenger chat link -->
        <a href="https://m.me/YourPageID" target="_blank" aria-label="Messenger Chat" class="floating-btn" title="Chat on Messenger">
            <i class="bi bi-messenger"></i>
        </a>

        <!-- Map button: toggles embedded map -->
        <button aria-label="Toggle Map" title="Show Map" class="floating-btn" id="mapToggleBtn">
            <i class="bi bi-geo-alt"></i>
        </button>
    </div>
    <!-- Floating Map Container -->
    <div id="floatingMap">
        <iframe src="https://www.google.com/maps?q=Alegria+Barangay+Rd,+Alegría,+Cebu,+Philippines&hl=en&z=15&output=embed"
                width="300"
                height="200"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade">
        </iframe>
    </div>


    <!-- Bootstrap JS (required for carousel) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Toggle map visibility
        const mapToggleBtn = document.getElementById('mapToggleBtn');
        const floatingMap = document.getElementById('floatingMap');

        mapToggleBtn.addEventListener('click', () => {
            if (floatingMap.style.display === 'none' || floatingMap.style.display === '') {
                floatingMap.style.display = 'block';
                mapToggleBtn.title = "Hide Map";
            } else {
                floatingMap.style.display = 'none';
                mapToggleBtn.title = "Show Map";
            }
        });
    </script>
</body>
</html>
