@{
    ViewData["Title"] = "Landing Page";
    Layout = "Layout_Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Alegria Canyoneering</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            900: '#1e3a8a'
                        },
                        accent: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d'
                        }
                    },
                    fontFamily: {
                        'inter': ['Inter', 'sans-serif'],
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.8s ease-out forwards',
                        'slide-up': 'slideUp 1s ease-out forwards',
                        'bounce-in': 'bounceIn 0.6s ease-out forwards',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0', transform: 'translateY(20px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        },
                        slideUp: {
                            '0%': { opacity: '0', transform: 'translateY(40px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        },
                        bounceIn: {
                            '0%': { opacity: '0', transform: 'scale(0.3)' },
                            '50%': { opacity: '1', transform: 'scale(1.05)' },
                            '70%': { transform: 'scale(0.9)' },
                            '100%': { opacity: '1', transform: 'scale(1)' },
                        },
                    },
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #f0f9ff 0%, #ecfdf5 100%);
        }

        .hero-bg {
            background-image: url('/images/canyoneering-hero.jpg'); /* Replace with actual image path */
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        .gradient-text {
            background: linear-gradient(135deg, #2563eb 0%, #16a34a 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .card-hover {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .card-hover:hover {
                transform: translateY(-8px) scale(1.02);
                box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            }

        .floating-container {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            z-index: 9999;
        }

        .floating-btn {
            background: linear-gradient(135deg, #2563eb, #16a34a);
            color: white;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 10px 25px rgba(37, 99, 235, 0.4);
            cursor: pointer;
            transition: all 0.3s ease;
            animation: bounce-in 0.6s ease-out;
        }

            .floating-btn:hover {
                transform: scale(1.1);
                box-shadow: 0 15px 35px rgba(37, 99, 235, 0.6);
            }

            .floating-btn i {
                font-size: 1.5rem;
            }

        .scroll-to-top {
            opacity: 0;
            transition: opacity 0.3s ease;
        }

            .scroll-to-top.show {
                opacity: 1;
            }

        .interactive-list li {
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .interactive-list li:hover {
                color: #2563eb;
                transform: translateX(10px);
            }

        .testimonial-card {
            transition: all 0.3s ease;
        }

            .testimonial-card:hover {
                transform: scale(1.05);
            }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .hero-bg {
                background-attachment: scroll;
            }

            .floating-container {
                bottom: 1rem;
                right: 1rem;
            }

            .floating-btn {
                width: 50px;
                height: 50px;
            }
        }
    </style>

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
</head>

<body class="bg-gray-50">

    <!-- Header -->
    <header class="flex items-center justify-between px-8 py-4 shadow-md bg-white">
        <!-- Left side: Logo -->
        <a href="/" class="flex items-center space-x-2">
            <img src="/images/alegrialogo2025.jpeg" alt="Alegria Logo" class="h-16 w-16 rounded-full shadow-md animate-bounce-in" />
            <span class="text-2xl font-semibold text-primary-700">AlegriaCanyoneering</span>
        </a>

        <!-- Right side: Navigation + Login -->
        <div class="flex items-center space-x-8">
            <nav class="hidden md:flex space-x-8">
                <a href="#how-to-use" class="text-gray-700 hover:text-primary-600 transition">How to Use</a>
                <a href="#testimonials" class="text-gray-700 hover:text-primary-600 transition">Testimonials</a>
                <a href="#contact" class="text-gray-700 hover:text-primary-600 transition">Contact</a>
            </nav>

            <a href="/Authentication/Login"
               class="bg-gradient-to-r from-primary-600 to-accent-600 text-white px-8 py-3 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 flex items-center gap-2 animate-bounce-in">
                <i class="bi bi-box-arrow-in-right text-lg"></i> Login
            </a>
        </div>
    </header>


    <!-- Loading Spinner Overlay -->
    <div id="loadingOverlay" class="fixed inset-0 bg-white flex items-center justify-center z-50">
        <div class="w-16 h-16 border-4 border-primary-600 border-t-transparent rounded-full animate-spin"></div>
    </div>

    <!-- Hero Section -->
    <section class="text-center py-20 px-6 bg-gradient-to-b from-sky-50 via-white to-emerald-50">
        <h2 class="text-5xl md:text-6xl font-extrabold bg-gradient-to-r from-primary-600 to-accent-600 bg-clip-text text-transparent mb-6 animate-fade">
            Transforming Guest Booking — One Click at a Time
        </h2>
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
            Simplify guest management through seamless online booking — designed for operators, made for convenience.
        </p>
    </section>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-6 py-16 space-y-16">

        <!-- How to Use This App -->
        <section id="how-to-use" class="bg-white p-8 rounded-2xl shadow-xl card-hover animate-slide-up">
            <h3 class="text-3xl font-bold text-primary-600 mb-6 flex items-center">
                <i class="bi bi-list-ol mr-3 text-accent-600"></i> How to Use This App
            </h3>
            <ol class="interactive-list list-decimal list-inside space-y-4 text-gray-700 text-lg leading-relaxed">
                <li><strong>Sign In or Register:</strong> The <em>Super Admin</em> creates operator accounts and provides the login credentials to each operator. Operators can then <strong>sign in</strong> using those credentials to access their booking dashboard.</li>
                <li><strong>Add New Bookings:</strong> Use the <em>"New Booking"</em> feature to record guest details, dates, and preferences.</li>
                <li><strong>Save Guest:</strong> After adding a new booking, go to the <em>"Save Guest"</em> section. Here, you can <strong>add another guest</strong> under the same booking or <strong>cancel</strong> if you don't want to save the guest information.</li>
                <li><strong>Open Reserve Booking:</strong> Go to the <em>Reserve Booking</em> section to manage guests arriving or confirming their reservations.</li>
                <li><strong>Scan Guest QR Code:</strong> Each guest has a unique QR code — scan it to quickly retrieve their booking details.</li>
                <li><strong>Confirm Booking:</strong> After scanning, a confirmation popup will appear. Choose <em>"Yes"</em> to confirm the reservation or <em>"No"</em> to cancel.</li>
                <li><strong>View Booked Guests:</strong> Go to the <em>Booked Guest</em> page. You can <strong>search by date</strong> to see who has booked for the current day and <strong>print the batch list</strong> for easy reference or record-keeping.</li>
            </ol>
            <div class="bg-gradient-to-r from-primary-100 to-accent-100 text-black mt-8 p-6 rounded-xl flex items-start shadow-md">
                <i class="bi bi-lightbulb mr-3 text-primary-600 text-2xl"></i>
                <p><strong>Tip:</strong> Always confirm and save guest information properly to ensure accurate booking records and smooth QR confirmation during check-in.</p>
            </div>
        </section>

        <!-- Testimonials -->
        <section id="testimonials" class="bg-white p-8 rounded-2xl shadow-xl card-hover animate-slide-up">
            <h3 class="text-3xl font-bold text-accent-600 mb-8 text-center">
                <i class="bi bi-chat-square-quote mr-3"></i> What Our Users Say
            </h3>
            <div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <div class="testimonial-card bg-gray-50 p-8 rounded-xl text-center shadow-md">
                            <blockquote class="text-gray-700 text-xl italic mb-4">"This app streamlined our entire booking process. It's so intuitive!"</blockquote>
                            <footer class="text-primary-600 font-semibold">Nikk Alvin Barrioquinto</footer>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="testimonial-card bg-gray-50 p-8 rounded-xl text-center shadow-md">
                            <blockquote class="text-gray-700 text-xl italic mb-4">"Our response time improved by 50%. Highly recommended!"</blockquote>
                            <footer class="text-primary-600 font-semibold">Jude Lequido</footer>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="testimonial-card bg-gray-50 p-8 rounded-xl text-center shadow-md">
                            <blockquote class="text-gray-700 text-xl italic mb-4">"A guest-friendly platform that actually works. Simple and effective."</blockquote>
                            <footer class="text-primary-600 font-semibold">Bryan Montemayor</footer>
                        </div>
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon bg-primary-600 rounded-circle p-3"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon bg-primary-600 rounded-circle p-3"></span>
                </button>
            </div>
        </section>

        <!-- Contact -->
        <section id="contact" class="bg-white p-8 rounded-2xl shadow-xl card-hover animate-slide-up">
            <h3 class="text-3xl font-bold text-accent-700 mb-6 flex items-center">
                <i class="bi bi-chat-dots mr-3"></i> Get in Touch
            </h3>
            <p class="text-gray-700 text-lg mb-6">
                Have an idea to make our app even better? We'd love to hear from you!
            </p>
            <ul class="text-gray-700 text-lg space-y-3 mb-6">
                <li><i class="bi bi-envelope mr-3 text-accent-600"></i>Email: <a href="mailto:lelis.markanthony@gmail.com" class="text-primary-600 font-semibold hover:underline transition">lelis.markanthony@gmail.com</a></li>
                <li><i class="bi bi-telephone mr-3 text-accent-600"></i>Phone: <a href="tel:+6324175154" class="text-primary-600 font-semibold hover:underline transition">(032) 417-5154</a></li>
            </ul>
            <a href="https://mail.google.com/mail/?view=cm&fs=1&to=lelis.markanthony@gmail.com&su=Inquiry&body=Hello, I would like to get in touch with you." target="_blank" class="inline-block bg-gradient-to-r from-primary-600 to-accent-600 text-white px-8 py-4 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 font-semibold">
                <i class="bi bi-chat-dots-fill mr-2"></i> Let's Talk
            </a>
        </section>

        <!-- Imprint -->
        <section class="bg-white p-8 rounded-2xl shadow-xl card-hover animate-slide-up">
            <h3 class="text-3xl font-bold text-yellow-600 mb-6 flex items-center">
                <i class="bi bi-building mr-3"></i> Imprint
            </h3>
            <p class="text-gray-700 text-lg leading-relaxed">
                Published by <strong>JustClick Integrated Solutions Inc.</strong><br />
                171 N. Bacalso Avenue, Cebu City<br />
                Developed by <strong>Dendo Pulgo</strong> and <strong>Darius Cumpio</strong><br />
                Responsible: <strong>Mark Anthony P. Lelis</strong><br />
                On behalf of: <strong>Municipality of Alegria, Cebu</strong>
            </p>
        </section>

    </main>

    <!-- Floating Buttons -->
    <div class="floating-container">
        <div class="floating-btn" onclick="scrollToTop()">
            <i class="bi bi-arrow-up"></i>
        </div>
     
    </div>



    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Loading overlay
        window.addEventListener('load', function() {
            setTimeout(() => {
                const overlay = document.getElementById('loadingOverlay');
                overlay.style.transition = 'opacity 0.5s ease';
                overlay.style.opacity = '0';
                setTimeout(() => overlay.style.display = 'none', 500);
            }, 2000);
        });

        // Scroll to top functionality
        function scrollToTop() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Show/hide scroll to top button
        window.addEventListener('scroll', function() {
            const scrollBtn = document.querySelector('.floating-btn:first-child');
            if (window.pageYOffset > 300) {
                scrollBtn.classList.add('show');
            } else {
                scrollBtn.classList.remove('show');
            }
        });

        // Placeholder for messenger functionality
        function openMessenger() {
            // Implement messenger opening logic here
            alert('Messenger would open here!');
        }

        // Smooth scrolling for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelector(this.getAttribute('href')).scrollIntoView({
                    behavior: 'smooth'
                });
            });
        });

        // Add intersection observer for animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.animationPlayState = 'running';
                }
            });
        }, observerOptions);

        document.querySelectorAll('.animate-slide-up, .animate-fade-in, .animate-bounce-in').forEach(el => {
            el.style.animationPlayState = 'paused';
            observer.observe(el);
        });
    </script>
</body>
</html>
