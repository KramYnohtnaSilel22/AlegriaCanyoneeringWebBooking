@{
    ViewData["Title"] = "Landing Page";
    Layout = "Layout_Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alegria Canyoneering — Web Booking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        :root {
            --blue-deep: #0f3460;
            --blue-mid: #1a6ef5;
            --blue-light: #4f9cf9;
            --green: #16a34a;
            --accent: #f0a500;
            --white: #ffffff;
            --gray-soft: #f4f7fe;
            --gray-text: #64748b;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: var(--gray-soft);
            color: #1e293b;
        }

        /* ── Navbar ─────────────────────────────────── */
        .navbar {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #e2e8f0;
            padding: 0.9rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 1px 12px rgba(15,52,96,0.07);
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
        }

        .nav-logo {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(26,110,245,0.2);
            box-shadow: 0 2px 8px rgba(15,52,96,0.15);
        }

        .nav-name {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--blue-deep);
            line-height: 1.1;
        }

            .nav-name span {
                display: block;
                font-size: 0.7rem;
                font-weight: 500;
                color: var(--gray-text);
                letter-spacing: 0.06em;
                text-transform: uppercase;
            }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 2rem;
        }

            .nav-links a {
                font-size: 0.9rem;
                font-weight: 500;
                color: var(--gray-text);
                text-decoration: none;
                transition: color 0.2s;
            }

                .nav-links a:hover {
                    color: var(--blue-mid);
                }

        .btn-login {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.6rem 1.5rem;
            background: linear-gradient(135deg, var(--blue-mid), var(--blue-deep));
            color: var(--white);
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            box-shadow: 0 4px 14px rgba(26,110,245,0.3);
            transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
        }

            .btn-login:hover {
                opacity: 0.9;
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(26,110,245,0.4);
                color: var(--white);
            }

        /* ── Hero ───────────────────────────────────── */
        .hero {
            background: linear-gradient(145deg, var(--blue-deep) 0%, #1a3a6e 50%, #1557b0 100%);
            padding: 5rem 2rem 4rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .hero::before {
                content: '';
                position: absolute;
                width: 600px;
                height: 600px;
                border-radius: 50%;
                border: 80px solid rgba(255,255,255,0.03);
                top: -150px;
                left: -150px;
                pointer-events: none;
            }

            .hero::after {
                content: '';
                position: absolute;
                width: 400px;
                height: 400px;
                border-radius: 50%;
                border: 50px solid rgba(255,255,255,0.04);
                bottom: -100px;
                right: -100px;
                pointer-events: none;
            }

        .hero-logo {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid rgba(255,255,255,0.3);
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
            margin-bottom: 1.5rem;
            animation: float 4s ease-in-out infinite;
        }
        @@keyframes float {
            0%, 100% {
                transform: translateY(0)
            }

            50% {
                transform: translateY(-10px)
            }
        }

        .hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2rem, 5vw, 3.25rem);
            color: var(--white);
            line-height: 1.2;
            margin-bottom: 1rem;
        }

            .hero h1 span {
                color: var(--accent);
            }

        .hero p {
            font-size: 1rem;
            color: rgba(255,255,255,0.75);
            max-width: 560px;
            margin: 0 auto 2rem;
            line-height: 1.7;
        }

        .hero-cta {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.85rem 2.5rem;
            background: var(--accent);
            color: #1e293b;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1rem;
            text-decoration: none;
            box-shadow: 0 4px 20px rgba(240,165,0,0.4);
            transition: opacity 0.2s, transform 0.15s;
        }

            .hero-cta:hover {
                opacity: 0.9;
                transform: translateY(-2px);
                color: #1e293b;
            }

        /* ── Sections ───────────────────────────────── */
        .section {
            padding: 2rem;
            margin-bottom: 1.5rem;
        }

        .content-wrap {
            max-width: 900px;
            margin: 2rem auto;
            padding: 0 1rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .card {
            background: var(--white);
            border-radius: 20px;
            padding: 2.25rem;
            box-shadow: 0 2px 24px rgba(15,52,96,0.08);
            border: 1px solid #e8edf5;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            animation: slideUp 0.5s ease both;
        }

            .card:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 40px rgba(15,52,96,0.13);
            }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        .card-title {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 1.3rem;
            font-weight: 700;
            margin-bottom: 1.25rem;
        }

            .card-title i {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.1rem;
                flex-shrink: 0;
            }

        /* How to use */
        .steps {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
        }

            .steps li {
                display: flex;
                align-items: flex-start;
                gap: 1rem;
                padding: 0.85rem 1rem;
                border-radius: 10px;
                background: #f8faff;
                border: 1px solid #e8edf5;
                font-size: 0.9rem;
                line-height: 1.6;
                transition: background 0.2s, transform 0.2s;
                cursor: default;
            }

                .steps li:hover {
                    background: #eef3ff;
                    transform: translateX(4px);
                }

        .step-num {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--blue-mid), var(--blue-deep));
            color: white;
            font-size: 0.75rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-top: 1px;
        }

        .tip-box {
            margin-top: 1.25rem;
            background: linear-gradient(135deg, #f0f7ff, #f0fdf4);
            border: 1px solid #bfdbfe;
            border-radius: 12px;
            padding: 1rem 1.25rem;
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            font-size: 0.875rem;
            color: #1e40af;
        }

            .tip-box i {
                font-size: 1.1rem;
                margin-top: 1px;
                flex-shrink: 0;
            }

        /* Testimonials */
        .testimonial-wrap {
            position: relative;
        }

        .testimonial-card {
            background: var(--gray-soft);
            border-radius: 14px;
            padding: 1.75rem;
            text-align: center;
        }

        .quote-icon {
            font-size: 2rem;
            color: var(--blue-light);
            margin-bottom: 0.75rem;
        }

        .quote-text {
            font-size: 1rem;
            color: #334155;
            font-style: italic;
            line-height: 1.7;
            margin-bottom: 1rem;
        }

        .quote-author {
            font-size: 0.875rem;
            font-weight: 700;
            color: var(--blue-mid);
        }

        /* Contact */
        .contact-links {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            margin-bottom: 1.25rem;
        }

        .contact-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.9rem;
            text-decoration: none;
            color: #334155;
            padding: 0.7rem 1rem;
            border-radius: 10px;
            background: #f8faff;
            border: 1px solid #e8edf5;
            transition: background 0.2s;
        }

            .contact-link i {
                color: var(--blue-mid);
                font-size: 1rem;
            }

            .contact-link:hover {
                background: #eef3ff;
                color: var(--blue-mid);
            }

        .btn-talk {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.8rem 2rem;
            background: linear-gradient(135deg, var(--blue-mid), var(--green));
            color: var(--white);
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.9rem;
            text-decoration: none;
            box-shadow: 0 4px 16px rgba(26,110,245,0.3);
            transition: opacity 0.2s, transform 0.15s;
        }

            .btn-talk:hover {
                opacity: 0.9;
                transform: translateY(-1px);
                color: var(--white);
            }

        /* Imprint */
        .imprint-content {
            font-size: 0.9rem;
            color: var(--gray-text);
            line-height: 2;
        }

            .imprint-content strong {
                color: #334155;
            }

        /* Footer */
        footer {
            background: var(--blue-deep);
            color: rgba(255,255,255,0.6);
            text-align: center;
            padding: 1.5rem;
            font-size: 0.8rem;
        }

            footer strong {
                color: rgba(255,255,255,0.9);
            }

        /* FAB scroll to top */
        .fab {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--blue-mid), var(--blue-deep));
            color: white;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            box-shadow: 0 4px 16px rgba(26,110,245,0.4);
            transition: opacity 0.3s, transform 0.2s;
            opacity: 0;
            pointer-events: none;
            z-index: 9999;
        }

            .fab.show {
                opacity: 1;
                pointer-events: auto;
            }

            .fab:hover {
                transform: scale(1.1);
            }

        /* Mobile nav */
        .nav-hamburger {
            display: none;
            background: none;
            border: none;
            font-size: 1.4rem;
            color: var(--blue-deep);
            cursor: pointer;
        }

        .nav-mobile {
            display: none;
            flex-direction: column;
            gap: 0.75rem;
            padding: 1rem 2rem;
            background: white;
            border-top: 1px solid #e2e8f0;
        }

            .nav-mobile.open {
                display: flex;
            }

            .nav-mobile a {
                font-size: 0.95rem;
                font-weight: 500;
                color: var(--gray-text);
                text-decoration: none;
                padding: 0.4rem 0;
            }

        @@media (max-width: 768px) {
            .nav-links {
                display: none;
            }

            .nav-hamburger {
                display: block;
            }
        }
    </style>
</head>
<body>

    <!-- Loading overlay -->
    <div id="loadingOverlay" style="position:fixed;inset:0;background:white;display:flex;align-items:center;justify-content:center;z-index:9999;">
        <div style="width:48px;height:48px;border:4px solid #e2e8f0;border-top-color:#1a6ef5;border-radius:50%;animation:spin 0.8s linear infinite;"></div>
        <style>
            @@keyframes spin {
                to {
                    transform: rotate(360deg)
                }
            }</style>
    </div>

    <!-- Navbar -->
    <nav class="navbar">
        <a href="/" class="nav-brand">
            <img src="/images/alegrialogo2025.jpeg" alt="Logo" class="nav-logo" />
            <div class="nav-name">Alegria Canyoneering<span>Web Booking System</span></div>
        </a>
        <div class="nav-links">
            <a href="#how-to-use">How to Use</a>
            <a href="#testimonials">Testimonials</a>
            <a href="#contact">Contact</a>
            <a href="/Authentication/Login" class="btn-login">
                <i class="bi bi-box-arrow-in-right"></i> Login
            </a>
        </div>
        <button class="nav-hamburger" onclick="document.getElementById('mobileNav').classList.toggle('open')">
            <i class="bi bi-list"></i>
        </button>
    </nav>
    <div id="mobileNav" class="nav-mobile">
        <a href="#how-to-use">How to Use</a>
        <a href="#testimonials">Testimonials</a>
        <a href="#contact">Contact</a>
        <a href="/Authentication/Login" style="color:#1a6ef5;font-weight:600;">Login →</a>
    </div>

    <!-- Hero -->
    <section class="hero">
        <img src="/images/alegrialogo2025.jpeg" alt="Alegria Logo" class="hero-logo" />
        <h1>Alegria <span>Canyoneering</span><br>Web Booking</h1>
        <p>Streamline your guest management with seamless online booking — designed for operators, built for adventure.</p>
        <a href="/Authentication/Login" class="hero-cta">
            <i class="bi bi-box-arrow-in-right"></i> Get Started
        </a>
    </section>

    <!-- Content -->
    <div class="content-wrap">

        <!-- How to Use -->
        <div class="card" id="how-to-use">
            <div class="card-title" style="color:#1d4ed8;">
                <i style="background:rgba(26,110,245,0.1);color:#1a6ef5;" class="bi bi-list-ol"></i>
                How to Use This App
            </div>
            <ol class="steps">
                <li><div class="step-num">1</div><div><strong>Sign In:</strong> The Super Admin creates operator accounts and provides credentials. Operators sign in to access their dashboard.</div></li>
                <li><div class="step-num">2</div><div><strong>Add New Booking:</strong> Use <em>"New Booking"</em> to enter guest details, dates, and tour preferences.</div></li>
                <li><div class="step-num">3</div><div><strong>Save Guest:</strong> After adding a booking, go to <em>"Save Guest"</em> to add another guest to the same booking or cancel.</div></li>
                <li><div class="step-num">4</div><div><strong>View Reservations:</strong> Go to <em>"Reserve Booking"</em> to see all reservations and confirm guest arrivals.</div></li>
                <li><div class="step-num">5</div><div><strong>Scan Batch QR Code:</strong> Scan the unique QR code for each batch to view booking details instantly.</div></li>
                <li><div class="step-num">6</div><div><strong>Confirm Booking:</strong> After scanning, a popup appears — click <em>"Yes"</em> to confirm or <em>"No"</em> to cancel.</div></li>
                <li><div class="step-num">7</div><div><strong>View Booked Guests:</strong> Go to <em>"Booked Guest"</em> to search by date and print the guest list for reference.</div></li>
                <li><div class="step-num">8</div><div><strong>Scan Guest Info:</strong> Scan a guest's QR code to pull up booking details and save a check-in log.</div></li>
            </ol>
            <div class="tip-box">
                <i class="bi bi-lightbulb-fill"></i>
                <span><strong>Tip:</strong> Always confirm and save guest info properly to ensure accurate records and smooth QR check-in.</span>
            </div>
        </div>

        <!-- Testimonials -->
        <div class="card" id="testimonials">
            <div class="card-title" style="color:#15803d;">
                <i style="background:rgba(22,163,74,0.1);color:#16a34a;" class="bi bi-chat-square-quote-fill"></i>
                What Our Users Say
            </div>
            <div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <div class="testimonial-card">
                            <div class="quote-icon"><i class="bi bi-quote"></i></div>
                            <p class="quote-text">"This app streamlined our entire booking process. It's so intuitive!"</p>
                            <div class="quote-author">— Nikk Alvin Barrioquinto</div>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="testimonial-card">
                            <div class="quote-icon"><i class="bi bi-quote"></i></div>
                            <p class="quote-text">"Our response time improved by 50%. Highly recommended!"</p>
                            <div class="quote-author">— Jude Lequido</div>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="testimonial-card">
                            <div class="quote-icon"><i class="bi bi-quote"></i></div>
                            <p class="quote-text">"A guest-friendly platform that actually works. Simple and effective."</p>
                            <div class="quote-author">— Bryan Montemayor</div>
                        </div>
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </div>

        <!-- Contact -->
        <div class="card" id="contact">
            <div class="card-title" style="color:#15803d;">
                <i style="background:rgba(22,163,74,0.1);color:#16a34a;" class="bi bi-chat-dots-fill"></i>
                Get in Touch
            </div>
            <p style="font-size:0.9rem;color:#64748b;margin-bottom:1.25rem;">Have an idea to make our app even better? We'd love to hear from you!</p>
            <div class="contact-links">
                <a href="mailto:lelis.markanthony@gmail.com" class="contact-link">
                    <i class="bi bi-envelope-fill"></i> lelis.markanthony@gmail.com
                </a>
                <a href="tel:+6324175154" class="contact-link">
                    <i class="bi bi-telephone-fill"></i> (032) 417-5154
                </a>
            </div>
            <a href="https://mail.google.com/mail/?view=cm&fs=1&to=lelis.markanthony@gmail.com&su=Inquiry&body=Hello, I would like to get in touch with you."
               target="_blank" class="btn-talk">
                <i class="bi bi-chat-dots-fill"></i> Let's Talk
            </a>
        </div>

        <!-- Imprint -->
        <div class="card">
            <div class="card-title" style="color:#b45309;">
                <i style="background:rgba(245,158,11,0.1);color:#f0a500;" class="bi bi-building-fill"></i>
                Imprint
            </div>
            <div class="imprint-content">
                Published by <strong>JustClick Integrated Solutions Inc.</strong><br />
                171 N. Bacalso Avenue, Cebu City<br />
                Developed by <strong>Dendo Pulgo</strong> and <strong>Darius Cumpio</strong><br />
                Responsible: <strong>Mark Anthony P. Lelis</strong><br />
                On behalf of: <strong>Municipality of Alegria, Cebu</strong>
            </div>
        </div>

    </div>

    <!-- Footer -->
    <footer>
        &copy; 2025 <strong>Alegria Canyoneering Web Booking</strong>. All rights reserved.<br>
        <a href="https://www.facebook.com/jcit2015" style="color:rgba(255,255,255,0.5);text-decoration:none;" target="_blank">JustClick Integrated Solutions Inc.</a>
    </footer>

    <!-- Scroll to top FAB -->
    <button class="fab" id="fabTop" onclick="window.scrollTo({top:0,behavior:'smooth'})">
        <i class="bi bi-arrow-up"></i>
    </button>

    <script>
        // Hide loading overlay
        window.addEventListener('load', () => {
            setTimeout(() => {
                const o = document.getElementById('loadingOverlay');
                o.style.transition = 'opacity 0.4s';
                o.style.opacity = '0';
                setTimeout(() => o.style.display = 'none', 400);
            }, 800);
        });

        // FAB visibility
        window.addEventListener('scroll', () => {
            document.getElementById('fabTop').classList.toggle('show', window.scrollY > 300);
        });

        // Smooth scroll nav links
        document.querySelectorAll('a[href^="#"]').forEach(a => {
            a.addEventListener('click', e => {
                e.preventDefault();
                document.querySelector(a.getAttribute('href'))?.scrollIntoView({ behavior: 'smooth' });
            });
        });

        // Intersection observer for staggered card animations
        const io = new IntersectionObserver(entries => {
            entries.forEach((e, i) => {
                if (e.isIntersecting) {
                    e.target.style.animationDelay = (i * 0.1) + 's';
                    e.target.classList.add('visible');
                }
            });
        }, { threshold: 0.1 });
        document.querySelectorAll('.card').forEach(c => io.observe(c));
    </script>
</body>
</html>