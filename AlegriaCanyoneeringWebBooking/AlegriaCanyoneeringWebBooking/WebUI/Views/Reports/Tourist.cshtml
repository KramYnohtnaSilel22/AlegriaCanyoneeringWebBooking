@model IEnumerable<TourismReportViewModel>
<link href="/css/ReportsTourist.css" rel="stylesheet" />
@{
    var currentFilter = ViewBag.Filter as string ?? "daily";
    var dateFrom = ViewBag.DateFrom as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var dateTo = ViewBag.DateTo as string ?? DateTime.Today.ToString("yyyy-MM-dd");

    // Calculate totals
    var totalThisProvinceMale = Model.Sum(x => x.ThisProvinceMale);
    var totalThisProvinceFemale = Model.Sum(x => x.ThisProvinceFemale);
    var totalOtherProvinceMale = Model.Sum(x => x.OtherProvinceMale);
    var totalOtherProvinceFemale = Model.Sum(x => x.OtherProvinceFemale);
    var totalForeignMale = Model.Sum(x => x.ForeignMale);
    var totalForeignFemale = Model.Sum(x => x.ForeignFemale);
    var grandTotalMale = totalThisProvinceMale + totalOtherProvinceMale + totalForeignMale;
    var grandTotalFemale = totalThisProvinceFemale + totalOtherProvinceFemale + totalForeignFemale;
    var grandTotal = grandTotalMale + grandTotalFemale;
}


<div class="card mt-4 shadow">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5>Tourism Visitor Report (@currentFilter.ToUpper())</h5>
        <div class="d-flex align-items-center">
            <form method="get" asp-action="Tourist" id="filterForm" class="d-flex align-items-center me-3">
                <label class="me-2 text-white fw-bold">Filter:</label>
                <select name="filter" id="filterSelect" class="form-select me-2">
                    <option value="daily" selected="@("daily" == currentFilter)">Daily</option>
                    <option value="weekly" selected="@("weekly" == currentFilter)">Weekly</option>
                    <option value="monthly" selected="@("monthly" == currentFilter)">Monthly</option>
                    <option value="quarterly" selected="@("quarterly" == currentFilter)">Quarterly</option>
                    <option value="yearly" selected="@("yearly" == currentFilter)">Yearly</option>
                </select>

                <label class="me-2 text-white fw-bold">From:</label>
                <input type="date" name="dateFrom" id="dateFrom" value="@dateFrom" class="form-control me-2" />

                <label class="me-2 text-white fw-bold">To:</label>
                <input type="date" name="dateTo" id="dateTo" value="@dateTo" class="form-control me-2" />

                <button type="submit" class="btn btn-light me-2">
                    <i class="bi bi-filter"></i> Apply
                </button>

                <button type="button" id="btnReset" class="btn btn-secondary">
                    <i class="bi bi-arrow-clockwise"></i> Reset
                </button>
            </form>

            <button class="btn btn-danger me-2" id="btnDownloadPDF">
                <i class="bi bi-file-earmark-pdf"></i> Download PDF
            </button>
            <button class="btn btn-success" id="btnDownloadExcel">
                <i class="bi bi-file-earmark-excel"></i> Download Excel
            </button>
        </div>
    </div>

    <div class="card-body report-container">
        <div class="report-title-box">
            <h3>Tourism Attraction Visitor Record</h3>
            <p>(This recording form can be used instead of just counting the visitors)</p>
        </div>

        <div class="info-grid">
            <div class="info-row">
                <div class="info-cell info-label">Date From:</div>
                <div class="info-cell">@DateTime.Parse(dateFrom).ToString("dddd, MMMM d, yyyy")</div>
            </div>
            <div class="info-row">
                <div class="info-cell info-label">Date To:</div>
                <div class="info-cell">@DateTime.Parse(dateTo).ToString("dddd, MMMM d, yyyy")</div>
            </div>
            <div class="info-row">
                <div class="info-cell info-label">Name of Municipality:</div>
                <div class="info-cell">ALEGRIA, CEBU</div>
            </div>
            <div class="info-row">
                <div class="info-cell info-label">Name of Attraction/Spot:</div>
                <div class="info-cell">Canyoneering Adventure</div>
            </div>
       
        </div>

        <table id="tourismReportTable">
            <thead>
                <tr>
                    <th rowspan="4">Seq.</th>
                    <th rowspan="4">Date<br />Week Day<br />(Mon-Sun)</th>
                    <th colspan="9">***Place of Residences</th>
                    <th colspan="3" rowspan="2">Grand Total Number of Visitors</th>
                </tr>
                <tr>
                    <th colspan="6">Philippines</th>
                    <th colspan="3" rowspan="2">Foreign Country Residence</th>
                </tr>
                <tr>
                    <th colspan="3">This province</th>
                    <th colspan="3">Other Province</th>
                </tr>
                <tr>
                    <th>Male</th>
                    <th>Female</th>
                    <th>Total</th>
                    <th>Male</th>
                    <th>Female</th>
                    <th>Total</th>
                    <th>Male</th>
                    <th>Female</th>
                    <th>Total</th>
                    <th>Male</th>
                    <th>Female</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int seq = 1;
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@seq</td>
                        <td>@item.Label</td>
                        <td>@item.ThisProvinceMale</td>
                        <td>@item.ThisProvinceFemale</td>
                        <td>@(item.ThisProvinceMale + item.ThisProvinceFemale)</td>

                        <td>@item.OtherProvinceMale</td>
                        <td>@item.OtherProvinceFemale</td>
                        <td>@(item.OtherProvinceMale + item.OtherProvinceFemale)</td>

                        <td>@item.ForeignMale</td>
                        <td>@item.ForeignFemale</td>
                        <td>@(item.ForeignMale + item.ForeignFemale)</td>

                        <td>@item.TotalMale</td>
                        <td>@item.TotalFemale</td>
                        <td>@item.GrandTotal</td>
                    </tr>
                    seq++;
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="2">Total of this Month ***</td>
                    <td>@totalThisProvinceMale</td>
                    <td>@totalThisProvinceFemale</td>
                    <td>@(totalThisProvinceMale + totalThisProvinceFemale)</td>

                    <td>@totalOtherProvinceMale</td>
                    <td>@totalOtherProvinceFemale</td>
                    <td>@(totalOtherProvinceMale + totalOtherProvinceFemale)</td>

                    <td>@totalForeignMale</td>
                    <td>@totalForeignFemale</td>
                    <td>@(totalForeignMale + totalForeignFemale)</td>

                    <td>@grandTotalMale</td>
                    <td>@grandTotalFemale</td>
                    <td>@grandTotal</td>
                </tr>
            </tfoot>
        </table>

        <p class="note-text">
            Note: "Total number must be recorded" Set & "Residence entries are optional Total number of this month must be recorded.
        </p>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.20.0/package/dist/xlsx.full.min.js"></script>
    <script src="~/js/ReportsTourism.js" asp-append-version="true"></script>
}