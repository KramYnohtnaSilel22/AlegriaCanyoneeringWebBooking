@model IEnumerable<TourismReportViewModel>
<link href="/css/ReportNationality.css" rel="stylesheet" />

@{
    var totalMale = ViewBag.TotalMale ?? 0;
    var totalFemale = ViewBag.TotalFemale ?? 0;
    var totalEnding = ViewBag.TotalEnding ?? 0;
    var currentFilter = ViewBag.Filter as string ?? "daily";
    var dateFrom = ViewBag.DateFrom as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var dateTo = ViewBag.DateTo as string ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="card mt-4 shadow">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center flex-wrap">
        <h5>Nationality Visitor Report (@currentFilter.ToUpper())</h5>
        <div class="d-flex align-items-center flex-wrap mt-2 mt-md-0">
            <form method="get" asp-action="Nationality" id="filterForm" class="d-flex align-items-center me-3">
                <label class="me-2 text-white fw-bold">Filter:</label>
                <select name="filter" id="filterSelect" class="form-select me-2">
                    <option value="daily" selected="@(currentFilter == "daily")">Daily</option>
                    <option value="weekly" selected="@(currentFilter == "weekly")">Weekly</option>
                    <option value="monthly" selected="@(currentFilter == "monthly")">Monthly</option>
                    <option value="quarterly" selected="@(currentFilter == "quarterly")">Quarterly</option>
                    <option value="yearly" selected="@(currentFilter == "yearly")">Yearly</option>
                </select>

                <label class="me-2 text-white fw-bold">From:</label>
                <input type="date" name="dateFrom" id="dateFrom" value="@dateFrom" class="form-control me-2" />

                <label class="me-2 text-white fw-bold">To:</label>
                <input type="date" name="dateTo" id="dateTo" value="@dateTo" class="form-control me-2" />

                <button type="submit" class="btn btn-light me-2">
                    <i class="bi bi-filter"></i> Apply
                </button>

                <button type="button" id="btnReset" class="btn btn-secondary">
                    <i class="bi bi-arrow-clockwise"></i> Reset
                </button>
            </form>

            <button class="btn btn-danger me-2 mb-2 mb-md-0" id="btnDownloadPDF">
                <i class="bi bi-file-earmark-pdf"></i> Download PDF
            </button>
            <button class="btn btn-success mb-2 mb-md-0" id="btnDownloadExcel">
                <i class="bi bi-file-earmark-excel"></i> Download Excel
            </button>
        </div>
    </div>

    <div class="card-body report-container">
        <div class="report-title-box">
            <h3>Nationality Visitor Record</h3>
            <p>(Summary of visitors by nationality)</p>
        </div>

        <div class="info-grid">
            <div class="info-row">
                <div class="info-cell info-label">Date From:</div>
                <div class="info-cell">@DateTime.Parse(dateFrom).ToString("dddd, MMMM d, yyyy")</div>
            </div>
            <div class="info-row">
                <div class="info-cell info-label">Date To:</div>
                <div class="info-cell">@DateTime.Parse(dateTo).ToString("dddd, MMMM d, yyyy")</div>
            </div>
            <div class="info-row">
                <div class="info-cell info-label">Municipality:</div>
                <div class="info-cell">ALEGRIA, CEBU</div>
            </div>
            <div class="info-row">
                <div class="info-cell info-label">Name of Attraction/Spot:</div>
                <div class="info-cell">Canyoneering Adventure</div>
            </div>
        </div>

        <table id="tourismReportTable" class="table table-bordered table-striped table-hover mt-3">
            <thead class="table-primary">
                <tr>
                    <th>Seq.</th>
                    <th>NATIONALITY</th>
                    <th>MALE</th>
                    <th>FEMALE</th>
                    <th>ENDING TOTAL</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int seq = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@seq</td>
                            <td>@item.Label</td>
                            <td>@item.OtherProvinceMale</td>
                            <td>@item.OtherProvinceFemale</td>
                            <td>@(item.OtherProvinceMale + item.OtherProvinceFemale)</td>
                        </tr>
                        seq++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-3">No data available for the selected date range</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-secondary">
                <tr>
                    <td colspan="2"><strong>TOTAL:</strong></td>
                    <td><strong>@totalMale</strong></td>
                    <td><strong>@totalFemale</strong></td>
                    <td><strong>@totalEnding</strong></td>
                </tr>
            </tfoot>
        </table>
        <p class="note-text">
            Note: Report generated on @DateTime.Today.ToString("MMMM dd, yyyy")
        </p>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.20.0/package/dist/xlsx.full.min.js"></script>
    <script src="~/js/ReportNationality.js" asp-append-version="true"></script>
}
