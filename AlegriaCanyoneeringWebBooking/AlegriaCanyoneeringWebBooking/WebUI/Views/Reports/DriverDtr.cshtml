@model IEnumerable<AlegriaCanyoneeringWebBooking.WebUI.ViewModel.DriverDtrReportViewModel>
<link href="~/css/ReportsDriverDtr.css" rel="stylesheet" />

@{
    var totalPassenger = (int)(ViewBag.TotalPassenger ?? 0);
    var totalGross = (decimal)(ViewBag.TotalGross ?? 0m);
    var totalNetPay = (decimal)(ViewBag.TotalNetPay ?? 0m);
    var period = ViewBag.Period as string ?? "";
    var dateFrom = ViewBag.DateFrom as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var dateTo = ViewBag.DateTo as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var selectedArea = ViewBag.SelectedArea as string ?? "";
    var areas = ViewBag.Areas as List<string> ?? new List<string> { "Wonder Falls", "Kanlaob", "Kawasan Exit" };
    var areaDisplay = string.IsNullOrEmpty(selectedArea) ? "ALL AREAS" : selectedArea.ToUpper();

    DateTime.TryParse(dateFrom, out var fromDt);
    DateTime.TryParse(dateTo, out var toDt);

    var rows = Model?.ToList() ?? new List<AlegriaCanyoneeringWebBooking.WebUI.ViewModel.DriverDtrReportViewModel>();
}

<div class="card mt-4 shadow">
    <!-- Card Header — hidden on print -->
    <div class="card-header bg-primary text-white d-flex flex-wrap justify-content-between align-items-center">
        <h5 class="mb-2 mb-md-0">
            <i class="bi bi-card-list me-2"></i>Driver DTR Report
        </h5>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <form method="get" asp-action="DriverDtr" id="filterForm"
                  class="d-flex flex-wrap align-items-center gap-2">
                <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2">
                    <label class="fw-bold text-white">From:</label>
                    <input type="date" id="dateFrom" name="dateFrom" value="@dateFrom"
                           class="form-control form-control-sm" required />
                </div>
                <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2">
                    <label class="fw-bold text-white">To:</label>
                    <input type="date" id="dateTo" name="dateTo" value="@dateTo"
                           class="form-control form-control-sm" required />
                </div>
                <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2">
                    <label class="fw-bold text-white">Area:</label>
                    <select name="area" class="form-select form-select-sm" style="min-width:140px;">
                        <option value="" selected="@(string.IsNullOrEmpty(selectedArea) ? "selected" : null)">— All Areas —</option>
                        @foreach (var a in areas)
                        {
                            <option value="@a" selected="@(selectedArea == a ? "selected" : null)">@a</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-light btn-sm mt-2 mt-sm-0">
                    <i class="bi bi-search"></i> Search
                </button>
            </form>
            <div class="btn-group mt-2 mt-sm-0">
                <button type="button" class="btn btn-info btn-sm dropdown-toggle"
                        data-bs-toggle="dropdown">
                    <i class="bi bi-printer"></i> Print
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" href="#" id="btnDownloadPDF">
                            <i class="bi bi-file-earmark-pdf"></i> Print as PDF
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="#" id="btnDownloadExcel">
                            <i class="bi bi-file-earmark-excel"></i> Print as Excel
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Payroll Form Body -->
    <div class="card-body report-container" id="printArea">

        <!-- ===== GOVERNMENT PAYROLL HEADER ===== -->
        <div class="pay-top-header text-center">
            <div class="pay-project-label">Project</div>
        </div>

        <div class="pay-meta-row">
            <div class="pay-meta-left">
                <div>LGU : &nbsp;<strong>MUNICIPALITY OF ALEGRIA</strong></div>
                <div class="pay-project-name"><strong id="displayArea">@areaDisplay</strong></div>
            </div>
            <div class="pay-meta-right">
                Period: <strong id="displayPeriod">@period</strong>
            </div>
        </div>

        <!-- ===== PAYROLL TABLE ===== -->
        <div class="table-responsive">
            <table id="driverDtrTable" class="pay-table">
                <thead>
                    <tr class="pay-thead-top">
                        <th rowspan="2" class="col-seq">&nbsp;</th>
                        <th rowspan="2" class="col-name">Name</th>
                        <th rowspan="2" class="col-address">Address</th>
                        <th rowspan="2" class="col-desig">Designation</th>
                        <th rowspan="2" class="col-pax">Number<br />of<br />Passenger</th>
                        <th rowspan="2" class="col-rate">Rate<br />per<br />Day</th>
                        <th rowspan="2" class="col-gross">Gross<br />Salary</th>
                        <th rowspan="2" class="col-net">NET PAY</th>
                        <th rowspan="2" class="col-seq2">&nbsp;</th>
                        <th rowspan="2" class="col-sig">Signature or<br />Thumbmark</th>
                        <th colspan="3" class="col-ctax-header">COMMUNITY TAX</th>
                    </tr>
                    <tr class="pay-thead-bottom">
                        <th class="col-ctax-num">Number</th>
                        <th class="col-ctax-date">Date</th>
                        <th class="col-ctax-place">Place of<br />Issue</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int seq = 1;
                        if (!rows.Any())
                        {
                            <tr>
                                <td colspan="13" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox me-2" style="font-size:1.4rem;"></i><br />
                                    <span class="fw-semibold">No data found</span>
                                    @if (!string.IsNullOrEmpty(selectedArea))
                                    {
                                        <span> for <strong>@selectedArea</strong></span>
                                    }
                                    <span> in the selected date range.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in rows)
                            {
                                <tr>
                                    <td class="col-seq text-center">@seq</td>
                                    <td class="col-name">@item.DriverName</td>
                                    <td class="col-address">@item.Address</td>
                                    <td class="col-desig text-center">@item.Designation</td>
                                    <td class="col-pax text-center" data-pax="@item.TotalPassenger">@item.TotalPassenger</td>
                                    <td class="col-rate text-center" data-rate="@item.RatePerDay">@item.RatePerDay</td>
                                    <td class="col-gross text-end" data-gross="@item.GrossSalary.ToString("F2")">@item.GrossSalary.ToString("N2")</td>
                                    <td class="col-net text-end" data-net="@item.NetPay.ToString("F2")">@item.NetPay.ToString("N2")</td>
                                    <td class="col-seq2 text-center">@seq</td>
                                    <td class="col-sig"></td>
                                    <td class="col-ctax-num"></td>
                                    <td class="col-ctax-date"></td>
                                    <td class="col-ctax-place text-center">@item.PlaceOfIssue</td>
                                </tr>
                                seq++;
                            }
                        }
                    }
                </tbody>
                <tfoot>
                    <tr class="pay-total-row">
                        <td colspan="4"></td>
                        <td class="text-center fw-bold" id="grandTotalPax">@totalPassenger</td>
                        <td></td>
                        <td class="text-end fw-bold" id="grandTotalGross">@totalGross.ToString("N2")</td>
                        <td class="text-end fw-bold" id="grandTotalNet">@totalNetPay.ToString("N2")</td>
                        <td colspan="5"></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- ===== FOOTER CERTIFICATION ===== -->
        <div class="pay-footer">
            <div class="pay-cert-row">
                <div class="pay-cert-left">
                    <div class="pay-cert-title">CERTIFIED:</div>
                    <div class="pay-cert-body">
                        Each person whose name appears on this<br />
                        roll had rendered services for the time stated.
                    </div>
                    <div class="pay-sig-block">
                        <div class="pay-sig-name">DESMOND KENNITH A. PLATERO</div>
                        <div class="pay-sig-label">Municipal Tourism Officer - Designate</div>
                    </div>
                </div>
                <div class="pay-cert-mid">
                    <div class="pay-approved-text">Approved for Payment:</div>
                    <div class="pay-sig-block">
                        <div class="pay-sig-name">GILBERTO F. MAGALLON, M.D.</div>
                        <div class="pay-sig-label">Municipal Mayor</div>
                    </div>
                </div>
                <div class="pay-cert-right">
                    <div class="pay-cert-title">CERTIFIED:</div>
                    <div class="pay-cert-body">
                        Each person whose name appears on the above
                        roll has been paid the amount stated opposite his
                        name after identifying them.
                    </div>
                    <div class="pay-sig-block">
                        <div class="pay-sig-name">C/O REGISTER PAYROLL</div>
                        <div class="pay-sig-label">Disbursing officer</div>
                    </div>
                </div>
            </div>
        </div>

        <p class="system-generated-text text-end small text-muted mt-2">
            <em>System Generated Report — Driver DTR Summary</em>
        </p>

    </div><!-- /report-container -->
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js"></script>
    <script src="~/js/ReportsDriverDtr.js" asp-append-version="true"></script>
}
