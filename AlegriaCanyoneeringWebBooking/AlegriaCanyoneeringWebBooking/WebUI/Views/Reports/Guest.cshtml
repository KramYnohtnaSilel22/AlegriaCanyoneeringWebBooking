@model IEnumerable<TourismReportViewModel>
<link href="~/css/ReportsGuest.css" rel="stylesheet" />

@{
    var dateFrom = ViewBag.DateFrom as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var dateTo = ViewBag.DateTo as string ?? DateTime.Today.ToString("yyyy-MM-dd");

    // FIX: Add null checking to prevent errors
    var totalThisProvinceMale = Model?.Sum(x => x.ThisProvinceMale) ?? 0;
    var totalThisProvinceFemale = Model?.Sum(x => x.ThisProvinceFemale) ?? 0;
    var totalOtherProvinceMale = Model?.Sum(x => x.OtherProvinceMale) ?? 0;
    var totalOtherProvinceFemale = Model?.Sum(x => x.OtherProvinceFemale) ?? 0;
    var totalForeignMale = Model?.Sum(x => x.ForeignMale) ?? 0;
    var totalForeignFemale = Model?.Sum(x => x.ForeignFemale) ?? 0;

    var grandTotalMale = totalThisProvinceMale + totalOtherProvinceMale + totalForeignMale;
    var grandTotalFemale = totalThisProvinceFemale + totalOtherProvinceFemale + totalForeignFemale;
    var grandTotal = grandTotalMale + grandTotalFemale;
}

<div class="card mt-4 shadow">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5>Guest Visitor Report</h5>
        <div class="d-flex align-items-center">
            <form method="get" asp-action="Guest" id="filterForm" class="d-flex align-items-center me-3">
                <label class="me-2 text-white fw-bold">From:</label>
                <input type="date" name="dateFrom" id="dateFrom" value="@ViewBag.DateFrom" class="form-control me-2" required />
                <label class="me-2 text-white fw-bold">To:</label>
                <input type="date" name="dateTo" id="dateTo" value="@ViewBag.DateTo" class="form-control me-2" required />
                <button type="submit" class="btn btn-light">
                    <i></i> Search
                </button>
            </form>

            <!-- Print Dropdown Button -->
            <div class="btn-group me-2" role="group">
                <button type="button" class="btn btn-info dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-printer"></i> Print
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#" id="btnDownloadPDF"><i class="bi bi-file-earmark-pdf"></i> Print as PDF</a></li>
                    <li><a class="dropdown-item" href="#" id="btnDownloadExcel"><i class="bi bi-file-earmark-excel"></i> Print as Excel</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="card-body report-container">
        <div class="report-title-box text-center mb-4">
            <h3>Tourism Attraction Visitor Record</h3>
            <p>(This recording form can be used instead of just counting the visitors)</p>
        </div>

        <div class="info-grid mb-3">
            <div class="info-row">
                <div class="info-cell fw-bold">Date From:</div>
                <div class="info-cell">@DateTime.Parse(dateFrom).ToString("dddd, MMMM d, yyyy")</div>
                <div class="info-cell fw-bold">Date To:</div>
                <div class="info-cell">@DateTime.Parse(dateTo).ToString("dddd, MMMM d, yyyy")</div>
            </div>
            <div class="info-row">
                <div class="info-cell fw-bold">Municipality:</div>
                <div class="info-cell">ALEGRIA, CEBU</div>
                <div class="info-cell fw-bold">Attraction:</div>
                <div class="info-cell">Canyoneering Adventure</div>
            </div>
        </div>

        <table id="tourismReportTable" class="table table-bordered table-striped text-center">
            <thead class="table-primary">
                <tr>
                    <th rowspan="4">Seq.</th>
                    <th rowspan="4">
                        @if (ViewBag.GroupByMonth == true)
                        {
                            <text>Month</text>
                        }
                        else
                        {
                            <text>Date<br />Week Day<br />(Mon-Sun)</text>
                        }
                    </th>
                    <th colspan="9">*** Place of Residences</th>
                    <th colspan="3" rowspan="2">Grand Total Number of Visitors</th>
                </tr>
                <tr>
                    <th colspan="6">Philippines</th>
                    <th colspan="3" rowspan="2">Foreign Country Residence</th>
                </tr>
                <tr>
                    <th colspan="3">This Province</th>
                    <th colspan="3">Other Province</th>
                </tr>
                <tr>
                    <th>Male</th>
                    <th>Female</th>
                    <th>Total</th>
                    <th>Male</th>
                    <th>Female</th>
                    <th>Total</th>
                    <th>Male</th>
                    <th>Female</th>
                    <th>Total</th>
                    <th>Male</th>
                    <th>Female</th>
                    <th>Total</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int seq = 1;
                    if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="14" class="text-center py-4">No data available for the selected date range</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@seq</td>
                                <td>@item.Label</td>
                                <td>@item.ThisProvinceMale</td>
                                <td>@item.ThisProvinceFemale</td>
                                <td>@(item.ThisProvinceMale + item.ThisProvinceFemale)</td>

                                <td>@item.OtherProvinceMale</td>
                                <td>@item.OtherProvinceFemale</td>
                                <td>@(item.OtherProvinceMale + item.OtherProvinceFemale)</td>

                                <td>@item.ForeignMale</td>
                                <td>@item.ForeignFemale</td>
                                <td>@(item.ForeignMale + item.ForeignFemale)</td>

                                <td>@item.TotalMale</td>
                                <td>@item.TotalFemale</td>
                                <td>@item.GrandTotal</td>
                            </tr>
                            seq++;
                        }
                    }
                }
            </tbody>

            <tfoot class="fw-bold table-secondary">
                <tr>
                    <td colspan="2">@(ViewBag.GroupByMonth == true ? "Period Total" : "Monthly Total")</td>
                    <td>@totalThisProvinceMale</td>
                    <td>@totalThisProvinceFemale</td>
                    <td>@(totalThisProvinceMale + totalThisProvinceFemale)</td>
                    <td>@totalOtherProvinceMale</td>
                    <td>@totalOtherProvinceFemale</td>
                    <td>@(totalOtherProvinceMale + totalOtherProvinceFemale)</td>
                    <td>@totalForeignMale</td>
                    <td>@totalForeignFemale</td>
                    <td>@(totalForeignMale + totalForeignFemale)</td>
                    <td>@grandTotalMale</td>
                    <td>@grandTotalFemale</td>
                    <td>@grandTotal</td>
                </tr>
            </tfoot>
        </table>

        <p class="note-text mt-3">
            <em>Note: Total number must be recorded. Residence entries are optional. @(ViewBag.GroupByMonth == true ? "Period" : "Monthly") totals must be recorded.</em>
        </p>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js"></script>

    <script src="~/js/ReportsGuest.js" asp-append-version="true"></script>
}
