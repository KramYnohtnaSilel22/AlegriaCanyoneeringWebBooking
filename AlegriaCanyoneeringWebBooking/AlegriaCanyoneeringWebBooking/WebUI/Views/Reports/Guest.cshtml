@model IEnumerable<TourismReportViewModel>
<link href="~/css/ReportsGuest.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

@{
    var dateFrom = ViewBag.DateFrom as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var dateTo = ViewBag.DateTo as string ?? DateTime.Today.ToString("yyyy-MM-dd");

    var totalThisProvinceMale = Model?.Sum(x => x.ThisProvinceMale) ?? 0;
    var totalThisProvinceFemale = Model?.Sum(x => x.ThisProvinceFemale) ?? 0;
    var totalOtherProvinceMale = Model?.Sum(x => x.OtherProvinceMale) ?? 0;
    var totalOtherProvinceFemale = Model?.Sum(x => x.OtherProvinceFemale) ?? 0;
    var totalForeignMale = Model?.Sum(x => x.ForeignMale) ?? 0;
    var totalForeignFemale = Model?.Sum(x => x.ForeignFemale) ?? 0;

    var grandTotalMale = totalThisProvinceMale + totalOtherProvinceMale + totalForeignMale;
    var grandTotalFemale = totalThisProvinceFemale + totalOtherProvinceFemale + totalForeignFemale;
    var grandTotal = grandTotalMale + grandTotalFemale;
}

<style>
    .rpt-wrap * {
        font-family: 'Outfit', sans-serif;
    }

    .rpt-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

        .rpt-header h2 {
            font-size: 1.35rem;
            font-weight: 700;
            color: #0f3460;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .rpt-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 20px rgba(15,52,96,0.08);
        border: 1px solid #e8edf5;
        overflow: hidden;
        margin-bottom: 1.5rem;
    }

    .rpt-card-header {
        background: linear-gradient(135deg,#1a6ef5,#0f3460);
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

        .rpt-card-header h5 {
            color: #fff;
            font-size: 1rem;
            font-weight: 700;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

    .rpt-filter-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem;
    }

    .rpt-filter-label {
        color: rgba(255,255,255,0.85);
        font-size: 0.8rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .rpt-filter-input {
        padding: 0.4rem 0.75rem;
        border: 1.5px solid rgba(255,255,255,0.3);
        border-radius: 8px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.8rem;
        background: rgba(255,255,255,0.15);
        color: #fff;
        outline: none;
        transition: border-color 0.2s, background 0.2s;
    }

        .rpt-filter-input:focus {
            border-color: rgba(255,255,255,0.7);
            background: rgba(255,255,255,0.25);
        }

    .btn-rpt-search {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.42rem 1rem;
        background: rgba(255,255,255,0.18);
        color: #fff;
        border: 1.5px solid rgba(255,255,255,0.4);
        border-radius: 8px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-rpt-search:hover {
            background: rgba(255,255,255,0.28);
        }

    .btn-rpt-print {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.42rem 1rem;
        background: #fff;
        color: #0f3460;
        border: none;
        border-radius: 8px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        transition: opacity 0.2s;
    }

        .btn-rpt-print:hover {
            opacity: 0.88;
        }

    .rpt-body {
        padding: 1.5rem;
    }

    .rpt-title-box {
        text-align: center;
        border: 2px solid #e8edf5;
        border-radius: 12px;
        padding: 1.25rem 1rem;
        margin-bottom: 1.25rem;
        background: #f8faff;
    }

        .rpt-title-box h3 {
            font-size: 1.2rem;
            font-weight: 700;
            color: #0f3460;
            margin: 0 0 0.25rem;
        }

        .rpt-title-box p {
            font-size: 0.8rem;
            color: #64748b;
            margin: 0;
        }

    .rpt-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 0.6rem;
        margin-bottom: 1.25rem;
    }

    .rpt-info-item {
        background: #f8faff;
        border: 1px solid #e8edf5;
        border-radius: 10px;
        padding: 0.55rem 0.9rem;
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }

    .rpt-info-label {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #94a3b8;
    }

    .rpt-info-value {
        font-size: 0.875rem;
        font-weight: 600;
        color: #0f3460;
    }

    #tourismReportTable {
        width: 100%;
        border-collapse: collapse;
        font-family: 'Outfit', sans-serif;
    }

        #tourismReportTable thead th {
            background: #f8faff;
            color: #0f3460;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            border: 1px solid #e8edf5;
            padding: 0.6rem 0.5rem;
            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
        }

        #tourismReportTable tbody td {
            font-size: 0.82rem;
            color: #334155;
            border: 1px solid #e8edf5;
            padding: 0.55rem 0.5rem;
            text-align: center;
            vertical-align: middle;
        }

        #tourismReportTable tbody tr:hover {
            background: #f0f6ff;
        }

        #tourismReportTable tbody td:nth-child(2) {
            font-weight: 600;
        }

        #tourismReportTable tfoot td {
            background: #f0f6ff;
            font-weight: 700;
            font-size: 0.82rem;
            color: #0f3460;
            border: 1px solid #e8edf5;
            padding: 0.6rem 0.5rem;
            text-align: center;
            vertical-align: middle;
        }

    .seq-badge {
        display: inline-block;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #e0e7ff;
        color: #3730a3;
        font-size: 0.72rem;
        font-weight: 700;
        line-height: 24px;
        text-align: center;
    }

    .total-badge {
        display: inline-block;
        padding: 0.2rem 0.55rem;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 700;
        background: #dcfce7;
        color: #166534;
    }

    .rpt-note {
        font-size: 0.78rem;
        color: #94a3b8;
        font-style: italic;
        margin-top: 1rem;
    }

    .rpt-sysgen {
        font-size: 0.72rem;
        color: #cbd5e1;
        font-style: italic;
        text-align: right;
        margin-top: 0.25rem;
    }

    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: #94a3b8;
    }

        .empty-state i {
            font-size: 2.5rem;
            display: block;
            margin-bottom: 0.5rem;
        }

        .empty-state span {
            font-size: 0.9rem;
            font-weight: 600;
        }
</style>

<div class="rpt-wrap">

    <div class="rpt-header">
        <h2>
            <i class="bi bi-people-fill" style="color:#1a6ef5;"></i> Guest Visitor Report
        </h2>
    </div>

    <div class="rpt-card">

        <!-- Gradient Header with Filters -->
        <div class="rpt-card-header">
            <h5><i class="bi bi-clipboard2-data"></i> Tourism Attraction Visitor Record</h5>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <form method="get" asp-action="Guest" id="filterForm" class="rpt-filter-row">
                    <span class="rpt-filter-label">From</span>
                    <input type="date" name="dateFrom" value="@ViewBag.DateFrom"
                           class="rpt-filter-input" required />

                    <span class="rpt-filter-label">To</span>
                    <input type="date" name="dateTo" value="@ViewBag.DateTo"
                           class="rpt-filter-input" required />

                    <button type="submit" class="btn-rpt-search">
                        <i class="bi bi-search"></i> Search
                    </button>
                </form>

                <div class="dropdown">
                    <button class="btn-rpt-print dropdown-toggle"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-printer"></i> Export
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0"
                        style="border-radius:12px;">
                        <li>
                            <a class="dropdown-item" href="#" id="btnDownloadPDF"
                               style="font-family:'Outfit',sans-serif;font-size:0.875rem;">
                                <i class="bi bi-file-earmark-pdf text-danger me-2"></i> Download PDF
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="#" id="btnDownloadExcel"
                               style="font-family:'Outfit',sans-serif;font-size:0.875rem;">
                                <i class="bi bi-file-earmark-excel text-success me-2"></i> Download Excel
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Report Body -->
        <div class="rpt-body report-container">

            <div class="rpt-title-box">
                <h3>Tourism Attraction Visitor Record</h3>
                <p>(This recording form can be used instead of just counting the visitors)</p>
            </div>

            <!-- Info Cards -->
            <div class="rpt-info-grid mb-3">
                <div class="rpt-info-item">
                    <span class="rpt-info-label">Date From</span>
                    <span class="rpt-info-value">
                        @(DateTime.TryParse(dateFrom, out var from) ? from.ToString("dddd, MMMM d, yyyy") : "N/A")
                    </span>
                </div>
                <div class="rpt-info-item">
                    <span class="rpt-info-label">Date To</span>
                    <span class="rpt-info-value">
                        @(DateTime.TryParse(dateTo, out var to) ? to.ToString("dddd, MMMM d, yyyy") : "N/A")
                    </span>
                </div>
                <div class="rpt-info-item">
                    <span class="rpt-info-label">Municipality</span>
                    <span class="rpt-info-value">ALEGRIA, CEBU</span>
                </div>
                <div class="rpt-info-item">
                    <span class="rpt-info-label">Attraction</span>
                    <span class="rpt-info-value">Canyoneering Adventure</span>
                </div>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table id="tourismReportTable" class="table table-bordered text-center align-middle">
                    <thead>
                        <tr>
                            <th rowspan="4">Seq.</th>
                            <th rowspan="4">
                                @if (ViewBag.GroupByMonth == true)
                                {
                                    <text>Month</text>
                                }
                                else
                                {
                                    <text>Date<br />Week Day<br />(Mon–Sun)</text>
                                }
                            </th>
                            <th colspan="9">★ Place of Residences</th>
                            <th colspan="3" rowspan="2">Grand Total<br />Visitors</th>
                        </tr>
                        <tr>
                            <th colspan="6">Philippines</th>
                            <th colspan="3" rowspan="2">Foreign<br />Country</th>
                        </tr>
                        <tr>
                            <th colspan="3">This Province</th>
                            <th colspan="3">Other Province</th>
                        </tr>
                        <tr>
                            <th>M</th>
                            <th>F</th>
                            <th>Total</th>
                            <th>M</th>
                            <th>F</th>
                            <th>Total</th>
                            <th>M</th>
                            <th>F</th>
                            <th>Total</th>
                            <th>M</th>
                            <th>F</th>
                            <th>Total</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int seq = 1;
                            if (Model == null || !Model.Any())
                            {
                                <tr>
                                    <td colspan="14">
                                        <div class="empty-state">
                                            <i class="bi bi-inbox"></i>
                                            <span>No data available for the selected date range.</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td><span class="seq-badge">@seq</span></td>
                                        <td>@item.Label</td>
                                        <td>@item.ThisProvinceMale</td>
                                        <td>@item.ThisProvinceFemale</td>
                                        <td>@(item.ThisProvinceMale + item.ThisProvinceFemale)</td>
                                        <td>@item.OtherProvinceMale</td>
                                        <td>@item.OtherProvinceFemale</td>
                                        <td>@(item.OtherProvinceMale + item.OtherProvinceFemale)</td>
                                        <td>@item.ForeignMale</td>
                                        <td>@item.ForeignFemale</td>
                                        <td>@(item.ForeignMale + item.ForeignFemale)</td>
                                        <td>@item.TotalMale</td>
                                        <td>@item.TotalFemale</td>
                                        <td><span class="total-badge">@item.GrandTotal</span></td>
                                    </tr>
                                    seq++;
                                }
                            }
                        }
                    </tbody>

                    <tfoot>
                        <tr>
                            <td colspan="2">@(ViewBag.GroupByMonth == true ? "Period Total" : "Monthly Total")</td>
                            <td>@totalThisProvinceMale</td>
                            <td>@totalThisProvinceFemale</td>
                            <td>@(totalThisProvinceMale + totalThisProvinceFemale)</td>
                            <td>@totalOtherProvinceMale</td>
                            <td>@totalOtherProvinceFemale</td>
                            <td>@(totalOtherProvinceMale + totalOtherProvinceFemale)</td>
                            <td>@totalForeignMale</td>
                            <td>@totalForeignFemale</td>
                            <td>@(totalForeignMale + totalForeignFemale)</td>
                            <td>@grandTotalMale</td>
                            <td>@grandTotalFemale</td>
                            <td><span class="total-badge">@grandTotal</span></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <p class="rpt-note">
                Note: Total number must be recorded. Residence entries are optional.
                @(ViewBag.GroupByMonth == true ? "Period" : "Monthly") totals must be recorded.
            </p>
            <p class="rpt-sysgen">System Generated Report — Guest Visitor Summary</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js"></script>
    <script src="~/js/ReportsGuest.js" asp-append-version="true"></script>
}