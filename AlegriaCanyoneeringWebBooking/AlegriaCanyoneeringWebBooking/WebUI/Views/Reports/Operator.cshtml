@model IEnumerable<TourismReportViewModel>
<link href="~/css/ReportsOperator.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

@{
    var totalMale = ViewBag.TotalMale ?? 0;
    var totalFemale = ViewBag.TotalFemale ?? 0;
    var totalEnding = ViewBag.TotalEnding ?? 0;
    var dateFrom = ViewBag.DateFrom as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var dateTo = ViewBag.DateTo as string ?? DateTime.Today.ToString("yyyy-MM-dd");

    DateTime.TryParse(dateFrom, out var fromDt);
    DateTime.TryParse(dateTo, out var toDt);
}

<style>
    .rpt-wrap * {
        font-family: 'Outfit', sans-serif;
    }

    .rpt-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

        .rpt-header h2 {
            font-size: 1.35rem;
            font-weight: 700;
            color: #0f3460;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .rpt-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 20px rgba(15,52,96,0.08);
        border: 1px solid #e8edf5;
        overflow: hidden;
        margin-bottom: 1.5rem;
    }

    .rpt-card-header {
        background: linear-gradient(135deg,#1a6ef5,#0f3460);
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

        .rpt-card-header h5 {
            color: #fff;
            font-size: 1rem;
            font-weight: 700;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

    .rpt-filter-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem;
    }

    .rpt-filter-label {
        color: rgba(255,255,255,0.85);
        font-size: 0.8rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .rpt-filter-input {
        padding: 0.4rem 0.75rem;
        border: 1.5px solid rgba(255,255,255,0.3);
        border-radius: 8px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.8rem;
        background: rgba(255,255,255,0.15);
        color: #fff;
        outline: none;
        transition: border-color 0.2s, background 0.2s;
    }

        .rpt-filter-input:focus {
            border-color: rgba(255,255,255,0.7);
            background: rgba(255,255,255,0.25);
        }

    .btn-rpt-search {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.42rem 1rem;
        background: rgba(255,255,255,0.18);
        color: #fff;
        border: 1.5px solid rgba(255,255,255,0.4);
        border-radius: 8px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-rpt-search:hover {
            background: rgba(255,255,255,0.28);
        }

    .btn-rpt-print {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.42rem 1rem;
        background: #fff;
        color: #0f3460;
        border: none;
        border-radius: 8px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        transition: opacity 0.2s;
    }

        .btn-rpt-print:hover {
            opacity: 0.88;
        }

    .rpt-body {
        padding: 1.5rem;
    }

    .rpt-title-box {
        text-align: center;
        border: 2px solid #e8edf5;
        border-radius: 12px;
        padding: 1.25rem 1rem;
        margin-bottom: 1.25rem;
        background: #f8faff;
    }

        .rpt-title-box h3 {
            font-size: 1.2rem;
            font-weight: 700;
            color: #0f3460;
            margin: 0 0 0.25rem;
        }

        .rpt-title-box p {
            font-size: 0.8rem;
            color: #64748b;
            margin: 0;
        }

    .rpt-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 0.6rem;
        margin-bottom: 1.25rem;
    }

    .rpt-info-item {
        background: #f8faff;
        border: 1px solid #e8edf5;
        border-radius: 10px;
        padding: 0.55rem 0.9rem;
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }

    .rpt-info-label {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #94a3b8;
    }

    .rpt-info-value {
        font-size: 0.875rem;
        font-weight: 600;
        color: #0f3460;
    }

    #operatorReportTable {
        width: 100%;
        border-collapse: collapse;
        font-family: 'Outfit', sans-serif;
    }

        #operatorReportTable thead th {
            background: #f8faff;
            color: #0f3460;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            border: 1px solid #e8edf5;
            padding: 0.65rem 0.75rem;
            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
        }

        #operatorReportTable tbody td {
            font-size: 0.85rem;
            color: #334155;
            border: 1px solid #e8edf5;
            padding: 0.6rem 0.75rem;
            text-align: center;
            vertical-align: middle;
        }

            #operatorReportTable tbody td:nth-child(2) {
                text-align: left;
                font-weight: 600;
            }

        #operatorReportTable tbody tr:hover {
            background: #f0f6ff;
        }

        #operatorReportTable tfoot td {
            background: #f0f6ff;
            font-weight: 700;
            font-size: 0.85rem;
            color: #0f3460;
            border: 1px solid #e8edf5;
            padding: 0.65rem 0.75rem;
            text-align: center;
            vertical-align: middle;
        }

            #operatorReportTable tfoot td:nth-child(1) {
                text-align: left;
            }

    .seq-badge {
        display: inline-block;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #e0e7ff;
        color: #3730a3;
        font-size: 0.72rem;
        font-weight: 700;
        line-height: 24px;
        text-align: center;
    }

    .total-badge {
        display: inline-block;
        padding: 0.2rem 0.55rem;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 700;
        background: #dcfce7;
        color: #166534;
    }

    .operator-icon {
        font-size: 0.9rem;
        margin-right: 0.35rem;
        color: #1a6ef5;
    }

    .rpt-note {
        font-size: 0.78rem;
        color: #94a3b8;
        font-style: italic;
        margin-top: 1rem;
    }

    .rpt-sysgen {
        font-size: 0.72rem;
        color: #cbd5e1;
        font-style: italic;
        text-align: right;
        margin-top: 0.25rem;
    }

    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: #94a3b8;
    }

        .empty-state i {
            font-size: 2.5rem;
            display: block;
            margin-bottom: 0.5rem;
        }

        .empty-state span {
            font-size: 0.9rem;
            font-weight: 600;
        }
</style>

<div class="rpt-wrap">

    <div class="rpt-header">
        <h2>
            <i class="bi bi-building" style="color:#1a6ef5;"></i> Operator Visitor Report
        </h2>
    </div>

    <div class="rpt-card">

        <!-- Gradient Header -->
        <div class="rpt-card-header">
            <h5><i class="bi bi-person-badge"></i> Operator Visitor Record</h5>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <form method="get" asp-action="Operator" id="filterForm" class="rpt-filter-row">
                    <span class="rpt-filter-label">From</span>
                    <input type="date" name="dateFrom" value="@dateFrom"
                           class="rpt-filter-input" required />

                    <span class="rpt-filter-label">To</span>
                    <input type="date" name="dateTo" value="@dateTo"
                           class="rpt-filter-input" required />

                    <button type="submit" class="btn-rpt-search">
                        <i class="bi bi-search"></i> Search
                    </button>
                </form>

                <div class="dropdown">
                    <button class="btn-rpt-print dropdown-toggle"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-printer"></i> Export
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0"
                        style="border-radius:12px;">
                        <li>
                            <a class="dropdown-item" href="#" id="btnDownloadPDF"
                               style="font-family:'Outfit',sans-serif;font-size:0.875rem;">
                                <i class="bi bi-file-earmark-pdf text-danger me-2"></i> Download PDF
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="#" id="btnDownloadExcel"
                               style="font-family:'Outfit',sans-serif;font-size:0.875rem;">
                                <i class="bi bi-file-earmark-excel text-success me-2"></i> Download Excel
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Body -->
        <div class="rpt-body report-container"
             data-date-from="@fromDt.ToString("MMMM d, yyyy")"
             data-date-to="@toDt.ToString("MMMM d, yyyy")">

            <div class="rpt-title-box">
                <h3>Operator Visitor Record</h3>
                <p>(Summary of visitors by operator)</p>
            </div>

            <!-- Info Cards -->
            <div class="rpt-info-grid mb-3">
                <div class="rpt-info-item">
                    <span class="rpt-info-label">Date From</span>
                    <span class="rpt-info-value" id="displayDateFrom">
                        @fromDt.ToString("dddd, MMMM d, yyyy")
                    </span>
                </div>
                <div class="rpt-info-item">
                    <span class="rpt-info-label">Date To</span>
                    <span class="rpt-info-value" id="displayDateTo">
                        @toDt.ToString("dddd, MMMM d, yyyy")
                    </span>
                </div>
                <div class="rpt-info-item">
                    <span class="rpt-info-label">Municipality</span>
                    <span class="rpt-info-value">ALEGRIA, CEBU</span>
                </div>
                <div class="rpt-info-item">
                    <span class="rpt-info-label">Attraction</span>
                    <span class="rpt-info-value">Canyoneering Adventure</span>
                </div>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table id="operatorReportTable" class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th rowspan="2" style="width:60px;">Seq.</th>
                            <th rowspan="2" style="text-align:left;">Operator</th>
                            <th colspan="2">Number of Guests</th>
                            <th rowspan="2">Ending Total</th>
                        </tr>
                        <tr>
                            <th>Male</th>
                            <th>Female</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int seq = 1;
                            if (Model == null || !Model.Any())
                            {
                                <tr>
                                    <td colspan="5">
                                        <div class="empty-state">
                                            <i class="bi bi-building-slash"></i>
                                            <span>No data available for the selected date range.</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td><span class="seq-badge">@seq</span></td>
                                        <td style="text-align:left;">
                                            <i class="bi bi-building operator-icon"></i>
                                            <span class="fw-semibold">@item.Label</span>
                                        </td>
                                        <td>@item.OtherProvinceMale</td>
                                        <td>@item.OtherProvinceFemale</td>
                                        <td>
                                            <span class="total-badge">
                                                @(item.OtherProvinceMale + item.OtherProvinceFemale)
                                            </span>
                                        </td>
                                    </tr>
                                    seq++;
                                }
                            }
                        }
                    </tbody>

                    <tfoot>
                        <tr>
                            <td colspan="2">TOTAL:</td>
                            <td>@totalMale</td>
                            <td>@totalFemale</td>
                            <td><span class="total-badge">@totalEnding</span></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <p class="rpt-note">
                Note: Total number must be recorded. Operator entries are required. Report totals must be recorded.
            </p>
            <p class="rpt-sysgen">System Generated Report — Operator Visitor Summary</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js"></script>
    <script src="~/js/ReportsOperator.js" asp-append-version="true"></script>
}