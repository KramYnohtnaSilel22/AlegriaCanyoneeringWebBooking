@using AlegriaCanyoneeringWebBooking.Models
@model Batch

@{
    ViewData["Title"] = "Create Batch";
}

<h2>Create Batch</h2>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="OperatorId" class="control-label"></label>
        <select asp-for="OperatorId" class="form-control" asp-items="ViewBag.OperatorId"></select>
    </div>

    <div class="form-group">
        <label asp-for="NoOfLocalGuest"></label>
        <input asp-for="NoOfLocalGuest" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="NoOfForeignGuest"></label>
        <input asp-for="NoOfForeignGuest" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="NoOfTGuide"></label>
        <input asp-for="NoOfTGuide" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="NoOfMDriver"></label>
        <input asp-for="NoOfMDriver" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="TotalNoOfGuest"></label>
        <input asp-for="TotalNoOfGuest" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="ArrivalDate"></label>
        <input asp-for="ArrivalDate" class="form-control" type="date" />
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
</form>
