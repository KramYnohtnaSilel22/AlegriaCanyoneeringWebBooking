@{
    ViewData["Title"] = "Batches";
}

<h2 class="fw-bold mb-4 text-primary">Batches</h2>

<!-- Hidden Anti-Forgery Token -->
<form id="__AjaxAntiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div class="table-responsive">
    <table id="batchesTable" class="table table-bordered table-striped table-sm align-middle w-100">
        <thead class="table-light">
            <tr>
                <th>Batch ID</th>
                <th>Operator</th>
                <th>Local Guests</th>
                <th>Foreign Guests</th>
                <th>Tour Guides</th>
                <th>Drivers</th>
                <th>Total Guests</th>
                <th>Arrival Date</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        // ✅ Toast helper
        function showToast(message, type = 'success') {
            const bgClass = {
                success: 'bg-success',
                error: 'bg-danger',
                warning: 'bg-warning text-dark',
                info: 'bg-info'
            }[type] || 'bg-success';

            const toast = $(`
                <div class="toast text-white ${bgClass} border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000">
                    <div class="toast-header ${bgClass} text-white border-0">
                        <strong class="me-auto">${type.charAt(0).toUpperCase() + type.slice(1)}</strong>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                    <div class="toast-body">${message}</div>
                </div>
            `);

            if (!$('#toastContainer').length)
                $('body').append('<div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080;"></div>');

            $('#toastContainer').append(toast);
            new bootstrap.Toast(toast[0]).show();
        }

        // ✅ Convert Unix timestamp to readable format
        function formatUnixTimestamp(unix) {
            if (!unix) return '';
            const timestamp = parseInt(unix);
            if (isNaN(timestamp)) return unix;

            const date = new Date(timestamp * 1000);
            const options = {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
                hour: 'numeric',
                minute: '2-digit',
                hour12: true
            };
            return date.toLocaleString('en-US', options); // "Nov 8, 2024, 10:00 AM"
        }

        $(document).ready(function () {

            // ✅ Initialize DataTable
            const table = $('#batchesTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetBatches", "Batches")',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    dataSrc: 'data',
                    error: function (xhr) {
                        console.error(xhr.responseText);
                        showToast("Failed to load batches.", "error");
                    }
                },
                columns: [
                    { data: 'id', className: 'text-center' },
                    { data: 'operatorName', defaultContent: '' },
                    { data: 'localGuests', className: 'text-center' },
                    { data: 'foreignGuests', className: 'text-center' },
                    { data: 'guides', className: 'text-center' },
                    { data: 'drivers', className: 'text-center' },
                    { data: 'totalGuests', className: 'text-center' },
                    {
                        data: 'arrivalUnix',
                        className: 'text-center',
                        render: function (data) {
                            return formatUnixTimestamp(data); // 👈 Converts here
                        }
                    },
                    {
                        data: 'id',
                        orderable: false,
                        searchable: false,
                        className: 'text-center',
                        render: function (data, type, row) {
                            return `
                                <button type="button" class="btn btn-sm btn-danger delete-btn"
                                        data-id="${data}" data-name="Batch ${data}">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </button>`;
                        }
                    }
                ],
                pageLength: 10,
                responsive: true,
                autoWidth: false,
                language: {
                    emptyTable: "No batches found",
                    processing: "Loading..."
                }
            });

            // ✅ Delete via AJAX
            $('#batchesTable').on('click', '.delete-btn', function () {
                const id = $(this).data('id');
                const name = $(this).data('name');

                if (confirm(`Delete ${name}?`)) {
                    $.post('@Url.Action("DeleteAjax", "Batches")', {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    }, function (res) {
                        if (res.success) {
                            showToast(res.message);
                            table.ajax.reload(null, false);
                        } else {
                            showToast(res.message, 'error');
                        }
                    }).fail(() => showToast('Server error deleting batch.', 'error'));
                }
            });
        });
    </script>
}
