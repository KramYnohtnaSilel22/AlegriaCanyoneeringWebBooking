@using AlegriaCanyoneeringWebBooking.Models
@model IEnumerable<Batch>

@{
    ViewData["Title"] = "Batches";
}
@{
    // Helper function to format ArrivalDate
    string FormatArrivalDate(string unixTimestamp)
    {
        if (string.IsNullOrEmpty(unixTimestamp))
            return "N/A";

        if (long.TryParse(unixTimestamp, out var unix))
        {
            // Convert Unix timestamp to local time
            var dateTime = DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime();

            return dateTime.ToString("MMMM dd, yyyy hh:mm tt"); // human-readable format
        }

        return unixTimestamp;
    }
}
<h2 class="mb-3">Batches</h2>

@* <p>
    <a asp-action="Create" class="btn btn-primary">Create New Batch</a>
</p> *@


<div class="table-responsive">
    <table id="example1" class="table text-truncate">
        <thead class="table-light">
        <tr>
            <th>Batch ID</th>
            <th>Operator</th>
            <th>Local Guests</th>
            <th>Foreign Guests</th>
            <th>Tour Guides</th>
            <th>Drivers</th>
            <th>Total Guests</th>
            <th>Arrival Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.BatchId</td>
                <td>@item.Operators.BusinessName</td> <!-- shows Operator name if loaded -->
                <td>@item.NoOfLocalGuest</td>
                <td>@item.NoOfForeignGuest</td>
                <td>@item.NoOfTGuide</td>
                <td>@item.NoOfMDriver</td>
                <td>@item.TotalNoOfGuest</td>
                <td>@FormatArrivalDate(item.ArrivalDate)</td>

    
           
                <td>
          
                    <form asp-action="Delete" asp-route-id="@item.BatchId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this batch?');">
                        <button type="submit" class="btn btn-danger btn-sm" title="Delete Batch">
                            <i class="fas fa-trash-alt"></i> Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
