@model AlegriaCanyoneeringWebBooking.Models.Nationality

<form asp-action="@ViewData["Action"]" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="id" />

    <div class="mb-3">
        <label asp-for="NatName" class="form-label">Nationality Name</label>
        <input asp-for="NatName" class="form-control" placeholder="Enter nationality" />
        <span asp-validation-for="NatName" class="text-danger"></span>
    </div>

    <div class="text-end">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
