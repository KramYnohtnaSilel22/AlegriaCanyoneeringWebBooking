@{
    ViewData["Title"] = "Nationality";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');
    .nat-wrap * {
        font-family: 'Outfit',sans-serif;
    }

    .nat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

        .nat-header h2 {
            font-size: 1.35rem;
            font-weight: 700;
            color: #0f3460;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .btn-create {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.6rem 1.25rem;
        background: linear-gradient(135deg,#1a6ef5,#0f3460);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: 'Outfit',sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s,transform 0.15s;
        box-shadow: 0 3px 12px rgba(26,110,245,0.3);
    }

        .btn-create:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    .nat-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 20px rgba(15,52,96,0.08);
        border: 1px solid #e8edf5;
        overflow: hidden;
    }

    .nat-card-body {
        padding: 1.25rem;
    }

    #nationalitiesTable thead th {
        background: #f8faff;
        color: #0f3460;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-bottom: 2px solid #e8edf5;
        white-space: nowrap;
        padding: 0.75rem 1rem;
    }

    #nationalitiesTable tbody td {
        vertical-align: middle;
        font-size: 0.875rem;
        color: #334155;
        padding: 0.7rem 1rem;
    }

    #nationalitiesTable tbody tr:hover {
        background: #f0f6ff;
    }

    .btn-act {
        padding: 0.28rem 0.65rem;
        border-radius: 7px;
        font-size: 0.78rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: opacity 0.15s;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

        .btn-act:hover {
            opacity: 0.82;
        }

    .btn-edit-act {
        background: rgba(240,165,0,0.1);
        color: #b45309;
        border: 1px solid #fde68a;
    }

    .btn-delete-act {
        background: rgba(239,68,68,0.08);
        color: #ef4444;
        border: 1px solid #fca5a5;
    }

    #natModal .modal-content {
        border-radius: 16px;
        border: 0;
        box-shadow: 0 8px 40px rgba(15,52,96,0.18);
        overflow: hidden;
    }

    .nat-modal-header {
        background: linear-gradient(135deg,#1a6ef5,#0f3460);
        color: #fff;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .nat-modal-header h5 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0;
        }

    #deleteConfirmModal .modal-content {
        border-radius: 16px;
        border: 0;
    }

    .del-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: rgba(239,68,68,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 0.75rem;
    }

        .del-icon i {
            font-size: 1.4rem;
            color: #ef4444;
        }
</style>

<form id="__AjaxAntiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<div class="nat-wrap">
    <div class="nat-header">
        <h2><i class="bi bi-flag-fill" style="color:#1a6ef5;"></i>Nationality</h2>
        <button type="button" id="btnCreate" class="btn-create">
            <i class="bi bi-plus-lg"></i> Add Nationality
        </button>
    </div>
    <div class="nat-card">
        <div class="nat-card-body">
            <div class="table-responsive">
                <table id="nationalitiesTable" class="table table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Nationality Name</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Form Modal -->
<div class="modal fade" id="natModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="nat-modal-header">
                <h5 id="natModalLabel"><i class="bi bi-flag me-2"></i>Nationality</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3" id="modalContent" style="min-height:140px;"></div>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:340px;">
        <div class="modal-content shadow">
            <div class="modal-body text-center pt-4 pb-3 px-4">
                <div class="del-icon"><i class="bi bi-trash3-fill"></i></div>
                <h6 class="fw-bold mb-1" style="color:#0f3460;">Delete Nationality?</h6>
                <p class="text-muted mb-0" style="font-size:0.875rem;">
                    Are you sure you want to delete <strong id="deleteNatName"></strong>?
                </p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 pb-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger rounded-pill px-4">
                    <i class="bi bi-trash3 me-1"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

<div id="natToastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090;"></div>

@section Scripts {
    <script>
        function showToast(message, type = 'success') {
            const map = {
                success: { bg:'#22c55e', icon:'bi-check-circle-fill',        title:'Success' },
                error:   { bg:'#ef4444', icon:'bi-exclamation-triangle-fill', title:'Error'   },
                warning: { bg:'#f0a500', icon:'bi-exclamation-circle-fill',   title:'Warning' }
            };
            const { bg, icon, title } = map[type] || map.success;
            const id = 'ntt-' + Date.now();
            const html = `
                <div id="${id}" class="toast border-0 text-white"
                     style="background:${bg};border-radius:12px;box-shadow:0 4px 16px rgba(0,0,0,0.15);"
                     role="alert" aria-atomic="true" data-bs-delay="4000">
                    <div class="toast-header border-0 text-white" style="background:transparent;">
                        <i class="bi ${icon} me-2"></i>
                        <strong class="me-auto">${title}</strong>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                    </div>
                    <div class="toast-body" style="padding-top:0;">${message}</div>
                </div>`;
            const c = document.getElementById('natToastContainer');
            c.insertAdjacentHTML('beforeend', html);
            const el = document.getElementById(id);
            new bootstrap.Toast(el).show();
            el.addEventListener('hidden.bs.toast', () => el.remove());
        }

        $(function () {
            var table = $('#nationalitiesTable').DataTable({
                processing: true, serverSide: true,
                ajax: {
                    url: '@Url.Action("GetNationalitiesData", "Nationalities")', type: 'POST',
                    dataSrc: 'data',
                    data: d => { d.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val(); },
                    error: xhr => showToast('Failed to load data.', 'error')
                },
                columns: [
                    { data: 'natName', render: d => `<span class="fw-semibold">${d || '—'}</span>` },
                    {
                        data: 'id', orderable: false, searchable: false, className: 'text-center',
                        render: (data, type, row) => `
                            <div class="d-flex gap-1 justify-content-center">
                                <a href="/Nationalities/Edit/${data}" class="btn-act btn-edit-act btn-edit">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <button class="btn-act btn-delete-act btn-delete"
                                        data-id="${data}" data-name="${row.natName ?? ''}">
                                    <i class="bi bi-trash3"></i> Delete
                                </button>
                            </div>`
                    }
                ],
                pageLength: 10, responsive: true, autoWidth: false,
                language: { emptyTable: 'No nationalities found.' }
            });

            function openModal(url, title) {
                var existing = bootstrap.Modal.getInstance(document.getElementById('natModal'));
                if (existing) existing.dispose();
                $('#modalContent').html(`
                    <div class="text-center py-4 text-muted">
                        <div class="spinner-border text-primary mb-2" role="status"></div>
                        <div style="font-size:0.875rem;">Loading...</div>
                    </div>`);
                $('#natModalLabel').html(`<i class="bi bi-flag me-2"></i>${title}`);
                $.get(url, res => {
                    $('#modalContent').html(res);
                    $.validator?.unobtrusive?.parse('#modalContent');
                    new bootstrap.Modal(document.getElementById('natModal')).show();
                }).fail(xhr => showToast('Error loading form.', 'error'));
            }

            $('#btnCreate').click(() => openModal('@Url.Action("Create", "Nationalities")', 'Add Nationality'));
            $('#nationalitiesTable').on('click', '.btn-edit', function (e) {
                e.preventDefault(); openModal($(this).attr('href'), 'Edit Nationality');
            });

            let pendingDeleteId = null;
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));

            $('#nationalitiesTable').on('click', '.btn-delete', function () {
                pendingDeleteId = $(this).data('id');
                $('#deleteNatName').text($(this).data('name'));
                deleteModal.show();
            });

            $('#confirmDeleteBtn').on('click', function () {
                if (!pendingDeleteId) return;
                const $btn = $(this);
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Deleting...');
                $.post('@Url.Action("DeleteAjax", "Nationalities")', {
                    id: pendingDeleteId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                }, res => {
                    deleteModal.hide();
                    if (res.success) { showToast(res.message, 'success'); table.ajax.reload(null, false); }
                    else showToast(res.message, 'error');
                }).fail(() => { deleteModal.hide(); showToast('Error deleting.', 'error'); })
                  .always(() => { $btn.prop('disabled', false).html('<i class="bi bi-trash3 me-1"></i>Delete'); pendingDeleteId = null; });
            });

            $('#natModal').on('submit', 'form', function (e) {
                e.preventDefault();
                const form = $(this);
                if (form.valid && !form.valid()) { showToast('Please fill in all required fields.', 'warning'); return; }
                const $btn = form.find('[type="submit"]');
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');
                $.post(form.attr('action'), form.serialize(), res => {
                    if (res.success) {
                        bootstrap.Modal.getInstance(document.getElementById('natModal'))?.hide();
                        table.ajax.reload(null, false);
                        showToast(res.message || 'Saved.', 'success');
                    } else {
                        $('#modalContent').html(res);
                        $.validator?.unobtrusive?.parse('#modalContent');
                        $btn.prop('disabled', false).html('Save');
                    }
                }).fail(xhr => { $btn.prop('disabled', false).html('Save'); showToast('Error saving.', 'error'); });
            });
        });
    </script>
}
