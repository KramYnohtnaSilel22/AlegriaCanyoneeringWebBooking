@{
    ViewData["Title"] = "Nationality";
}

<h2 class="fw-bold mb-4 text-primary">Nationality</h2>

<!-- Anti-Forgery Token for AJAX -->
<form id="__AjaxAntiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- Button to open Create Modal -->
<button type="button" id="btnCreate" class="btn btn-primary mb-3">
    <i></i> Create New
</button>

<div class="table-responsive">
    <table id="nationalitiesTable" class="table table-bordered table-striped table-sm align-middle w-100">
        <thead class="table-light">
            <tr>
                <th>Nationality Name</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
    </table>
</div>

<!-- Create/Edit Modal -->
<div class="modal fade" id="nationalityModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="nationalityModalLabel">Nationality</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalContent">
                <!-- AJAX loaded form will appear here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />

    <!-- Validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

    <script>
        // ✅ Bootstrap Toast Notification (Your Version)
         function showToast(message, type = 'success') {
             let bgClass = 'bg-success';
             let icon = 'bi-check-circle-fill';
             let title = 'Success';

             if (type === 'error') { bgClass = 'bg-danger'; icon = 'bi-exclamation-triangle-fill'; title = 'Error'; }
             else if (type === 'warning') { bgClass = 'bg-danger'; icon = 'bi-exclamation-circle-fill'; title = 'Warning'; }
             else if (type === 'info') { bgClass = 'bg-info'; icon = 'bi-info-circle-fill'; title = 'Info'; }

             const toastContainer = $('<div></div>')
                 .addClass('toast-container position-fixed top-0 end-0 p-3')
                 .css('z-index', 1080);

             const toast = $('<div></div>').addClass(`toast text-white ${bgClass} border-0`)
                 .attr({ role: 'alert', 'aria-live': 'assertive', 'aria-atomic': 'true', 'data-bs-delay': 4000 });

             const toastHeader = $('<div></div>').addClass(`toast-header ${bgClass} text-white border-0`).html(`
                 <i class="bi ${icon} me-2"></i>
                 <strong class="me-auto">${title}</strong>
                 <small>Now</small>
                 <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
             `);

             const toastBody = $('<div></div>').addClass('toast-body').text(message);

             toast.append(toastHeader, toastBody);
             toastContainer.append(toast);
             $('body').append(toastContainer);

             var bsToast = new bootstrap.Toast(toast[0]);
             bsToast.show();

             toast.on('hidden.bs.toast', function () { toastContainer.remove(); });
         }

        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#nationalitiesTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetNationalitiesData", "Nationalities")',
                    type: 'POST',
                    dataSrc: 'data',
                    error: function (xhr) {
                        console.error(xhr.responseText);
                        showToast("Failed to load data.", "error");
                    }
                },
                columns: [
                    { data: 'natName', className: 'text-break' },
                    {
                        data: 'id',
                        orderable: false,
                        searchable: false,
                        className: 'text-center',
                        render: function (data, type, row) {
                            return `
                                <div class="d-flex flex-wrap gap-2 justify-content-center">
                                    <a href="/Nationalities/Edit/${data}" class="btn btn-sm btn-warning btn-edit">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger delete-btn" data-id="${data}" data-name="${row.natName}">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </div>`;
                        }
                    }
                ],
                pageLength: 10,
                responsive: true,
                autoWidth: false
            });

            // Delete
            $('#nationalitiesTable').on('click', '.delete-btn', function () {
                const id = $(this).data('id');
                const name = $(this).data('name');
                if (confirm(`Delete "${name}"? This action cannot be undone.`)) {
                    $.post('@Url.Action("DeleteAjax", "Nationalities")', {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    }, function (res) {
                        if (res.success) { showToast(res.message, 'success'); table.ajax.reload(null, false); }
                        else showToast(res.message, 'error');
                    });
                }
            });

            // Open modal for Create/Edit
            function openNationalityModal(url, title) {
                $.get(url, function (data) {
                    $('#modalContent').html(data);
                    $('#nationalityModalLabel').text(title);
                    new bootstrap.Modal(document.getElementById('nationalityModal')).show();
                });
            }

            $('#btnCreate').click(() => openNationalityModal('@Url.Action("Create", "Nationalities")', 'Create Nationality'));
            $('#nationalitiesTable').on('click', '.btn-edit', function (e) {
                e.preventDefault();
                openNationalityModal($(this).attr('href'), 'Edit Nationality');
            });

            // ✅ Form Submission with Validation Toast
            $('#nationalityModal').on('submit', 'form', function (e) {
                e.preventDefault();
                var form = $(this);
                // If form invalid → show warning toast
                if (!form.valid()) {
                    showToast('Please fill in all required fields.', 'warning');
                    return false;
                }
                $.post(form.attr('action'), form.serialize(), function (res) {
                    if (res.success) {
                        bootstrap.Modal.getInstance(document.getElementById('nationalityModal')).hide();
                        table.ajax.reload(null, false);
                        showToast(res.message || 'Record saved successfully.', 'success');
                    } else {
                        // Reload validation errors if backend returned HTML
                        $('#modalContent').html(res);
                        $.validator.unobtrusive.parse('#modalContent');
                    }
                }).fail(function (xhr) {
                    console.error(xhr.responseText);
                    showToast('An error occurred while saving.', 'error');
                });
            });
        });
    </script>
}
