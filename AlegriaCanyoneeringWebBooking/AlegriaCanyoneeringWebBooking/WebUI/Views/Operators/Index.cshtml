@{
    ViewData["Title"] = "User";
}

<h2 class="fw-bold mb-4 text-primary">User</h2>

<!-- Anti-Forgery Token for AJAX -->
<form id="__AjaxAntiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- Button to open Create Modal -->
<button type="button" id="btnCreate" class="btn btn-primary mb-3">
    <i></i> Create New
</button>

<div class="table-responsive">
    <table id="operatorsTable" class="table table-bordered table-striped table-sm align-middle w-100">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th class="d-none d-sm-table-cell">Business Name</th>
                <th class="d-none d-md-table-cell">Age</th>
                <th class="d-none d-md-table-cell">Gender</th>
                <th>Username</th>
                <th class="d-none d-sm-table-cell">Role</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
    </table>
</div>

<!-- Create/Edit Modal -->
<div class="modal fade" id="operatorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="operatorModalLabel">Operator</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalContent">
                <!-- AJAX loaded form will appear here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">

    <!-- Validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

    <script>
        function showToast(message, type = 'success') {
            let bgClass = 'bg-success';
            let icon = 'bi-check-circle-fill';
            let title = 'Success';

            if (type === 'error') { bgClass = 'bg-danger'; icon = 'bi-exclamation-triangle-fill'; title = 'Error'; }
            else if (type === 'warning') { bgClass = 'bg-warning'; icon = 'bi-exclamation-circle-fill'; title = 'Warning'; }
            else if (type === 'info') { bgClass = 'bg-info'; icon = 'bi-info-circle-fill'; title = 'Info'; }

            const toastContainer = $('<div></div>').addClass('toast-container position-fixed top-0 end-0 p-3').css('z-index', 1080);
            const toast = $('<div></div>').addClass(`toast text-white ${bgClass} border-0`)
                .attr({ role: 'alert', 'aria-live': 'assertive', 'aria-atomic': 'true', 'data-bs-delay': 4000 });

            const toastHeader = $('<div></div>').addClass(`toast-header ${bgClass} text-white border-0`).html(`
                <i class="bi ${icon} me-2"></i>
                <strong class="me-auto">${title}</strong>
                <small>Now</small>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            `);

            const toastBody = $('<div></div>').addClass('toast-body').text(message);

            toast.append(toastHeader, toastBody);
            toastContainer.append(toast);
            $('body').append(toastContainer);

            var bsToast = new bootstrap.Toast(toast[0]);
            bsToast.show();

            toast.on('hidden.bs.toast', function () { toastContainer.remove(); });
        }

        $(document).ready(function () {
            var table = $('#operatorsTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetUserData", "Operators")',
                    type: 'POST',
                    dataSrc: 'data',
                    error: function (xhr) { console.error(xhr.responseText); showToast("Failed to load data.", "error"); }
                },
                columns: [
                    { data: 'ownerName', className: 'text-break' },
                    { data: 'emailAddress', className: 'text-break' },
                    { data: 'businessName', className: 'd-none d-sm-table-cell text-break' },
                    { data: 'age', className: 'd-none d-md-table-cell text-center', defaultContent: '' },
                    { data: 'gender', className: 'd-none d-md-table-cell text-center' },
                    { data: 'username' },
                    {
                        data: 'role',
                        className: 'd-none d-sm-table-cell',
                        render: function(data) {
                            if (data === 'Super Admin') return '<span class="badge bg-danger">Super Admin</span>';
                            if (data === 'Admin') return '<span class="badge bg-warning text-dark">Admin</span>';
                            if (data === 'Operator') return '<span class="badge bg-info">Operator</span>';
                            return '<span class="badge bg-secondary">' + data + '</span>';
                        }
                    },
                    {
                        data: 'id',
                        orderable: false,
                        searchable: false,
                        className: 'text-center',
                        render: function (data, type, row) {
                            return `
                                <div class="d-flex flex-wrap gap-2 justify-content-center">
                                    <a href="/Operators/Edit/${data}" class="btn btn-sm btn-warning btn-edit">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger delete-btn" data-id="${data}" data-name="${row.ownerName}">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </div>`;
                        }
                    }
                ],
                pageLength: 10,
                responsive: true,
                autoWidth: false
            });

            // Delete
            $('#operatorsTable').on('click', '.delete-btn', function () {
                var id = $(this).data('id'), name = $(this).data('name');
                if (confirm(`Delete "${name}"?\n\nThis action cannot be undone.`)) {
                    $.post('@Url.Action("DeleteAjax", "Operators")', {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    }, function (res) {
                        if (res.success) { showToast(res.message); table.ajax.reload(null, false); }
                        else { showToast(res.message, 'error'); }
                    });
                }
            });

            // Function to open modal for Create/Edit
            function openOperatorModal(url, title) {
                $.get(url, function (data) {
                    $('#modalContent').html(data);
                    $('#operatorModalLabel').text(title);
                    new bootstrap.Modal(document.getElementById('operatorModal')).show();
                });
            }

            // Open Create Modal
            $('#btnCreate').click(() => openOperatorModal('@Url.Action("Create", "Operators")', 'Create User'));

            // Open Edit Modal
            $('#operatorsTable').on('click', '.btn-edit', function (e) {
                e.preventDefault();
                openOperatorModal($(this).attr('href'), 'Edit User');
            });


         // Submit form via AJAX (works for both Create and Edit)
          $('#operatorModal').on('submit', 'form', function (e) {
                e.preventDefault();
                var form = $(this);

                // Check if form is valid before submitting
                if (!form.valid()) {
                    return false;
                }

                $.post(form.attr('action'), form.serialize(), function (response) {
                    if (response.success) {
                        bootstrap.Modal.getInstance(document.getElementById('operatorModal')).hide();
                        table.ajax.reload(null, false);
                        showToast(response.message, 'success');
                    } else {
                        // Reload form with validation errors
                        $('#modalContent').html(response);
                        // Re-parse validation after reloading
                        $.validator.unobtrusive.parse('#modalContent');
                    }
                }).fail(function (xhr) {
                    console.error(xhr.responseText);
                    showToast("Error saving.", 'error');
                });
            });
        });
    </script>
}