@using AlegriaCanyoneeringWebBooking.Models
@model IEnumerable<Operator>

@{
    ViewData["Title"] = "User";
}

<h1 class="mb-3">User</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">Create New</a>
</p>

<div class="table-responsive">
    <table id="example1" class="table table-bordered table-striped table-sm align-middle">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th class="d-none d-sm-table-cell">Business Name</th>
                <th class="d-none d-md-table-cell">Age</th>
                <th class="d-none d-md-table-cell">Gender</th>
                <th>Username</th>
                <th class="d-none d-sm-table-cell">Role</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-break">@item.Name</td>
                    <td class="text-break">@item.EmailAddress</td>
                    <td class="d-none d-sm-table-cell">
                        @(string.IsNullOrWhiteSpace(item.BusinessName) ? "No Operator" : item.BusinessName)
                    </td>
                    <td class="d-none d-md-table-cell">@item.Age</td>
                    <td class="d-none d-md-table-cell">@item.Gender</td>
                    <td class="text-break">@item.Username</td>
                    <td class="d-none d-sm-table-cell">@item.Roles?.Name</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i> <span class="d-none d-sm-inline">Edit</span>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this item?')">
                                    <i class="fas fa-trash"></i> <span class="d-none d-sm-inline">Delete</span>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
