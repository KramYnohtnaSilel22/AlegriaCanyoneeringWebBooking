@{
    ViewData["Title"] = "Operators";
}

<h2 class="fw-bold mb-4 text-primary">User</h2>

<!-- Anti-Forgery Token for AJAX -->
<form id="__AjaxAntiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- Create Button -->
<button type="button" id="btnCreate" class="btn btn-primary mb-3">
    <i></i> Create New
</button>

<div class="table-responsive">
    <table id="operatorsTable" class="table table-bordered table-striped table-sm align-middle w-100">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th class="d-none d-sm-table-cell">Business Name</th>
                <th class="d-none d-md-table-cell">Age</th>
                <th class="d-none d-md-table-cell">Gender</th>
                <th>Username</th>
                <th class="d-none d-sm-table-cell">Role</th>
                <th>Actions</th>
            </tr>
        </thead>
    </table>
</div>

<!-- Modal for Create/Edit -->
<div class="modal fade" id="operatorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="operatorModalLabel">Operator</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalContent">
                <!-- AJAX-loaded form will appear here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">

    <!-- Validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

    <script>
           // ===== Toast Notification Function =====
        function showToast(message, type='success') {
            let bg='bg-success', icon='bi-check-circle-fill', title='Success';
            if(type==='error'){ bg='bg-danger'; icon='bi-exclamation-triangle-fill'; title='Error'; }
            else if(type==='warning'){ bg='bg-warning'; icon='bi-exclamation-circle-fill'; title='Warning'; }
            else if(type==='info'){ bg='bg-info'; icon='bi-info-circle-fill'; title='Info'; }

            const container=$('<div class="toast-container position-fixed top-0 end-0 p-3"></div>').css('z-index',1080);
            const toast=$('<div class="toast text-white '+bg+' border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000"></div>');
            const header=$('<div class="toast-header '+bg+' text-white border-0"></div>').html(`<i class="bi ${icon} me-2"></i><strong class="me-auto">${title}</strong><small>Now</small><button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>`);
            const body=$('<div class="toast-body"></div>').text(message);
            toast.append(header,body); container.append(toast); $('body').append(container);
            new bootstrap.Toast(toast[0]).show(); toast.on('hidden.bs.toast',()=>container.remove());
        }

        $(document).ready(function() {
                  // Initialize DataTable
            var table = $('#operatorsTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetUserData", "Operators")',
                    type: 'POST',
                    headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                    dataSrc: 'data',
                    error: function(xhr){ showToast("Failed to load data","error"); console.error(xhr.responseText); }
                },
                columns: [
                    { data:'ownerName' },
                    { data:'emailAddress' },
                    { data:'businessName', className:'d-none d-sm-table-cell' },
                    { data:'age', className:'d-none d-md-table-cell text-center', defaultContent: '' },
                    { data:'gender', className:'d-none d-md-table-cell text-center' },
                    { data:'username' },
                    { data:'role', className:'d-none d-sm-table-cell',
                        render: function(d){
                            if(d==='Super Admin') return '<span class="badge bg-danger">'+d+'</span>';
                            if(d==='Admin') return '<span class="badge bg-warning text-dark">'+d+'</span>';
                            if(d==='Operator') return '<span class="badge bg-info">'+d+'</span>';
                            return '<span class="badge bg-secondary">'+d+'</span>';
                        }
                    },
                    { data:'id', orderable:false, searchable:false, className:'text-center',
                         render: function(d, type, row) {
                           return `<div class="d-flex gap-2">
                                <button class="btn btn-sm btn-warning btn-edit" data-url="/Operators/Edit/${d}"><i class="fas fa-edit"></i> Edit</button>
                                <button type="button" class="btn btn-sm btn-danger btn-delete" data-id="${d}" data-name="${row.ownerName}">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </div>`;
                        }

                    }
                ],
                pageLength: 10,
                lengthMenu: [[10,25,50,100],[10,25,50,100]],
                responsive:true,
                autoWidth:false,
                language:{emptyTable:"No operators found", processing:'<div class="spinner-border text-primary"></div>'}
            });

             // Function to open modal for Create/Edit
            function openModal(url,title){
                $.get(url,function(html){
                    $('#modalContent').html(html);
                    $('#operatorModalLabel').text(title);
                    new bootstrap.Modal(document.getElementById('operatorModal')).show();
                });
            }
          
            // ===== Open Create Modal =====
            $('#btnCreate').click(()=>openModal('@Url.Action("Create", "Operators")','Create User'));
            $('#operatorsTable').on('click','.btn-edit',function(){ openModal($(this).data('url'),'Edit User'); });

            // Submit form via AJAX (works for both Create and Edit)
                $('#operatorModal').on('submit', '#operatorForm', function (e) {
            e.preventDefault();
            const form = $(this);
            const actionUrl = form.attr('action');
            const formData = form.serialize();

            form.find('.text-danger').text('');
            form.find('.is-invalid').removeClass('is-invalid');

            const submitBtn = form.find('button[type="submit"]');
            const originalText = submitBtn.text();
            submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Saving...');

            $.post(actionUrl, formData)
                .done(function(response){
                    if(response.success){
                        bootstrap.Modal.getInstance(document.getElementById('operatorModal')).hide();
                        $('#operatorsTable').DataTable().ajax.reload(null,false);
                        showToast(response.message,'success');
                    } else {
                        showToast(response.message||"Please fix errors.",'error');
                        if(response.errors){
                            $.each(response.errors, function(field,msgs){
                                const input = form.find(`[name="${field}"]`);
                                input.addClass('is-invalid');
                                input.siblings('.text-danger').text(msgs[0]);
                            });
                        }
                    }
                })
                .fail(function(xhr){
                    showToast("Server error. Check console.",'error');
                    console.error(xhr.responseText);
                })
                .always(function(){ submitBtn.prop('disabled', false).text(originalText); });
        });


             // ===== Delete Button =====
            $('#operatorsTable').on('click', '.btn-delete', function () {
                var btn = $(this);
                var userId = btn.data('id');
                var userName = btn.data('name');

                console.log('Delete clicked - ID:', userId, 'Name:', userName);

                if (!confirm(`Are you sure you want to delete user "${userName}"?\n\nThis action cannot be undone.`)) {
                    return;
                }

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

                $.ajax({
                    url: '@Url.Action("DeleteAjax", "Operators")',
                    type: 'POST',
                    data: {
                        id: userId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    dataType: 'json',
                    success: function (res) {
                        if (res.success) {
                            table.ajax.reload(null, false);
                            showToast(res.message, 'success');
                        } else {
                            showToast(res.message, 'error');
                            btn.prop('disabled', false).html('<i class="fas fa-trash"></i> Delete');
                        }
                    },
                    error: function (xhr) {
                        console.error('Delete error:', xhr.responseText);
                        showToast("Error deleting user.", 'error');
                        btn.prop('disabled', false).html('<i class="fas fa-trash"></i> Delete');
                    }
                });
            });

           // Show TempData messages on page load
            @if (TempData["SuccessMessage"] != null)
            {
                    <text>showToast('@TempData["SuccessMessage"]','success');</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                    <text>showToast('@TempData["ErrorMessage"]','error');</text>
            }
        });
    </script>
}
