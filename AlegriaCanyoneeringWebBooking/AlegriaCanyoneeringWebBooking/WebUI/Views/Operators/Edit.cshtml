@using AlegriaCanyoneeringWebBooking.Models
@model Operator

@{
    ViewData["Title"] = "Edit User";
}

<h1 class="mb-4">Edit User</h1>

<form asp-action="Edit" method="post" class="needs-validation" novalidate>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <!-- Name -->
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" required />
            <div class="invalid-feedback">Please enter the name.</div>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <!-- Business Name -->
        <div class="col-md-6">
            <label asp-for="BusinessName" class="form-label"></label>
            <input asp-for="BusinessName" class="form-control" />
            <div class="invalid-feedback">Please enter the business name.</div>
            <span asp-validation-for="BusinessName" class="text-danger"></span>
        </div>

        <!-- Age -->
        <div class="col-md-4">
            <label asp-for="Age" class="form-label"></label>
            <input asp-for="Age" type="number" class="form-control" required />
            <div class="invalid-feedback">Please enter a valid age.</div>
            <span asp-validation-for="Age" class="text-danger"></span>
        </div>

        <!-- Gender -->
        <div class="col-md-4">
            <label asp-for="Gender" class="form-label"></label>
            <select asp-for="Gender" class="form-select" required>
                <option value="">-- Select Gender --</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
            </select>
            <div class="invalid-feedback">Please select a gender.</div>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>

        <!-- Username -->
        <div class="col-md-4">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" required />
            <div class="invalid-feedback">Username is required.</div>
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <!-- New Password -->
        <div class="col-md-6">
            <label for="NewPassword" class="form-label">New Password (leave blank to keep current)</label>
            <input type="password" name="NewPassword" class="form-control" />
        </div>

        <!-- Email -->
        <div class="col-md-6">
            <label asp-for="EmailAddress" class="form-label"></label>
            <input asp-for="EmailAddress" type="email" class="form-control" required />
            <div class="invalid-feedback">Please enter a valid email address.</div>
            <span asp-validation-for="EmailAddress" class="text-danger"></span>
        </div>

        <!-- Role -->
        <div class="col-md-6">
            <label asp-for="RoleId" class="form-label">User Role</label>
            <select asp-for="RoleId" class="form-select" asp-items="ViewBag.RoleId" required></select>
            <div class="invalid-feedback">Please select a role.</div>
            <span asp-validation-for="RoleId" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4">Save</button>
        <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        (() => {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}
