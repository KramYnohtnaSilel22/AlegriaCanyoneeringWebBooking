@model AlegriaCanyoneeringWebBooking.Models.Operator
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="operatorForm" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-4">
        <!-- Left Column -->
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Full Name <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Enter full name" />
                <span asp-validation-for="Name" class="text-danger" data-valmsg-for="Name"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Gender" class="form-label">Gender <span class="text-danger">*</span></label>
                <select asp-for="Gender" class="form-select" asp-items="ViewBag.GenderList">
                    <option value="">-- Select Gender --</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger" data-valmsg-for="Gender"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BusinessName" class="form-label">Business Name</label>
                <input asp-for="BusinessName" class="form-control" placeholder="Optional" />
                <span asp-validation-for="BusinessName" class="text-danger" data-valmsg-for="BusinessName"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Age" class="form-label">Age <span class="text-danger">*</span></label>
                <input asp-for="Age" type="number" class="form-control" min="18" max="100" />
                <span asp-validation-for="Age" class="text-danger" data-valmsg-for="Age"></span>
            </div>
        </div>
        <!-- Right Column -->
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Username" class="form-label">Username <span class="text-danger">*</span></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger" data-valmsg-for="Username"></span>
            </div>
            <div class="mb-3">
                <label for="NewPassword" class="form-label">New Password</label>
                <input type="password" name="NewPassword" id="NewPassword" class="form-control"
                       placeholder="Leave blank to keep current password" />
                <small class="text-muted">Fill this only if you want to change the password.</small>
            </div>
            <div class="mb-3">
                <label asp-for="EmailAddress" class="form-label">Email <span class="text-danger">*</span></label>
                <input asp-for="EmailAddress" type="email" class="form-control" placeholder="example@email.com" />
                <span asp-validation-for="EmailAddress" class="text-danger" data-valmsg-for="EmailAddress"></span>
            </div>
            <div class="mb-3">
                <label asp-for="RoleId" class="form-label">Role <span class="text-danger">*</span></label>
                <select asp-for="RoleId" class="form-select" asp-items='(SelectList)ViewData["RoleId"]'>
                    <option value="">-- Select Role --</option>
                </select>
                <span asp-validation-for="RoleId" class="text-danger" data-valmsg-for="RoleId"></span>
            </div>
        </div>
    </div>
    <div class="mt-3 text-end">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>

@section Scripts {
    <script>
        // Re-initialize unobtrusive validation for dynamically loaded form
        $.validator.unobtrusive.parse('#operatorForm');
    </script>
}