@model AlegriaCanyoneeringWebBooking.Models.OperatorList

<form asp-action="Edit" method="post" id="operatorForm" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="OperatorId" />
    <div class="row g-4">
        <!-- Left Column -->
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="OwnerName" class="form-label">Owner Name <span class="text-danger">*</span></label>
                <input asp-for="OwnerName" class="form-control" placeholder="Enter owner's name" />
                <span asp-validation-for="OwnerName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Gender" class="form-label">Gender <span class="text-danger">*</span></label>
                <select asp-for="Gender" class="form-select" required>
                    <option value="">-- Select Gender --</option>
                    <option value="M">M - Male</option>
                    <option value="F">F - Female</option>
                </select>

                <span asp-validation-for="Gender" class="validation-message text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BusinessName" class="form-label">Business Name <span class="text-danger">*</span></label>
                <input asp-for="BusinessName" class="form-control" placeholder="e.g. Adventure Co." />
                <span asp-validation-for="BusinessName" class="text-danger"></span>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="BussPermit" class="form-label">Business Permit <span class="text-danger">*</span></label>
                <input asp-for="BussPermit" class="form-control" placeholder="Enter permit number" />
                <span asp-validation-for="BussPermit" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label">Location <span class="text-danger">*</span></label>
                <input asp-for="Location" class="form-control" placeholder="Enter business location" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label">Status <span class="text-danger">*</span></label>
                <select asp-for="Status" class="form-select">
                    <option value="1">Active</option>
                    <option value="0">Inactive</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="mt-3 text-end">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
