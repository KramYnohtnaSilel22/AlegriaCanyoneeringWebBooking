@{
    ViewData["Title"] = "Operators";
}

<h2 class="fw-bold mb-4 text-primary">Operators</h2>

<!-- Anti-Forgery Token for AJAX -->
<form id="__AjaxAntiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- Button to open Create Modal -->
<button type="button" id="btnCreate" class="btn btn-primary mb-3">
    <i></i> Create New
</button>

<div class="table-responsive">
    <table id="operatorsTable" class="table table-bordered table-striped table-sm align-middle w-100">
        <thead class="table-light">
            <tr>
                <th>Owner Name</th>
                <th class="d-none d-sm-table-cell">Gender</th>
                <th>Business Name</th>
                <th class="d-none d-md-table-cell">Business Permit</th>
                <th class="d-none d-lg-table-cell">Location</th>
                <th class="text-center">Status</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
    </table>
</div>

<!-- Create/Edit Modal -->
<div class="modal fade" id="operatorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="operatorModalLabel">Operator</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalContent">
                <!-- AJAX loaded form will appear here -->
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">

    <!-- Validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

    <script>
        // ===== Toast Notification Function =====
        function showToast(message, type = 'success') {
            let bgClass = 'bg-success';
            let icon = 'bi-check-circle-fill';
            let title = 'Success';

            if (type === 'error') {
                bgClass = 'bg-danger';
                icon = 'bi-exclamation-triangle-fill';
                title = 'Error';
            } else if (type === 'warning') {
                bgClass = 'bg-warning';
                icon = 'bi-exclamation-circle-fill';
                title = 'Warning';
            } else if (type === 'info') {
                bgClass = 'bg-info';
                icon = 'bi-info-circle-fill';
                title = 'Info';
            }

            const toastContainer = $('<div></div>')
                .addClass('toast-container position-fixed top-0 end-0 p-3')
                .css('z-index', 1080);

            const toast = $('<div></div>')
                .addClass(`toast text-white ${bgClass} border-0`)
                .attr({
                    role: 'alert',
                    'aria-live': 'assertive',
                    'aria-atomic': 'true',
                    'data-bs-delay': 4000
                });

            const toastHeader = $('<div></div>')
                .addClass(`toast-header ${bgClass} text-white border-0`)
                .html(`
                    <i class="bi ${icon} me-2"></i>
                    <strong class="me-auto">${title}</strong>
                    <small>Now</small>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
                `);

            const toastBody = $('<div></div>')
                .addClass('toast-body')
                .text(message);

            toast.append(toastHeader, toastBody);
            toastContainer.append(toast);
            $('body').append(toastContainer);

            var bsToast = new bootstrap.Toast(toast[0]);
            bsToast.show();

            toast.on('hidden.bs.toast', function () {
                toastContainer.remove();
            });
        }

        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#operatorsTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetOperatorsData", "OperatorList")',
                    type: 'POST',
                    dataSrc: 'data',
                    error: function (xhr, error, code) {
                        console.error("DataTables AJAX error:", xhr.responseText);
                        showToast("Failed to load data. Please refresh the page.", "error");
                    }
                },
                columns: [
                    { data: 'ownerName', className: 'text-break' },
                    { data: 'gender', className: 'd-none d-sm-table-cell' },
                    { data: 'businessName', className: 'text-break' },
                    { data: 'bussPermit', className: 'd-none d-md-table-cell' },
                    { data: 'location', className: 'd-none d-lg-table-cell text-break' },
                    {
                        data: 'status',
                        className: 'text-center',
                        render: function (data, type, row) {
                            if (data === 1) {
                                return `<span class="badge bg-success status-badge" data-id="${row.operatorId}" data-status="${data}" style="cursor: pointer;" title="Click to deactivate">Active</span>`;
                            } else {
                                return `<span class="badge bg-danger status-badge" data-id="${row.operatorId}" data-status="${data}" style="cursor: pointer;" title="Click to activate">Inactive</span>`;
                            }
                        }
                    },
                    {
                        data: 'operatorId',
                        orderable: false,
                        searchable: false,
                        className: 'text-center',
                        render: function (data, type, row) {
                            return `
                                <div class="d-flex flex-wrap gap-2 justify-content-center">
                                <a href="/OperatorList/Edit/${data}" class="btn btn-sm btn-warning btn-edit">
                                     <i class="fas fa-edit"></i> <span class="d-none d-sm-inline">Edit</span>
                                 </a>
                                    <button type="button" class="btn btn-sm btn-danger delete-btn" data-id="${data}" data-name="${row.ownerName}">
                                        <i class="fas fa-trash"></i> <span class="d-none d-sm-inline">Delete</span>
                                    </button>
                                </div>`;
                        }
                    }
                ],
                pageLength: 10,
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                responsive: {
                    details: {
                        type: 'column',
                        target: 'tr'
                    }
                },
                autoWidth: false,
                language: {
                    emptyTable: "No operators found",
                    processing: '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>'
                }
            });

            // Handle Status Toggle
            $('#operatorsTable').on('click', '.status-badge', function () {
                var operatorId = $(this).data('id');
                var currentStatus = $(this).data('status');
                var newStatusText = currentStatus === 1 ? 'deactivate' : 'activate';

                if (confirm(`Are you sure you want to ${newStatusText} this operator?`)) {
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '@Url.Action("ToggleStatus", "OperatorList")',
                        type: 'POST',
                        data: {
                            id: operatorId,
                            __RequestVerificationToken: token
                        },
                        success: function (response) {
                            if (response.success) {
                                showToast(response.message, 'success');
                                table.ajax.reload(null, false);
                            } else {
                                showToast(response.message, 'error');
                            }
                        },
                        error: function (xhr) {
                            console.error("Status toggle error:", xhr.responseText);
                            showToast("An error occurred while updating status.", "error");
                        }
                    });
                }
            });

            // Handle Delete Button
            $('#operatorsTable').on('click', '.delete-btn', function () {
                var operatorId = $(this).data('id');
                var operatorName = $(this).data('name');

                if (confirm(`Are you sure you want to delete operator "${operatorName}"?`)) {
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '@Url.Action("DeleteAjax", "OperatorList")',
                        type: 'POST',
                        data: {
                            id: operatorId,
                            __RequestVerificationToken: token
                        },
                        success: function (response) {
                            if (response.success) {
                                showToast(response.message, 'success');
                                table.ajax.reload(null, false);
                            } else {
                                showToast(response.message, 'error');
                            }
                        },
                        error: function (xhr) {
                            console.error("Delete error:", xhr.responseText);
                            showToast("An error occurred while deleting the operator.", "error");
                        }
                    });
                }
            });

            // Show TempData messages on page load
            @if (TempData["SuccessMessage"] != null)
            {
                    <text>showToast('@TempData["SuccessMessage"]', 'success');</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                    <text>showToast('@TempData["ErrorMessage"]', 'error');</text>
            }
        });

             $(document).ready(function () {

            // Function to open modal for Create/Edit
            function openOperatorModal(url, title) {
                $.get(url, function (data) {
                    $('#modalContent').html(data);
                    $('#operatorModalLabel').text(title);
                    var modal = new bootstrap.Modal(document.getElementById('operatorModal'));
                    modal.show();
                });
            }

            // Open Create Modal
            $('#btnCreate').click(function () {
                openOperatorModal('@Url.Action("Create", "OperatorList")', 'Create Operator');
            });

            // Open Edit Modal
            $('#operatorsTable').on('click', '.btn-edit', function (e) {
                e.preventDefault();
                var url = $(this).attr('href'); // e.g., /OperatorList/Edit/5
                openOperatorModal(url, 'Edit Operator');
            });

            // Submit form via AJAX (works for both Create and Edit)
            $('#operatorModal').on('submit', 'form', function (e) {
                e.preventDefault();
                var form = $(this);
                var actionUrl = form.attr('action');
                var formData = form.serialize();

                $.post(actionUrl, formData, function (response) {
                    if (response.success) {
                        // Close modal and reload DataTable
                        var modalEl = document.getElementById('operatorModal');
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        modal.hide();

                        $('#operatorsTable').DataTable().ajax.reload(null, false);
                        showToast(response.message, 'success');
                    } else {
                        // Validation errors, reload form partial
                        $('#modalContent').html(response);
                    }
                }).fail(function (xhr) {
                    console.error(xhr.responseText);
                    showToast("An error occurred while saving.", 'error');
                });
            });

        });



    </script>
}