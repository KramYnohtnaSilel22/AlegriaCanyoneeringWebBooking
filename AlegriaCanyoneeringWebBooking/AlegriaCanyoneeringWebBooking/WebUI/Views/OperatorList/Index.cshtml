@{
    ViewData["Title"] = "Operators List";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');
    .ol-wrap * {
        font-family: 'Outfit',sans-serif;
    }

    .ol-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

        .ol-header h2 {
            font-size: 1.35rem;
            font-weight: 700;
            color: #0f3460;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .btn-create {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.6rem 1.25rem;
        background: linear-gradient(135deg,#1a6ef5,#0f3460);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: 'Outfit',sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s,transform 0.15s;
        box-shadow: 0 3px 12px rgba(26,110,245,0.3);
    }

        .btn-create:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    .ol-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 20px rgba(15,52,96,0.08);
        border: 1px solid #e8edf5;
        overflow: hidden;
    }

    .ol-card-body {
        padding: 1.25rem;
    }

    #operatorsTable thead th {
        background: #f8faff;
        color: #0f3460;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-bottom: 2px solid #e8edf5;
        white-space: nowrap;
        padding: 0.75rem 1rem;
    }

    #operatorsTable tbody td {
        vertical-align: middle;
        font-size: 0.875rem;
        color: #334155;
        padding: 0.7rem 1rem;
    }

    #operatorsTable tbody tr:hover {
        background: #f0f6ff;
    }

    .status-pill {
        padding: 0.2rem 0.65rem;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
        cursor: pointer;
        display: inline-block;
        transition: opacity 0.15s;
    }

        .status-pill:hover {
            opacity: 0.75;
        }

    .status-active {
        background: rgba(22,163,74,0.1);
        color: #16a34a;
        border: 1px solid #bbf7d0;
    }

    .status-inactive {
        background: rgba(239,68,68,0.08);
        color: #ef4444;
        border: 1px solid #fca5a5;
    }

    .btn-act {
        padding: 0.28rem 0.65rem;
        border-radius: 7px;
        font-size: 0.78rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: opacity 0.15s;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

        .btn-act:hover {
            opacity: 0.82;
        }

    .btn-edit-act {
        background: rgba(240,165,0,0.1);
        color: #b45309;
        border: 1px solid #fde68a;
    }

    .btn-delete-act {
        background: rgba(239,68,68,0.08);
        color: #ef4444;
        border: 1px solid #fca5a5;
    }

    #operatorModal .modal-content {
        border-radius: 16px;
        border: 0;
        box-shadow: 0 8px 40px rgba(15,52,96,0.18);
        overflow: hidden;
    }

    .ol-modal-header {
        background: linear-gradient(135deg,#1a6ef5,#0f3460);
        color: #fff;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .ol-modal-header h5 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0;
        }

    #deleteConfirmModal .modal-content {
        border-radius: 16px;
        border: 0;
    }

    .del-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: rgba(239,68,68,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 0.75rem;
    }

        .del-icon i {
            font-size: 1.4rem;
            color: #ef4444;
        }
</style>

<form id="__AjaxAntiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<div class="ol-wrap">
    <div class="ol-header">
        <h2><i class="bi bi-building-fill" style="color:#1a6ef5;"></i>Operators List</h2>
        <button type="button" id="btnCreate" class="btn-create">
            <i class="bi bi-plus-lg"></i> Add Operator
        </button>
    </div>

    <div class="ol-card">
        <div class="ol-card-body">
            <div class="table-responsive">
                <table id="operatorsTable" class="table table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Owner Name</th>
                            <th>Gender</th>
                            <th>Business Name</th>
                            <th>Permit</th>
                            <th>Location</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Form Modal -->
<div class="modal fade" id="operatorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="ol-modal-header">
                <h5 id="operatorModalLabel">
                    <i class="bi bi-building me-2"></i>Operator
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" id="modalContent" style="min-height:280px;"></div>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:340px;">
        <div class="modal-content shadow">
            <div class="modal-body text-center pt-4 pb-3 px-4">
                <div class="del-icon"><i class="bi bi-trash3-fill"></i></div>
                <h6 class="fw-bold mb-1" style="color:#0f3460;">Delete Operator?</h6>
                <p class="text-muted mb-0" style="font-size:0.875rem;">
                    Are you sure you want to delete <strong id="deleteOpName"></strong>?
                    This cannot be undone.
                </p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 pb-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger rounded-pill px-4">
                    <i class="bi bi-trash3 me-1"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

<div id="olToastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090;"></div>

@section Scripts {
    <script>
        function showToast(message, type = 'success') {
            const map = {
                success: { bg:'#22c55e', icon:'bi-check-circle-fill',        title:'Success' },
                error:   { bg:'#ef4444', icon:'bi-exclamation-triangle-fill', title:'Error'   },
                warning: { bg:'#f0a500', icon:'bi-exclamation-circle-fill',   title:'Warning' },
                info:    { bg:'#1a6ef5', icon:'bi-info-circle-fill',          title:'Info'    }
            };
            const { bg, icon, title } = map[type] || map.success;
            const id = 'olt-' + Date.now();
            const html = `
                <div id="${id}" class="toast border-0 text-white"
                     style="background:${bg};border-radius:12px;box-shadow:0 4px 16px rgba(0,0,0,0.15);"
                     role="alert" aria-atomic="true" data-bs-delay="4000">
                    <div class="toast-header border-0 text-white" style="background:transparent;">
                        <i class="bi ${icon} me-2"></i>
                        <strong class="me-auto">${title}</strong>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                    </div>
                    <div class="toast-body" style="padding-top:0;">${message}</div>
                </div>`;
            const c = document.getElementById('olToastContainer');
            c.insertAdjacentHTML('beforeend', html);
            const el = document.getElementById(id);
            new bootstrap.Toast(el).show();
            el.addEventListener('hidden.bs.toast', () => el.remove());
        }

        $(function () {
            var table = $('#operatorsTable').DataTable({
                processing: true, serverSide: true,
                ajax: {
                    url: '@Url.Action("GetOperatorsData", "OperatorList")', type: 'POST',
                    dataSrc: 'data',
                    data: d => { d.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val(); },
                    error: xhr => { console.error(xhr.responseText); showToast('Failed to load data.', 'error'); }
                },
                columns: [
                    { data: 'ownerName',    render: d => `<span class="fw-semibold">${d || '—'}</span>` },
                    { data: 'gender',       defaultContent: '—' },
                    { data: 'businessName', defaultContent: '—' },
                    { data: 'bussPermit',   defaultContent: '—' },
                    { data: 'location',     defaultContent: '—' },
                    {
                        data: 'status', className: 'text-center',
                        render: (data, type, row) => data === 1
                            ? `<span class="status-pill status-active status-badge" data-id="${row.operatorId}" title="Click to toggle">Active</span>`
                            : `<span class="status-pill status-inactive status-badge" data-id="${row.operatorId}" title="Click to toggle">Inactive</span>`
                    },
                    {
                        data: 'operatorId', orderable: false, searchable: false, className: 'text-center',
                        render: (data, type, row) => `
                            <div class="d-flex gap-1 justify-content-center">
                                <a href="/OperatorList/Edit/${data}" class="btn-act btn-edit-act btn-edit">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <button class="btn-act btn-delete-act btn-delete"
                                        data-id="${data}" data-name="${row.ownerName ?? ''}">
                                    <i class="bi bi-trash3"></i> Delete
                                </button>
                            </div>`
                    }
                ],
                pageLength: 10, responsive: true, autoWidth: false,
                language: { emptyTable: 'No operators found.' }
            });

            // ── Open modal ──────────────────────────────────────
            function openModal(url, title) {
                var existing = bootstrap.Modal.getInstance(document.getElementById('operatorModal'));
                if (existing) existing.dispose();
                $('#modalContent').html(`
                    <div class="text-center py-5 text-muted">
                        <div class="spinner-border text-primary mb-3" role="status"></div>
                        <div style="font-size:0.875rem;">Loading form...</div>
                    </div>`);
                $('#operatorModalLabel').html(`<i class="bi bi-building me-2"></i>${title}`);
                $.get(url, res => {
                    $('#modalContent').html(res);
                    $.validator?.unobtrusive?.parse('#modalContent');
                    new bootstrap.Modal(document.getElementById('operatorModal')).show();
                }).fail(xhr => {
                    $('#modalContent').html(`<div class="alert alert-danger m-3">HTTP ${xhr.status}: ${xhr.statusText}</div>`);
                    showToast('Error loading form.', 'error');
                });
            }

            $('#btnCreate').click(() => openModal('@Url.Action("Create", "OperatorList")', 'Add Operator'));
            $('#operatorsTable').on('click', '.btn-edit', function (e) {
                e.preventDefault(); openModal($(this).attr('href'), 'Edit Operator');
            });

            // ── Status toggle ───────────────────────────────────
            $('#operatorsTable').on('click', '.status-badge', function () {
                const id = $(this).data('id');
                $.post('@Url.Action("ToggleStatus", "OperatorList")', {
                    id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                }, res => {
                    if (res.success) { showToast(res.message, 'success'); table.ajax.reload(null, false); }
                    else showToast(res.message, 'error');
                });
            });

            // ── Delete confirm modal ────────────────────────────
            let pendingDeleteId = null;
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));

            $('#operatorsTable').on('click', '.btn-delete', function () {
                pendingDeleteId = $(this).data('id');
                $('#deleteOpName').text($(this).data('name'));
                deleteModal.show();
            });

            $('#confirmDeleteBtn').on('click', function () {
                if (!pendingDeleteId) return;
                const $btn = $(this);
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Deleting...');
                $.post('@Url.Action("DeleteAjax", "OperatorList")', {
                    id: pendingDeleteId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                }, res => {
                    deleteModal.hide();
                    if (res.success) { showToast(res.message, 'success'); table.ajax.reload(null, false); }
                    else showToast(res.message, 'error');
                }).fail(() => { deleteModal.hide(); showToast('Error deleting operator.', 'error'); })
                  .always(() => { $btn.prop('disabled', false).html('<i class="bi bi-trash3 me-1"></i>Delete'); pendingDeleteId = null; });
            });

            // ── Form submit ─────────────────────────────────────
            $('#operatorModal').on('submit', 'form', function (e) {
                e.preventDefault();
                const form = $(this);
                if (form.valid && !form.valid()) { showToast('Please fill in all required fields.', 'warning'); return; }
                const $btn = form.find('[type="submit"]');
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');
                $.post(form.attr('action'), form.serialize(), res => {
                    if (res.success) {
                        bootstrap.Modal.getInstance(document.getElementById('operatorModal'))?.hide();
                        table.ajax.reload(null, false);
                        showToast(res.message || 'Saved successfully.', 'success');
                    } else {
                        $('#modalContent').html(res);
                        $.validator?.unobtrusive?.parse('#modalContent');
                        $btn.prop('disabled', false).html('Save');
                    }
                }).fail(xhr => { $btn.prop('disabled', false).html('Save'); showToast('Error saving (HTTP ' + xhr.status + ').', 'error'); });
            });
        });
    </script>
}
