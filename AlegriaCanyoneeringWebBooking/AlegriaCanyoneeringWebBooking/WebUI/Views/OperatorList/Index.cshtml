@{
    ViewData["Title"] = "Operators";
}

<h2 class="fw-bold mb-4 text-primary">Operators</h2>

<!-- Anti-Forgery Token for AJAX -->
<form id="__AjaxAntiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- Button to open Create Modal -->
<button type="button" id="btnCreate" class="btn btn-primary mb-3">
    <i></i> Create New
</button>

<div class="table-responsive">
    <table id="operatorsTable" class="table table-bordered table-striped table-sm align-middle w-100">
        <thead class="table-light">
            <tr>
                <th>Owner Name</th>
                <th class="d-none d-sm-table-cell">Gender</th>
                <th>Business Name</th>
                <th class="d-none d-md-table-cell">Business Permit</th>
                <th class="d-none d-lg-table-cell">Location</th>
                <th class="text-center">Status</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
    </table>
</div>

<!-- Create/Edit Modal -->
<div class="modal fade" id="operatorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="operatorModalLabel">Operator</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalContent">
                <!-- AJAX loaded form will appear here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">

    <!-- Validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

    <script>
        // ✅ Bootstrap Toast Notification (Your Version)
        function showToast(message, type = 'success') {
            let bgClass = 'bg-success';
            let icon = 'bi-check-circle-fill';
            let title = 'Success';

            if (type === 'error') { bgClass = 'bg-danger'; icon = 'bi-exclamation-triangle-fill'; title = 'Error'; }
            else if (type === 'warning') { bgClass = 'bg-danger'; icon = 'bi-exclamation-circle-fill'; title = 'Warning'; }
            else if (type === 'info') { bgClass = 'bg-info'; icon = 'bi-info-circle-fill'; title = 'Info'; }

            const toastContainer = $('<div></div>')
                .addClass('toast-container position-fixed top-0 end-0 p-3')
                .css('z-index', 1080);

            const toast = $('<div></div>').addClass(`toast text-white ${bgClass} border-0`)
                .attr({ role: 'alert', 'aria-live': 'assertive', 'aria-atomic': 'true', 'data-bs-delay': 4000 });

            const toastHeader = $('<div></div>').addClass(`toast-header ${bgClass} text-white border-0`).html(`
                <i class="bi ${icon} me-2"></i>
                <strong class="me-auto">${title}</strong>
                <small>Now</small>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            `);

            const toastBody = $('<div></div>').addClass('toast-body').text(message);

            toast.append(toastHeader, toastBody);
            toastContainer.append(toast);
            $('body').append(toastContainer);

            var bsToast = new bootstrap.Toast(toast[0]);
            bsToast.show();

            toast.on('hidden.bs.toast', function () { toastContainer.remove(); });
        }

        $(document).ready(function () {
            // ✅ Initialize DataTable
            var table = $('#operatorsTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetOperatorsData", "OperatorList")',
                    type: 'POST',
                    dataSrc: 'data',
                    error: function (xhr) {
                        console.error(xhr.responseText);
                        showToast("Failed to load data.", "error");
                    }
                },
                columns: [
                    { data: 'ownerName', className: 'text-break' },
                    { data: 'gender', className: 'd-none d-sm-table-cell' },
                    { data: 'businessName', className: 'text-break' },
                    { data: 'bussPermit', className: 'd-none d-md-table-cell' },
                    { data: 'location', className: 'd-none d-lg-table-cell text-break' },
                    {
                        data: 'status',
                        className: 'text-center',
                        render: function (data, type, row) {
                            return data === 1
                                ? `<span class="badge bg-success status-badge" data-id="${row.operatorId}" data-status="${data}" style="cursor:pointer;">Active</span>`
                                : `<span class="badge bg-danger status-badge" data-id="${row.operatorId}" data-status="${data}" style="cursor:pointer;">Inactive</span>`;
                        }
                    },
                    {
                        data: 'operatorId',
                        orderable: false,
                        searchable: false,
                        className: 'text-center',
                        render: function (data, type, row) {
                            return `
                                <div class="d-flex flex-wrap gap-2 justify-content-center">
                                    <a href="/OperatorList/Edit/${data}" class="btn btn-sm btn-warning btn-edit">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger delete-btn" data-id="${data}" data-name="${row.ownerName}">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </div>`;
                        }
                    }
                ],
                pageLength: 10,
                responsive: true,
                autoWidth: false
            });


            // ✅ Delete
            $('#operatorsTable').on('click', '.delete-btn', function () {
                var id = $(this).data('id'), name = $(this).data('name');
                if (confirm(`Delete "${name}"? This action cannot be undone.`)) {
                    $.post('@Url.Action("DeleteAjax", "OperatorList")', {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    }, function (res) {
                        if (res.success) {
                            showToast(res.message, 'success');
                            table.ajax.reload(null, false);
                        } else showToast(res.message, 'error');
                    });
                }
            });

            // ✅ Status Toggle
            $('#operatorsTable').on('click', '.status-badge', function () {
                var operatorId = $(this).data('id');
                var token = $('input[name="__RequestVerificationToken"]').val();
                $.post('@Url.Action("ToggleStatus", "OperatorList")', { id: operatorId, __RequestVerificationToken: token }, function (res) {
                    if (res.success) {
                        showToast(res.message, 'success');
                        table.ajax.reload(null, false);
                    } else showToast(res.message, 'error');
                });
            });

   

            // ✅ Open Modal for Create/Edit
            function openOperatorModal(url, title) {
                $.get(url, function (data) {
                    $('#modalContent').html(data);
                    $('#operatorModalLabel').text(title);
                    new bootstrap.Modal(document.getElementById('operatorModal')).show();
                });
            }

            $('#btnCreate').click(() => openOperatorModal('@Url.Action("Create", "OperatorList")', 'Create Operator'));
            $('#operatorsTable').on('click', '.btn-edit', function (e) {
                e.preventDefault();
                openOperatorModal($(this).attr('href'), 'Edit Operator');
            });

            // ✅ Form Submission with Validation Toast
            $('#operatorModal').on('submit', 'form', function (e) {
                e.preventDefault();
                var form = $(this);
                // If form invalid → show warning toast
                if (!form.valid()) {
                    showToast('Please fill in all required fields.', 'warning');
                    return false;
                }
                $.post(form.attr('action'), form.serialize(), function (res) {
                    if (res.success) {
                        bootstrap.Modal.getInstance(document.getElementById('operatorModal')).hide();
                        table.ajax.reload(null, false);
                        showToast(res.message || 'Record saved successfully.', 'success');
                    } else {
                        // Reload validation errors if backend returned HTML
                        $('#modalContent').html(res);
                        $.validator.unobtrusive.parse('#modalContent');
                    }
                }).fail(function (xhr) {
                    console.error(xhr.responseText);
                    showToast('An error occurred while saving.', 'error');
                });
            });
        });
    </script>
}
