@{
    ViewData["Title"] = "Dashboard - Alegria Canyoneering";

    var monthLabels = ViewBag.MonthLabels as List<string>;
    var monthlyGuestCounts = ViewBag.MonthlyGuestCounts as List<int>;
    var yearLabels = ViewBag.YearLabels as List<string>;
    var yearlyGuestCounts = ViewBag.YearlyGuestCounts as List<int>;
    var guestDates = ViewBag.GuestDates as List<string>; // Unix timestamps

    // Old year data: 2018 - 2020 (must be passed from controller)
    var oldYearLabels = ViewBag.YearLabelsOld as List<string> ?? new List<string>();
    var oldYearlyGuestCounts = ViewBag.YearlyGuestCountsOld as List<int> ?? new List<int>();

    // Reverse the new year labels and counts to ascending order
    yearLabels.Reverse();
    yearlyGuestCounts.Reverse();

    // Combine old and new year data ascending from 2018 to current year
    var combinedYearLabels = new List<string>();
    var combinedYearlyGuestCounts = new List<int>();

    combinedYearLabels.AddRange(oldYearLabels);
    combinedYearLabels.AddRange(yearLabels);

    combinedYearlyGuestCounts.AddRange(oldYearlyGuestCounts);
    combinedYearlyGuestCounts.AddRange(yearlyGuestCounts);
}


<link href="~/css/Dashboard.css" rel="stylesheet" />

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">Dashboard Overview</h2>
        <div class="text-end">
            <h6 class="text-muted mb-1">Welcome back</h6>
            <h5 class="fw-semibold text-dark">@User.Identity.Name</h5>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="card-subtitle text-muted mb-2">Guests Today</h6>
                            <h2 class="card-title fw-bold text-primary">@ViewBag.GuestsToday</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                            <i class="fas fa-users text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="card-subtitle text-muted mb-2">Guests This Month</h6>
                            <h2 class="card-title fw-bold text-success">@ViewBag.GuestsThisMonth</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 p-2 rounded">
                            <i class="fas fa-calendar-alt text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="card-subtitle text-muted mb-2">Previous Month</h6>
                            <h2 class="card-title fw-bold text-warning">@ViewBag.GuestsPrevMonth</h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-2 rounded">
                            <i class="fas fa-chart-line text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row g-4">
        <!-- Monthly Guest Trend Chart -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="card-title mb-0 fw-semibold">Monthly Guest Trend</h5>
                </div>
                <div class="card-body">
                    <canvas id="monthlyGuestTrendChart" height="250"></canvas>
                </div>
            </div>
        </div>

        <!-- Yearly Guest Trend Chart -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="card-title mb-0 fw-semibold">Yearly Guest Trend</h5>
                </div>
                <div class="card-body">
                    <canvas id="yearlyGuestTrendChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Convert Unix timestamp to human-readable date
        function convertUnixToDate(unixTimestamp) {
            var date = new Date(unixTimestamp * 1000); // seconds to ms
            return date.toLocaleDateString(); // MM/DD/YYYY format
        }

        // Display guest dates in human-readable format
        const guestDates = @Html.Raw(Json.Serialize(guestDates));
        console.log(guestDates.map(timestamp => convertUnixToDate(timestamp)));

        // Monthly guest trend data
        const monthlyGuestCounts = @Html.Raw(Json.Serialize(monthlyGuestCounts));
        const monthLabels = @Html.Raw(Json.Serialize(monthLabels));

        // Chart.js gradient for monthly trend
        const ctxMonthly = document.getElementById('monthlyGuestTrendChart').getContext('2d');
        const gradientMonthly = ctxMonthly.createLinearGradient(0, 0, 0, 400);
        gradientMonthly.addColorStop(0, 'rgba(0, 123, 255, 0.8)');
        gradientMonthly.addColorStop(1, 'rgba(0, 123, 255, 0.1)');

        new Chart(ctxMonthly, {
            type: 'line',
            data: {
                labels: monthLabels,
                datasets: [{
                    label: 'Monthly Guests',
                    data: monthlyGuestCounts,
                    borderColor: gradientMonthly,
                    backgroundColor: gradientMonthly,
                    fill: true,
                    pointBackgroundColor: 'rgba(0, 123, 255, 0.7)',
                    pointRadius: 5,
                    pointHoverRadius: 8,
                    borderWidth: 3
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    tooltip: {
                        enabled: true,
                        backgroundColor: 'rgba(0, 0, 0, 0.7)',
                        titleColor: '#fff',
                        bodyColor: '#fff',
                        borderColor: '#fff',
                        borderWidth: 1,
                    },
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            font: { family: 'Arial', size: 14 }
                        }
                    }
                },
                scales: {
                    x: { ticks: { font: { size: 14 } } },
                    y: { ticks: { font: { size: 14 } } }
                }
            }
        });

        // Yearly guest trend combined data
        const yearLabelsCombined = @Html.Raw(Json.Serialize(combinedYearLabels));
        const yearlyGuestCountsCombined = @Html.Raw(Json.Serialize(combinedYearlyGuestCounts));

        const ctxYearly = document.getElementById('yearlyGuestTrendChart').getContext('2d');
        const gradientYearly = ctxYearly.createLinearGradient(0, 0, 0, 400);
        gradientYearly.addColorStop(0, 'rgba(40, 167, 69, 0.8)');
        gradientYearly.addColorStop(1, 'rgba(40, 167, 69, 0.1)');

        new Chart(ctxYearly, {
            type: 'line',
            data: {
                labels: yearLabelsCombined,
                datasets: [{
                    label: 'Yearly Guests',
                    data: yearlyGuestCountsCombined,
                    borderColor: gradientYearly,
                    backgroundColor: gradientYearly,
                    fill: true,
                    pointBackgroundColor: 'rgba(40, 167, 69, 0.7)',
                    pointRadius: 5,
                    pointHoverRadius: 8,
                    borderWidth: 3
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    tooltip: {
                        enabled: true,
                        backgroundColor: 'rgba(0, 0, 0, 0.7)',
                        titleColor: '#fff',
                        bodyColor: '#fff',
                        borderColor: '#fff',
                        borderWidth: 1,
                    },
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            font: { family: 'Arial', size: 14 }
                        }
                    }
                },
                scales: {
                    x: { ticks: { font: { size: 14 } } },
                    y: { ticks: { font: { size: 14 } } }
                }
            }
        });
    </script>
}
