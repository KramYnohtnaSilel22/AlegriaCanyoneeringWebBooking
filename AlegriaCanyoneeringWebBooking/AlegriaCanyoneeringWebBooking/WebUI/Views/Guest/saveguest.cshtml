@{
    ViewData["Title"] = "Saved Batch Leaders";

}

<h2 class="fw-bold mb-4 text-primary">
    <i class="bi bi-bookmark-check-fill me-2"></i> Saved Guests
</h2>
<!-- ✅ Booking Details Modal -->
<div class="modal fade" id="bookingDetailsModal" tabindex="-1" aria-labelledby="bookingDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="bookingDetailsLabel">
                    <i class="fas fa-clipboard-list me-2"></i> Booking Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="bookingDetailsBody">
                <!-- Content will be loaded dynamically -->
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
<table id="guestsTable" class="table table-bordered table-striped">
    <thead class="table-light">
        <tr>
            <th>Operator</th>
            <th>Total Guests</th>
            <th>Arrival Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
</table>
        </div>
    </div>
</div>
<!-- ✅ Toast Message -->
@if (TempData["ToastMessage"] != null)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055;">
        <div id="toastMessage" class="toast align-items-center text-white bg-@TempData["ToastType"] border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="fas fa-check-circle me-2"></i> @TempData["ToastMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        const bookingDetailsUrl = '@Url.Action("GetBookingDetails", "Guest")';

        // Function to load booking details
        function loadBookingDetails(id) {
            const $body = $('#bookingDetailsBody');
            $body.html(`
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    Loading...
                </div>
            `);

            $.get(`${bookingDetailsUrl}/${id}`)
                .done(function (html) {
                    $body.html(html);
                })
                .fail(function () {
                    $body.html(`<div class="alert alert-danger">Failed to load booking details. Please try again.</div>`);
                });
        }

        const isAdmin = @User.IsInRole("Admin").ToString().ToLower(); // true/false in JS

        $(document).ready(function () {
            $('#guestsTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetGuestsData", "Guest")',
                    type: 'POST',
                    dataSrc: function (json) {
                        if (json.error) {
                            alert(json.error);
                            return [];
                        }
                        return json.data;  // Ensure this corresponds to the 'data' field in the response from the server
                    },
                    error: function (xhr, error, code) {
                        console.log("Error occurred while fetching data: ", error, xhr);
                        alert("An error occurred while fetching the data. Please try again.");
                    }
                },
                columns: [
                    {
                        data: 'operatorName',  // Display the operator's name from the backend (operatorName)
                        title: 'Operator',
                        render: function (data) {
                            return data || 'No Operator';  // If no operator, show 'No Operator'
                        }
                    },
                    {
                        data: 'totalGuests',  // Display the total number of guests
                        title: 'Total Guests'
                    },
                           {
            data: 'arrivalDate',
            render: function (data) {
                // ✅ Handle null or undefined
                if (!data) return '<span class="text-muted">N/A</span>';

                let date;

                if (!isNaN(data)) {
                    // ✅ Unix timestamp (in seconds)
                    date = new Date(parseInt(data) * 1000);
                } else {
                    // ✅ Fallback for ISO/UTC date strings
                    date = new Date(data);
                }

                // ❌ If still invalid, just return the raw data
                if (isNaN(date.getTime())) return data;

                // ✅ Format date with full month name, time, and AM/PM
                var formattedDate = date.toLocaleString('en-US', {
                    year: 'numeric',
                    month: 'long',  // Full month name
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: true     // 12-hour format
                });

                return formattedDate;
            }
        },

                    {
                        data: 'bookingStatus',  // Assuming bookingStatus is a string like "anticipated"
                        title: 'Status',
                        render: function (data) {
                            let statusText = '';
                            let badgeClass = '';

                            // Map the bookingStatus string to a badge color
                            switch (data) {
                                case "anticipated":
                                    statusText = 'Anticipated';
                                    badgeClass = 'warning';  // Apply info badge for anticipated
                                    break;
                                case "reserved":
                                    statusText = 'reserved';
                                    badgeClass = 'success';  // Apply success badge for reserved
                                    break;
                                case "canceled":
                                    statusText = 'canceled';
                                    badgeClass = 'danger';  // Apply danger badge for canceled
                                    break;
                                default:
                                    statusText = 'unknown';
                                    badgeClass = 'secondary';  // Default case for unknown statuses
                                    break;
                            }

                            return `<span class="badge bg-${badgeClass}">${statusText}</span>`;
                        }
                    },
                    {
                        data: 'id',  // Assuming this is the ID field in your response
                        title: 'Actions',
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            const detailsUrl = `@Url.Action("Details", "Guest")/${data}`;
                            return `
                                <button type="button" class="btn btn-sm btn-primary me-1" onclick="loadBookingDetails(${data})" data-bs-toggle="modal" data-bs-target="#bookingDetailsModal">
                                    <i class="fas fa-eye me-1"></i> View
                                </button>
                                ${row.bookingStatus === "anticipated" ? `
                                    <!-- Show only if status is "anticipated" -->
                                    <form method="post" action="/Guest/UpdateStatus" style="display:inline">
                                        <input type="hidden" name="id" value="${data}" />
                                        <input type="hidden" name="status" value="reserved" /> <!-- Status update to "reserved" -->
                                        <button type="submit" class="btn btn-sm btn-success">Submit</button>
                                    </form>
                                ` : ''}
                            `;
                        }
                    }
                ],
                pageLength: 10,
                lengthMenu: [[10, 20, 30, 50, 100], [10, 20, 30, 50, 100]],
                responsive: true,
                autoWidth: false,
                language: {
                    emptyTable: "No guests found."
                }
            });

            // ✅ Toast Message Handling
            var toastElement = document.getElementById('toastMessage');
            if (toastElement) {
                var toast = new bootstrap.Toast(toastElement);
                toast.show();
            }
        });
    </script>
}
