@{
    ViewData["Title"] = "Saved Batch Leaders";
}
<link href="/css/SaveGuest.css" rel="stylesheet" />

<h2 class="fw-bold mb-4 text-primary">
    <i class="bi bi-bookmark-check-fill me-2"></i> Saved Guests
</h2>

<!-- Booking Details Modal -->
<div class="modal fade" id="bookingDetailsModal" tabindex="-1" aria-labelledby="bookingDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="bookingDetailsLabel">
                    <i class="fas fa-clipboard-list me-2"></i> Booking Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="bookingDetailsBody">
                <!-- Content will be loaded dynamically -->
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table id="guestsTable" class="table table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th>Operator</th>
                        <th>Total Guests</th>
                        <th>Arrival Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- Toast Message -->
@if (TempData["ToastMessage"] != null)
{
    var toastType = TempData["ToastType"]?.ToString()?.ToLower() ?? "success";
    var toastConfig = toastType switch
    {
        "success" => new { Icon = "bi-check-circle-fill", Bg = "bg-success text-white", Title = "Success" },
        "danger" => new { Icon = "bi-exclamation-triangle-fill", Bg = "bg-danger text-white", Title = "Error" },
        "warning" => new { Icon = "bi-exclamation-circle-fill", Bg = "bg-warning text-dark", Title = "Warning" },
        _ => new { Icon = "bi-info-circle-fill", Bg = "bg-info text-light", Title = "Notification" }
    };

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1055;">
        <div id="toastMessage"
             class="toast border-0 shadow-sm show @toastConfig.Bg"
             role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000">

            <div class="toast-header @toastConfig.Bg">
                <i class="bi @toastConfig.Icon me-2"></i>
                <strong class="me-auto">@toastConfig.Title</strong>
                <small>Now</small>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>

            <div class="toast-body">
                @TempData["ToastMessage"]
            </div>
        </div>
    </div>

  
}


@section Scripts {
    <script>
               document.addEventListener("DOMContentLoaded", function () {
                const toastEl = document.getElementById('toastMessage');
                const toast = new bootstrap.Toast(toastEl);
                toast.show();
            });
        const bookingDetailsUrl = '@Url.Action("GetBookingDetails", "Guest")';

        function loadBookingDetails(id) {
            const $body = $('#bookingDetailsBody');
            $body.html(`
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    Loading...
                </div>
            `);

            $.get(`${bookingDetailsUrl}/${id}`)
                .done(function (html) {
                    $body.html(html);
                })
                .fail(function () {
                    $body.html(`<div class="alert alert-danger">Failed to load booking details. Please try again.</div>`);
                });
        }

        const isAdmin = @User.IsInRole("Admin").ToString().ToLower();

        $(document).ready(function () {
            $('#guestsTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetGuestsData", "Guest")',
                    type: 'POST',
                    dataSrc: function (json) {
                        if (json.error) {
                            alert(json.error);
                            return [];
                        }
                        return json.data;
                    },
                    error: function (xhr, error, code) {
                        console.log("Error occurred while fetching data: ", error, xhr);
                        alert("An error occurred while fetching the data. Please try again.");
                    }
                },
                columns: [
                    {
                        data: 'operatorName',
                        title: 'Operator',
                        render: function (data) {
                            return data || 'No Operator';
                        }
                    },
                    {
                        data: 'totalGuests',
                        title: 'Total Guests'
                    },
                    {
                        data: 'arrivalDate',
                        render: function (data) {
                            if (!data) return '<span class="text-muted">N/A</span>';

                            let date;
                            if (!isNaN(data)) {
                                date = new Date(parseInt(data) * 1000);
                            } else {
                                date = new Date(data);
                            }

                            if (isNaN(date.getTime())) return data;

                            return date.toLocaleString('en-US', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit',
                                hour12: true
                            });
                        }
                    },
                    {
                        data: 'bookingStatus',
                        title: 'Status',
                        render: function (data) {
                            let statusText = '';
                            let badgeClass = '';

                            switch (data) {
                                case "anticipated":
                                    statusText = 'Anticipated';
                                    badgeClass = 'warning';
                                    break;
                                case "reserved":
                                    statusText = 'Reserved';
                                    badgeClass = 'success';
                                    break;
                                case "canceled":
                                    statusText = 'Canceled';
                                    badgeClass = 'danger';
                                    break;
                                default:
                                    statusText = 'Unknown';
                                    badgeClass = 'secondary';
                                    break;
                            }

                            return `<span class="badge bg-${badgeClass}">${statusText}</span>`;
                        }
                    },
                    {
                        data: 'id',
                        title: 'Actions',
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            return `
                                <button type="button" class="btn btn-sm btn-primary me-1" onclick="loadBookingDetails(${data})" data-bs-toggle="modal" data-bs-target="#bookingDetailsModal">
                                    <i class="fas fa-eye me-1"></i> View
                                </button>
                                ${row.bookingStatus === "anticipated" ? `
                                    <form method="post" action="/Guest/UpdateStatus" style="display:inline">
                                        <input type="hidden" name="id" value="${data}" />
                                        <input type="hidden" name="status" value="reserved" />
        @if (User.IsInRole("Super Admin") || User.IsInRole("Operator"))
    {
                                        <button type="submit" class="btn btn-sm btn-success">    <i class="fas fa-check"></i>Submit</button>
        }
                                    </form>
                                ` : ''}
                            `;
                        }
                    }
                ],
                pageLength: 10,
                lengthMenu: [[10, 20, 30, 50, 100], [10, 20, 30, 50, 100]],
                responsive: true,
                autoWidth: false,
                language: { emptyTable: "No guests found." },

                // Mobile responsive: add data-label attributes for each <td>
                drawCallback: function () {
                    const table = document.getElementById('guestsTable');
                    if (!table) return;
                    const headers = Array.from(table.querySelectorAll('thead th')).map(th => th.innerText.trim());

                    table.querySelectorAll('tbody tr').forEach(row => {
                        row.querySelectorAll('td').forEach((cell, idx) => {
                            if (headers[idx]) {
                                cell.setAttribute('data-label', headers[idx]);
                            }
                        });
                    });
                }
            });

            // Toast Message Handling
            var toastElement = document.getElementById('toastMessage');
            if (toastElement) {
                var toast = new bootstrap.Toast(toastElement);
                toast.show();
            }
        });
    </script>
}
