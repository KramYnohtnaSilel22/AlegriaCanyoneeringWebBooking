@model GuestListViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "New Booking";
    var batchDetails = ViewBag.BatchDetails ?? new { };
    var serializedBatch = JsonSerializer.Serialize(batchDetails);
    bool isReadonly = ViewBag.IsReadonly ?? false;
    bool operatorLocked = ViewBag.OperatorLocked ?? false;
}

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    .nb-wrap * {
        font-family: 'Outfit', sans-serif;
    }

    /* ── Page header ──────────────────────────────── */
    .nb-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

        .nb-header h2 {
            font-size: 1.35rem;
            font-weight: 700;
            color: #0f3460;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    /* Guest counter pill */
    .nb-counter {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 1rem;
        background: rgba(26,110,245,0.08);
        border: 1px solid #bfdbfe;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
        color: #1a6ef5;
    }

        .nb-counter span {
            font-size: 1.1rem;
            font-weight: 800;
        }

    /* ── Card ─────────────────────────────────────── */
    .nb-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 20px rgba(15,52,96,0.08);
        border: 1px solid #e8edf5;
        overflow: hidden;
        margin-bottom: 1.25rem;
    }

    .nb-card-header {
        padding: 0.9rem 1.5rem;
        border-bottom: 1.5px solid #f1f5f9;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .nb-card-header h5 {
            font-size: 0.82rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: #1a6ef5;
            margin: 0;
        }

    .nb-card-body {
        padding: 1.25rem 1.5rem;
    }

    /* ── Field ────────────────────────────────────── */
    .nb-field {
        margin-bottom: 1rem;
    }

    .nb-label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #0f3460;
        display: block;
        margin-bottom: 0.35rem;
    }

        .nb-label .req {
            color: #ef4444;
            margin-left: 2px;
        }

    .nb-input, .nb-select, .nb-textarea {
        width: 100%;
        padding: 0.65rem 0.9rem;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        font-family: 'Outfit',sans-serif;
        font-size: 0.9rem;
        color: #1e293b;
        background: #fafbff;
        outline: none;
        transition: border-color 0.2s,box-shadow 0.2s;
        appearance: none;
        box-sizing: border-box;
    }

        .nb-input:focus, .nb-select:focus, .nb-textarea:focus {
            border-color: #1a6ef5;
            box-shadow: 0 0 0 3px rgba(26,110,245,0.1);
            background: #fff;
        }

        .nb-input[readonly], .nb-select[disabled], .nb-input[disabled] {
            background: #f1f5f9;
            color: #94a3b8;
            cursor: not-allowed;
        }

    .nb-lock-note {
        font-size: 0.75rem;
        color: #94a3b8;
        margin-top: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    /* ── Footer buttons ───────────────────────────── */
    .nb-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 1.5rem;
        border-top: 1.5px solid #f1f5f9;
        background: #fafbff;
        flex-wrap: wrap;
    }

    .btn-nb-add {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.6rem 1.25rem;
        background: linear-gradient(135deg,#1a6ef5,#0f3460);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: 'Outfit',sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s,transform 0.15s;
        box-shadow: 0 3px 12px rgba(26,110,245,0.3);
    }

        .btn-nb-add:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    .btn-nb-save {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.6rem 1.4rem;
        background: linear-gradient(135deg,#22c55e,#15803d);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: 'Outfit',sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s,transform 0.15s;
        box-shadow: 0 3px 12px rgba(34,197,94,0.3);
    }

        .btn-nb-save:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

        .btn-nb-save:disabled {
            opacity: 0.45;
            cursor: not-allowed;
            transform: none;
        }
</style>

<!-- Server-side toast -->
@if (TempData["ToastMessage"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090;">
        <div id="guestToast" class="toast border-0 text-white"
             style="background:#22c55e;border-radius:12px;"
             role="alert" data-bs-delay="4000">
            <div class="toast-header border-0 text-white" style="background:transparent;">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">@TempData["ToastMessage"]</div>
        </div>
    </div>
}

<div id="nbToastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090;"></div>

<div class="nb-wrap">

    <!-- Header -->
    <div class="nb-header">
        <h2>
            <i class="bi bi-person-plus-fill" style="color:#1a6ef5;"></i>
            New Booking
        </h2>
        <div class="nb-counter">
            <i class="bi bi-people-fill"></i>
            Total Guests: <span id="totalGuestsCount">0</span>
        </div>
    </div>

    <form asp-action="NewBooking" method="post" id="guestForm" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" id="BatchGuestsJson" name="BatchGuestsJson" value="@Model.BatchGuestsJson" />
        <input type="hidden" id="CurrentBatch" name="batch" value="@ViewBag.CurrentBatch" readonly />
        <input type="hidden" id="MainGuestId" name="id" value="@ViewBag.MainGuestId" />

        <!-- Guest Info card -->
        <div class="nb-card">
            <div class="nb-card-header">
                <i class="bi bi-person-vcard" style="color:#1a6ef5;"></i>
                <h5>Guest Info</h5>
            </div>
            <div class="nb-card-body">
                <div class="row g-3">

                    <!-- Operator -->
                    <div class="col-md-6">
                        <div class="nb-field">
                            <label class="nb-label">Operator</label>
                            @if (operatorLocked)
                            {
                                <select asp-for="NewGuest.OperatorId" asp-items="ViewBag.OperatorList"
                                        class="nb-select" id="OperatorInput" disabled="disabled"></select>
                                <input type="hidden" name="NewGuest.OperatorId" id="OperatorInputHidden"
                                       value="@Model.NewGuest.OperatorId" />
                                <div class="nb-lock-note"><i class="bi bi-lock-fill"></i>Assigned to your operator account</div>
                            }
                            else
                            {
                                <select asp-for="NewGuest.OperatorId" asp-items="ViewBag.OperatorList"
                                        class="nb-select" id="OperatorInput"
                                        disabled="@(isReadonly ? "disabled" : null)"></select>
                            }
                        </div>
                    </div>

                    <!-- Full Name -->
                    <div class="col-md-6">
                        <div class="nb-field">
                            <label class="nb-label">Full Name<span class="req">*</span></label>
                            <input asp-for="NewGuest.Fullname" class="nb-input"
                                   placeholder="e.g. Juan Dela Cruz"
                                   oninput="this.value=this.value.replace(/[^A-Za-z\s]/g,'')" />
                        </div>
                    </div>

                    <!-- Age -->
                    <div class="col-md-3">
                        <div class="nb-field">
                            <label class="nb-label">Age<span class="req">*</span></label>
                            <input asp-for="NewGuest.Age" type="number" class="nb-input"
                                   placeholder="e.g. 25" inputmode="numeric" />
                        </div>
                    </div>

                    <!-- Gender -->
                    <div class="col-md-3">
                        <div class="nb-field">
                            <label class="nb-label">Gender<span class="req">*</span></label>
                            <select asp-for="NewGuest.Gender" class="nb-select">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                    </div>

                    <!-- Contact -->
                    <div class="col-md-6">
                        <div class="nb-field">
                            <label class="nb-label">Mobile Number</label>
                            <input asp-for="NewGuest.ContactNumber" type="tel" class="nb-input"
                                   placeholder="e.g. 09171234567"
                                   maxlength="11" inputmode="numeric"
                                   oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                            <span asp-validation-for="NewGuest.ContactNumber" class="text-danger small"></span>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Nationality & Booking card -->
        <div class="nb-card">
            <div class="nb-card-header">
                <i class="bi bi-globe2" style="color:#1a6ef5;"></i>
                <h5>Nationality &amp; Booking</h5>
            </div>
            <div class="nb-card-body">
                <div class="row g-3">

                    <!-- Nationality Type -->
                    <div class="col-md-4">
                        <div class="nb-field">
                            <label class="nb-label">Nationality Type<span class="req">*</span></label>
                            <select asp-for="NewGuest.NationalityType" class="nb-select" id="NationalityType">
                                <option value="Local">Local</option>
                                <option value="Foreign">Foreign</option>
                            </select>
                        </div>
                    </div>

                    <!-- Nationality -->
                    <div class="col-md-4">
                        <div class="nb-field">
                            <label class="nb-label">Nationality<span class="req">*</span></label>
                            <select asp-for="NewGuest.NationalityId" class="nb-select" id="NationalityId"></select>
                            <span asp-validation-for="NewGuest.NationalityId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Tour Area -->
                    <div class="col-md-4">
                        <div class="nb-field">
                            <label class="nb-label">Tour Area<span class="req">*</span></label>
                            <select asp-for="NewGuest.Area" class="nb-select" id="TourAreaInput"
                                    disabled="@(isReadonly ? "disabled" : null)">
                                <option value="Wonder Falls">Wonder Falls</option>
                                <option value="Kanlaob">Kanlaob</option>
                                <option value="Kawasan Exit">Kawasan Exit</option>
                            </select>
                        </div>
                    </div>

                    <!-- Arrival Date -->
                    <div class="col-md-6">
                        <div class="nb-field">
                            <label class="nb-label">Arrival Date<span class="req">*</span></label>
                            <input type="datetime-local" name="NewGuest.ArrivalDate"
                                   class="nb-input" id="ArrivalDateInput"
                                   value="@Model.Html5ArrivalDate"
                                   readonly="@(isReadonly ? "readonly" : null)" />
                            <span asp-validation-for="NewGuest.ArrivalDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Photo -->
                    <div class="col-md-6">
                        <div class="nb-field">
                            <label class="nb-label">Guest Photo</label>
                            <input type="file" name="Photo" id="photoInput" class="nb-input"
                                   accept="image/jpeg,image/png,image/webp,image/jpg"
                                   capture="environment" onchange="validateImage(this)"
                                   style="padding:0.5rem 0.9rem;cursor:pointer;" />
                            <div id="fileError" class="text-danger small mt-1"></div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Footer actions -->
        <div class="nb-footer">
            <button id="addGuestBtn" type="button" class="btn-nb-add">
                <i class="bi bi-person-plus"></i> Add Guest
            </button>
            <button type="submit" id="saveBtn" class="btn-nb-save" disabled>
                <i class="bi bi-save"></i> Save All Guests
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <script>
        function validateImage(input) {
            var file = input.files[0];
            var err  = document.getElementById('fileError');
            err.textContent = '';
            if (!file) return;
            if (file.size > 1 * 1024 * 1024) {
                err.textContent = 'Image too large. Max 1 MB.';
                input.value = '';
            }
        }

        function showToast(message, type) {
            type = type || 'success';
            var map = {
                success: { bg:'#22c55e', icon:'bi-check-circle-fill',        title:'Success' },
                error:   { bg:'#ef4444', icon:'bi-exclamation-triangle-fill', title:'Error'   },
                warning: { bg:'#f0a500', icon:'bi-exclamation-circle-fill',   title:'Warning' }
            };
            var m = map[type] || map.success;
            var id = 'nbt-' + Date.now();
            var html = '<div id="' + id + '" class="toast border-0 text-white" style="background:' + m.bg + ';border-radius:12px;box-shadow:0 4px 16px rgba(0,0,0,0.15);" role="alert" aria-atomic="true" data-bs-delay="4000">'
                + '<div class="toast-header border-0 text-white" style="background:transparent;">'
                + '<i class="bi ' + m.icon + ' me-2"></i><strong class="me-auto">' + m.title + '</strong>'
                + '<button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button></div>'
                + '<div class="toast-body" style="padding-top:0;">' + message + '</div></div>';
            var c = document.getElementById('nbToastContainer');
            c.insertAdjacentHTML('beforeend', html);
            var el = document.getElementById(id);
            new bootstrap.Toast(el).show();
            el.addEventListener('hidden.bs.toast', function() { el.remove(); });
        }

        $(function () {
            var $type             = $('#NationalityType');
            var $list             = $('#NationalityId');
            var $operatorInput    = $('#OperatorInput');
            var $operatorHidden   = $('#OperatorInputHidden');
            var $tourAreaInput    = $('#TourAreaInput');
            var $arrivalDateInput = $('#ArrivalDateInput');
            var $batchGuestsJson  = $('#BatchGuestsJson');
            var $saveBtn          = $('#saveBtn');
            var $totalCount       = $('#totalGuestsCount');
            var $currentBatch     = $('#CurrentBatch');

            var getNatUrl       = '@Url.Action("GetNationalities", "Guest")';
            var isReadonly      = '@((ViewBag.IsReadonly ?? false).ToString().ToLower())' === 'true';
            var operatorLocked  = '@((ViewBag.OperatorLocked ?? false).ToString().ToLower())' === 'true';

            // Server toast
            var $st = document.getElementById('guestToast');
            if ($st) new bootstrap.Toast($st).show();

            // Nationality options
            function updateNatOptions(choice) {
                $list.empty();
                var savedId = localStorage.getItem('selectedNationalityId');
                if (choice === 'Local') {
                    $list.append(new Option('Within Cebu Province',  '1'));
                    $list.append(new Option('Outside Cebu Province', '2'));
                    if (savedId === '1' || savedId === '2') $list.val(savedId);
                } else if (choice === 'Foreign') {
                    $list.append(new Option('Loading...', ''));
                    $.getJSON(getNatUrl).done(function(data) {
                        $list.empty();
                        data.forEach(function(item) { $list.append(new Option(item.natName, item.id)); });
                        setTimeout(function() { if (savedId) $list.val(savedId); }, 50);
                    }).fail(function() { $list.empty().append(new Option('Error loading', '')); });
                } else {
                    $list.append(new Option('-- Select --', ''));
                }
            }

            function lockInputs() {
                $operatorInput.prop('disabled', true);
                $tourAreaInput.prop('disabled', true);
                $currentBatch.prop('readonly', true);
                $arrivalDateInput.prop('readonly', false);
            }

            function updateCount(batch) {
                $totalCount.text(batch.length);
                $saveBtn.prop('disabled', batch.length < 1);
            }

            function prefillLast(guest) {
                if (!operatorLocked) $('[name="NewGuest.OperatorId"]').val(guest.OperatorId);
                $('[name="NewGuest.Fullname"]').val('');
                $('[name="NewGuest.Age"]').val('');
                $('[name="NewGuest.ContactNumber"]').val('');
                $('[name="NewGuest.Gender"]').val(guest.Gender);
                $('[name="NewGuest.NationalityType"]').val(guest.NationalityType).trigger('change');
                setTimeout(function() { $('[name="NewGuest.NationalityId"]').val(guest.NationalityId); }, 300);
                $('[name="NewGuest.Area"]').val(guest.Area);
                if (!$arrivalDateInput.val() && guest.ArrivalDate) {
                    var dt = new Date(guest.ArrivalDate);
                    if (!isNaN(dt.getTime())) $arrivalDateInput.val(dt.toLocaleString('sv-SE').slice(0, 16));
                }
            }

            // Init
            var savedType = localStorage.getItem('selectedNationalityType') || $type.val();
            $type.val(savedType);
            updateNatOptions(savedType);
            if (isReadonly) lockInputs();

            var guestsBatch = JSON.parse(localStorage.getItem('guestsBatch')) || [];
            if (guestsBatch.length > 0) { lockInputs(); updateCount(guestsBatch); prefillLast(guestsBatch[guestsBatch.length - 1]); }
            else updateCount(guestsBatch);

            $type.on('change', function() {
                var t = $(this).val();
                localStorage.setItem('selectedNationalityType', t);
                localStorage.removeItem('selectedNationalityId');
                updateNatOptions(t);
            });

            $list.on('change', function() { localStorage.setItem('selectedNationalityId', $(this).val()); });

            $arrivalDateInput.on('change', function() {
                if ($(this).val()) localStorage.setItem('initialArrivalDate', new Date($(this).val()).toISOString());
            });

            $operatorInput.on('change', function() {
                if ($operatorHidden.length) $operatorHidden.val($(this).val());
            });

            // Add Guest
            $('#addGuestBtn').on('click', function() {
                var arrivalVal = $arrivalDateInput.val();
                var opId = operatorLocked
                    ? parseInt($operatorHidden.val()) || null
                    : parseInt($operatorInput.val())  || null;

                var guest = {
                    OperatorId:      opId,
                    Fullname:        $('[name="NewGuest.Fullname"]').val().trim(),
                    Age:             $('[name="NewGuest.Age"]').val(),
                    Gender:          $('[name="NewGuest.Gender"]').val(),
                    ContactNumber:   $('[name="NewGuest.ContactNumber"]').val().trim(),
                    NationalityType: $('[name="NewGuest.NationalityType"]').val(),
                    NationalityId:   parseInt($('[name="NewGuest.NationalityId"]').val()) || null,
                    Area:            $('[name="NewGuest.Area"]').val(),
                    ArrivalDate:     arrivalVal ? new Date(arrivalVal).toISOString() : null
                };

                if (!guest.Fullname || !guest.OperatorId || !guest.Age || !guest.Gender ||
                    !guest.NationalityType || !guest.NationalityId || !guest.ArrivalDate || !guest.Area) {
                    showToast('Please fill in all required fields.', 'warning');
                    return;
                }

                guestsBatch.push(guest);
                localStorage.setItem('guestsBatch', JSON.stringify(guestsBatch));
                localStorage.setItem('selectedNationalityType', guest.NationalityType);
                localStorage.setItem('selectedNationalityId', guest.NationalityId.toString());

                updateCount(guestsBatch);
                lockInputs();
                prefillLast(guest);
                showToast('"' + guest.Fullname + '" added successfully!', 'success');
            });

            // Save
            $('#guestForm').on('submit', function() {
                $batchGuestsJson.val(JSON.stringify(guestsBatch));
                localStorage.removeItem('guestsBatch');
                localStorage.removeItem('selectedNationalityType');
                localStorage.removeItem('selectedNationalityId');
                localStorage.removeItem('initialArrivalDate');
            });
        });
    </script>
}