@model GuestListViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Guest Management";
    var batchDetails = ViewBag.BatchDetails ?? new { };
    var serializedBatch = JsonSerializer.Serialize(batchDetails);
    bool isReadonly = ViewBag.IsReadonly ?? false;
    bool operatorLocked = ViewBag.OperatorLocked ?? false;
}

<!-- Feedback Modal -->
<div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="feedbackModalLabel">Notification</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="modalMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Ok</button>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div class="overlay" id="loadingOverlay">
    <div class="spinner"></div>
    <div class="success-message" id="successMessage"></div>
</div>

<!-- Toast (server-side) -->
@if (TempData["ToastMessage"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080;">
        <div id="guestToast"
             class="toast text-white bg-success border-0"
             role="alert" aria-live="assertive" aria-atomic="true"
             data-bs-delay="4000">
            <div class="toast-header bg-success text-white border-0">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong class="me-auto">Success</strong>
                <small>Now</small>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">@TempData["ToastMessage"]</div>
        </div>
    </div>
}

<div class="card shadow-lg rounded-4 border-0">
    <div class="card-body p-4">
        <h4 class="text-primary mb-4 fw-semibold border-bottom pb-2 d-flex align-items-center">
            <i class="bi bi-person-plus-fill me-2"></i> Add New Guest
        </h4>

        <!-- Total Guests Counter -->
        <div class="mb-3">
            <h5 class="text-primary">
                <i class="fas fa-users me-2"></i>
                Total Guests: <span id="totalGuestsCount">0</span>
            </h5>
        </div>

        <!-- Main Form -->
        <form asp-action="NewBooking" method="post" id="guestForm"
              enctype="multipart/form-data" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" id="BatchGuestsJson" name="BatchGuestsJson" value="@Model.BatchGuestsJson" />
            <input type="hidden" id="CurrentBatch" name="batch" value="@ViewBag.CurrentBatch" readonly />
            <input type="hidden" id="MainGuestId" name="id" value="@ViewBag.MainGuestId" />

            <div class="row">

                <!-- ── Guest Info ─────────────────────────────────── -->
                <div class="col-md-6">
                    <fieldset>
                        <legend>Guest Info</legend>

                        <!-- OPERATOR DROPDOWN ─────────────────────── -->
                        <div class="mb-3">
                            <label asp-for="NewGuest.OperatorId" class="form-label">Operator</label>

                            @if (operatorLocked)
                            {
                                @* Operator role: read-only, grayed out, not clickable *@
                                <select asp-for="NewGuest.OperatorId"
                                        asp-items="ViewBag.OperatorList"
                                        class="form-select"
                                        id="OperatorInput"
                                        disabled="disabled"
                                        style="background-color:#f5f5f5;color:#555;cursor:not-allowed;">
                                </select>
                                @* Hidden input so value still submits when disabled *@
                                <input type="hidden"
                                       name="NewGuest.OperatorId"
                                       id="OperatorInputHidden"
                                       value="@Model.NewGuest.OperatorId" />
                                <small class="text-muted mt-1 d-block">
                                    <i class="bi bi-lock-fill me-1"></i>Assigned to your operator account
                                </small>
                            }
                            else
                            {
                                @* Admin / Super Admin: full editable dropdown *@
                                <select asp-for="NewGuest.OperatorId"
                                        asp-items="ViewBag.OperatorList"
                                        class="form-select"
                                        id="OperatorInput"
                                        disabled="@(isReadonly ? "disabled" : null)">
                                </select>
                            }
                        </div>
                        <!-- END OPERATOR DROPDOWN ─────────────────── -->

                        <div class="mb-3">
                            <label asp-for="NewGuest.Fullname" class="form-label">Full Name</label>
                            <input asp-for="NewGuest.Fullname"
                                   class="form-control"
                                   placeholder="e.g., Juan Dela Cruz"
                                   oninput="this.value = this.value.replace(/[^A-Za-z\s]/g, '')" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.Age" class="form-label">Age</label>
                            <input asp-for="NewGuest.Age"
                                   type="number"
                                   class="form-control"
                                   placeholder="e.g., 25"
                                   pattern="\d*"
                                   inputmode="numeric" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.Gender" class="form-label">Gender</label>
                            <select asp-for="NewGuest.Gender" class="form-select">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.ContactNumber" class="form-label">Mobile Number</label>
                            <input asp-for="NewGuest.ContactNumber"
                                   type="tel"
                                   class="form-control"
                                   placeholder="e.g., 09171234567"
                                   pattern="\d{11}"
                                   maxlength="11"
                                   inputmode="numeric"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                            <span asp-validation-for="NewGuest.ContactNumber" class="text-danger"></span>
                        </div>

                    </fieldset>
                </div>

                <!-- ── Nationality & Booking ───────────────────────── -->
                <div class="col-md-6">
                    <fieldset>
                        <legend>Nationality &amp; Booking</legend>

                        <div class="mb-3">
                            <label asp-for="NewGuest.NationalityType" class="form-label">Nationality Type</label>
                            <select asp-for="NewGuest.NationalityType" class="form-select" id="NationalityType">
                                <option value="Local">Local</option>
                                <option value="Foreign">Foreign</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.NationalityId" class="form-label">Nationality</label>
                            <select asp-for="NewGuest.NationalityId" class="form-select" id="NationalityId"></select>
                            <span asp-validation-for="NewGuest.NationalityId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.ArrivalDate" class="form-label">Arrival Date</label>
                            <input type="datetime-local"
                                   name="NewGuest.ArrivalDate"
                                   class="form-control"
                                   id="ArrivalDateInput"
                                   value="@Model.Html5ArrivalDate"
                                   readonly="@(isReadonly ? "readonly" : null)" />
                            <span asp-validation-for="NewGuest.ArrivalDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.Area" class="form-label">Tour Area</label>
                            <select asp-for="NewGuest.Area" class="form-select" id="TourAreaInput"
                                    disabled="@(isReadonly ? "disabled" : null)">
                                <option value="Wonder Falls">Wonder Falls</option>
                                <option value="Kanlaob">Kanlaob</option>
                                <option value="Kawasan Exit">Kawasan Exit</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="photoInput" class="form-label fw-semibold text-secondary">
                                Upload Guest Photo
                            </label>
                            <input type="file"
                                   name="Photo"
                                   id="photoInput"
                                   class="form-control"
                                   accept="image/jpeg,image/png,image/webp,image/jpg"
                                   capture="environment"
                                   onchange="validateImage(this)" />
                            <div id="fileError" class="text-danger small mt-1"></div>
                        </div>

                    </fieldset>
                </div>

            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-between mt-4">
                <button id="addGuestBtn" type="button" class="btn btn-primary">
                    <i class="bi bi-person-plus me-1"></i> Add Guest
                </button>
                <button type="submit" id="saveBtn" class="btn btn-success" disabled>
                    <i class="bi bi-save me-1"></i> Save All Guests
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        function validateImage(input) {
            const file = input.files[0];
            const errorDiv = document.getElementById("fileError");
            errorDiv.textContent = "";
            if (!file) return;
            const maxSizeMB = 1;
            const maxSizeBytes = maxSizeMB * 1024 * 1024;
            if (file.size > maxSizeBytes) {
                errorDiv.textContent = `The selected image is too large. Maximum allowed size is ${maxSizeMB}MB.`;
                input.value = "";
            }
        }

        $(function () {
            const $type             = $('#NationalityType');
            const $list             = $('#NationalityId');
            const $operatorInput    = $('#OperatorInput');
            const $operatorHidden   = $('#OperatorInputHidden');
            const $tourAreaInput    = $('#TourAreaInput');
            const $arrivalDateInput = $('#ArrivalDateInput');
            const $batchGuestsJson  = $('#BatchGuestsJson');
            const $saveBtn          = $('#saveBtn');
            const $totalGuestsCount = $('#totalGuestsCount');
            const $currentBatch     = $('#CurrentBatch');

            const getNationalitiesUrl = '@Url.Action("GetNationalities", "Guest")';
            const isReadonly          = '@((ViewBag.IsReadonly ?? false).ToString().ToLower())' === 'true';
            const operatorLocked      = '@((ViewBag.OperatorLocked ?? false).ToString().ToLower())' === 'true';

            // ── Show server-side toast on load ─────────────────────
            const $serverToast = document.getElementById('guestToast');
            if ($serverToast) new bootstrap.Toast($serverToast).show();

            // ── Nationality dropdown ────────────────────────────────
            function updateNationalityIdOptions(choice) {
                $list.empty();
                const savedId = localStorage.getItem('selectedNationalityId');

                if (choice === 'Local') {
                    $list.append(new Option('Within Cebu Province',  '1'));
                    $list.append(new Option('Outside Cebu Province', '2'));
                    if (savedId === '1' || savedId === '2') $list.val(savedId);

                } else if (choice === 'Foreign') {
                    $list.append(new Option('Loading...', ''));
                    $.getJSON(getNationalitiesUrl)
                        .done(function (data) {
                            $list.empty();
                            data.forEach(item => $list.append(new Option(item.natName, item.id)));
                            setTimeout(() => { if (savedId) $list.val(savedId); }, 50);
                        })
                        .fail(() => $list.empty().append(new Option('Error loading', '')));
                } else {
                    $list.append(new Option('-- Select --', ''));
                }
            }

            // ── Lock Operator & Tour Area (Arrival Date stays open) ─
            function lockInputs() {
                $operatorInput.prop('disabled', true)
                              .css({ 'background-color': '#f5f5f5', color: '#888' });
                $tourAreaInput.prop('disabled', true)
                              .css({ 'background-color': '#f5f5f5', color: '#888' });
                $currentBatch.prop('readonly', true)
                             .css({ 'background-color': '#f5f5f5', color: '#888' });
                // Always keep arrival date editable
                $arrivalDateInput.prop('readonly', false).css({ 'background-color': '', color: '' });
            }

            // ── Sync hidden input when operator select changes ──────
            // (only needed when NOT locked — locked already has hidden input set server-side)
            $operatorInput.on('change', function () {
                if ($operatorHidden.length) $operatorHidden.val($(this).val());
            });

            // ── Guest count display ─────────────────────────────────
            function updateTotalGuestsDisplay(batch) {
                $totalGuestsCount.text(batch.length);
                $saveBtn.prop('disabled', batch.length < 1);
            }

            // ── Prefill form from last guest ────────────────────────
            function prefillLastGuest(guest) {
                // Operator
                if (!operatorLocked) {
                    $('[name="NewGuest.OperatorId"]').val(guest.OperatorId);
                }
                // Clear personal fields
                $('[name="NewGuest.Fullname"]').val('');
                $('[name="NewGuest.Age"]').val('');
                $('[name="NewGuest.ContactNumber"]').val('');
                // Keep shared fields
                $('[name="NewGuest.Gender"]').val(guest.Gender);
                $('[name="NewGuest.NationalityType"]').val(guest.NationalityType).trigger('change');
                setTimeout(() => $('[name="NewGuest.NationalityId"]').val(guest.NationalityId), 300);
                $('[name="NewGuest.Area"]').val(guest.Area);
                // Only set arrival date if currently empty
                if (!$arrivalDateInput.val() && guest.ArrivalDate) {
                    const dt = new Date(guest.ArrivalDate);
                    if (!isNaN(dt.getTime()))
                        $arrivalDateInput.val(dt.toLocaleString('sv-SE').slice(0, 16));
                }
            }

            // ── Toast helper (client-side) ──────────────────────────
            function showToast(message) {
                const container = $('<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080;"></div>');
                const toast = $(`
                    <div class="toast text-white bg-success border-0"
                         role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000">
                        <div class="toast-header bg-success text-white border-0">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <strong class="me-auto">Success</strong>
                            <small>Now</small>
                            <button type="button" class="btn-close btn-close-white"
                                    data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                        <div class="toast-body">${message}</div>
                    </div>`);
                container.append(toast);
                $('body').append(container);
                new bootstrap.Toast(toast[0]).show();
                toast.on('hidden.bs.toast', () => container.remove());
            }

            // ── Init ────────────────────────────────────────────────
            const savedType = localStorage.getItem('selectedNationalityType') || $type.val();
            $type.val(savedType);
            updateNationalityIdOptions(savedType);

            if (isReadonly) lockInputs();

            let guestsBatch = JSON.parse(localStorage.getItem('guestsBatch')) || [];

            if (guestsBatch.length > 0) {
                lockInputs();
                updateTotalGuestsDisplay(guestsBatch);
                prefillLastGuest(guestsBatch[guestsBatch.length - 1]);
            } else {
                updateTotalGuestsDisplay(guestsBatch);
            }

            // ── Nationality type change ─────────────────────────────
            $type.on('change', function () {
                const t = $(this).val();
                localStorage.setItem('selectedNationalityType', t);
                localStorage.removeItem('selectedNationalityId');
                updateNationalityIdOptions(t);
            });

            $list.on('change', function () {
                localStorage.setItem('selectedNationalityId', $(this).val());
            });

            // ── Arrival date change ─────────────────────────────────
            $arrivalDateInput.on('change', function () {
                const val = $(this).val();
                if (val) localStorage.setItem('initialArrivalDate', new Date(val).toISOString());
            });

            // ── Add Guest ───────────────────────────────────────────
            $('#addGuestBtn').on('click', function () {
                const arrivalVal = $arrivalDateInput.val();

                // Get operator ID — prefer hidden input if locked
                const opId = operatorLocked
                    ? parseInt($operatorHidden.val()) || null
                    : parseInt($operatorInput.val())  || null;

                const guest = {
                    OperatorId:      opId,
                    Fullname:        $('[name="NewGuest.Fullname"]').val().trim(),
                    Age:             $('[name="NewGuest.Age"]').val(),
                    Gender:          $('[name="NewGuest.Gender"]').val(),
                    ContactNumber:   $('[name="NewGuest.ContactNumber"]').val().trim(),
                    NationalityType: $('[name="NewGuest.NationalityType"]').val(),
                    NationalityId:   parseInt($('[name="NewGuest.NationalityId"]').val()) || null,
                    Area:            $('[name="NewGuest.Area"]').val(),
                    ArrivalDate:     arrivalVal ? new Date(arrivalVal).toISOString() : null
                };

                if (!guest.Fullname || !guest.OperatorId || !guest.Age || !guest.Gender ||
                    !guest.NationalityType || !guest.NationalityId || !guest.ArrivalDate || !guest.Area) {
                    alert('Please fill in all required fields.');
                    return;
                }

                guestsBatch.push(guest);
                localStorage.setItem('guestsBatch', JSON.stringify(guestsBatch));
                localStorage.setItem('selectedNationalityType', guest.NationalityType);
                localStorage.setItem('selectedNationalityId', guest.NationalityId.toString());

                updateTotalGuestsDisplay(guestsBatch);
                lockInputs();
                prefillLastGuest(guest);
                showToast(`Guest "${guest.Fullname}" added successfully!`);
            });

            // ── Form Submit ─────────────────────────────────────────
            $('#guestForm').on('submit', function () {
                $batchGuestsJson.val(JSON.stringify(guestsBatch));
                localStorage.removeItem('guestsBatch');
                localStorage.removeItem('selectedNationalityType');
                localStorage.removeItem('selectedNationalityId');
                localStorage.removeItem('initialArrivalDate');
            });

            // Hide loading overlay
            $('#loadingOverlay').fadeOut(300);
        });
    </script>
}
