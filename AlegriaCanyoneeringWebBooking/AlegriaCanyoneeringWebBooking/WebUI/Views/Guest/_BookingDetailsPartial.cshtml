@using AlegriaCanyoneeringWebBooking.Models
@model GuestDetailsViewModel

@{
    var allGuests = new List<Guest>();
    if (Model.Guest != null) allGuests.Add(Model.Guest);
    if (Model.GuestsInBatch != null)
        allGuests.AddRange(Model.GuestsInBatch.Where(g => g.BookingStatus != 1));
}

@Html.AntiForgeryToken()

@{
    string FormatArrivalDate(string unixTimestamp)
    {
        if (string.IsNullOrEmpty(unixTimestamp)) return "N/A";
        if (long.TryParse(unixTimestamp, out var unix))
        {
            var dateTime = DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime();
            return dateTime.ToString("MMMM dd, yyyy hh:mm tt");
        }
        return unixTimestamp;
    }
}

<div class="container py-5">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Guest List</h5>

            @if (!User.IsInRole("Admin"))
            {
                <a asp-controller="Guest"
                   asp-action="NewBooking"
                   asp-route-batch="@Model.Guest.Batch"
                   asp-route-id="@Model.Guest.Id"
                   class="btn btn-primary rounded-pill d-flex align-items-center gap-2">
                    <i class="fas fa-user-plus"></i> Add Guest
                </a>
            }
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="companionsTable" class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 70px;">Action</th>
                            <th>Full Name</th>
                            <th>Age</th>
                            <th>Gender</th>
                            <th>Nationality</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="guestTableBody">
                        @foreach (var guest in allGuests)
                        {
                            <tr data-guest-row="@guest.Id" class="@(guest.Id == Model.Guest.Id ? "table-primary" : "")">
                                <td class="text-center">
                                    @if (!User.IsInRole("Admin"))
                                    {
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm rounded-circle cancel-btn"
                                                data-guest-id="@guest.Id"
                                                title="Cancel this guest">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </td>
                                <td>@guest.Fullname</td>
                                <td>@guest.Age</td>
                                <td>@guest.Gender</td>
                                <td>@(guest.NationalityEntity?.NatName ?? "N/A")</td>
                                <td>
                                    <span class="badge @(guest.Id == Model.Guest.Id ? "badge-primary" : "badge-info") text-capitalize px-3 py-2 rounded-pill">
                                        @(guest.Id == Model.Guest.Id ? "Primary ✦" : "Companion")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<style>
    #companionsTable {
        border-radius: 0.5rem;
        overflow: hidden;
    }

        #companionsTable tbody tr:hover {
            background-color: #f2f7ff;
        }

        #companionsTable thead {
            background-color: #f8f9fa;
            font-weight: 600;
        }

    .badge-primary {
        background-color: #0d6efd;
        color: #fff;
    }

    .badge-info {
        background-color: #cfe2ff;
        color: #0d6efd;
    }

    .cancel-btn:hover {
        background-color: #dc3545;
        color: #fff;
        transition: 0.2s;
        cursor: pointer;
    }

    @@media (max-width: 576px) {
        #companionsTable td:nth-child(3), #companionsTable th:nth-child(3)

    {
        display: none;
    }

    }
</style>

    <script>
        $(document).ready(function () {
            // Initialize DataTable for the companion list
            $('#companionsTable').DataTable({
                responsive: true,
                pageLength: 5,
                lengthMenu: [5, 10, 25],
                columnDefs: [{ orderable: false, targets: 0 }],  // Disable sorting for the first column (Actions)
                language: { searchPlaceholder: "Search guest...", search: "" }
            });

            // Handle cancel button click event
            $('.cancel-btn').off('click').on('click', function () {
                // Confirm the action
                if (!confirm("Are you sure you want to cancel this guest?")) return;

                // Get the guest ID and CSRF token
                var guestId = $(this).data('guest-id');
                var token = $('input[name="__RequestVerificationToken"]').val();

                // Send AJAX request to cancel the guest
                $.ajax({
                    url: '/Guest/CancelGuest',
                    type: 'POST',
                    data: { GuestId: guestId, __RequestVerificationToken: token },
                    success: function (result) {
                        if (result.success) {
                            // Remove the guest row from the table
                            $('tr[data-guest-row="' + guestId + '"]').remove();

                            // Reload the guest list partial view with updated data
                            $('#guestTableBody').load('@Url.Action("GetUpdatedGuestList", "Guest")', function () {
                                alert("Guest cancelled successfully.");
                            });
                        } else {
                            alert(result.message || "Failed to cancel guest.");
                        }
                    },
                    error: function (xhr) {
                        // Handle any errors
                        console.error(xhr.responseText);
                        alert("An error occurred while cancelling the guest.");
                    }
                });
            });
        });
    </script>
