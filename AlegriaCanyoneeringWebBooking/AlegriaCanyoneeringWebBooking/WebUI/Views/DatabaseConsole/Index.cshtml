<!-- Toast Container -->
<div id="pmaToast" class="bg-dark text-white">
    <i class="bi bi-info-circle-fill text-info" id="pmaToastIcon"></i>
    <span id="pmaToastMsg">Notification</span>
</div>

<script>
    // =========================================================================
    // STATE
    // =========================================================================
    let currentTable = 'guest';
    let currentColumns = [];
    let currentPrimaryKey = 'id';
    let lastQueryResults = null;
    let browsePage = 1;
    let browsePageSize = 25;
    let browseTotalPages = 1;
    let selectedColIndex = -1;

    const AUTO_SAVE_KEY = 'pma_saved_query_' + window.location.host;

    // =========================================================================
    // INITIALIZATION
    // =========================================================================
    document.addEventListener('DOMContentLoaded', async () => {
        updateGutter();
        await loadTablesList();
        await loadTableColumns(currentTable);
        checkAutoSavedQueryNotice();
    });

    // =========================================================================
    // TAB SWITCHER
    // =========================================================================
    function switchTab(tabName) {
        const tabs = ['browse', 'structure', 'sql', 'search', 'insert', 'export', 'import', 'operations', 'triggers'];
        tabs.forEach(t => {
            const tabBtn = document.getElementById('tab' + capitalize(t));
            const viewDiv = document.getElementById('view' + capitalize(t));
            if (tabBtn) tabBtn.classList.remove('active');
            if (viewDiv) viewDiv.style.display = 'none';
        });

        const activeBtn = document.getElementById('tab' + capitalize(tabName));
        const activeView = document.getElementById('view' + capitalize(tabName));
        if (activeBtn) activeBtn.classList.add('active');
        if (activeView) activeView.style.display = 'block';

        if (tabName === 'browse') {
            loadBrowseData(1);
        } else if (tabName === 'structure') {
            loadStructureTab();
        } else if (tabName === 'insert') {
            renderDirectInsertTab();
        } else if (tabName === 'search') {
            renderSearchTab();
        }
    }

    function capitalize(s) {
        return s.charAt(0).toUpperCase() + s.slice(1);
    }

    // =========================================================================
    // TABLE MANAGEMENT
    // =========================================================================
    async function loadTablesList() {
        try {
            const res = await fetch('/DatabaseConsole/GetTables');
            const data = await res.json();
            if (data.success && data.tables) {
                const select = document.getElementById('tableSelect');
                select.innerHTML = '';
                data.tables.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.name;
                    opt.textContent = `${t.name} (${t.rowCount})`;
                    if (t.name.toLowerCase() === currentTable.toLowerCase()) {
                        opt.selected = true;
                    }
                    select.appendChild(opt);
                });
            }
        } catch (err) {
            console.error('Error fetching tables list:', err);
        }
    }

    async function onTableChanged() {
        const select = document.getElementById('tableSelect');
        currentTable = select.value;
        document.getElementById('currentTableLabel').textContent = currentTable;
        document.getElementById('sqlHeaderTable').textContent = `tsujkcilc_canyoneeringdb.${currentTable}`;
        document.querySelectorAll('.current-table-name').forEach(el => el.textContent = currentTable);

        // Update default query in textarea
        document.getElementById('sqlTextarea').value = `SELECT * FROM \`${currentTable}\` WHERE 1`;
        updateGutter();

        await loadTableColumns(currentTable);

        // If on browse or structure tab, refresh it
        const currentActive = document.querySelector('.pma-tab.active')?.id;
        if (currentActive === 'tabBrowse') loadBrowseData(1);
        else if (currentActive === 'tabStructure') loadStructureTab();
        else if (currentActive === 'tabInsert') renderDirectInsertTab();
    }

    async function loadTableColumns(tableName) {
        try {
            const res = await fetch(`/DatabaseConsole/GetColumns?tableName=${encodeURIComponent(tableName)}`);
            const data = await res.json();
            if (data.success && data.columns) {
                currentColumns = data.columns;
                const pkCol = currentColumns.find(c => c.isPrimaryKey);
                currentPrimaryKey = pkCol ? pkCol.name : (currentColumns[0]?.name || 'id');

                renderColumnsList(currentColumns);
                document.getElementById('columnCount').textContent = currentColumns.length;
            }
        } catch (err) {
            console.error('Error loading columns:', err);
        }
    }

    function renderColumnsList(columns) {
        const list = document.getElementById('columnList');
        list.innerHTML = '';
        columns.forEach((col, idx) => {
            const li = document.createElement('li');
            li.textContent = col.name;
            li.title = `${col.name} (${col.type})${col.isPrimaryKey ? ' [PRI KEY]' : ''}`;
            if (col.isPrimaryKey) {
                li.style.fontWeight = 'bold';
                li.style.color = '#1d4ed8';
            }
            li.onclick = () => selectColumnItem(idx);
            li.ondblclick = () => insertColumnToEditor(col.name);
            list.appendChild(li);
        });
    }

    function filterColumns() {
        const query = document.getElementById('columnFilter').value.toLowerCase();
        const filtered = currentColumns.filter(c => c.name.toLowerCase().includes(query));
        renderColumnsList(filtered);
    }

    function selectColumnItem(idx) {
        selectedColIndex = idx;
        const items = document.querySelectorAll('#columnList li');
        items.forEach((it, i) => {
            if (i === idx) it.classList.add('selected');
            else it.classList.remove('selected');
        });
    }

    function insertSelectedColumn() {
        const items = document.querySelectorAll('#columnList li');
        const selected = document.querySelector('#columnList li.selected');
        if (selected) {
            insertColumnToEditor(selected.textContent.trim());
        } else if (items.length > 0) {
            insertColumnToEditor(items[0].textContent.trim());
        }
    }

    function insertColumnToEditor(colName) {
        const textarea = document.getElementById('sqlTextarea');
        const start = textarea.selectionStart;
        const end = textarea.selectionEnd;
        const text = textarea.value;
        const insertText = `\`${colName}\``;

        textarea.value = text.substring(0, start) + insertText + text.substring(end);
        textarea.selectionStart = textarea.selectionEnd = start + insertText.length;
        textarea.focus();
        onSqlInput();
    }

    // =========================================================================
    // SQL EDITOR & GUTTER
    // =========================================================================
    function onSqlInput() {
        updateGutter();
        saveQueryToLocalStorage();
    }

    function onSqlKeyDown(e) {
        // Ctrl + Enter executes query
        if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
            e.preventDefault();
            executeSql();
            return;
        }

        // Tab indents
        if (e.key === 'Tab') {
            e.preventDefault();
            const textarea = e.target;
            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            textarea.value = textarea.value.substring(0, start) + '    ' + textarea.value.substring(end);
            textarea.selectionStart = textarea.selectionEnd = start + 4;
            updateGutter();
        }
    }

    function updateGutter() {
        const textarea = document.getElementById('sqlTextarea');
        const lines = (textarea.value.match(/\n/g) || []).length + 1;
        let gutterText = '';
        for (let i = 1; i <= lines; i++) {
            gutterText += i + '\n';
        }
        document.getElementById('sqlGutter').innerText = gutterText;
    }

    // =========================================================================
    // QUERY SNIPPETS
    // =========================================================================
    function snippetSelectAll() {
        document.getElementById('sqlTextarea').value = `SELECT * FROM \`${currentTable}\` WHERE 1`;
        onSqlInput();
    }

    function snippetSelectCols() {
        const colList = currentColumns.map(c => `\`${c.name}\``).join(', ');
        document.getElementById('sqlTextarea').value = `SELECT ${colList} FROM \`${currentTable}\` WHERE 1`;
        onSqlInput();
    }

    function snippetInsert() {
        const cols = currentColumns.filter(c => !c.extra.includes('auto_increment')).map(c => `\`${c.name}\``);
        const vals = cols.map(() => "''");
        document.getElementById('sqlTextarea').value = `INSERT INTO \`${currentTable}\` (${cols.join(', ')}) VALUES (${vals.join(', ')})`;
        onSqlInput();
    }

    function snippetUpdate() {
        const sets = currentColumns.filter(c => !c.isPrimaryKey).slice(0, 3).map(c => `\`${c.name}\` = ''`).join(', ');
        document.getElementById('sqlTextarea').value = `UPDATE \`${currentTable}\` SET ${sets} WHERE \`${currentPrimaryKey}\` = 1`;
        onSqlInput();
    }

    function snippetDelete() {
        document.getElementById('sqlTextarea').value = `DELETE FROM \`${currentTable}\` WHERE \`${currentPrimaryKey}\` = 1`;
        onSqlInput();
    }

    function clearSql() {
        document.getElementById('sqlTextarea').value = '';
        onSqlInput();
        document.getElementById('sqlTextarea').focus();
    }

    function formatSql() {
        let sql = document.getElementById('sqlTextarea').value;
        const keywords = ['SELECT', 'FROM', 'WHERE', 'ORDER BY', 'GROUP BY', 'LIMIT', 'OFFSET', 'INSERT INTO', 'VALUES', 'UPDATE', 'SET', 'DELETE FROM', 'JOIN', 'LEFT JOIN', 'INNER JOIN', 'AND', 'OR'];
        keywords.forEach(kw => {
            const regex = new RegExp('\\b' + kw + '\\b', 'gi');
            sql = sql.replace(regex, kw);
        });
        document.getElementById('sqlTextarea').value = sql;
        onSqlInput();
    }

    // =========================================================================
    // AUTO-SAVE FUNCTIONALITY
    // =========================================================================
    function saveQueryToLocalStorage() {
        const sql = document.getElementById('sqlTextarea').value;
        if (sql && sql.trim() !== '') {
            localStorage.setItem(AUTO_SAVE_KEY, sql);
        }
    }

    function checkAutoSavedQueryNotice() {
        const saved = localStorage.getItem(AUTO_SAVE_KEY);
        const notice = document.getElementById('autoSaveAlert');
        if (saved && saved.trim() !== document.getElementById('sqlTextarea').value.trim()) {
            notice.style.display = 'block';
        } else {
            notice.style.display = 'none';
        }
    }

    function getAutoSavedQuery() {
        const saved = localStorage.getItem(AUTO_SAVE_KEY);
        if (saved) {
            document.getElementById('sqlTextarea').value = saved;
            onSqlInput();
            showToast('Auto-saved query loaded.', 'info');
        }
        dismissAutoSaveNotice();
    }

    function dismissAutoSaveNotice() {
        document.getElementById('autoSaveAlert').style.display = 'none';
    }

    // =========================================================================
    // EXECUTE SQL QUERY
    // =========================================================================
    async function executeSql() {
        const sql = document.getElementById('sqlTextarea').value.trim();
        if (!sql) {
            showToast('Please enter a SQL query.', 'warning');
            return;
        }

        const btn = document.getElementById('btnExecuteSql');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Running...';

        try {
            const res = await fetch('/DatabaseConsole/ExecuteSql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sql: sql })
            });

            const data = await res.json();
            const banner = document.getElementById('sqlStatusBanner');
            const resultsArea = document.getElementById('sqlResultsArea');

            banner.style.display = 'block';

            if (data.success) {
                banner.className = 'pma-status-banner pma-status-success';
                banner.innerHTML = `
                    <i class="bi bi-check-circle-fill fs-5 mt-1"></i>
                    <div>
                        <strong>${data.message || 'Query executed successfully.'}</strong>
                        <div class="pma-status-sql">${escapeHtml(data.sql)}</div>
                    </div>
                `;

                if (data.isQuery && data.columns && data.rows) {
                    lastQueryResults = data;
                    resultsArea.style.display = 'block';
                    renderQueryResultsTable(data.columns, data.rows);
                    document.getElementById('sqlResultCount').textContent = `Showing ${data.rows.length} rows (total ${data.totalRows})`;
                } else {
                    resultsArea.style.display = 'none';
                    // If non-query updated database, refresh table counts
                    loadTablesList();
                }
            } else {
                banner.className = 'pma-status-banner pma-status-error';
                banner.innerHTML = `
                    <i class="bi bi-x-circle-fill fs-5 mt-1"></i>
                    <div>
                        <strong>Execution Error:</strong> ${escapeHtml(data.error || 'Unknown SQL error')}
                        <div class="pma-status-sql">${escapeHtml(data.sql)}</div>
                    </div>
                `;
                resultsArea.style.display = 'none';
            }
        } catch (err) {
            console.error('Execute query error:', err);
            showToast('Network error while executing query.', 'danger');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-play-fill me-1"></i> Go';
        }
    }

    // =========================================================================
    // RENDER QUERY RESULTS (WITH DIRECT EDIT & DELETE ACTIONS)
    // =========================================================================
    function renderQueryResultsTable(columns, rows) {
        const thead = document.getElementById('sqlResultsHead');
        const tbody = document.getElementById('sqlResultsBody');

        // Header
        let thHtml = '<tr><th style="width:36px;"><input type="checkbox" id="chkAllResults" onchange="toggleSelectAllRows(this.checked)"></th>';
        thHtml += '<th style="width:130px;">Action</th>';
        columns.forEach(col => {
            thHtml += `<th>${escapeHtml(col)}</th>`;
        });
        thHtml += '</tr>';
        thead.innerHTML = thHtml;

        // Body
        if (rows.length === 0) {
            tbody.innerHTML = `<tr><td colspan="${columns.length + 2}" class="text-center py-4 text-muted">MySQL returned an empty result set (i.e. zero rows).</td></tr>`;
            return;
        }

        let tbHtml = '';
        rows.forEach((row, rIdx) => {
            const pkVal = row[currentPrimaryKey] || row['id'] || Object.values(row)[0];

            tbHtml += `<tr>`;
            tbHtml += `<td><input type="checkbox" class="chk-result-row" data-pk="${escapeHtml(pkVal)}"></td>`;
            tbHtml += `
                <td>
                    <div class="pma-row-actions">
                        <button type="button" class="btn-row-action btn-row-edit" onclick="openDirectEditModal('${escapeHtml(currentPrimaryKey)}', '${escapeHtml(pkVal)}')">
                            <i class="bi bi-pencil-fill"></i> Edit
                        </button>
                        <button type="button" class="btn-row-action btn-row-copy" onclick="openDirectCopyModal(${rIdx})">
                            <i class="bi bi-clipboard-plus"></i> Copy
                        </button>
                        <button type="button" class="btn-row-action btn-row-delete" onclick="promptDirectDelete('${escapeHtml(currentPrimaryKey)}', '${escapeHtml(pkVal)}')">
                            <i class="bi bi-trash-fill"></i> Delete
                        </button>
                    </div>
                </td>
            `;

            columns.forEach(col => {
                const val = row[col];
                if (val === null || val === undefined) {
                    tbHtml += `<td><span class="pma-null-val">NULL</span></td>`;
                } else {
                    tbHtml += `<td>${escapeHtml(val)}</td>`;
                }
            });
            tbHtml += `</tr>`;
        });

        tbody.innerHTML = tbHtml;
    }

    // =========================================================================
    // DIRECT EDIT ACTIONS
    // =========================================================================
    async function openDirectEditModal(pkCol, pkVal) {
        document.getElementById('editPkColumn').value = pkCol;
        document.getElementById('editPkValue').value = pkVal;
        document.getElementById('editModalPkDisplay').textContent = `${pkCol} = ${pkVal}`;

        const container = document.getElementById('editFieldsContainer');
        container.innerHTML = '<div class="text-center py-3"><span class="spinner-border spinner-border-sm me-2"></span>Loading record data...</div>';

        const modalEl = document.getElementById('directEditModal');
        const modal = new bootstrap.Modal(modalEl);
        modal.show();

        try {
            const res = await fetch(`/DatabaseConsole/GetRecord?tableName=${encodeURIComponent(currentTable)}&pkColumn=${encodeURIComponent(pkCol)}&pkValue=${encodeURIComponent(pkVal)}`);
            const json = await res.json();

            if (json.success && json.data) {
                renderEditFields(json.data);
            } else {
                container.innerHTML = `<div class="alert alert-danger">${json.error || 'Failed to load record.'}</div>`;
            }
        } catch (err) {
            container.innerHTML = `<div class="alert alert-danger">Error: ${err.message}</div>`;
        }
    }

    function renderEditFields(data) {
        const container = document.getElementById('editFieldsContainer');
        container.innerHTML = '';

        currentColumns.forEach(col => {
            const val = data[col.name] !== undefined && data[col.name] !== null ? data[col.name] : '';
            const isPk = col.isPrimaryKey;

            const colDiv = document.createElement('div');
            colDiv.className = 'col-md-6 mb-2';
            colDiv.innerHTML = `
                <label class="form-label mb-1" style="font-size:12px; font-weight:600; color:#1e293b;">
                    ${escapeHtml(col.name)}
                    <span class="text-muted fw-normal">(${escapeHtml(col.type)})</span>
                    ${isPk ? '<span class="badge bg-primary ms-1">PK</span>' : ''}
                </label>
                <input type="text" class="form-control form-control-sm edit-field-input"
                       data-col="${escapeHtml(col.name)}"
                       value="${escapeHtml(val)}"
                       ${isPk ? 'readonly style="background:#f1f5f9;"' : ''}>
            `;
            container.appendChild(colDiv);
        });
    }

    async function saveDirectEdit() {
        const pkCol = document.getElementById('editPkColumn').value;
        const pkVal = document.getElementById('editPkValue').value;

        const updateData = {};
        document.querySelectorAll('.edit-field-input').forEach(inp => {
            const col = inp.dataset.col;
            updateData[col] = inp.value;
        });

        try {
            const res = await fetch('/DatabaseConsole/DirectUpdate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    tableName: currentTable,
                    primaryKeyColumn: pkCol,
                    primaryKeyValue: pkVal,
                    data: updateData
                })
            });

            const result = await res.json();
            if (result.success) {
                showToast(result.message, 'success');
                bootstrap.Modal.getInstance(document.getElementById('directEditModal')).hide();

                // Refresh active view
                if (document.getElementById('sqlResultsArea').style.display !== 'none') {
                    executeSql();
                } else {
                    loadBrowseData(browsePage);
                }
            } else {
                showToast('Update failed: ' + result.error, 'danger');
            }
        } catch (err) {
            showToast('Error saving record: ' + err.message, 'danger');
        }
    }

    // =========================================================================
    // DIRECT DELETE ACTIONS
    // =========================================================================
    function promptDirectDelete(pkCol, pkVal) {
        document.getElementById('confirmDeleteSqlText').textContent = `DELETE FROM \`${currentTable}\` WHERE \`${pkCol}\` = '${pkVal}' LIMIT 1;`;

        const btn = document.getElementById('btnConfirmDeleteAction');
        btn.onclick = async () => {
            await executeDirectDelete(pkCol, pkVal);
        };

        const modal = new bootstrap.Modal(document.getElementById('confirmDeleteModal'));
        modal.show();
    }

    async function executeDirectDelete(pkCol, pkVal) {
        try {
            const res = await fetch('/DatabaseConsole/DirectDelete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    tableName: currentTable,
                    primaryKeyColumn: pkCol,
                    primaryKeyValue: pkVal
                })
            });

            const result = await res.json();
            bootstrap.Modal.getInstance(document.getElementById('confirmDeleteModal')).hide();

            if (result.success) {
                showToast(result.message, 'success');
                // Refresh
                if (document.getElementById('sqlResultsArea').style.display !== 'none') {
                    executeSql();
                } else {
                    loadBrowseData(browsePage);
                }
                loadTablesList();
            } else {
                showToast('Delete failed: ' + result.error, 'danger');
            }
        } catch (err) {
            showToast('Error deleting row: ' + err.message, 'danger');
        }
    }

    // =========================================================================
    // DIRECT INSERT MODAL
    // =========================================================================
    function openDirectInsertModal() {
        const container = document.getElementById('insertModalFieldsContainer');
        container.innerHTML = '';

        currentColumns.forEach(col => {
            const isAutoInc = col.extra.includes('auto_increment');
            const colDiv = document.createElement('div');
            colDiv.className = 'col-md-6 mb-2';
            colDiv.innerHTML = `
                <label class="form-label mb-1" style="font-size:12px; font-weight:600; color:#1e293b;">
                    ${escapeHtml(col.name)}
                    <span class="text-muted fw-normal">(${escapeHtml(col.type)})</span>
                    ${isAutoInc ? '<span class="badge bg-secondary ms-1">AUTO_INCREMENT</span>' : ''}
                </label>
                <input type="text" class="form-control form-control-sm modal-insert-input"
                       data-col="${escapeHtml(col.name)}"
                       placeholder="${isAutoInc ? '(Auto Generated)' : (col.defaultValue || '')}"
                       ${isAutoInc ? 'disabled style="background:#f1f5f9;"' : ''}>
            `;
            container.appendChild(colDiv);
        });

        const modal = new bootstrap.Modal(document.getElementById('directInsertModal'));
        modal.show();
    }

    async function saveDirectInsertModal() {
        const insertData = {};
        document.querySelectorAll('.modal-insert-input:not([disabled])').forEach(inp => {
            const col = inp.dataset.col;
            if (inp.value !== '') {
                insertData[col] = inp.value;
            }
        });

        try {
            const res = await fetch('/DatabaseConsole/DirectInsert', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    tableName: currentTable,
                    data: insertData
                })
            });

            const result = await res.json();
            if (result.success) {
                showToast(result.message, 'success');
                bootstrap.Modal.getInstance(document.getElementById('directInsertModal')).hide();

                if (document.getElementById('sqlResultsArea').style.display !== 'none') {
                    executeSql();
                } else {
                    loadBrowseData(1);
                }
                loadTablesList();
            } else {
                showToast('Insert failed: ' + result.error, 'danger');
            }
        } catch (err) {
            showToast('Error inserting record: ' + err.message, 'danger');
        }
    }

    function openDirectCopyModal(rowIdx) {
        if (!lastQueryResults || !lastQueryResults.rows[rowIdx]) return;
        const row = lastQueryResults.rows[rowIdx];

        openDirectInsertModal();
        setTimeout(() => {
            document.querySelectorAll('.modal-insert-input:not([disabled])').forEach(inp => {
                const col = inp.dataset.col;
                if (row[col] !== undefined && row[col] !== null) {
                    inp.value = row[col];
                }
            });
        }, 150);
    }

    // =========================================================================
    // DIRECT INSERT TAB (FULL TAB)
    // =========================================================================
    function renderDirectInsertTab() {
        const tbody = document.getElementById('directInsertTabBody');
        tbody.innerHTML = '';

        currentColumns.forEach(col => {
            const isAutoInc = col.extra.includes('auto_increment');
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="fw-semibold text-dark">${escapeHtml(col.name)}</td>
                <td class="text-muted">${escapeHtml(col.type)}</td>
                <td class="text-center">${col.isNullable ? '<input type="checkbox" class="chk-insert-null" data-col="' + escapeHtml(col.name) + '">' : ''}</td>
                <td>
                    <input type="text" class="pma-insert-input tab-insert-input"
                           data-col="${escapeHtml(col.name)}"
                           placeholder="${isAutoInc ? '(Auto Generated)' : (col.defaultValue || '')}"
                           ${isAutoInc ? 'disabled style="background:#f1f5f9;"' : ''}>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    async function submitDirectInsertTab(e) {
        e.preventDefault();
        const insertData = {};

        document.querySelectorAll('.tab-insert-input:not([disabled])').forEach(inp => {
            const col = inp.dataset.col;
            const nullChk = document.querySelector(`.chk-insert-null[data-col="${col}"]`);
            if (nullChk && nullChk.checked) {
                insertData[col] = null;
            } else if (inp.value !== '') {
                insertData[col] = inp.value;
            }
        });

        try {
            const res = await fetch('/DatabaseConsole/DirectInsert', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    tableName: currentTable,
                    data: insertData
                })
            });

            const result = await res.json();
            if (result.success) {
                showToast(result.message, 'success');
                loadTablesList();
                switchTab('browse');
            } else {
                showToast('Insert failed: ' + result.error, 'danger');
            }
        } catch (err) {
            showToast('Error inserting row: ' + err.message, 'danger');
        }
    }

    function resetInsertForm() {
        renderDirectInsertTab();
    }

    // =========================================================================
    // BROWSE TAB ACTIONS
    // =========================================================================
    async function loadBrowseData(page) {
        browsePage = page || 1;
        browsePageSize = parseInt(document.getElementById('browsePageSize').value) || 25;
        const search = document.getElementById('browseSearchInput')?.value || '';

        const tbody = document.getElementById('browseTableBody');
        tbody.innerHTML = `<tr><td colspan="20" class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading data...</td></tr>`;

        try {
            const url = `/DatabaseConsole/BrowseTable?tableName=${encodeURIComponent(currentTable)}&page=${browsePage}&pageSize=${browsePageSize}&search=${encodeURIComponent(search)}`;
            const res = await fetch(url);
            const data = await res.json();

            if (data.success) {
                browseTotalPages = data.totalPages || 1;
                renderBrowseTable(data);
                document.getElementById('browsePageIndicator').textContent = `Page ${data.page} of ${browseTotalPages}`;
                const startRec = data.totalRecords > 0 ? (data.page - 1) * data.pageSize + 1 : 0;
                const endRec = Math.min(data.page * data.pageSize, data.totalRecords);
                document.getElementById('browsePaginationInfo').textContent = `Showing ${startRec}-${endRec} of ${data.totalRecords}`;

                document.getElementById('btnPrevPage').disabled = data.page <= 1;
                document.getElementById('btnNextPage').disabled = data.page >= browseTotalPages;
            } else {
                tbody.innerHTML = `<tr><td colspan="20" class="text-danger p-3">${data.error}</td></tr>`;
            }
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="20" class="text-danger p-3">Error: ${err.message}</td></tr>`;
        }
    }

    function renderBrowseTable(data) {
        const thead = document.getElementById('browseTableHead');
        const tbody = document.getElementById('browseTableBody');
        const pkCol = data.primaryKey || 'id';

        // Header
        let thHtml = '<tr><th style="width:36px;"><input type="checkbox" id="chkAllBrowse" onchange="toggleSelectAllBrowse(this.checked)"></th>';
        thHtml += '<th style="width:130px;">Action</th>';
        data.columns.forEach(col => {
            thHtml += `<th>${escapeHtml(col)}</th>`;
        });
        thHtml += '</tr>';
        thead.innerHTML = thHtml;

        // Body
        if (data.rows.length === 0) {
            tbody.innerHTML = `<tr><td colspan="${data.columns.length + 2}" class="text-center py-4 text-muted">No records found.</td></tr>`;
            return;
        }

        let tbHtml = '';
        data.rows.forEach(row => {
            const pkVal = row[pkCol] || Object.values(row)[0];
            tbHtml += `<tr>`;
            tbHtml += `<td><input type="checkbox" class="chk-browse-row" data-pk="${escapeHtml(pkVal)}"></td>`;
            tbHtml += `
                <td>
                    <div class="pma-row-actions">
                        <button type="button" class="btn-row-action btn-row-edit" onclick="openDirectEditModal('${escapeHtml(pkCol)}', '${escapeHtml(pkVal)}')">
                            <i class="bi bi-pencil-fill"></i> Edit
                        </button>
                        <button type="button" class="btn-row-action btn-row-delete" onclick="promptDirectDelete('${escapeHtml(pkCol)}', '${escapeHtml(pkVal)}')">
                            <i class="bi bi-trash-fill"></i> Delete
                        </button>
                    </div>
                </td>
            `;

            data.columns.forEach(col => {
                const val = row[col];
                if (val === null || val === undefined) {
                    tbHtml += `<td><span class="pma-null-val">NULL</span></td>`;
                } else {
                    tbHtml += `<td>${escapeHtml(val)}</td>`;
                }
            });
            tbHtml += `</tr>`;
        });

        tbody.innerHTML = tbHtml;
    }

    function browsePrevPage() {
        if (browsePage > 1) loadBrowseData(browsePage - 1);
    }

    function browseNextPage() {
        if (browsePage < browseTotalPages) loadBrowseData(browsePage + 1);
    }

    // =========================================================================
    // STRUCTURE TAB
    // =========================================================================
    function loadStructureTab() {
        const tbody = document.getElementById('structureTableBody');
        tbody.innerHTML = '';

        currentColumns.forEach((col, idx) => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${idx + 1}</td>
                <td class="fw-semibold text-primary">${escapeHtml(col.name)}</td>
                <td>${escapeHtml(col.type)}</td>
                <td>${escapeHtml(col.collation || '-')}</td>
                <td>${col.isNullable ? '<span class="badge bg-light text-dark">YES</span>' : '<span class="badge bg-secondary">NO</span>'}</td>
                <td>${escapeHtml(col.defaultValue || 'None')}</td>
                <td>${col.isPrimaryKey ? '<span class="badge bg-primary">PRIMARY</span>' : (col.key || '-')}</td>
                <td>${escapeHtml(col.extra || '-')}</td>
            `;
            tbody.appendChild(tr);
        });
    }

    // =========================================================================
    // SEARCH TAB
    // =========================================================================
    function renderSearchTab() {
        const container = document.getElementById('searchFieldsContainer');
        container.innerHTML = '';

        currentColumns.forEach(col => {
            const div = document.createElement('div');
            div.className = 'col-md-6';
            div.innerHTML = `
                <div class="row align-items-center">
                    <label class="col-sm-4 col-form-label" style="font-size:12px; font-weight:600;">${escapeHtml(col.name)}:</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control form-control-sm search-tab-input" data-col="${escapeHtml(col.name)}">
                    </div>
                </div>
            `;
            container.appendChild(div);
        });
    }

    function executeSearchTab() {
        const clauses = [];
        document.querySelectorAll('.search-tab-input').forEach(inp => {
            if (inp.value.trim() !== '') {
                clauses.push(`\`${inp.dataset.col}\` LIKE '%${inp.value.trim()}%'`);
            }
        });

        const whereSql = clauses.length > 0 ? clauses.join(' AND ') : '1';
        const fullSql = `SELECT * FROM \`${currentTable}\` WHERE ${whereSql}`;

        switchTab('sql');
        document.getElementById('sqlTextarea').value = fullSql;
        onSqlInput();
        executeSql();
    }

    // =========================================================================
    // BATCH SELECTION & MULTI-DELETE
    // =========================================================================
    function toggleSelectAllRows(checked) {
        document.querySelectorAll('.chk-result-row').forEach(cb => cb.checked = checked);
    }

    function toggleSelectAllBrowse(checked) {
        document.querySelectorAll('.chk-browse-row').forEach(cb => cb.checked = checked);
    }

    async function deleteSelectedRows() {
        const pks = [];
        document.querySelectorAll('.chk-result-row:checked').forEach(cb => pks.push(cb.dataset.pk));
        if (pks.length === 0) {
            showToast('No rows selected.', 'warning');
            return;
        }

        if (!confirm(`Are you sure you want to delete ${pks.length} selected row(s)?`)) return;

        await executeMultipleDelete(pks);
        executeSql();
    }

    async function deleteSelectedBrowseRows() {
        const pks = [];
        document.querySelectorAll('.chk-browse-row:checked').forEach(cb => pks.push(cb.dataset.pk));
        if (pks.length === 0) {
            showToast('No rows selected.', 'warning');
            return;
        }

        if (!confirm(`Are you sure you want to delete ${pks.length} selected row(s)?`)) return;

        await executeMultipleDelete(pks);
        loadBrowseData(browsePage);
    }

    async function executeMultipleDelete(pks) {
        try {
            const res = await fetch('/DatabaseConsole/DirectDeleteMultiple', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    tableName: currentTable,
                    primaryKeyColumn: currentPrimaryKey,
                    primaryKeyValues: pks
                })
            });

            const result = await res.json();
            if (result.success) {
                showToast(result.message, 'success');
                loadTablesList();
            } else {
                showToast('Multiple delete failed: ' + result.error, 'danger');
            }
        } catch (err) {
            showToast('Error deleting rows: ' + err.message, 'danger');
        }
    }

    // =========================================================================
    // EXPORT
    // =========================================================================
    function exportResultsCsv() {
        if (!lastQueryResults || !lastQueryResults.rows || lastQueryResults.rows.length === 0) {
            showToast('No results to export.', 'warning');
            return;
        }

        const cols = lastQueryResults.columns;
        let csvContent = "data:text/csv;charset=utf-8," + cols.join(",") + "\n";

        lastQueryResults.rows.forEach(r => {
            const rowValues = cols.map(c => {
                let v = r[c] ?? '';
                v = v.toString().replace(/"/g, '""');
                return `"${v}"`;
            });
            csvContent += rowValues.join(",") + "\n";
        });

        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", `${currentTable}_export_${Date.now()}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    function handleExportClick() {
        const format = document.getElementById('exportFormat').value;
        showToast(`Preparing ${format.toUpperCase()} export...`, 'info');
        switchTab('sql');
        document.getElementById('sqlTextarea').value = `SELECT * FROM \`${currentTable}\``;
        onSqlInput();
        executeSql().then(() => {
            if (format === 'csv') exportResultsCsv();
        });
    }

    // =========================================================================
    // IMPORT
    // =========================================================================
    function executeImportSql() {
        const sql = document.getElementById('importSqlTextarea').value.trim();
        if (!sql) {
            showToast('Please paste a SQL script to execute.', 'warning');
            return;
        }

        switchTab('sql');
        document.getElementById('sqlTextarea').value = sql;
        onSqlInput();
        executeSql();
    }

    // =========================================================================
    // OPERATIONS
    // =========================================================================
    function runQuickMaintenance(op) {
        switchTab('sql');
        document.getElementById('sqlTextarea').value = `${op} \`${currentTable}\`;`;
        onSqlInput();
        executeSql();
    }

    function confirmTruncateTable() {
        if (confirm(`CAUTION: Are you sure you want to TRUNCATE (delete all rows from) table \`${currentTable}\`? This action cannot be undone.`)) {
            switchTab('sql');
            document.getElementById('sqlTextarea').value = `TRUNCATE TABLE \`${currentTable}\`;`;
            onSqlInput();
            executeSql();
        }
    }

    // =========================================================================
    // TOAST NOTIFICATIONS
    // =========================================================================
    function showToast(message, type = 'info') {
        const toast = document.getElementById('pmaToast');
        const msg = document.getElementById('pmaToastMsg');
        const icon = document.getElementById('pmaToastIcon');

        msg.textContent = message;

        if (type === 'success') {
            toast.className = 'bg-success text-white';
            icon.className = 'bi bi-check-circle-fill me-2';
        } else if (type === 'danger') {
            toast.className = 'bg-danger text-white';
            icon.className = 'bi bi-exclamation-triangle-fill me-2';
        } else if (type === 'warning') {
            toast.className = 'bg-warning text-dark';
            icon.className = 'bi bi-exclamation-circle-fill me-2';
        } else {
            toast.className = 'bg-dark text-white';
            icon.className = 'bi bi-info-circle-fill text-info me-2';
        }

        toast.style.display = 'flex';
        setTimeout(() => {
            toast.style.display = 'none';
        }, 4000);
    }

    function escapeHtml(str) {
        if (str === null || str === undefined) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }
</script>
