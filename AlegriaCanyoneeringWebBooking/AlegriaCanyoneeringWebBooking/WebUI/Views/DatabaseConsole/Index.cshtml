                    <div class="card border-0 shadow-sm p-3">
                        <h6 class="fw-bold text-danger mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Table Maintenance</h6>
                        <p class="text-muted" style="font-size:12px;">Execute maintenance commands on table `<span class="current-table-name">guest</span>`.</p>
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-outline-secondary btn-sm" onclick="runQuickMaintenance('CHECK TABLE')">Check Table</button>
                            <button class="btn btn-outline-secondary btn-sm" onclick="runQuickMaintenance('OPTIMIZE TABLE')">Optimize Table</button>
                            <button class="btn btn-outline-secondary btn-sm" onclick="runQuickMaintenance('ANALYZE TABLE')">Analyze Table</button>
