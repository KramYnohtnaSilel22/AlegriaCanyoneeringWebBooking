                <div class="mb-3">
                    <label class="form-label">Export Format:</label>
                    <select id="exportFormat" class="form-select">
                        <option value="csv">CSV (Comma-Separated Values)</option>
                        <option value="sql">SQL Dump (INSERT statements)</option>
