        <!-- =================================================================
             7. IMPORT TAB
             ================================================================= -->
        <div id="viewImport" style="display:none;">
            <div class="card border-0 shadow-sm p-4" style="max-width:700px;">
                <h6 class="fw-bold mb-3"><i class="bi bi-upload text-primary me-2"></i>Import / Execute SQL Script</h6>
                <div class="mb-3">
                    <label class="form-label">Paste SQL script:</label>
                    <textarea id="importSqlTextarea" class="form-control" rows="8" placeholder="Paste SQL queries or scripts here..."></textarea>
                </div>
                <button class="btn btn-primary btn-sm px-4" onclick="executeImportSql()">
                    <i class="bi bi-play-fill me-1"></i> Execute Script
                </button>
