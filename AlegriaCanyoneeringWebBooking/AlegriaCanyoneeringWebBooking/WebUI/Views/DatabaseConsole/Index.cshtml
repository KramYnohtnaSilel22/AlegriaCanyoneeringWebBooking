                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- =================================================================
             9. TRIGGERS TAB
             ================================================================= -->
        <div id="viewTriggers" style="display:none;">
            <div class="card border-0 shadow-sm p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-lightning text-warning me-2"></i>Triggers for `<span class="current-table-name">guest</span>`</h6>
                <div id="triggersContent" class="text-muted" style="font-size:12px;">No triggers found for this table.</div>
