@{
    ViewData["Title"] = "Roles";
}

<h2 class="fw-bold mb-4 text-primary">Roles</h2>

<!-- Anti-Forgery Token for AJAX -->
<form id="__AjaxAntiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<a asp-action="Create" class="btn btn-primary mb-3">
    <i class="fas fa-plus"></i> Create New
</a>

<div class="table-responsive">
    <table id="rolesTable" class="table table-bordered table-striped table-sm align-middle w-100">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

    <script>
        function showToast(message, type = 'success') {
            let bgClass = 'bg-success', icon = 'bi-check-circle-fill', title = 'Success';
            if (type === 'error') { bgClass = 'bg-danger'; icon = 'bi-exclamation-triangle-fill'; title = 'Error'; }

            const toastContainer = $('<div class="toast-container position-fixed top-0 end-0 p-3"></div>').css('z-index', 1080);
            const toast = $('<div class="toast text-white ' + bgClass + ' border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000"></div>');
            const toastHeader = $('<div class="toast-header ' + bgClass + ' text-white border-0"></div>').html(`
                <i class="bi ${icon} me-2"></i>
                <strong class="me-auto">${title}</strong>
                <small>Now</small>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            `);
            const toastBody = $('<div class="toast-body"></div>').text(message);

            toast.append(toastHeader, toastBody);
            toastContainer.append(toast);
            $('body').append(toastContainer);
            new bootstrap.Toast(toast[0]).show();

            toast.on('hidden.bs.toast', () => toastContainer.remove());
        }

        $(document).ready(function () {
            var table = $('#rolesTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetRolesData", "Roles")',
                    type: 'POST',
                    data: { __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                    error: function (xhr) {
                        console.error("DataTables AJAX error:", xhr.responseText);
                        showToast("Failed to load roles. Refresh the page.", "error");
                    }
                },
                columns: [
                    { data: 'name', className: 'text-break' },
                    {
                        data: 'roleId',
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            return `
                                <div class="d-flex flex-wrap gap-2">
                                    <a href="/Roles/Edit/${data}" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i> <span class="d-none d-sm-inline">Edit</span>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger delete-btn" data-id="${data}" data-name="${row.name}">
                                        <i class="fas fa-trash"></i> <span class="d-none d-sm-inline">Delete</span>
                                    </button>
                                </div>`;
                        },
                        className: 'text-center'
                    }
                ],
                pageLength: 10,
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                responsive: true,
                autoWidth: false,
                language: {
                    emptyTable: "No roles found",
                    processing: '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>'
                }
            });

            $('#rolesTable').on('click', '.delete-btn', function () {
                var roleId = $(this).data('id');
                var roleName = $(this).data('name');
                if (confirm('Are you sure you want to delete role "' + roleName + '"?')) {
                    $.ajax({
                        url: '@Url.Action("DeleteAjax", "Roles")',
                        type: 'POST',
                        data: { id: roleId, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                        success: function (response) {
                            if (response.success) {
                                showToast(response.message, 'success');
                                table.ajax.reload(null, false);
                            } else showToast(response.message, 'error');
                        },
                        error: function (xhr) {
                            console.error("AJAX Error:", xhr.responseText);
                            showToast("Error deleting role. Check console.", "error");
                        }
                    });
                }
            });

            @if (TempData["SuccessMessage"] != null)
            {
                <text>showToast('@TempData["SuccessMessage"]', 'success');</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>showToast('@TempData["ErrorMessage"]', 'error');</text>
            }
        });
    </script>
}
