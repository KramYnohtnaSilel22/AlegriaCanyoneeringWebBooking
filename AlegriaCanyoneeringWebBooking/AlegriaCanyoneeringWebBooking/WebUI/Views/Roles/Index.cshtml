@model IEnumerable<AlegriaCanyoneeringWebBooking.Models.Role>

@{
    ViewData["Title"] = "Roles";
}

<h1 class="mb-3">Roles</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table id="rolesTable" class="table table-bordered table-striped align-middle">
    <thead class="table-light">
        <tr>
            <th>@Html.DisplayNameFor(m => m.Name)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.RoleId" class="btn btn-sm btn-warning">
                        <i class="fas fa-edit me-1"></i> Edit
                    </a>

                    <form asp-action="Delete" asp-route-id="@item.RoleId" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this role?')">
                            <i class="fas fa-trash me-1"></i> Delete
                        </button>
                    </form>

                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <!-- ✅ Include DataTables and Font Awesome (if not already in _Layout.cshtml) -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/js/all.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#rolesTable').DataTable({
                responsive: true,
                autoWidth: false,
                pageLength: 10,
                lengthMenu: [[10, 20, 30, 50, 100], [10, 20, 30, 50, 100]],
                language: {
                    search: "Search Role:",
                    emptyTable: "No roles available.",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ roles"
                }
            });
        });
    </script>
}