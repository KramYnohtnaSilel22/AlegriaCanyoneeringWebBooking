@{
    ViewData["Title"] = "Roles";
}

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    .rl-wrap * {
        font-family: 'Outfit', sans-serif;
    }

    .rl-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

        .rl-header h2 {
            font-size: 1.35rem;
            font-weight: 700;
            color: #0f3460;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .btn-create {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.6rem 1.25rem;
        background: linear-gradient(135deg,#1a6ef5,#0f3460);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s;
        box-shadow: 0 3px 12px rgba(26,110,245,0.3);
    }

        .btn-create:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    .rl-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 20px rgba(15,52,96,0.08);
        border: 1px solid #e8edf5;
        overflow: hidden;
    }

    .rl-card-body {
        padding: 1.25rem;
    }

    #rolesTable thead th {
        background: #f8faff;
        color: #0f3460;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-bottom: 2px solid #e8edf5;
        white-space: nowrap;
        padding: 0.75rem 1rem;
    }

    #rolesTable tbody td {
        vertical-align: middle;
        font-size: 0.875rem;
        color: #334155;
        padding: 0.7rem 1rem;
    }

    #rolesTable tbody tr:hover {
        background: #f0f6ff;
    }

    .btn-act {
        padding: 0.28rem 0.65rem;
        border-radius: 7px;
        font-size: 0.78rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: opacity 0.15s;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

        .btn-act:hover {
            opacity: 0.82;
        }

    .btn-edit-act {
        background: rgba(240,165,0,0.1);
        color: #b45309;
        border: 1px solid #fde68a;
    }

    .btn-delete-act {
        background: rgba(239,68,68,0.08);
        color: #ef4444;
        border: 1px solid #fca5a5;
    }

    #roleModal .modal-content {
        border-radius: 16px;
        border: 0;
        box-shadow: 0 8px 40px rgba(15,52,96,0.18);
        overflow: hidden;
    }

    .rl-modal-header {
        background: linear-gradient(135deg,#1a6ef5,#0f3460);
        color: #fff;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .rl-modal-header h5 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0;
        }

    #deleteConfirmModal .modal-content {
        border-radius: 16px;
        border: 0;
    }

    .del-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: rgba(239,68,68,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 0.75rem;
    }

        .del-icon i {
            font-size: 1.4rem;
            color: #ef4444;
        }
</style>

<form id="__AjaxAntiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<div class="rl-wrap">
    <div class="rl-header">
        <h2><i class="bi bi-shield-fill" style="color:#1a6ef5;"></i> Roles</h2>
        <button type="button" id="btnCreate" class="btn-create">
            <i class="bi bi-plus-lg"></i> Add Role
        </button>
    </div>

    <div class="rl-card">
        <div class="rl-card-body">
            <div class="table-responsive">
                <table id="rolesTable" class="table table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Role Name</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Form Modal -->
<div class="modal fade" id="roleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="rl-modal-header">
                <h5 id="roleModalLabel"><i class="bi bi-shield me-2"></i>Role</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" id="roleModalContent" style="min-height:140px;"></div>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:340px;">
        <div class="modal-content shadow">
            <div class="modal-body text-center pt-4 pb-3 px-4">
                <div class="del-icon"><i class="bi bi-trash3-fill"></i></div>
                <h6 class="fw-bold mb-1" style="color:#0f3460;">Delete Role?</h6>
                <p class="text-muted mb-0" style="font-size:0.875rem;">
                    Are you sure you want to delete <strong id="deleteRoleName"></strong>?
                </p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 pb-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger rounded-pill px-4">
                    <i class="bi bi-trash3 me-1"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

<div id="rlToastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090;"></div>

@section Scripts {
    <script>
        function showToast(message, type) {
            type = type || 'success';
            var map = {
                success: { bg: '#22c55e', icon: 'bi-check-circle-fill',        title: 'Success' },
                error:   { bg: '#ef4444', icon: 'bi-exclamation-triangle-fill', title: 'Error'   },
                warning: { bg: '#f0a500', icon: 'bi-exclamation-circle-fill',   title: 'Warning' }
            };
            var m  = map[type] || map.success;
            var id = 'rlt-' + Date.now();
            var html =
                '<div id="' + id + '" class="toast border-0 text-white" '
                + 'style="background:' + m.bg + ';border-radius:12px;box-shadow:0 4px 16px rgba(0,0,0,0.15);" '
                + 'role="alert" aria-atomic="true" data-bs-delay="4000">'
                + '<div class="toast-header border-0 text-white" style="background:transparent;">'
                + '<i class="bi ' + m.icon + ' me-2"></i>'
                + '<strong class="me-auto">' + m.title + '</strong>'
                + '<button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>'
                + '</div>'
                + '<div class="toast-body" style="padding-top:0;">' + message + '</div>'
                + '</div>';
            document.getElementById('rlToastContainer').insertAdjacentHTML('beforeend', html);
            var el = document.getElementById(id);
            new bootstrap.Toast(el).show();
            el.addEventListener('hidden.bs.toast', function () { el.remove(); });
        }

        // ── Nuke all stale Bootstrap modal leftovers ──────────────────────
        function cleanupModals() {
            document.querySelectorAll('.modal-backdrop').forEach(function (el) { el.remove(); });
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
        }

        $(function () {

            // ── Helpers ───────────────────────────────────────────────────
            function getToken() {
                return $('#__AjaxAntiForgeryForm input[name="__RequestVerificationToken"]').val();
            }

            function escHtml(str) {
                return $('<div>').text(str || '').html();
            }

            // ── DataTable ─────────────────────────────────────────────────
            var table = $('#rolesTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetRolesData", "Roles")',
                    type: 'POST',
                    dataSrc: 'data',
                    data: function (d) {
                        d.__RequestVerificationToken = getToken();
                    },
                    error: function (xhr) {
                        console.error('DataTable error:', xhr.responseText);
                        showToast('Failed to load data. Check console for details.', 'error');
                    }
                },
                columns: [
                    {
                        data: 'name',
                        render: function (d) {
                            return '<span class="fw-semibold">' + (d || '—') + '</span>';
                        }
                    },
                    {
                        data: 'roleId',
                        orderable: false,
                        searchable: false,
                        className: 'text-center',
                        render: function (data, type, row) {
                            return '<div class="d-flex gap-1 justify-content-center">'
                                + '<button class="btn-act btn-edit-act btn-edit" data-id="' + data + '">'
                                + '<i class="bi bi-pencil"></i> Edit</button>'
                                + '<button class="btn-act btn-delete-act btn-delete" data-id="' + data + '" data-name="' + escHtml(row.name) + '">'
                                + '<i class="bi bi-trash3"></i> Delete</button>'
                                + '</div>';
                        }
                    }
                ],
                pageLength: 10,
                responsive: true,
                autoWidth: false,
                language: { emptyTable: 'No roles found.' }
            });

            // ── Open modal helper ─────────────────────────────────────────
            function openModal(url, title) {
                // Dispose any existing roleModal instance + clean backdrops
                var inst = bootstrap.Modal.getInstance(document.getElementById('roleModal'));
                if (inst) { inst.hide(); inst.dispose(); }
                cleanupModals();

                $('#roleModalContent').html(
                    '<div class="text-center py-4 text-muted">'
                    + '<div class="spinner-border text-primary mb-2" role="status"></div>'
                    + '<div style="font-size:0.875rem;">Loading...</div></div>'
                );
                $('#roleModalLabel').html('<i class="bi bi-shield me-2"></i>' + title);

                $.get(url)
                    .done(function (res) {
                        $('#roleModalContent').html(res);
                        new bootstrap.Modal(document.getElementById('roleModal')).show();
                    })
                    .fail(function (xhr) {
                        console.error('Modal load error:', xhr.responseText);
                        showToast('Error loading form. Check console for details.', 'error');
                    });
            }

            // Clean up when roleModal closes
            $('#roleModal').on('hidden.bs.modal', function () {
                cleanupModals();
            });

            // ── Create ────────────────────────────────────────────────────
            $('#btnCreate').on('click', function () {
                openModal('@Url.Action("Create", "Roles")', 'Add Role');
            });

            // ── Edit ──────────────────────────────────────────────────────
            $('#rolesTable').on('click', '.btn-edit', function () {
                var id = $(this).data('id');
                openModal('/Roles/Edit/' + id, 'Edit Role');
            });

            // ── Delete — open confirm ─────────────────────────────────────
            var pendingDeleteId = null;

            $('#rolesTable').on('click', '.btn-delete', function () {
                pendingDeleteId = $(this).data('id');
                $('#deleteRoleName').text($(this).data('name'));

                // Always fresh instance — kills stale backdrop issue
                var existing = bootstrap.Modal.getInstance(document.getElementById('deleteConfirmModal'));
                if (existing) { existing.hide(); existing.dispose(); }
                cleanupModals();

                new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show();
            });

            // Clean up when deleteConfirmModal closes
            $('#deleteConfirmModal').on('hidden.bs.modal', function () {
                cleanupModals();
            });

            // ── Delete — confirm click ────────────────────────────────────
            $('#confirmDeleteBtn').on('click', function () {
                if (!pendingDeleteId) return;

                var $btn        = $(this);
                var deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteConfirmModal'));

                $btn.prop('disabled', true)
                    .html('<span class="spinner-border spinner-border-sm me-1"></span>Deleting...');

                $.ajax({
                    url: '@Url.Action("DeleteAjax", "Roles")',
                    type: 'POST',
                    data: { id: pendingDeleteId },
                    headers: { 'RequestVerificationToken': getToken() }
                })
                .done(function (res) {
                    if (deleteModal) deleteModal.hide();
                    cleanupModals();
                    if (res.success) {
                        showToast(res.message, 'success');
                        table.ajax.reload(null, false);
                    } else {
                        showToast(res.message, 'error');
                    }
                })
                .fail(function (xhr) {
                    if (deleteModal) deleteModal.hide();
                    cleanupModals();
                    console.error('Delete error:', xhr.responseText);
                    showToast('Error deleting. Check console for details.', 'error');
                })
                .always(function () {
                    $btn.prop('disabled', false)
                        .html('<i class="bi bi-trash3 me-1"></i>Delete');
                    pendingDeleteId = null;
                });
            });

            // ── Form submit (Create & Edit) ───────────────────────────────
            $('#roleModal').on('submit', 'form', function (e) {
                e.preventDefault();
                var $form = $(this);
                var $btn  = $form.find('[type="submit"]');
                $btn.prop('disabled', true)
                    .html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');

                $.ajax({
                    url: $form.attr('action'),
                    type: 'POST',
                    data: $form.serialize()
                })
                .done(function (res) {
                    if (res.success) {
                        var inst = bootstrap.Modal.getInstance(document.getElementById('roleModal'));
                        if (inst) inst.hide();
                        cleanupModals();
                        table.ajax.reload(null, false);
                        showToast(res.message || 'Saved.', 'success');
                    } else {
                        $('#roleModalContent').html(res);
                        $btn.prop('disabled', false);
                    }
                })
                .fail(function (xhr) {
                    console.error('Save error:', xhr.responseText);
                    showToast('Error saving. Check console for details.', 'error');
                    $btn.prop('disabled', false);
                });
            });

        });
    </script>
}