@model GuestPaginationViewModel
<link href="/css/GuestDetails.css" rel="stylesheet" />

@{
    // Helper function to format ArrivalDate
    string FormatArrivalDate(string unixTimestamp)
    {
        if (string.IsNullOrEmpty(unixTimestamp)) return "N/A";

        if (long.TryParse(unixTimestamp, out var unix))
        {
            var dateTime = DateTimeOffset.FromUnixTimeSeconds(unix).DateTime;
            return dateTime.ToString("MMMM dd, yyyy hh:mm tt"); // human-readable format
        }

        return unixTimestamp;
    }
}

<div class="modal fade" id="guestOfTheDayModal" " tabindex="-1" aria-labelledby="guestOfTheDayModalLabel" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="guestDetailsModalLabel">
                    🧾 Guests of the Day - @DateTime.Today.ToString("MMMM dd, yyyy")
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="d-flex justify-content-between align-items-center px-3 py-2 bg-light border-bottom">
                <span class="fw-semibold text-muted">
                    Total Guests: <strong class="text-dark">@Model.TotalCount</strong>
                </span>
                <div>
                    <button class="btn btn-danger btn-sm" onclick="downloadGuestDetailsPdf()">
                        <i class="fas fa-file-pdf"></i> Download PDF
                    </button>
                    <button class="btn btn-success btn-sm ms-2" onclick="downloadGuestDetailsExcel()">
                        <i class="fas fa-file-excel"></i> Download Excel
                    </button>
                </div>
            </div>

            <div class="modal-body bg-white text-black" id="guestDetailsContent">
                <!-- Batch Search -->
                <div class="mb-3">
                    <input type="text" id="batchSearchInput" class="form-control" placeholder="Search by Batch..." />
                </div>

                @if (Model.Guests != null && Model.Guests.Any())
                {
                    var grouped = Model.Guests.GroupBy(g => g.Guest.Batch);

                    foreach (var batchGroup in grouped)
                    {
                        var primaryGuestVM = batchGroup.First();
                        var companionsVM = batchGroup.Skip(1).ToList();

                        <div class="card border mb-4">
                            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-2 px-3">
                                <div>
                                    <strong>Batch:</strong>
                                    <span class="text-muted">@batchGroup.Key</span>
                                    <small class="ms-3">(Operator: @primaryGuestVM.OperatorName)</small>
                                </div>
                                <span class="text-muted">@FormatArrivalDate(primaryGuestVM.Guest.ArrivalDate)</span>
                            </div>

                            <div class="card-body px-3 py-3">
                                <h6 class="fw-bold mb-3">Primary Guest</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover">
                                        <thead>
                                            <tr class="table-light">
                                                <th>Full Name</th>
                                                <th>Age</th>
                                                <th>Contact</th>
                                                <th>Gender</th>
                                                <th>Nationality</th>
                                                <th>Area</th>
                                                <th>Arrival Date</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>@primaryGuestVM.Guest.Fullname</td>
                                                <td>@primaryGuestVM.Guest.Age</td>
                                                <td>@primaryGuestVM.Guest.ContactNumber</td>
                                                <td>@primaryGuestVM.Guest.Gender</td>
                                                <td>@primaryGuestVM.Guest.NationalityType</td>
                                                <td>@primaryGuestVM.Guest.Area</td>
                                                <td>@FormatArrivalDate(primaryGuestVM.Guest.ArrivalDate)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                @if (companionsVM.Any())
                                {
                                    <h6 class="fw-bold mt-4 mb-2">Companion Guests</h6>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover">
                                            <thead>
                                                <tr class="table-light">
                                                    <th>Full Name</th>
                                                    <th>Age</th>
                                                    <th>Contact</th>
                                                    <th>Gender</th>
                                                    <th>Nationality Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var vm in companionsVM)
                                                {
                                                    <tr>
                                                        <td>@vm.Guest.Fullname</td>
                                                        <td>@vm.Guest.Age</td>
                                                        <td>@vm.Guest.ContactNumber</td>
                                                        <td>@vm.Guest.Gender</td>
                                                        <td>@(vm.Guest.NationalityEntity?.NatName ?? "N/A")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted">No companions in this batch.</p>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No guest arrivals found today.</p>
                }

                <!-- Pagination Controls -->
                <nav aria-label="Guest pagination">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0)" onclick="loadGuestPage(@(Model.CurrentPage - 1))">Previous</a>
                        </li>
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" href="javascript:void(0)" onclick="loadGuestPage(@i)">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0)" onclick="loadGuestPage(@(Model.CurrentPage + 1))">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="~/js/GuestPDF" asp-append-version="true" defer></script>
<script src="~/js/GuestExcel.js" asp-append-version="true" defer></script>

<script>
    let currentPage = @Model.CurrentPage;
    const pageSize = @Model.PageSize;

    function loadGuestPage(pageNumber) {
        const batchFilter = $('#batchSearchInput').val();

        $.get('@Url.Action("GetGuestOfTheDay", "Reserve")', {
            pageNumber: pageNumber,
            pageSize: pageSize,
            batchFilter: batchFilter
        }, function (data) {
            $('#guestDetailsModal .modal-content').html(data);
        });
    }

    $(document).ready(function () {
        loadGuestPage(1);

        $('#batchSearchInput').on('keyup', function () {
            loadGuestPage(1);
        });
    });
</script>
