@{
    var batch = ViewBag.Batch as string;
    var guestCount = (int)(ViewBag.GuestCount ?? 0);
    var recommendedDrivers = (int)(ViewBag.RecommendedDrivers ?? 0);
    var operatorName = ViewBag.OperatorName as string;
    var operatorId = ViewBag.OperatorId as string;
    var availableDrivers = ViewBag.AvailableDrivers as IEnumerable<dynamic>;
    var busyDrivers = ViewBag.BusyDrivers as IEnumerable<dynamic>;
    int totalDrivers = availableDrivers?.Count() ?? 0;
}

<div class="modal-header text-white" style="background:#0dcaf0;">
    <h5 class="modal-title">
        <i class="fas fa-car me-2"></i> Assign Outside Drivers
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">

    <!-- Batch Info Bar -->
    <div class="mb-3 p-3 bg-light rounded border">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
                <i class="fas fa-layer-group me-1" style="color:#0dcaf0;"></i>
                <strong>Batch:</strong> @batch
            </span>
            <span>
                <i class="fas fa-users me-1 text-primary"></i>
                <strong>Guests:</strong> @guestCount
            </span>
            @if (!string.IsNullOrEmpty(operatorName))
            {
                <span>
                    <i class="fas fa-building me-1 text-secondary"></i>
                    <strong>Operator:</strong> @operatorName
                </span>
            }
            <span class="badge fs-6 bg-info text-dark">
                <i class="fas fa-car me-1"></i>
                Limit: @recommendedDrivers driver@(recommendedDrivers != 1 ? "s" : "")
            </span>
            <span class="badge bg-primary fs-6">
                Selected: <span id="driverSelectedCount">0</span> / @recommendedDrivers
            </span>
        </div>
    </div>

    <!-- Limit Warning -->
    <div id="driverLimitWarning"
         class="alert alert-danger d-flex align-items-center gap-2 py-2 mb-3"
         style="display:none !important;">
        <i class="fas fa-ban fa-lg"></i>
        <div>
            <strong>Limit Reached!</strong>
            Max <strong>@recommendedDrivers driver@(recommendedDrivers != 1 ? "s" : "")</strong>
            for @guestCount guests. Deselect a driver to pick a different one.
        </div>
    </div>

    <!-- Search -->
    <div class="mb-3">
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input type="text" id="driverSearch" class="form-control"
                   placeholder="Search driver by name or Ref ID..."
                   oninput="filterOutsideDrivers()" />
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link active" id="tab-odriver-queue" onclick="switchDriverTab('queue')">
                <i class="fas fa-sort-numeric-up me-1" style="color:#0dcaf0;"></i>
                Queue
                <span class="badge ms-1 bg-info text-dark">@totalDrivers</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="tab-odriver-assigned" onclick="switchDriverTab('assigned')">
                <i class="fas fa-clock text-warning me-1"></i>
                Assigned Today
                <span class="badge bg-warning text-dark ms-1" id="driverAssignedCountBadge">
                    @(busyDrivers?.Count() ?? 0)
                </span>
            </button>
        </li>
    </ul>

    <!-- PANEL: Queue -->
    <div id="panel-odriver-queue">

        @if (availableDrivers != null && availableDrivers.Any() && recommendedDrivers > 0)
        {
            <div class="d-flex align-items-center gap-2 flex-wrap mb-3 p-2 rounded border"
                 style="border-color:#0dcaf0 !important;background:rgba(13,202,240,.06);">
                <i class="fas fa-magic flex-shrink-0" style="color:#0dcaf0;"></i>
                <span class="small fw-semibold" style="color:#0dcaf0;">Next in Queue:</span>
                @{
                    int shownCount = 0;
                    foreach (var d in availableDrivers)
                    {
                        if (shownCount >= recommendedDrivers) break;
                        if (!(bool)(d.isAbsent ?? false))
                        {
                            <span class="badge py-1 px-2 bg-info text-dark">
                                #@((int)(d.queuePosition ?? 0)) @((string)(d.fullName ?? ""))
                            </span>
                            shownCount++;
                        }
                    }
                    if (shownCount == 0)
                    {
                        <span class="text-muted small fst-italic">All top drivers are absent today</span>
                    }
                }
                <button class="btn btn-sm ms-auto py-0 px-2 bg-info text-dark"
                        style="font-size:11px;"
                        onclick="autoSelectTopDrivers()">
                    <i class="fas fa-check-double me-1"></i>Auto-Select Top @recommendedDrivers
                </button>
            </div>
        }

        <div class="row g-2" id="availableDriverList">
            @if (availableDrivers != null && availableDrivers.Any())
            {
                foreach (var d in availableDrivers)
                {
                    bool hasTrip = (bool)(d.hasTrip ?? false);
                    bool isAbsent = (bool)(d.isAbsent ?? false);
                    int qPos = (int)(d.queuePosition ?? 0);
                    bool isTopN = qPos <= recommendedDrivers && !isAbsent;
                    string dRefId = (string)(d.RefId ?? "");
                    string dFullName = (string)(d.fullName ?? "");
                    string dImage = (string)(d.Image ?? "");
                    int dPax = (int)(d.passengers ?? 0);

                    <div class="col-md-6 driver-item @(isAbsent ? "driver-absent-item" : "")"
                         data-name="@dFullName.ToLower()"
                         data-refid-search="@dRefId.ToLower()"
                         data-panel="queue"
                         data-refid="@dRefId"
                         data-fullname="@dFullName"
                         data-hastrip="@hasTrip.ToString().ToLower()"
                         data-isabsent="@isAbsent.ToString().ToLower()"
                         data-image="@dImage">

                        <div class="driver-card card border-2 h-100
                                            @(isAbsent ? "driver-absent-card" : "")
                                            @(isTopN ? "driver-top-card" : "")"
                             style="cursor:pointer;" onclick="toggleSelectDriver(this)">
                            <div class="card-body d-flex align-items-center gap-2 p-2">

                                <!-- Queue badge -->
                                <div class="d-flex flex-column align-items-center flex-shrink-0" style="min-width:34px;">
                                    <span class="badge text-dark"
                                          style="font-size:11px;width:30px;text-align:center;
                                                         background:@(isAbsent ? "#dc3545" : isTopN ? "#0dcaf0" : "#6c757d");
                                                         color:@(isAbsent ? "white" : "dark") !important;">
                                        #@qPos
                                    </span>
                                    @if (isTopN)
                                    {
                                        <span style="font-size:8px;white-space:nowrap;color:#0dcaf0;" class="fw-bold">NEXT</span>
                                    }
                                    else if (isAbsent)
                                    {
                                        <span style="font-size:8px;" class="text-danger fw-bold">ABS</span>
                                    }
                                </div>

                                <!-- Avatar -->
                                @if (!string.IsNullOrEmpty(dImage))
                                {
                                    <img src="@dImage"
                                         style="width:44px;height:44px;object-fit:cover;@(isAbsent ? "filter:grayscale(70%);" : "")"
                                         class="rounded-circle border @(isAbsent ? "border-danger" : "border-info")" />
                                }
                                else
                                {
                                    <div style="width:44px;height:44px;background:@(isAbsent ? "transparent" : "#0dcaf0");"
                                         class="rounded-circle border d-flex align-items-center justify-content-center
                                                            @(isAbsent ? "border-danger bg-danger bg-opacity-10" : "border-info")">
                                        <i class="fas fa-car @(isAbsent ? "text-danger" : "text-white")"></i>
                                    </div>
                                }

                                <!-- Info -->
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="fw-semibold small text-truncate @(isAbsent ? "text-decoration-line-through text-muted" : "")">
                                        @dFullName
                                    </div>
                                    <div class="text-muted" style="font-size:10px;">
                                        <i class="fas fa-id-card me-1"></i>Ref: @dRefId
                                    </div>
                                    @if (isAbsent)
                                    {
                                        <div style="font-size:10px;" class="text-danger">
                                            <i class="fas fa-car-crash me-1"></i>Absent — 0 passengers
                                        </div>
                                    }
                                    else if (hasTrip)
                                    {
                                        <div style="font-size:10px;" class="text-warning driver-trip-info">
                                            <i class="fas fa-users me-1"></i>Last: @dPax passenger@(dPax != 1 ? "s" : "")
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="font-size:10px;color:#0dcaf0;">
                                            <i class="fas fa-clock me-1"></i>Never assigned
                                        </div>
                                    }
                                </div>

                                <!-- Status badge -->
                                @if (isAbsent)
                                {
                                    <span class="badge bg-danger driver-status-badge">Absent</span>
                                }
                                else if (hasTrip)
                                {
                                    <span class="badge bg-warning text-dark driver-status-badge">On Trip</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark driver-status-badge">Free</span>
                                }

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted py-4">
                    <i class="fas fa-car fa-2x mb-2 d-block"></i>
                    <small>No outside drivers are linked to this operator.</small>
                </div>
            }
        </div>

        <!-- Selected Section -->
        <div id="selectedDriversSection" class="mt-3" style="display:none;">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h6 class="fw-bold mb-0" style="color:#0dcaf0;">
                    <i class="fas fa-check-double me-1"></i> Selected Drivers
                </h6>
                <button class="btn btn-outline-danger btn-sm" onclick="clearAllSelectedDrivers()">
                    <i class="fas fa-times me-1"></i> Clear All
                </button>
            </div>
            <div class="row g-2" id="selectedDriverList"></div>
        </div>
    </div>

    <!-- PANEL: Assigned Today -->
    <div id="panel-odriver-assigned" style="display:none;">

        <div class="alert alert-info py-2 small mb-2">
            <i class="fas fa-info-circle me-1"></i>
            <strong>Edit</strong> = update passenger count &nbsp;|&nbsp;
            <span class="text-danger"><strong>Absent</strong></span> = set 0 passengers, driver still cycles in FIFO &nbsp;|&nbsp;
            <strong>Remove</strong> = fully unassign
        </div>

        <div class="row g-2" id="assignedDriverList">
            @if (busyDrivers != null && busyDrivers.Any())
            {
                foreach (var d in busyDrivers)
                {
                    bool isAbsent = (bool)(d.isAbsent ?? false);
                    int queuePosN = (int)(d.queuePos ?? 0);
                    int dPax = (int)(d.passengers ?? 0);
                    string bRefId = (string)(d.RefId ?? "");
                    string bFullName = (string)(d.fullName ?? "");
                    string bImage = (string)(d.Image ?? "");

                    <div class="col-12 assigned-driver-row" id="assigned-driver-row-@bRefId">
                        <div class="card @(isAbsent ? "border-danger bg-danger bg-opacity-5" : "border-info")">
                            <div class="card-body p-2">
                                <div class="d-flex align-items-center gap-2">

                                    <!-- Queue # -->
                                    <div class="fw-bold text-center flex-shrink-0"
                                         style="font-size:14px;min-width:28px;color:@(isAbsent ? "#dc3545" : "#0dcaf0");">
                                        #@queuePosN
                                    </div>

                                    <!-- Avatar -->
                                    @if (!string.IsNullOrEmpty(bImage))
                                    {
                                        <img src="@bImage"
                                             style="width:44px;height:44px;object-fit:cover;@(isAbsent ? "filter:grayscale(70%);" : "")"
                                             class="rounded-circle border @(isAbsent ? "border-danger" : "border-info")" />
                                    }
                                    else
                                    {
                                        <div style="width:44px;height:44px;"
                                             class="rounded-circle border bg-light d-flex align-items-center justify-content-center">
                                            <i class="fas fa-car" style="color:@(isAbsent ? "#dc3545" : "#0dcaf0");"></i>
                                        </div>
                                    }

                                    <!-- Info -->
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-semibold small text-truncate @(isAbsent ? "text-decoration-line-through text-muted" : "")">
                                            @bFullName
                                        </div>
                                        <div class="text-muted" style="font-size:10px;">
                                            <i class="fas fa-id-card me-1"></i>Ref: @bRefId
                                        </div>
                                        <div style="font-size:10px;" class="@(isAbsent ? "text-danger" : "")"
                                             id="driver-pax-label-@bRefId">
                                            <i class="fas fa-users me-1"></i>
                                            Passengers: <strong id="driver-pax-value-@bRefId">@dPax</strong>
                                            @if (isAbsent)
                                            {
                                                <span class="ms-1"><i class="fas fa-car-crash"></i> <em>Absent</em></span>
                                            }
                                        </div>
                                    </div>

                                    <!-- Buttons -->
                                    <div class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
                                        @if (isAbsent)
                                        {
                                            <span class="badge bg-danger mb-1">Absent</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark mb-1">On Trip</span>
                                        }

                                        <div class="d-flex gap-1">
                                            @if (!isAbsent)
                                            {
                                                <button class="btn btn-outline-primary btn-sm py-0 px-1"
                                                        style="font-size:10px;"
                                                        id="driver-edit-btn-@bRefId"
                                                        data-refid="@bRefId"
                                                        data-pax="@dPax"
                                                        onclick="toggleEditDriver($(this).data('refid'), $(this).data('pax'))">
                                                    <i class="fas fa-pencil-alt"></i>
                                                </button>
                                            }
                                            <button class="btn @(isAbsent ? "btn-outline-success" : "btn-outline-secondary") btn-sm py-0 px-1"
                                                    style="font-size:10px;"
                                                    title="@(isAbsent ? "Unmark Absent" : "Mark Absent (0 passengers, stays in queue)")"
                                                    id="driver-absent-btn-@bRefId"
                                                    data-refid="@bRefId"
                                                    data-isabsent="@isAbsent.ToString().ToLower()"
                                                    onclick="handleDriverAbsent(this)">
                                                <i class="fas @(isAbsent ? "fa-car" : "fa-car-crash")"></i>
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm py-0 px-1"
                                                    style="font-size:10px;"
                                                    data-refid="@bRefId"
                                                    data-fullname="@bFullName"
                                                    onclick="confirmRemoveDriver($(this).data('refid'), $(this).data('fullname'))">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>

                                </div>

                                <!-- Inline Edit -->
                                <div id="driver-edit-form-@bRefId" class="mt-2 pt-2 border-top" style="display:none;">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <label class="text-muted small mb-0" style="white-space:nowrap;">
                                            <i class="fas fa-users me-1"></i>Passengers:
                                        </label>
                                        <input type="number"
                                               id="driver-edit-pax-@bRefId"
                                               class="form-control form-control-sm"
                                               value="@dPax" min="1" style="max-width:80px;" />
                                        <button class="btn btn-primary btn-sm py-0 px-2" style="font-size:11px;"
                                                id="driver-save-btn-@bRefId"
                                                data-refid="@bRefId"
                                                onclick="saveEditDriver($(this).data('refid'))">
                                            <i class="fas fa-save me-1"></i>Save
                                        </button>
                                        <button class="btn btn-secondary btn-sm py-0 px-2" style="font-size:11px;"
                                                data-refid="@bRefId"
                                                data-pax="@dPax"
                                                onclick="toggleEditDriver($(this).data('refid'), $(this).data('pax'))">
                                            Cancel
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted py-3" id="noAssignedDriverMsg">
                    <i class="fas fa-check-circle text-success me-1"></i> No outside drivers assigned today.
                </div>
            }
        </div>
    </div>

</div>

<!-- Footer -->
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <i class="fas fa-times me-1"></i> Cancel
    </button>
    <button type="button" class="btn btn-info text-dark" id="btnConfirmAssignDriver"
            onclick="confirmAssignOutsideDrivers('@batch')">
        <i class="fas fa-car me-1"></i> Assign Selected Drivers
        (<span id="btnDriverSelectedCount">0</span>)
    </button>
</div>

<style>
    .driver-card {
        transition: all 0.2s;
    }

        .driver-card:hover {
            border-color: #0dcaf0 !important;
            background-color: rgba(13,202,240,.05);
        }

        .driver-card.selected {
            border-color: #0d6efd !important;
            background-color: #cfe2ff;
        }

    .driver-top-card {
        border-color: #0dcaf0 !important;
        background-color: rgba(13,202,240,.05);
    }

    .driver-absent-card {
        border-color: #dc3545 !important;
        background-color: #fff5f5 !important;
        opacity: 0.75;
    }

    .driver-card.limit-locked {
        opacity: 0.4;
        cursor: not-allowed !important;
        pointer-events: none;
    }

    .driver-absent-item .driver-card {
        cursor: not-allowed !important;
    }

    .selected-driver-card {
        border-left: 4px solid #0dcaf0 !important;
    }

    #tab-odriver-queue.active, #tab-odriver-assigned.active {
        border-bottom: 2px solid #0dcaf0 !important;
        color: #0dcaf0 !important;
    }

    .nav-link {
        cursor: pointer;
        border: none;
        background: none;
    }
</style>

<script>
    var selectedDrivers   = {};
    var driverLimit       = @recommendedDrivers;
    var driverGuestTotal  = @guestCount;

    function lockUnselectedDriverCards() {
        $('#driverLimitWarning').show();
        $('.driver-item:not(.driver-absent-item) .driver-card:not(.selected)').addClass('limit-locked');
    }

    function unlockDriverCards() {
        $('#driverLimitWarning').hide();
        $('.driver-item .driver-card').removeClass('limit-locked');
    }

    function toggleSelectDriver(card) {
        var wrapper  = $(card).closest('.driver-item');
        var refId    = wrapper.data('refid');
        var fullName = wrapper.data('fullname');
        var image    = wrapper.data('image');
        var hasTrip  = wrapper.data('hastrip')  === 'true';
        var isAbsent = wrapper.data('isabsent') === 'true' || wrapper.data('isabsent') === true;

        if (isAbsent) { showToast(`${fullName} is marked as absent and cannot be selected.`, 'Absent Driver', 'warning'); return; }
        if (selectedDrivers[refId]) { deselectDriver(refId, hasTrip); return; }
        if (Object.keys(selectedDrivers).length >= driverLimit) {
            $('#driverLimitWarning').show();
            $('#driverLimitWarning').addClass('border border-danger shadow-sm');
            setTimeout(() => $('#driverLimitWarning').removeClass('border border-danger shadow-sm'), 1500);
            return;
        }

        selectedDrivers[refId] = { refId, fullName, image, hasTrip };
        $(card).addClass('selected');
        $(card).find('.driver-status-badge').attr('style', '').removeClass('bg-warning text-dark bg-info').addClass('bg-primary text-white').text('Selected');
        addDriverToSelectedPanel(refId, fullName, image);
        updateDriverSelectedCount();
        if (Object.keys(selectedDrivers).length >= driverLimit) lockUnselectedDriverCards();
    }

    function autoSelectTopDrivers() {
        clearAllSelectedDrivers();
        var count = 0;
        $('#availableDriverList .driver-item').each(function () {
            if (count >= driverLimit) return false;
            var isAbsent = $(this).data('isabsent') === 'true' || $(this).data('isabsent') === true;
            var card     = $(this).find('.driver-card');
            if (!isAbsent && !card.hasClass('limit-locked') && !card.hasClass('selected')) {
                toggleSelectDriver(card[0]); count++;
            }
        });
        if (count === 0) showToast('No available drivers to auto-select.', 'Info', 'info');
        else showToast(`${count} driver(s) auto-selected from FIFO queue.`, 'Auto-Selected', 'success');
    }

    function deselectDriver(refId, hasTrip) {
        if (hasTrip === undefined && selectedDrivers[refId]) hasTrip = selectedDrivers[refId].hasTrip;
        delete selectedDrivers[refId];
        var card  = $(`.driver-item[data-refid="${refId}"] .driver-card`);
        var badge = $(`.driver-item[data-refid="${refId}"] .driver-status-badge`);
        card.removeClass('selected');
        if (hasTrip) badge.attr('style', '').removeClass('bg-primary text-white').addClass('bg-warning text-dark').text('On Trip');
        else badge.removeClass('bg-primary').addClass('bg-info text-dark').attr('style', '').text('Free');
        $(`#selected-driver-card-${refId}`).remove();
        if ($('#selectedDriverList').children().length === 0) $('#selectedDriversSection').hide();
        unlockDriverCards();
        if (Object.keys(selectedDrivers).length >= driverLimit) lockUnselectedDriverCards();
        updateDriverSelectedCount();
    }

    function addDriverToSelectedPanel(refId, fullName, image) {
        var imgHtml = image
            ? `<img src="${image}" style="width:38px;height:38px;object-fit:cover;" class="rounded-circle border border-info" />`
            : `<div style="width:38px;height:38px;background:#0dcaf0;" class="rounded-circle border border-info d-flex align-items-center justify-content-center">
                   <i class="fas fa-car text-white" style="font-size:14px;"></i></div>`;
        $('#selectedDriverList').append(`
            <div class="col-md-6" id="selected-driver-card-${refId}">
                <div class="card selected-driver-card border h-100">
                    <div class="card-body d-flex align-items-center gap-2 p-2">
                        ${imgHtml}
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-semibold small text-truncate">${fullName}</div>
                            <div class="text-muted" style="font-size:10px;">Ref: ${refId}</div>
                        </div>
                        <button class="btn btn-outline-danger btn-sm py-0 px-1" style="font-size:10px;"
                                onclick="deselectDriver('${refId}')"><i class="fas fa-times"></i></button>
                    </div>
                </div>
            </div>`);
        $('#selectedDriversSection').show();
    }

    function clearAllSelectedDrivers() { Object.keys(selectedDrivers).forEach(refId => deselectDriver(refId)); }

    function updateDriverSelectedCount() {
        var count = Object.keys(selectedDrivers).length;
        $('#driverSelectedCount').text(count);
        $('#btnDriverSelectedCount').text(count);
    }

    function switchDriverTab(tab) {
        $('#panel-odriver-queue, #panel-odriver-assigned').hide();
        $('#tab-odriver-queue, #tab-odriver-assigned').removeClass('active');
        $(`#panel-odriver-${tab}`).show();
        $(`#tab-odriver-${tab}`).addClass('active');
        $('#driverSearch').val('');
        $('.driver-item').show();
    }

    function filterOutsideDrivers() {
        var q = $('#driverSearch').val().toLowerCase();
        $('.driver-item[data-panel="queue"]').each(function () {
            var name  = $(this).data('name')        || '';
            var refid = $(this).data('refidSearch') || '';
            $(this).toggle(name.includes(q) || refid.includes(q));
        });
    }

    function toggleEditDriver(refId, currentPax) {
        var form = $(`#driver-edit-form-${refId}`);
        if (form.is(':visible')) {
            form.slideUp(150);
            $(`#driver-edit-pax-${refId}`).val(currentPax);
        } else {
            $('[id^="driver-edit-form-"]').not(form).slideUp(150);
            form.slideDown(150);
            $(`#driver-edit-pax-${refId}`).focus().select();
        }
    }

    function saveEditDriver(refId) {
        var pax = parseInt($(`#driver-edit-pax-${refId}`).val());
        if (isNaN(pax) || pax < 1) {
            alert('Please enter a valid passenger count (min 1).\nTo mark absent, use the Absent button.');
            return;
        }
        var btn = $(`#driver-save-btn-${refId}`);
        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');
        $.ajax({
            url: '@Url.Action("EditOutsideDriverAssignment", "Reserve")',
            type: 'POST',
            data: {
                driverRefId: refId,
                passengers: pax,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (res) {
                if (res.success) {
                    $(`#driver-pax-label-${refId}`).html(
                        `<i class="fas fa-users me-1"></i>Passengers: <strong id="driver-pax-value-${refId}">${pax}</strong>`
                    );
                    $(`#driver-edit-form-${refId}`).slideUp(150);
                    showToast(res.message, 'Updated', 'success');
                } else {
                    showToast(res.message, 'Error', 'danger');
                }
            },
            error:    function () { showToast('Error updating assignment.', 'Error', 'danger'); },
            complete: function () { btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i>Save'); }
        });
    }

    function handleDriverAbsent(btn) {
        var refId    = $(btn).data('refid');
        var isAbsent = $(btn).data('isabsent') === true || $(btn).data('isabsent') === 'true';
        var row      = $(`#assigned-driver-row-${refId}`);
        var nameEl   = row.find('.fw-semibold.small');

        if (isAbsent) {
            $(`#driver-edit-form-${refId}`).slideDown(150);
            $(`#driver-edit-pax-${refId}`).val(1).focus().select();
            showToast('Enter the correct passenger count to restore this driver.', 'Unmark Absent', 'info');
            return;
        }

        if (!confirm(`Mark "${nameEl.text().trim()}" as absent?\n\n✔ Passenger count → 0\n✔ Driver stays in FIFO rotation`)) return;

        $(btn).prop('disabled', true);
        $.ajax({
            url: '@Url.Action("MarkOutsideDriverAbsent", "Reserve")',
            type: 'POST',
            data: { driverRefId: refId, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
            success: function (res) {
                if (res.success) {
                    $(`#driver-pax-label-${refId}`).html(
                        `<i class="fas fa-users me-1"></i>Passengers: <strong id="driver-pax-value-${refId}">0</strong>` +
                        `<span class="text-danger ms-1"><i class="fas fa-car-crash"></i> <em>Absent</em></span>`
                    );
                    row.find('.card').addClass('border-danger bg-danger bg-opacity-5').removeClass('border-info');
                    row.find('.badge:visible').first().attr('style', '').removeClass().addClass('badge bg-danger').text('Absent');
                    nameEl.addClass('text-decoration-line-through text-muted');
                    $(`#driver-edit-btn-${refId}`).hide();
                    $(btn).data('isabsent', 'true')
                          .removeClass('btn-outline-secondary').addClass('btn-outline-success')
                          .attr('title', 'Unmark Absent')
                          .html('<i class="fas fa-car"></i>');

                    var qCard = $(`.driver-item[data-refid="${refId}"]`);
                    qCard.addClass('driver-absent-item').attr('data-isabsent', 'true');
                    qCard.find('.driver-card').addClass('driver-absent-card').removeClass('driver-top-card');
                    qCard.find('.driver-status-badge').attr('style', '').removeClass().addClass('badge bg-danger driver-status-badge').text('Absent');
                    qCard.find('.driver-trip-info').remove();
                    if (selectedDrivers[refId]) deselectDriver(refId, false);
                    showToast(res.message, 'Marked Absent', 'warning');
                } else {
                    showToast(res.message, 'Error', 'danger');
                }
            },
            error:    function () { showToast('Error marking driver absent.', 'Error', 'danger'); },
            complete: function () { $(btn).prop('disabled', false); }
        });
    }

    function confirmRemoveDriver(refId, fullName) {
        if (!confirm(`Remove "${fullName}" from today's assignment?\n\nThey will return to the FIFO queue as if never assigned today.`)) return;
        var row = $(`#assigned-driver-row-${refId}`);
        row.find('.btn').prop('disabled', true);
        $.ajax({
            url: '@Url.Action("RemoveOutsideDriverAssignment", "Reserve")',
            type: 'POST',
            data: { driverRefId: refId, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
            success: function (res) {
                if (res.success) {
                    row.fadeOut(300, function () {
                        $(this).remove();
                        var remaining = $('#assignedDriverList .assigned-driver-row').length;
                        $('#driverAssignedCountBadge').text(remaining);
                        if (remaining === 0) {
                            $('#assignedDriverList').html(
                                `<div class="col-12 text-center text-muted py-3">
                                     <i class="fas fa-check-circle text-success me-1"></i> No outside drivers assigned today.
                                 </div>`
                            );
                        }
                    });
                    var dc = $(`.driver-item[data-refid="${refId}"]`);
                    dc.attr('data-hastrip', 'false').attr('data-isabsent', 'false').removeClass('driver-absent-item');
                    dc.find('.driver-card').removeClass('driver-absent-card driver-top-card');
                    dc.find('.driver-status-badge').removeClass().addClass('badge bg-info text-dark driver-status-badge').attr('style', '').text('Free');
                    dc.find('.driver-trip-info').remove();
                    unlockDriverCards();
                    if (Object.keys(selectedDrivers).length >= driverLimit) lockUnselectedDriverCards();
                    if (selectedDrivers[refId]) deselectDriver(refId, false);
                    showToast(res.message, 'Removed', 'success');
                } else {
                    row.find('.btn').prop('disabled', false);
                    showToast(res.message, 'Error', 'danger');
                }
            },
            error: function () {
                row.find('.btn').prop('disabled', false);
                showToast('Error removing driver assignment.', 'Error', 'danger');
            }
        });
    }

    function confirmAssignOutsideDrivers(batch) {
        var refIds = Object.keys(selectedDrivers);
        if (refIds.length === 0) { alert('Please select at least one driver.'); return; }
        if (refIds.length > driverLimit) { alert(`Maximum ${driverLimit} driver(s) allowed for ${driverGuestTotal} guests.`); return; }

        $('#btnConfirmAssignDriver').prop('disabled', true)
            .html('<span class="spinner-border spinner-border-sm me-1"></span>Assigning...');
        $.ajax({
            url: '@Url.Action("AssignOutsideDriver", "Reserve")',
            type: 'POST',
            traditional: true,
            data: { batch, driverRefIds: refIds, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
            success: function (res) {
                if (res.success) {
                    $(document).trigger('outsideDriverAssigned', [batch]);
                    bootstrap.Modal.getInstance(document.getElementById('assignOutsideDriverModal')).hide();
                    showToast(res.message, 'Success', 'success');
                } else {
                    showToast(res.message, 'Error', 'danger');
                    resetAssignDriverBtn(refIds.length);
                }
            },
            error: function () {
                showToast('Error assigning outside drivers.', 'Error', 'danger');
                resetAssignDriverBtn(refIds.length);
            }
        });
    }

    function resetAssignDriverBtn(count) {
        $('#btnConfirmAssignDriver').prop('disabled', false)
            .html(`<i class="fas fa-car me-1"></i> Assign Selected Drivers (<span id="btnDriverSelectedCount">${count}</span>)`);
    }
</script>
