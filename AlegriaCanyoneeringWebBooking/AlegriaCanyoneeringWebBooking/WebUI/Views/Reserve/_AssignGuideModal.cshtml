@{
    var batch = ViewBag.Batch as string;
    var guestCount = (int)(ViewBag.GuestCount ?? 0);
    var availableGuides = ViewBag.AvailableGuides as IEnumerable<dynamic>;
    var busyGuides = ViewBag.BusyGuides as IEnumerable<dynamic>;
}

<div class="modal-header bg-success text-white">
    <h5 class="modal-title">
        <i class="fas fa-user-tie me-2"></i> Assign Tour Guides
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <!-- Batch Info -->
    <div class="mb-3 p-3 bg-light rounded border">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="fas fa-layer-group me-1 text-success"></i><strong>Batch:</strong> @batch</span>
            <span><i class="fas fa-users me-1 text-primary"></i><strong>Guests:</strong> @guestCount</span>
            <span class="badge bg-success">
                <i class="fas fa-user-tie me-1"></i> Selected: <span id="guideSelectedCount">0</span>
            </span>
        </div>
    </div>

    <!-- Search Box -->
    <div class="mb-3">
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input type="text" id="guideSearch" class="form-control"
                   placeholder="Search guide by name or RFID..."
                   oninput="filterGuides()" />
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link active" id="guide-tab-available" onclick="switchGuideTab('available')">
                <i class="fas fa-check-circle text-success me-1"></i>
                Available
                <span class="badge bg-success ms-1">@(availableGuides?.Count() ?? 0)</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="guide-tab-busy" onclick="switchGuideTab('busy')">
                <i class="fas fa-clock text-warning me-1"></i>
                Busy
                <span class="badge bg-warning text-dark ms-1">@(busyGuides?.Count() ?? 0)</span>
            </button>
        </li>
    </ul>

    <!-- Available Guides Panel -->
    <div id="guide-panel-available">
        <p class="text-muted small mb-2">
            <i class="fas fa-hand-pointer me-1"></i>
            Click a guide to select. Busy guides appear at the bottom and can still be selected.
        </p>
        <div class="row g-2" id="availableGuideList">
            @if (availableGuides != null && availableGuides.Any())
            {
                foreach (var g in availableGuides)
                {
                    bool isBusy = (bool)(g.isBusy ?? false);
                    <div class="col-md-6 guide-item @(isBusy ? "guide-busy-row" : "")"
                         data-name="@g.fullName.ToLower()"
                         data-ref="@g.Rfid.ToLower()"
                         data-panel="available"
                         data-rfid="@g.Rfid"
                         data-fullname="@g.fullName"
                         data-image="@(g.Image ?? "")">
                        <div class="card guide-card border-2 h-100 @(isBusy ? "border-warning" : "")"
                             style="cursor:pointer; @(isBusy ? "opacity:0.75;" : "")"
                             onclick="toggleSelectGuide(this)">
                            <div class="card-body d-flex align-items-center gap-3 p-2">
                                @if (!string.IsNullOrEmpty((string)g.Image))
                                {
                                    <img src="@g.Image"
                                         style="width:50px;height:50px;object-fit:cover;"
                                         class="rounded-circle border @(isBusy ? "border-warning" : "")" />
                                }
                                else
                                {
                                    <div style="width:50px;height:50px;"
                                         class="rounded-circle border @(isBusy ? "border-warning bg-light" : "bg-secondary") d-flex align-items-center justify-content-center">
                                        <i class="fas fa-user @(isBusy ? "text-warning" : "text-white")"></i>
                                    </div>
                                }
                                <div class="flex-grow-1">
                                    <div class="fw-semibold small">@g.fullName</div>
                                    <div class="text-muted" style="font-size:11px;">
                                        <i class="fas fa-id-card me-1"></i>RFID: @g.Rfid
                                    </div>
                                    @if (isBusy)
                                    {
                                        <div style="font-size:10px;" class="text-warning">
                                            <i class="fas fa-users me-1"></i>Currently serving: @g.passengers pax
                                        </div>
                                    }
                                </div>
                                @if (isBusy)
                                {
                                    <span class="badge bg-warning text-dark guide-status-badge">Busy</span>
                                }
                                else
                                {
                                    <span class="badge bg-success guide-status-badge">Free</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted py-3">
                    <i class="fas fa-info-circle me-1"></i> No guides found.
                </div>
            }
        </div>

        <!-- Selected Guides Section -->
        <div id="selectedGuidesSection" class="mt-3" style="display:none;">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h6 class="fw-bold text-success mb-0">
                    <i class="fas fa-check-double me-1"></i> Selected Guides
                </h6>
                <button class="btn btn-outline-danger btn-sm" onclick="clearAllSelectedGuides()">
                    <i class="fas fa-times me-1"></i> Clear All
                </button>
            </div>
            <div class="row g-2" id="selectedGuideList"></div>
        </div>
    </div>

    <!-- Busy Guides Panel — info only -->
    <div id="guide-panel-busy" style="display:none;">
        <div class="alert alert-info py-2 small mb-2">
            <i class="fas fa-info-circle me-1"></i>
            Guides currently on a trip. They are still selectable from the
            <strong>Available</strong> tab and will cycle to the bottom automatically.
        </div>
        <div class="row g-2" id="busyGuideList">
            @if (busyGuides != null && busyGuides.Any())
            {
                int pos = 1;
                foreach (var g in busyGuides)
                {
                    <div class="col-md-6 guide-item"
                         data-name="@g.fullName.ToLower()"
                         data-ref="@g.Rfid.ToLower()"
                         data-panel="busy">
                        <div class="card border-warning h-100">
                            <div class="card-body d-flex align-items-center gap-2 p-2">
                                <div class="text-warning fw-bold" style="font-size:16px; min-width:24px;">#@pos</div>
                                @if (!string.IsNullOrEmpty((string)g.Image))
                                {
                                    <img src="@g.Image"
                                         style="width:45px;height:45px;object-fit:cover;"
                                         class="rounded-circle border border-warning" />
                                }
                                else
                                {
                                    <div style="width:45px;height:45px;"
                                         class="rounded-circle border border-warning bg-light d-flex align-items-center justify-content-center">
                                        <i class="fas fa-user text-warning"></i>
                                    </div>
                                }
                                <div class="flex-grow-1">
                                    <div class="fw-semibold small">@g.fullName</div>
                                    <div class="text-muted" style="font-size:10px;">
                                        <i class="fas fa-id-card me-1"></i>RFID: @g.Rfid
                                    </div>
                                    <div style="font-size:10px;" class="text-info">
                                        <i class="fas fa-users me-1"></i>Passengers: @g.passengers
                                    </div>
                                </div>
                                <span class="badge bg-warning text-dark">Busy</span>
                            </div>
                        </div>
                    </div>
                    pos++;
                }
            }
            else
            {
                <div class="col-12 text-center text-muted py-3">
                    <i class="fas fa-check-circle text-success me-1"></i> No guides are busy today.
                </div>
            }
        </div>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <i class="fas fa-times me-1"></i> Cancel
    </button>
    <button type="button" class="btn btn-success text-white" id="btnConfirmAssignGuide"
            onclick="confirmAssignGuide('@batch')">
        <i class="fas fa-user-tie me-1"></i> Assign Selected Guides
        (<span id="btnGuideSelectedCount">0</span>)
    </button>
</div>

<style>
    .guide-card {
        transition: all 0.2s;
    }

        .guide-card:hover {
            border-color: #198754 !important;
            background-color: #f0fff4;
        }

        .guide-card.selected {
            border-color: #0d6efd !important;
            background-color: #cfe2ff;
        }

    .selected-guide-card {
        border-left: 4px solid #198754 !important;
    }

    .guide-busy-row .guide-card:hover {
        border-color: #ffc107 !important;
        background-color: #fffbf0;
    }
</style>

<script>
    var selectedGuides = {};

    function toggleSelectGuide(card) {
        var wrapper  = $(card).closest('.guide-item');
        var rfid     = wrapper.data('rfid');
        var fullName = wrapper.data('fullname');
        var image    = wrapper.data('image');

        if (selectedGuides[rfid]) {
            deselectGuide(rfid);
        } else {
            selectedGuides[rfid] = { rfid, fullName, image };
            $(card).addClass('selected');
            $(card).find('.guide-status-badge')
                   .removeClass('bg-success bg-warning text-dark').addClass('bg-primary').text('Selected');
            addToSelectedGuidePanel(rfid, fullName, image);
        }
        updateGuideSelectedCount();
    }

    function addToSelectedGuidePanel(rfid, fullName, image) {
        var imgHtml = image
            ? `<img src="${image}" style="width:40px;height:40px;object-fit:cover;" class="rounded-circle border" />`
            : `<div style="width:40px;height:40px;" class="rounded-circle border bg-secondary d-flex align-items-center justify-content-center"><i class="fas fa-user text-white"></i></div>`;

        $('#selectedGuideList').append(`
            <div class="col-md-6" id="selected-guide-card-${rfid}">
                <div class="card selected-guide-card border h-100">
                    <div class="card-body d-flex align-items-center gap-2 p-2">
                        ${imgHtml}
                        <div class="flex-grow-1">
                            <div class="fw-semibold small">${fullName}</div>
                            <div class="text-muted" style="font-size:11px;">RFID: ${rfid}</div>
                        </div>
                        <button class="btn btn-outline-danger btn-sm py-0 px-1"
                                style="font-size:11px;"
                                onclick="deselectGuide('${rfid}')">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            </div>`);
        $('#selectedGuidesSection').show();
    }

    function deselectGuide(rfid) {
        delete selectedGuides[rfid];
        $(`.guide-item[data-rfid="${rfid}"] .guide-card`).removeClass('selected');
        // ✅ Restore correct badge
        var isBusy = $(`.guide-item[data-rfid="${rfid}"]`).hasClass('guide-busy-row');
        if (isBusy) {
            $(`.guide-item[data-rfid="${rfid}"] .guide-status-badge`)
                .removeClass('bg-primary').addClass('bg-warning text-dark').text('Busy');
        } else {
            $(`.guide-item[data-rfid="${rfid}"] .guide-status-badge`)
                .removeClass('bg-primary').addClass('bg-success').text('Free');
        }
        $(`#selected-guide-card-${rfid}`).remove();
        if ($('#selectedGuideList').children().length === 0)
            $('#selectedGuidesSection').hide();
        updateGuideSelectedCount();
    }

    function clearAllSelectedGuides() {
        Object.keys(selectedGuides).forEach(function(rfid) { deselectGuide(rfid); });
    }

    function updateGuideSelectedCount() {
        var count = Object.keys(selectedGuides).length;
        $('#guideSelectedCount').text(count);
        $('#btnGuideSelectedCount').text(count);
    }

    function switchGuideTab(tab) {
        $('#guide-panel-available, #guide-panel-busy').hide();
        $('#guide-tab-available, #guide-tab-busy').removeClass('active');
        $(`#guide-panel-${tab}`).show();
        $(`#guide-tab-${tab}`).addClass('active');
        $('#guideSearch').val('');
        $('.guide-item').show();
    }

    function filterGuides() {
        var q = $('#guideSearch').val().toLowerCase();
        var activePanel = $('#guide-panel-available').is(':visible') ? 'available' : 'busy';
        $(`.guide-item[data-panel="${activePanel}"]`).each(function () {
            var name = $(this).data('name');
            var ref  = $(this).data('ref');
            $(this).toggle(name.includes(q) || ref.includes(q));
        });
    }

    function confirmAssignGuide(batch) {
        var rfids = Object.keys(selectedGuides);
        if (rfids.length === 0) {
            alert('Please select at least one guide.');
            return;
        }

        $('#btnConfirmAssignGuide')
            .prop('disabled', true)
            .html('<span class="spinner-border spinner-border-sm me-1"></span>Assigning...');

        $.ajax({
            url: '@Url.Action("AssignGuides", "Reserve")',
            type: 'POST',
            traditional: true,
            data: {
                batch      : batch,
                guideRfids : rfids,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (res) {
                if (res.success) {
                    $(document).trigger('guideAssigned', [batch]);
                    bootstrap.Modal.getInstance(
                        document.getElementById('assignGuideModal')
                    ).hide();
                    showToast(res.message, 'Success', 'success');
                } else {
                    showToast(res.message, 'Error', 'danger');
                    $('#btnConfirmAssignGuide')
                        .prop('disabled', false)
                        .html(`<i class="fas fa-user-tie me-1"></i> Assign Selected Guides (<span id="btnGuideSelectedCount">${rfids.length}</span>)`);
                }
            },
            error: function () {
                showToast('Error assigning guides.', 'Error', 'danger');
                $('#btnConfirmAssignGuide')
                    .prop('disabled', false)
                    .html(`<i class="fas fa-user-tie me-1"></i> Assign Selected Guides (<span id="btnGuideSelectedCount">${rfids.length}</span>)`);
            }
        });
    }
</script>