@{
    var batch = ViewBag.Batch as string;
    var guestCount = (int)(ViewBag.GuestCount ?? 0);
    var recommendedGuides = (int)(ViewBag.RecommendedGuides ?? 0);
    var availableGuides = ViewBag.AvailableGuides as IEnumerable<dynamic>;
    var busyGuides = ViewBag.BusyGuides as IEnumerable<dynamic>;
    int totalGuides = availableGuides?.Count() ?? 0;
}

<div class="modal-header bg-success text-white">
    <h5 class="modal-title">
        <i class="fas fa-user-tie me-2"></i> Assign Guides
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">

    <!-- Batch Info Bar -->
    <div class="mb-3 p-3 bg-light rounded border">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
                <i class="fas fa-layer-group me-1 text-success"></i>
                <strong>Batch:</strong> @batch
            </span>
            <span>
                <i class="fas fa-users me-1 text-primary"></i>
                <strong>Guests:</strong> @guestCount
            </span>
            <span class="badge bg-success fs-6">
                <i class="fas fa-user-tie me-1"></i>
                Limit: @recommendedGuides guide@(recommendedGuides != 1 ? "s" : "")
            </span>
            <span class="badge bg-primary fs-6">
                <i class="fas fa-user-tie me-1"></i>
                Selected: <span id="guideSelectedCount">0</span> / @recommendedGuides
            </span>
        </div>
    </div>

    <!-- FIFO Queue Explanation -->
    <div class="alert alert-success py-2 mb-3 small">
        <div class="d-flex align-items-start gap-2">
            <i class="fas fa-sort-numeric-up mt-1 flex-shrink-0"></i>
            <div>
                <strong>FIFO Queue</strong> — Guide who waited longest is <strong>#1</strong> (next to assign).
                After assignment, guide moves to the <strong>bottom</strong>. Cycle repeats:
                <code>#1 → #2 → ... → Last → #1</code>
                &nbsp;|&nbsp;
                <span class="text-danger"><i class="fas fa-user-times me-1"></i>Absent</span> =
                0 guests, still cycles in queue.
            </div>
        </div>
    </div>

    <!-- Limit Warning Banner -->
    <div id="guideLimitWarning"
         class="alert alert-danger d-flex align-items-center gap-2 py-2 mb-3"
         style="display:none !important;">
        <i class="fas fa-ban fa-lg"></i>
        <div>
            <strong>Limit Reached!</strong>
            Max <strong>@recommendedGuides guide@(recommendedGuides != 1 ? "s" : "")</strong>
            for @guestCount guests.
            Deselect a guide to pick a different one.
        </div>
    </div>

    <!-- Search -->
    <div class="mb-3">
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input type="text" id="guideSearch" class="form-control"
                   placeholder="Search guide by name or RFID..."
                   oninput="filterGuides()" />
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link active" id="tab-guides" onclick="switchGuideTab('guides')">
                <i class="fas fa-sort-numeric-up text-success me-1"></i>
                Queue
                <span class="badge bg-success ms-1">@totalGuides</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="tab-assigned" onclick="switchGuideTab('assigned')">
                <i class="fas fa-clock text-warning me-1"></i>
                Assigned Today
                <span class="badge bg-warning text-dark ms-1" id="assignedCountBadge">
                    @(busyGuides?.Count() ?? 0)
                </span>
            </button>
        </li>
    </ul>

    <!-- ============================================
         PANEL: FIFO QUEUE — Guide Selection
         ============================================ -->
    <div id="panel-guides">

        <!-- Auto-Select Suggestion Bar -->
        @if (availableGuides != null && availableGuides.Any() && recommendedGuides > 0)
        {
            <div class="d-flex align-items-center gap-2 flex-wrap mb-3 p-2 rounded border border-success border-opacity-25 bg-success bg-opacity-10">
                <i class="fas fa-magic text-success flex-shrink-0"></i>
                <span class="small text-success fw-semibold">Next in Queue:</span>
                @{
                    int shownCount = 0;
                    foreach (var g in availableGuides)
                    {
                        if (shownCount >= recommendedGuides) break;
                        bool gIsAbsent = (bool)(g.isAbsent ?? false);
                        if (!gIsAbsent)
                        {
                            int gQPos = (int)(g.queuePosition ?? 0);
                            string gFirstName = ((string)(g.fullName ?? "")).Split(' ')[0];
                            <span class="badge bg-success py-1 px-2">
                                #@gQPos @gFirstName
                            </span>
                            shownCount++;
                        }
                    }
                    if (shownCount == 0)
                    {
                        <span class="text-muted small fst-italic">All top guides are absent today</span>
                    }
                }
                <button class="btn btn-success btn-sm ms-auto py-0 px-2"
                        style="font-size:11px;"
                        onclick="autoSelectTopGuides()"
                        title="Automatically select the next @recommendedGuides guide(s) in queue">
                    <i class="fas fa-check-double me-1"></i>Auto-Select Top @recommendedGuides
                </button>
            </div>
        }

        <div class="row g-2" id="availableGuideList">
            @if (availableGuides != null && availableGuides.Any())
            {
                foreach (var g in availableGuides)
                {
                    bool hasTrip = (bool)(g.hasTrip ?? false);
                    bool isAbsent = (bool)(g.isAbsent ?? false);
                    int qPos = (int)(g.queuePosition ?? 0);
                    bool isTopN = qPos <= recommendedGuides && !isAbsent;

                    // ✅ null-safe strings for data attributes
                    string gRfid = (string)(g.Rfid ?? "");
                    string gFullName = (string)(g.fullName ?? "");
                    string gImage = (string)(g.Image ?? "");

                    <div class="col-md-6 guide-item @(isAbsent ? "guide-absent-item" : "")"
                         data-name="@gFullName.ToLower()"
                         data-rfid-search="@gRfid.ToLower()"
                         data-panel="guides"
                         data-guiderfid="@gRfid"
                         data-fullname="@gFullName"
                         data-hastrip="@hasTrip.ToString().ToLower()"
                         data-isabsent="@isAbsent.ToString().ToLower()"
                         data-image="@gImage">

                        <div class="card guide-card border-2 h-100
                                            @(isAbsent ? "guide-absent-card" : "")
                                            @(isTopN ? "guide-top-card" : "")"
                             style="cursor:pointer;"
                             onclick="toggleSelectGuide(this)">

                            <div class="card-body d-flex align-items-center gap-2 p-2">

                                <!-- Queue Position Badge -->
                                <div class="d-flex flex-column align-items-center flex-shrink-0"
                                     style="min-width:34px;">
                                    <span class="badge @(isAbsent ? "bg-danger" : (isTopN ? "bg-success" : "bg-secondary"))"
                                          style="font-size:11px; width:30px; text-align:center;">
                                        #@qPos
                                    </span>
                                    @if (isTopN)
                                    {
                                        <span style="font-size:8px; white-space:nowrap;" class="text-success fw-bold">NEXT</span>
                                    }
                                    else if (isAbsent)
                                    {
                                        <span style="font-size:8px;" class="text-danger fw-bold">ABS</span>
                                    }
                                </div>

                                <!-- Avatar -->
                                @if (!string.IsNullOrEmpty(gImage))
                                {
                                    <img src="@gImage"
                                         style="width:44px;height:44px;object-fit:cover; @(isAbsent ? "filter:grayscale(70%);" : "")"
                                         class="rounded-circle border @(isAbsent ? "border-danger" : "")" />
                                }
                                else
                                {
                                    <div style="width:44px;height:44px;"
                                         class="rounded-circle border @(isAbsent ? "border-danger bg-danger bg-opacity-10" : "bg-secondary") d-flex align-items-center justify-content-center">
                                        <i class="fas fa-user @(isAbsent ? "text-danger" : "text-white")"></i>
                                    </div>
                                }

                                <!-- Info -->
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="fw-semibold small text-truncate @(isAbsent ? "text-decoration-line-through text-muted" : "")">
                                        @gFullName
                                    </div>
                                    <div class="text-muted" style="font-size:10px;">
                                        <i class="fas fa-id-card me-1"></i>RFID: @gRfid
                                    </div>
                                    @if (isAbsent)
                                    {
                                        <div style="font-size:10px;" class="text-danger">
                                            <i class="fas fa-user-times me-1"></i>Absent — 0 guests
                                        </div>
                                    }
                                    else if (hasTrip)
                                    {
                                      @*   <div style="font-size:10px;" class="text-warning trip-info">
                                            <i class="fas fa-users me-1"></i>Last: @g.passengers pax
                                        </div> *@
                                    }
                                    else
                                    {
                                        <div style="font-size:10px;" class="text-success">
                                            <i class="fas fa-clock me-1"></i>Never assigned
                                        </div>
                                    }
                                </div>

                                <!-- Status Badge -->
                                @if (isAbsent)
                                {
                                    <span class="badge bg-danger guide-status-badge">Absent</span>
                                }
                                else if (hasTrip)
                                {
                                    <span class="badge bg-warning text-dark guide-status-badge">On Trip</span>
                                }
                                else
                                {
                                    <span class="badge bg-success guide-status-badge">Free</span>
                                }

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted py-3">
                    <i class="fas fa-info-circle me-1"></i> No guides found.
                </div>
            }
        </div>

        <!-- Selected Guides Section -->
        <div id="selectedGuidesSection" class="mt-3" style="display:none;">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h6 class="fw-bold text-success mb-0">
                    <i class="fas fa-check-double me-1"></i> Selected Guides
                </h6>
                <button class="btn btn-outline-danger btn-sm" onclick="clearAllSelectedGuides()">
                    <i class="fas fa-times me-1"></i> Clear All
                </button>
            </div>
            <div class="row g-2" id="selectedGuideList"></div>
        </div>
    </div>

    <!-- ============================================
         PANEL: ASSIGNED TODAY (Edit / Absent / Remove)
         ============================================ -->
    <div id="panel-assigned" style="display:none;">

        <div class="alert alert-info py-2 small mb-2">
            <i class="fas fa-info-circle me-1"></i>
            <strong>Edit</strong> = update passenger count &nbsp;|&nbsp;
            <span class="text-danger"><strong>Absent</strong></span> = set 0 guests, guide still cycles in FIFO &nbsp;|&nbsp;
            <strong>Remove</strong> = fully unassign
        </div>

        <div class="row g-2" id="assignedGuideList">
            @if (busyGuides != null && busyGuides.Any())
            {
                foreach (var g in busyGuides)
                {
                    bool isAbsent = (bool)(g.isAbsent ?? false);
                    int queuePosN = (int)(g.queuePos ?? 0);

                    // ✅ null-safe strings
                    string bRfid = (string)(g.Rfid ?? "");
                    string bFullName = (string)(g.fullName ?? "");
                    string bImage = (string)(g.Image ?? "");

                    <div class="col-12 assigned-guide-row" id="assigned-row-@bRfid">
                        <div class="card @(isAbsent ? "border-danger bg-danger bg-opacity-5" : "border-warning")">
                            <div class="card-body p-2">

                                <!-- Guide Info Row -->
                                <div class="d-flex align-items-center gap-2">

                                    <!-- Queue # -->
                                    <div class="@(isAbsent ? "text-danger" : "text-warning") fw-bold text-center flex-shrink-0"
                                         style="font-size:14px; min-width:28px;">
                                        #@queuePosN
                                    </div>

                                    <!-- Avatar -->
                                    @if (!string.IsNullOrEmpty(bImage))
                                    {
                                        <img src="@bImage"
                                             style="width:44px;height:44px;object-fit:cover; @(isAbsent ? "filter:grayscale(70%);" : "")"
                                             class="rounded-circle border @(isAbsent ? "border-danger" : "border-warning")" />
                                    }
                                    else
                                    {
                                        <div style="width:44px;height:44px;"
                                             class="rounded-circle border @(isAbsent ? "border-danger bg-light" : "border-warning bg-light") d-flex align-items-center justify-content-center">
                                            <i class="fas fa-user @(isAbsent ? "text-danger" : "text-warning")"></i>
                                        </div>
                                    }

                                    <!-- Info -->
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-semibold small text-truncate @(isAbsent ? "text-decoration-line-through text-muted" : "")">
                                            @bFullName
                                        </div>
                                        <div class="text-muted" style="font-size:10px;">
                                            <i class="fas fa-id-card me-1"></i>RFID: @bRfid
                                        </div>
                                        @* <div style="font-size:10px;"
                                             class="@(isAbsent ? "text-danger" : "text-info")"
                                             id="pax-label-@bRfid">
                                            <i class="fas fa-users me-1"></i>
                                            Passengers: <strong id="pax-value-@bRfid">@g.passengers</strong>
                                            @if (isAbsent)
                                            {
                                                <span class="ms-1">
                                                    <i class="fas fa-user-times"></i> <em>Absent</em>
                                                </span>
                                            }
                                        </div> *@
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
                                        @if (isAbsent)
                                        {
                                            <span class="badge bg-danger mb-1">Absent</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark mb-1">On Trip</span>
                                        }

                                        <div class="d-flex gap-1">
                                            @if (!isAbsent)
                                            {
                                                <button class="btn btn-outline-primary btn-sm py-0 px-1"
                                                        style="font-size:10px;"
                                                        title="Edit passenger count"
                                                        id="edit-btn-@bRfid"
                                                        data-rfid="@bRfid"
                                                        data-pax="@g.passengers"
                                                        onclick="toggleEditGuide($(this).data('rfid'), $(this).data('pax'))">
                                                    <i class="fas fa-pencil-alt"></i>
                                                </button>
                                            }

                                            <!-- Mark/Unmark Absent Button -->
                                            <button class="btn @(isAbsent ? "btn-outline-success" : "btn-outline-secondary") btn-sm py-0 px-1"
                                                    style="font-size:10px;"
                                                    title="@(isAbsent ? "Unmark Absent — restore guests" : "Mark as Absent (0 guests, stays in queue)")"
                                                    id="absent-btn-@bRfid"
                                                    data-rfid="@bRfid"
                                                    data-isabsent="@isAbsent.ToString().ToLower()"
                                                    onclick="handleGuideAbsent(this)">
                                                <i class="fas @(isAbsent ? "fa-user-check" : "fa-user-times")"></i>
                                            </button>

                                            <!-- Remove -->
                                            <button class="btn btn-outline-danger btn-sm py-0 px-1"
                                                    style="font-size:10px;"
                                                    title="Remove guide assignment"
                                                    data-rfid="@bRfid"
                                                    data-fullname="@bFullName"
                                                    onclick="confirmRemoveGuide($(this).data('rfid'), $(this).data('fullname'))">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>

                                </div>

                                <!-- Inline Edit Form -->
                                <div id="edit-form-@bRfid" class="mt-2 pt-2 border-top" style="display:none;">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <label class="text-muted small mb-0" style="white-space:nowrap;">
                                            <i class="fas fa-users me-1"></i>Passengers:
                                        </label>
                                        <input type="number"
                                               id="edit-pax-@bRfid"
                                               class="form-control form-control-sm"
                                               value="@g.passengers"
                                               min="1"
                                               style="max-width:80px;" />
                                        <button class="btn btn-primary btn-sm py-0 px-2"
                                                style="font-size:11px;"
                                                id="save-btn-@bRfid"
                                                data-rfid="@bRfid"
                                                onclick="saveEditGuide($(this).data('rfid'))">
                                            <i class="fas fa-save me-1"></i>Save
                                        </button>
                                        <button class="btn btn-secondary btn-sm py-0 px-2"
                                                style="font-size:11px;"
                                                data-rfid="@bRfid"
                                                data-pax="@g.passengers"
                                                onclick="toggleEditGuide($(this).data('rfid'), $(this).data('pax'))">
                                            Cancel
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted py-3" id="noAssignedMsg">
                    <i class="fas fa-check-circle text-success me-1"></i> No guides assigned today.
                </div>
            }
        </div>
    </div>

</div>

<!-- Footer -->
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <i class="fas fa-times me-1"></i> Cancel
    </button>
    <button type="button" class="btn btn-success" id="btnConfirmAssignGuide"
            onclick="confirmAssignGuides('@batch')">
        <i class="fas fa-user-tie me-1"></i> Assign Selected Guides
        (<span id="btnGuideSelectedCount">0</span>)
    </button>
</div>

<!-- ===== STYLES ===== -->
<style>
    .guide-card {
        transition: all 0.2s;
    }

        .guide-card:hover {
            border-color: #198754 !important;
            background-color: #f0fff4;
        }

        .guide-card.selected {
            border-color: #0d6efd !important;
            background-color: #cfe2ff;
        }

    .guide-top-card {
        border-color: #198754 !important;
        background-color: #f0fff4;
    }

    .guide-absent-card {
        border-color: #dc3545 !important;
        background-color: #fff5f5 !important;
        opacity: 0.75;
    }

    .guide-card.limit-locked {
        opacity: 0.4;
        cursor: not-allowed !important;
        pointer-events: none;
    }

    .guide-absent-item .guide-card {
        cursor: not-allowed !important;
    }

    .selected-guide-card {
        border-left: 4px solid #198754 !important;
    }

    .nav-link {
        cursor: pointer;
        border: none;
        background: none;
    }

        .nav-link.active {
            border-bottom: 2px solid #198754 !important;
            color: #198754 !important;
        }

    #panel-assigned .card {
        transition: all 0.3s;
    }
</style>

<!-- ===== SCRIPTS ===== -->
<script>
    var selectedGuides = {};
    var guideLimit     = @recommendedGuides;
    var guestTotal     = @guestCount;

    function lockUnselectedGuideCards() {
        $('#guideLimitWarning').show();
        $('.guide-item:not(.guide-absent-item) .guide-card:not(.selected)').addClass('limit-locked');
    }

    function unlockGuideCards() {
        $('#guideLimitWarning').hide();
        $('.guide-item .guide-card').removeClass('limit-locked');
    }

    function toggleSelectGuide(card) {
        var wrapper  = $(card).closest('.guide-item');
        var rfid     = wrapper.data('guiderfid');
        var fullName = wrapper.data('fullname');
        var image    = wrapper.data('image');
        var hasTrip  = wrapper.data('hastrip')  === 'true';
        var isAbsent = wrapper.data('isabsent') === 'true' || wrapper.data('isabsent') === true;

        if (isAbsent) {
            showToast(`${fullName} is marked as absent and cannot be selected.`, 'Absent Guide', 'warning');
            return;
        }

        if (selectedGuides[rfid]) { deselectGuide(rfid, hasTrip); return; }

        if (Object.keys(selectedGuides).length >= guideLimit) {
            $('#guideLimitWarning').show();
            $('#guideLimitWarning').addClass('border border-danger shadow-sm');
            setTimeout(() => $('#guideLimitWarning').removeClass('border border-danger shadow-sm'), 1500);
            return;
        }

        selectedGuides[rfid] = { rfid, fullName, image, hasTrip };
        $(card).addClass('selected');
        $(card).find('.guide-status-badge')
               .removeClass('bg-success bg-warning text-dark')
               .addClass('bg-primary').text('Selected');

        addGuideToSelectedPanel(rfid, fullName, image);
        updateGuideSelectedCount();

        if (Object.keys(selectedGuides).length >= guideLimit) lockUnselectedGuideCards();
    }

    function autoSelectTopGuides() {
        clearAllSelectedGuides();
        var count = 0;
        $('#availableGuideList .guide-item').each(function () {
            if (count >= guideLimit) return false;
            var isAbsent   = $(this).data('isabsent') === 'true' || $(this).data('isabsent') === true;
            var card       = $(this).find('.guide-card');
            if (!isAbsent && !card.hasClass('limit-locked') && !card.hasClass('selected')) {
                toggleSelectGuide(card[0]);
                count++;
            }
        });
        if (count === 0) showToast('No available guides to auto-select (all may be absent).', 'Info', 'info');
        else showToast(`${count} guide(s) auto-selected from FIFO queue.`, 'Auto-Selected', 'success');
    }

    function deselectGuide(rfid, hasTrip) {
        if (hasTrip === undefined && selectedGuides[rfid]) hasTrip = selectedGuides[rfid].hasTrip;
        delete selectedGuides[rfid];

        var card  = $(`.guide-item[data-guiderfid="${rfid}"] .guide-card`);
        var badge = $(`.guide-item[data-guiderfid="${rfid}"] .guide-status-badge`);
        card.removeClass('selected');

        if (hasTrip) badge.removeClass('bg-primary').addClass('bg-warning text-dark').text('On Trip');
        else badge.removeClass('bg-primary text-dark').addClass('bg-success').text('Free');

        $(`#selected-guide-card-${rfid}`).remove();
        if ($('#selectedGuideList').children().length === 0) $('#selectedGuidesSection').hide();

        unlockGuideCards();
        if (Object.keys(selectedGuides).length >= guideLimit) lockUnselectedGuideCards();
        updateGuideSelectedCount();
    }

    function addGuideToSelectedPanel(rfid, fullName, image) {
        var imgHtml = image
            ? `<img src="${image}" style="width:38px;height:38px;object-fit:cover;" class="rounded-circle border" />`
            : `<div style="width:38px;height:38px;" class="rounded-circle border bg-secondary d-flex align-items-center justify-content-center">
                   <i class="fas fa-user text-white" style="font-size:14px;"></i>
               </div>`;

        $('#selectedGuideList').append(`
            <div class="col-md-6" id="selected-guide-card-${rfid}">
                <div class="card selected-guide-card border h-100">
                    <div class="card-body d-flex align-items-center gap-2 p-2">
                        ${imgHtml}
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-semibold small text-truncate">${fullName}</div>
                            <div class="text-muted" style="font-size:10px;">RFID: ${rfid}</div>
                        </div>
                        <button class="btn btn-outline-danger btn-sm py-0 px-1"
                                style="font-size:10px;" onclick="deselectGuide('${rfid}')">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            </div>`);
        $('#selectedGuidesSection').show();
    }

    function clearAllSelectedGuides() {
        Object.keys(selectedGuides).forEach(rfid => deselectGuide(rfid));
    }

    function updateGuideSelectedCount() {
        var count = Object.keys(selectedGuides).length;
        $('#guideSelectedCount').text(count);
        $('#btnGuideSelectedCount').text(count);
    }

    function switchGuideTab(tab) {
        $('#panel-guides, #panel-assigned').hide();
        $('#tab-guides, #tab-assigned').removeClass('active');
        $(`#panel-${tab}`).show();
        $(`#tab-${tab}`).addClass('active');
        $('#guideSearch').val('');
        $('.guide-item').show();
    }

    // ✅ FIXED: jQuery camelCases data-rfid-search → rfidSearch
    function filterGuides() {
        var q = $('#guideSearch').val().toLowerCase();
        $('.guide-item[data-panel="guides"]').each(function () {
            var name = $(this).data('name')       || '';
            var rfid = $(this).data('rfidSearch') || '';   // ✅ was 'rfid-search' — broken
            $(this).toggle(name.includes(q) || rfid.includes(q));
        });
    }

    function toggleEditGuide(rfid, currentPax) {
        var form = $(`#edit-form-${rfid}`);
        if (form.is(':visible')) {
            form.slideUp(150);
            $(`#edit-pax-${rfid}`).val(currentPax);
        } else {
            $('[id^="edit-form-"]').not(form).slideUp(150);
            form.slideDown(150);
            $(`#edit-pax-${rfid}`).focus().select();
        }
    }

    function saveEditGuide(rfid) {
        var passengers = parseInt($(`#edit-pax-${rfid}`).val());
        if (isNaN(passengers) || passengers < 1) {
            alert('Please enter a valid passenger count (minimum 1).\nTo mark absent, use the Absent button.');
            return;
        }
        var btn = $(`#save-btn-${rfid}`);
        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');
        $.ajax({
            url: '@Url.Action("EditGuideAssignment", "Reserve")',
            type: 'POST',
            data: {
                guideRfid  : rfid,
                passengers : passengers,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (res) {
                if (res.success) {
                    $(`#pax-label-${rfid}`).html(
                        `<i class="fas fa-users me-1"></i>Passengers: <strong id="pax-value-${rfid}">${passengers}</strong>`
                    );
                    $(`#edit-form-${rfid}`).slideUp(150);
                    showToast(res.message, 'Updated', 'success');
                } else {
                    showToast(res.message, 'Error', 'danger');
                }
            },
            error: function () { showToast('Error updating guide assignment.', 'Error', 'danger'); },
            complete: function () { btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i>Save'); }
        });
    }

    function handleGuideAbsent(btn) {
        var rfid       = $(btn).data('rfid');
        var isAbsent   = $(btn).data('isabsent') === true || $(btn).data('isabsent') === 'true';
        var row        = $(`#assigned-row-${rfid}`);
        var fullNameEl = row.find('.fw-semibold.small');
        var fullName   = fullNameEl.text().trim();

        if (isAbsent) {
            $(`#edit-form-${rfid}`).slideDown(150);
            $(`#edit-pax-${rfid}`).val(1).focus().select();
            showToast('Enter the correct passenger count to restore this guide.', 'Unmark Absent', 'info');
            return;
        }

        if (!confirm(`Mark "${fullName}" as absent?\n\n✔ Guest count → 0\n✔ Guide stays in FIFO rotation\n✔ Cannot be selected for new batches today`))
            return;

        $(btn).prop('disabled', true);
        $.ajax({
            url: '@Url.Action("MarkGuideAbsent", "Reserve")',
            type: 'POST',
            data: {
                guideRfid: rfid,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (res) {
                if (res.success) {
                    $(`#pax-label-${rfid}`).html(
                        `<i class="fas fa-users me-1"></i>Passengers: <strong id="pax-value-${rfid}">0</strong>` +
                        `<span class="text-danger ms-1"><i class="fas fa-user-times"></i> <em>Absent</em></span>`
                    );
                    row.find('.card').removeClass('border-warning').addClass('border-danger bg-danger bg-opacity-5');
                    row.find('.badge.bg-warning').removeClass('bg-warning text-dark').addClass('bg-danger').text('Absent');
                    fullNameEl.addClass('text-decoration-line-through text-muted');
                    $(`#edit-btn-${rfid}`).hide();
                    $(btn).data('isabsent', 'true')
                          .removeClass('btn-outline-secondary').addClass('btn-outline-success')
                          .attr('title', 'Unmark Absent — restore guests')
                          .html('<i class="fas fa-user-check"></i>');

                    var qCard = $(`.guide-item[data-guiderfid="${rfid}"]`);
                    qCard.addClass('guide-absent-item').attr('data-isabsent', 'true');
                    qCard.find('.guide-card').addClass('guide-absent-card').removeClass('guide-top-card');
                    qCard.find('.guide-status-badge')
                         .removeClass('bg-warning text-dark bg-success bg-primary')
                         .addClass('bg-danger').text('Absent');
                    qCard.find('.trip-info').remove();

                    if (selectedGuides[rfid]) deselectGuide(rfid, false);
                    showToast(res.message, 'Marked Absent', 'warning');
                } else {
                    showToast(res.message, 'Error', 'danger');
                }
            },
            error: function () { showToast('Error marking guide absent.', 'Error', 'danger'); },
            complete: function () { $(btn).prop('disabled', false); }
        });
    }

    function confirmRemoveGuide(rfid, fullName) {
        if (!confirm(`Remove "${fullName}" from today's assignment?\n\nThis will fully unassign them and clear their DTR record for today.\nThey will return to the FIFO queue as if never assigned today.`))
            return;

        var row = $(`#assigned-row-${rfid}`);
        row.find('.btn').prop('disabled', true);
        $.ajax({
            url: '@Url.Action("RemoveGuideAssignment", "Reserve")',
            type: 'POST',
            data: {
                guideRfid: rfid,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (res) {
                if (res.success) {
                    row.fadeOut(300, function () {
                        $(this).remove();
                        var remaining = $('#assignedGuideList .assigned-guide-row').length;
                        $('#assignedCountBadge').text(remaining);
                        if (remaining === 0) {
                            $('#assignedGuideList').html(`
                                <div class="col-12 text-center text-muted py-3" id="noAssignedMsg">
                                    <i class="fas fa-check-circle text-success me-1"></i> No guides assigned today.
                                </div>`);
                        }
                    });

                    var guideCard = $(`.guide-item[data-guiderfid="${rfid}"]`);
                    guideCard.attr('data-hastrip', 'false').attr('data-isabsent', 'false').removeClass('guide-absent-item');
                    guideCard.find('.guide-card').removeClass('guide-absent-card guide-top-card');
                    guideCard.find('.guide-status-badge')
                             .removeClass('bg-warning text-dark bg-danger bg-primary')
                             .addClass('bg-success').text('Free');
                    guideCard.find('.trip-info').remove();

                    unlockGuideCards();
                    if (Object.keys(selectedGuides).length >= guideLimit) lockUnselectedGuideCards();
                    if (selectedGuides[rfid]) deselectGuide(rfid, false);

                    showToast(res.message, 'Removed', 'success');
                } else {
                    row.find('.btn').prop('disabled', false);
                    showToast(res.message, 'Error', 'danger');
                }
            },
            error: function () {
                row.find('.btn').prop('disabled', false);
                showToast('Error removing guide assignment.', 'Error', 'danger');
            }
        });
    }

    function confirmAssignGuides(batch) {
        var rfids = Object.keys(selectedGuides);
        if (rfids.length === 0) { alert('Please select at least one guide.'); return; }
        if (rfids.length > guideLimit) {
            alert(`Maximum ${guideLimit} guide(s) allowed for ${guestTotal} guests.\nYou selected ${rfids.length}.`);
            return;
        }

        $('#btnConfirmAssignGuide').prop('disabled', true)
            .html('<span class="spinner-border spinner-border-sm me-1"></span>Assigning...');

        $.ajax({
            url: '@Url.Action("AssignGuides", "Reserve")',
            type: 'POST',
            traditional: true,
            data: {
                batch      : batch,
                guideRfids : rfids,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (res) {
                if (res.success) {
                    $(document).trigger('guideAssigned', [batch]);
                    bootstrap.Modal.getInstance(document.getElementById('assignGuideModal')).hide();
                    showToast(res.message, 'Success', 'success');
                } else {
                    showToast(res.message, 'Error', 'danger');
                    resetAssignGuideBtn(rfids.length);
                }
            },
            error: function () {
                showToast('Error assigning guides.', 'Error', 'danger');
                resetAssignGuideBtn(rfids.length);
            }
        });
    }

    function resetAssignGuideBtn(count) {
        $('#btnConfirmAssignGuide').prop('disabled', false)
            .html(`<i class="fas fa-user-tie me-1"></i> Assign Selected Guides (<span id="btnGuideSelectedCount">${count}</span>)`);
    }
</script>
