@model GuestDetailsViewModel?

@{
    Layout = null;
    var toastMessage = TempData["ToastMessage"] as string;
    var toastType = TempData["ToastType"] as string; // e.g., "warning", "danger", "success"
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Scan Guest Info</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="icon" href="/images/alegrialogo2025.jpeg" type="image/png" />
    <link href="/css/ScanGuestInfo.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>

    <!-- ✅ Header -->
    <header>
        <a asp-controller="Dashboard" asp-action="Index" class="exit-btn">
            <i class="bi bi-box-arrow-left"></i> Exit
        </a>
    </header>

    <h2>Scan Guest Info</h2>

    <!-- ✅ QR Input -->
    <form id="scanForm" method="get" asp-action="ScanGuestInfo">
        <input type="text" id="qrCodeValue" name="qrCodeValue" placeholder="Scan QR" autofocus />
        <button type="submit">Search</button>
    </form>

    <!-- ✅ Guest Info Display -->
    @if (Model != null)
    {
        <div id="guestInfo" class="guest-info">
            <h3>Guest Information</h3>
            <p><strong>Operator:</strong> @Model.Operators</p>
            <p><strong>Full Name:</strong> @Model.FullName</p>
            <p><strong>Arrival:</strong> @(Model.ArrivalDate?.ToLocalTime().ToString("M/d/yyyy h:mm tt"))</p>
            <p><strong>Age:</strong> @Model.Age</p>
            <p><strong>Nationality:</strong> @Model.Nationality</p>

            <div style="text-align:center; margin-top:1rem;">
                @if (!string.IsNullOrEmpty(Model.GuestImageBase64))
                {
                    <img src="@Model.GuestImageBase64" alt="Guest Image" width="150" style="border-radius: 8px;" />
                }
                else
                {
                    <img src="~/images/default_guest.png" alt="Default Guest Image" width="150" style="border-radius: 8px;" />
                }
            </div>
        </div>
    }

    <!-- ✅ Toast Container -->
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="toastMessage" class="toast border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="2000">
            <div class="toast-header">
                <i class="bi bi-info-circle-fill me-2"></i>
                <strong class="me-auto" id="toastTitle">Notification</strong>
                <small class="text-muted">Now</small>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body" id="toastBody"></div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // ✅ Prevent empty QR submission (client-side)
        document.getElementById("scanForm").addEventListener("submit", function (e) {
            const qrValue = document.getElementById("qrCodeValue").value.trim();
            if (!qrValue) {
                e.preventDefault();
                showToast("Please scan a QR code before submitting.", "warning");
            }
        });

        // ✅ Function to show Bootstrap toast
        function showToast(message, type) {
            const toastEl = document.getElementById('toastMessage');
            const toastBody = document.getElementById('toastBody');
            const toastTitle = document.getElementById('toastTitle');

            toastBody.textContent = message;

            // dynamic class for background color
            toastEl.className = `toast text-bg-${type} border-0`;
            toastTitle.textContent =
                type === "danger" ? "Error" :
                type === "warning" ? "Warning" :
                type === "success" ? "Success" :
                "Notification";

            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }

        // ✅ Server-triggered toast (via TempData)
        @if (!string.IsNullOrEmpty(toastMessage))
        {
            <text>
                    window.addEventListener('DOMContentLoaded', () => {
                        showToast('@toastMessage', '@toastType');
                    });
            </text>
        }

        // ✅ Fade out guest info after 5 seconds
        window.onload = function () {
            const guestDiv = document.getElementById('guestInfo');
            if (guestDiv) {
                setTimeout(() => guestDiv.classList.add('fade-out'), 5000);
            }
        };
    </script>

</body>
</html>
