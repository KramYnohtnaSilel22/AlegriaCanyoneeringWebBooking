@model GuestDetailsViewModel?

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Scan Guest Info</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="icon" href="/images/alegrialogo2025.jpeg" type="image/png" />
     <link href="/css/ScanGuestInfo.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>

    <!-- ✅ Exit button -->
    <header>
        <a asp-controller="Dashboard" asp-action="Index" class="exit-btn">
            <i class="bi bi-box-arrow-left"></i> Exit
        </a>
    </header>

    <h2>Scan Guest Info</h2>

    <!-- ✅ Input for scanning -->
    <form method="get" asp-action="ScanGuestInfo">
        <input type="text" name="qrCodeValue" placeholder="Scan QR" autofocus />
        <button type="submit">Search</button>
    </form>

    @if (Model != null)
    {
        <div id="guestInfo" class="guest-info">
            <h3>Guest Information</h3>
            <p><strong>Operator:</strong> @Model.Operators</p>
            <p><strong>Full Name:</strong> @Model.FullName</p>
            <p><strong>Arrival:</strong> @(Model.ArrivalDate?.ToLocalTime().ToString("M/d/yyyy h:mm tt"))</p>
            <p><strong>Age:</strong> @Model.Age</p>
            <p><strong>Nationality:</strong> @Model.Nationality</p>

            <div style="text-align:center; margin-top:1rem;">
                @if (!string.IsNullOrEmpty(Model.GuestImageBase64))
                {
                    <img src="@Model.GuestImageBase64" alt="Guest Image" width="150" style="border-radius: 8px;" />
                }
                else
                {
                    <img src="~/images/default_guest.png" alt="Default Guest Image" width="150" style="border-radius: 8px;" />
                }
            </div>
        </div>
    }

    <script>
        // Fade out guest info after 5 seconds
        window.onload = function () {
            const guestDiv = document.getElementById('guestInfo');
            if (guestDiv) {
                setTimeout(() => {
                    guestDiv.classList.add('fade-out');
                }, 5000);
            }
        };
    </script>

</body>
</html>
