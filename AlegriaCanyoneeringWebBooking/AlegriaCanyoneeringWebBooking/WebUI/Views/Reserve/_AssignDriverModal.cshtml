@{
    var batch = ViewBag.Batch as string;
    var guestCount = (int)(ViewBag.GuestCount ?? 0);
    var recommendedDrivers = (int)(ViewBag.RecommendedDrivers ?? 0);
    var availableDrivers = ViewBag.AvailableDrivers as IEnumerable<dynamic>;
    var busyDrivers = ViewBag.BusyDrivers as IEnumerable<dynamic>;
    int totalDrivers = availableDrivers?.Count() ?? 0;
}

<div class="modal-header bg-info text-white">
    <h5 class="modal-title">
        <i class="fas fa-car me-2"></i> Assign Drivers
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">

    <!-- Batch Info Bar -->
    <div class="mb-3 p-3 bg-light rounded border">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
                <i class="fas fa-layer-group me-1 text-info"></i>
                <strong>Batch:</strong> @batch
            </span>
            <span>
                <i class="fas fa-users me-1 text-primary"></i>
                <strong>Guests:</strong> @guestCount
            </span>
            <span class="badge bg-info text-white fs-6">
                <i class="fas fa-car me-1"></i>
                Limit: @recommendedDrivers driver@(recommendedDrivers != 1 ? "s" : "")
            </span>
            <span class="badge bg-primary fs-6">
                <i class="fas fa-car me-1"></i>
                Selected: <span id="driverSelectedCount">0</span> / @recommendedDrivers
            </span>
        </div>
    </div>

    <!-- FIFO Queue Explanation -->
    <div class="alert alert-info py-2 mb-3 small">
        <div class="d-flex align-items-start gap-2">
            <i class="fas fa-sort-numeric-up mt-1 flex-shrink-0"></i>
            <div>
                <strong>FIFO Queue</strong> — Driver who waited longest is <strong>#1</strong> (next to assign).
                After assignment, driver moves to the <strong>bottom</strong>. Cycle repeats:
                <code>#1 → #2 → ... → Last → #1</code>
                &nbsp;|&nbsp;
                <span class="text-danger"><i class="fas fa-user-times me-1"></i>Absent</span> =
                0 passengers, still cycles in queue.
            </div>
        </div>
    </div>

    <!-- Limit Warning Banner -->
    <div id="driverLimitWarning"
         class="alert alert-danger d-flex align-items-center gap-2 py-2 mb-3"
         style="display:none !important;">
        <i class="fas fa-ban fa-lg"></i>
        <div>
            <strong>Limit Reached!</strong>
            Max <strong>@recommendedDrivers driver@(recommendedDrivers != 1 ? "s" : "")</strong>
            for @guestCount guests.
            Deselect a driver to pick a different one.
        </div>
    </div>

    <!-- Search -->
    <div class="mb-3">
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input type="text" id="driverSearch" class="form-control"
                   placeholder="Search driver by name or Ref ID..."
                   oninput="filterDrivers()" />
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link active" id="tab-drivers" onclick="switchDriverTab('drivers')">
                <i class="fas fa-sort-numeric-up text-info me-1"></i>
                Queue
                <span class="badge bg-info ms-1">@totalDrivers</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="tab-assigned" onclick="switchDriverTab('assigned')">
                <i class="fas fa-clock text-warning me-1"></i>
                Assigned Today
                <span class="badge bg-warning text-dark ms-1" id="driverAssignedCountBadge">
                    @(busyDrivers?.Count() ?? 0)
                </span>
            </button>
        </li>
    </ul>

    <!-- ============================================
         PANEL: FIFO QUEUE — Driver Selection
         ============================================ -->
    <div id="panel-drivers">

        <!-- Auto-Select Suggestion Bar -->
        @if (availableDrivers != null && availableDrivers.Any() && recommendedDrivers > 0)
        {
            <div class="d-flex align-items-center gap-2 flex-wrap mb-3 p-2 rounded border border-info border-opacity-25 bg-info bg-opacity-10">
                <i class="fas fa-magic text-info flex-shrink-0"></i>
                <span class="small text-info fw-semibold">Next in Queue:</span>
                @{
                    int shownCount = 0;
                    foreach (var d in availableDrivers)
                    {
                        if (shownCount >= recommendedDrivers) break;
                        bool dIsAbsent = (bool)(d.isAbsent ?? false);
                        if (!dIsAbsent)
                        {
                            int dQPos = (int)(d.queuePosition ?? 0);
                            string dFirstName = ((string)d.fullName ?? "").Split(' ')[0];
                            <span class="badge bg-info py-1 px-2">
                                #@dQPos @dFirstName
                            </span>
                            shownCount++;
                        }
                    }
                    if (shownCount == 0)
                    {
                        <span class="text-muted small fst-italic">All top drivers are absent today</span>
                    }
                }
                <button class="btn btn-info btn-sm ms-auto py-0 px-2 text-white"
                        style="font-size:11px;"
                        onclick="autoSelectTopDrivers()"
                        title="Automatically select the next @recommendedDrivers driver(s) in queue">
                    <i class="fas fa-check-double me-1"></i>Auto-Select Top @recommendedDrivers
                </button>
            </div>
        }

        <div class="row g-2" id="availableDriverList">
            @if (availableDrivers != null && availableDrivers.Any())
            {
                foreach (var d in availableDrivers)
                {
                    bool hasTrip = (bool)(d.hasTrip ?? false);
                    bool isAbsent = (bool)(d.isAbsent ?? false);
                    int qPos = (int)(d.queuePosition ?? 0);
                    bool isTopN = qPos <= recommendedDrivers && !isAbsent;

                    <div class="col-md-6 driver-item @(isAbsent ? "driver-absent-item" : "")"
                         data-name="@d.fullName.ToLower()"
                         data-ref-search="@d.RefId.ToLower()"
                         data-panel="drivers"
                         data-refid="@d.RefId"
                         data-fullname="@d.fullName"
                         data-hastrip="@hasTrip.ToString().ToLower()"
                         data-isabsent="@isAbsent.ToString().ToLower()"
                         data-image="@(d.Image ?? "")">

                        <div class="card driver-card border-2 h-100
                                                            @(isAbsent ? "driver-absent-card" : "")
                                                            @(isTopN ? "driver-top-card" : "")"
                             style="cursor:pointer;"
                             onclick="toggleSelectDriver(this)">

                            <div class="card-body d-flex align-items-center gap-2 p-2">

                                <!-- Queue Position Badge -->
                                <div class="d-flex flex-column align-items-center flex-shrink-0"
                                     style="min-width:34px;">
                                    <span class="badge @(isAbsent ? "bg-danger" : (isTopN ? "bg-info" : "bg-secondary"))"
                                          style="font-size:11px; width:30px; text-align:center;">
                                        #@qPos
                                    </span>
                                    @if (isTopN)
                                    {
                                        <span style="font-size:8px; white-space:nowrap;" class="text-info fw-bold">NEXT</span>
                                    }
                                    else if (isAbsent)
                                    {
                                        <span style="font-size:8px;" class="text-danger fw-bold">ABS</span>
                                    }
                                </div>

                                <!-- Avatar -->
                                @if (!string.IsNullOrEmpty((string)d.Image))
                                {
                                    <img src="@d.Image"
                                         style="width:44px;height:44px;object-fit:cover; @(isAbsent ? "filter:grayscale(70%);" : "")"
                                         class="rounded-circle border @(isAbsent ? "border-danger" : "")" />
                                }
                                else
                                {
                                    <div style="width:44px;height:44px;"
                                         class="rounded-circle border @(isAbsent ? "border-danger bg-danger bg-opacity-10" : "bg-secondary") d-flex align-items-center justify-content-center">
                                        <i class="fas fa-car @(isAbsent ? "text-danger" : "text-white")"></i>
                                    </div>
                                }

                                <!-- Info -->
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="fw-semibold small text-truncate @(isAbsent ? "text-decoration-line-through text-muted" : "")">
                                        @d.fullName
                                    </div>
                                    <div class="text-muted" style="font-size:10px;">
                                        <i class="fas fa-id-card me-1"></i>Ref: @d.RefId
                                    </div>
                                    @if (isAbsent)
                                    {
                                        <div style="font-size:10px;" class="text-danger">
                                            <i class="fas fa-user-times me-1"></i>Absent — 0 passengers
                                        </div>
                                    }
                                    else if (hasTrip)
                                    {
                                      @*   <div style="font-size:10px;" class="text-warning trip-info">
                                            <i class="fas fa-users me-1"></i>Last: @d.passengers pax
                                        </div> *@
                                    }
                                    else
                                    {
                                        <div style="font-size:10px;" class="text-info">
                                            <i class="fas fa-clock me-1"></i>Never assigned
                                        </div>
                                    }
                                </div>

                                <!-- Status Badge -->
                                @if (isAbsent)
                                {
                                    <span class="badge bg-danger driver-status-badge">Absent</span>
                                }
                                else if (hasTrip)
                                {
                                    <span class="badge bg-warning text-dark driver-status-badge">On Trip</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-white driver-status-badge">Free</span>
                                }

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted py-3">
                    <i class="fas fa-info-circle me-1"></i> No drivers found.
                </div>
            }
        </div>

        <!-- Selected Drivers Section -->
        <div id="selectedDriversSection" class="mt-3" style="display:none;">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h6 class="fw-bold text-info mb-0">
                    <i class="fas fa-check-double me-1"></i> Selected Drivers
                </h6>
                <button class="btn btn-outline-danger btn-sm" onclick="clearAllSelectedDrivers()">
                    <i class="fas fa-times me-1"></i> Clear All
                </button>
            </div>
            <div class="row g-2" id="selectedDriverList"></div>
        </div>
    </div>

    <!-- ============================================
         PANEL: ASSIGNED TODAY (Edit / Absent / Remove)
         ============================================ -->
    <div id="panel-assigned" style="display:none;">

        <div class="alert alert-info py-2 small mb-2">
            <i class="fas fa-info-circle me-1"></i>
            <strong>Edit</strong> = update passenger count &nbsp;|&nbsp;
            <span class="text-danger"><strong>Absent</strong></span> = set 0 passengers, driver still cycles in FIFO &nbsp;|&nbsp;
            <strong>Remove</strong> = fully unassign
        </div>

        <div class="row g-2" id="assignedDriverList">
            @if (busyDrivers != null && busyDrivers.Any())
            {
                foreach (var d in busyDrivers)
                {
                    bool isAbsent = (bool)(d.isAbsent ?? false);
                    int queuePosN = (int)(d.queuePos ?? 0);

                    <div class="col-12 assigned-driver-row" id="assigned-row-@d.RefId">
                        <div class="card @(isAbsent ? "border-danger bg-danger bg-opacity-5" : "border-warning")">
                            <div class="card-body p-2">

                                <!-- Driver Info Row -->
                                <div class="d-flex align-items-center gap-2">

                                    <!-- Queue # -->
                                    <div class="@(isAbsent ? "text-danger" : "text-warning") fw-bold text-center flex-shrink-0"
                                         style="font-size:14px; min-width:28px;">
                                        #@queuePosN
                                    </div>

                                    <!-- Avatar -->
                                    @if (!string.IsNullOrEmpty((string)d.Image))
                                    {
                                        <img src="@d.Image"
                                             style="width:44px;height:44px;object-fit:cover; @(isAbsent ? "filter:grayscale(70%);" : "")"
                                             class="rounded-circle border @(isAbsent ? "border-danger" : "border-warning")" />
                                    }
                                    else
                                    {
                                        <div style="width:44px;height:44px;"
                                             class="rounded-circle border @(isAbsent ? "border-danger bg-light" : "border-warning bg-light") d-flex align-items-center justify-content-center">
                                            <i class="fas fa-car @(isAbsent ? "text-danger" : "text-warning")"></i>
                                        </div>
                                    }

                                    <!-- Info -->
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-semibold small text-truncate @(isAbsent ? "text-decoration-line-through text-muted" : "")">
                                            @d.fullName
                                        </div>
                                        <div class="text-muted" style="font-size:10px;">
                                            <i class="fas fa-id-card me-1"></i>Ref: @d.RefId
                                        </div>
                                        @* <div style="font-size:10px;"
                                             class="@(isAbsent ? "text-danger" : "text-info")"
                                             id="pax-label-@d.RefId">
                                            <i class="fas fa-users me-1"></i>
                                            Passengers: <strong id="pax-value-@d.RefId">@d.passengers</strong>
                                            @if (isAbsent)
                                            {
                                                <span class="ms-1">
                                                    <i class="fas fa-user-times"></i> <em>Absent</em>
                                                </span>
                                            }
                                        </div> *@
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
                                        @if (isAbsent)
                                        {
                                            <span class="badge bg-danger mb-1">Absent</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark mb-1">On Trip</span>
                                        }

                                        <div class="d-flex gap-1">
                                            @if (!isAbsent)
                                            {
                                                <button class="btn btn-outline-primary btn-sm py-0 px-1"
                                                        style="font-size:10px;"
                                                        title="Edit passenger count"
                                                        id="edit-btn-@d.RefId"
                                                        data-refid="@d.RefId"
                                                        data-pax="@d.passengers"
                                                        onclick="toggleEditDriver($(this).data('refid'), $(this).data('pax'))">
                                                    <i class="fas fa-pencil-alt"></i>
                                                </button>
                                            }

                                            <!-- Mark/Unmark Absent Button -->
                                            <button class="btn @(isAbsent ? "btn-outline-success" : "btn-outline-secondary") btn-sm py-0 px-1"
                                                    style="font-size:10px;"
                                                    title="@(isAbsent ? "Unmark Absent — restore passengers" : "Mark as Absent (0 passengers, stays in queue)")"
                                                    id="absent-btn-@d.RefId"
                                                    data-refid="@d.RefId"
                                                    data-isabsent="@isAbsent.ToString().ToLower()"
                                                    onclick="handleDriverAbsent(this)">
                                                <i class="fas @(isAbsent ? "fa-user-check" : "fa-user-times")"></i>
                                            </button>

                                            <!-- Remove -->
                                            <button class="btn btn-outline-danger btn-sm py-0 px-1"
                                                    style="font-size:10px;"
                                                    title="Remove driver assignment"
                                                    data-refid="@d.RefId"
                                                    data-fullname="@d.fullName"
                                                    onclick="confirmRemoveDriver($(this).data('refid'), $(this).data('fullname'))">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>

                                </div>

                                <!-- Inline Edit Form -->
                                <div id="edit-form-@d.RefId" class="mt-2 pt-2 border-top" style="display:none;">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <label class="text-muted small mb-0" style="white-space:nowrap;">
                                            <i class="fas fa-users me-1"></i>Passengers:
                                        </label>
                                        <input type="number"
                                               id="edit-pax-@d.RefId"
                                               class="form-control form-control-sm"
                                               value="@d.passengers"
                                               min="1"
                                               style="max-width:80px;" />
                                        <button class="btn btn-primary btn-sm py-0 px-2"
                                                style="font-size:11px;"
                                                id="save-btn-@d.RefId"
                                                data-refid="@d.RefId"
                                                onclick="saveEditDriver($(this).data('refid'))">
                                            <i class="fas fa-save me-1"></i>Save
                                        </button>
                                        <button class="btn btn-secondary btn-sm py-0 px-2"
                                                style="font-size:11px;"
                                                data-refid="@d.RefId"
                                                data-pax="@d.passengers"
                                                onclick="toggleEditDriver($(this).data('refid'), $(this).data('pax'))">
                                            Cancel
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted py-3" id="noAssignedDriverMsg">
                    <i class="fas fa-check-circle text-success me-1"></i> No drivers assigned today.
                </div>
            }
        </div>
    </div>

</div>

<!-- Footer -->
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <i class="fas fa-times me-1"></i> Cancel
    </button>
    <button type="button" class="btn btn-info text-white" id="btnConfirmAssignDriver"
            onclick="confirmAssignDrivers('@batch')">
        <i class="fas fa-car me-1"></i> Assign Selected Drivers
        (<span id="btnDriverSelectedCount">0</span>)
    </button>
</div>

<!-- ===== STYLES ===== -->
<style>
    .driver-card {
        transition: all 0.2s;
    }

        .driver-card:hover {
            border-color: #0dcaf0 !important;
            background-color: #f0fdff;
        }

        .driver-card.selected {
            border-color: #0d6efd !important;
            background-color: #cfe2ff;
        }

    .driver-top-card {
        border-color: #0dcaf0 !important;
        background-color: #f0fdff;
    }

    .driver-absent-card {
        border-color: #dc3545 !important;
        background-color: #fff5f5 !important;
        opacity: 0.75;
    }

    .driver-card.limit-locked {
        opacity: 0.4;
        cursor: not-allowed !important;
        pointer-events: none;
    }

    .driver-absent-item .driver-card {
        cursor: not-allowed !important;
    }

    .selected-driver-card {
        border-left: 4px solid #0dcaf0 !important;
    }

    .nav-link {
        cursor: pointer;
        border: none;
        background: none;
    }

        .nav-link.active {
            border-bottom: 2px solid #0dcaf0 !important;
            color: #0dcaf0 !important;
        }

    #panel-assigned .card {
        transition: all 0.3s;
    }
</style>

<!-- ===== SCRIPTS ===== -->
<script>
    var selectedDrivers = {};
    var driverLimit     = @recommendedDrivers;
    var driverGuestTotal = @guestCount;

    // ============================================
    // LOCK / UNLOCK unselected cards
    // ============================================
    function lockUnselectedDriverCards() {
        $('#driverLimitWarning').show();
        $('.driver-item:not(.driver-absent-item) .driver-card:not(.selected)')
            .addClass('limit-locked');
    }

    function unlockDriverCards() {
        $('#driverLimitWarning').hide();
        $('.driver-item .driver-card').removeClass('limit-locked');
    }

    // ============================================
    // FIFO: Toggle select — blocks absent, enforces limit
    // ============================================
    function toggleSelectDriver(card) {
        var wrapper  = $(card).closest('.driver-item');
        var refId    = wrapper.data('refid');
        var fullName = wrapper.data('fullname');
        var image    = wrapper.data('image');
        var hasTrip  = wrapper.data('hastrip')  === 'true';
        var isAbsent = wrapper.data('isabsent') === 'true' || wrapper.data('isabsent') === true;

        if (isAbsent) {
            showToast(`${fullName} is marked as absent and cannot be selected.`, 'Absent Driver', 'warning');
            return;
        }

        if (selectedDrivers[refId]) {
            deselectDriver(refId, hasTrip);
            return;
        }

        if (Object.keys(selectedDrivers).length >= driverLimit) {
            $('#driverLimitWarning').show();
            $('#driverLimitWarning').addClass('border border-danger shadow-sm');
            setTimeout(() => $('#driverLimitWarning').removeClass('border border-danger shadow-sm'), 1500);
            return;
        }

        selectedDrivers[refId] = { refId, fullName, image, hasTrip };
        $(card).addClass('selected');
        $(card).find('.driver-status-badge')
               .removeClass('bg-info bg-warning text-dark text-white')
               .addClass('bg-primary')
               .text('Selected');

        addDriverToSelectedPanel(refId, fullName, image);
        updateDriverSelectedCount();

        if (Object.keys(selectedDrivers).length >= driverLimit) {
            lockUnselectedDriverCards();
        }
    }

    // ============================================
    // FIFO: Auto-select top N non-absent drivers
    // ============================================
    function autoSelectTopDrivers() {
        clearAllSelectedDrivers();
        var count = 0;

        $('#availableDriverList .driver-item').each(function () {
            if (count >= driverLimit) return false;

            var isAbsent   = $(this).data('isabsent') === 'true' || $(this).data('isabsent') === true;
            var card       = $(this).find('.driver-card');
            var isLocked   = card.hasClass('limit-locked');
            var isSelected = card.hasClass('selected');

            if (!isAbsent && !isLocked && !isSelected) {
                toggleSelectDriver(card[0]);
                count++;
            }
        });

        if (count === 0) {
            showToast('No available drivers to auto-select (all may be absent).', 'Info', 'info');
        } else {
            showToast(`${count} driver(s) auto-selected from FIFO queue.`, 'Auto-Selected', 'success');
        }
    }

    // ============================================
    // Deselect
    // ============================================
    function deselectDriver(refId, hasTrip) {
        if (hasTrip === undefined && selectedDrivers[refId])
            hasTrip = selectedDrivers[refId].hasTrip;

        delete selectedDrivers[refId];

        var card  = $(`.driver-item[data-refid="${refId}"] .driver-card`);
        var badge = $(`.driver-item[data-refid="${refId}"] .driver-status-badge`);

        card.removeClass('selected');

        if (hasTrip) {
            badge.removeClass('bg-primary').addClass('bg-warning text-dark').text('On Trip');
        } else {
            badge.removeClass('bg-primary text-dark').addClass('bg-info text-white').text('Free');
        }

        $(`#selected-driver-card-${refId}`).remove();
        if ($('#selectedDriverList').children().length === 0)
            $('#selectedDriversSection').hide();

        unlockDriverCards();
        if (Object.keys(selectedDrivers).length >= driverLimit) {
            lockUnselectedDriverCards();
        }

        updateDriverSelectedCount();
    }

    // ============================================
    // Add to Selected Panel
    // ============================================
    function addDriverToSelectedPanel(refId, fullName, image) {
        var imgHtml = image
            ? `<img src="${image}" style="width:38px;height:38px;object-fit:cover;" class="rounded-circle border" />`
            : `<div style="width:38px;height:38px;" class="rounded-circle border bg-secondary d-flex align-items-center justify-content-center">
                   <i class="fas fa-car text-white" style="font-size:14px;"></i>
               </div>`;

        $('#selectedDriverList').append(`
            <div class="col-md-6" id="selected-driver-card-${refId}">
                <div class="card selected-driver-card border h-100">
                    <div class="card-body d-flex align-items-center gap-2 p-2">
                        ${imgHtml}
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-semibold small text-truncate">${fullName}</div>
                            <div class="text-muted" style="font-size:10px;">Ref: ${refId}</div>
                        </div>
                        <button class="btn btn-outline-danger btn-sm py-0 px-1"
                                style="font-size:10px;"
                                onclick="deselectDriver('${refId}')">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            </div>`);

        $('#selectedDriversSection').show();
    }

    function clearAllSelectedDrivers() {
        Object.keys(selectedDrivers).forEach(refId => deselectDriver(refId));
    }

    function updateDriverSelectedCount() {
        var count = Object.keys(selectedDrivers).length;
        $('#driverSelectedCount').text(count);
        $('#btnDriverSelectedCount').text(count);
    }

    // ============================================
    // Tab switch + Search filter
    // ============================================
    function switchDriverTab(tab) {
        $('#panel-drivers, #panel-assigned').hide();
        $('#tab-drivers, #tab-assigned').removeClass('active');
        $(`#panel-${tab}`).show();
        $(`#tab-${tab}`).addClass('active');
        $('#driverSearch').val('');
        $('.driver-item').show();
    }

    function filterDrivers() {
        var q = $('#driverSearch').val().toLowerCase();
        $('.driver-item[data-panel="drivers"]').each(function () {
            var name = $(this).data('name');
            var ref  = $(this).data('ref-search');
            $(this).toggle(name.includes(q) || ref.includes(q));
        });
    }

    // ============================================
    // EDIT — inline toggle + save
    // ============================================
    function toggleEditDriver(refId, currentPax) {
        var form = $(`#edit-form-${refId}`);
        if (form.is(':visible')) {
            form.slideUp(150);
            $(`#edit-pax-${refId}`).val(currentPax);
        } else {
            $('[id^="edit-form-"]').not(form).slideUp(150);
            form.slideDown(150);
            $(`#edit-pax-${refId}`).focus().select();
        }
    }

    function saveEditDriver(refId) {
        var passengers = parseInt($(`#edit-pax-${refId}`).val());

        if (isNaN(passengers) || passengers < 1) {
            alert('Please enter a valid passenger count (minimum 1).\nTo mark absent, use the Absent button.');
            return;
        }

        var btn = $(`#save-btn-${refId}`);
        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');

        $.ajax({
            url: '@Url.Action("EditDriverAssignment", "Reserve")',
            type: 'POST',
            data: {
                driverRefId : refId,
                passengers  : passengers,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (res) {
                if (res.success) {
                    $(`#pax-label-${refId}`).html(
                        `<i class="fas fa-users me-1"></i>Passengers: <strong id="pax-value-${refId}">${passengers}</strong>`
                    );
                    $(`#edit-form-${refId}`).slideUp(150);
                    showToast(res.message, 'Updated', 'success');
                } else {
                    showToast(res.message, 'Error', 'danger');
                }
            },
            error: function () {
                showToast('Error updating driver assignment.', 'Error', 'danger');
            },
            complete: function () {
                btn.prop('disabled', false).html('<i class="fas fa-save me-1"></i>Save');
            }
        });
    }

    // ============================================
    // MARK/UNMARK ABSENT
    // ============================================
    function handleDriverAbsent(btn) {
        var refId      = $(btn).data('refid');
        var isAbsent   = $(btn).data('isabsent') === true || $(btn).data('isabsent') === 'true';
        var row        = $(`#assigned-row-${refId}`);
        var fullNameEl = row.find('.fw-semibold.small');
        var fullName   = fullNameEl.text().trim();

        if (isAbsent) {
            // UNMARK — show edit form to restore passenger count
            $(`#edit-form-${refId}`).slideDown(150);
            $(`#edit-pax-${refId}`).val(1).focus().select();
            showToast('Enter the correct passenger count to restore this driver.', 'Unmark Absent', 'info');
            return;
        }

        if (!confirm(`Mark "${fullName}" as absent?\n\n✔ Passenger count → 0\n✔ Driver stays in FIFO rotation (cycles to queue bottom)\n✔ Cannot be selected for new batches today`))
            return;

        $(btn).prop('disabled', true);

        $.ajax({
            url: '@Url.Action("MarkDriverAbsent", "Reserve")',
            type: 'POST',
            data: {
                driverRefId: refId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (res) {
                if (res.success) {
                    $(`#pax-label-${refId}`).html(
                        `<i class="fas fa-users me-1"></i>Passengers: <strong id="pax-value-${refId}">0</strong>` +
                        `<span class="text-danger ms-1"><i class="fas fa-user-times"></i> <em>Absent</em></span>`
                    );

                    row.find('.card')
                       .removeClass('border-warning')
                       .addClass('border-danger bg-danger bg-opacity-5');

                    row.find('.badge.bg-warning').removeClass('bg-warning text-dark').addClass('bg-danger').text('Absent');
                    fullNameEl.addClass('text-decoration-line-through text-muted');

                    $(`#edit-btn-${refId}`).hide();
                    $(btn).data('isabsent', 'true')
                          .removeClass('btn-outline-secondary')
                          .addClass('btn-outline-success')
                          .attr('title', 'Unmark Absent — restore passengers')
                          .html('<i class="fas fa-user-check"></i>');

                    // Update driver card in Queue panel
                    var qCard = $(`.driver-item[data-refid="${refId}"]`);
                    qCard.addClass('driver-absent-item')
                         .attr('data-isabsent', 'true');
                    qCard.find('.driver-card')
                         .addClass('driver-absent-card')
                         .removeClass('driver-top-card');
                    qCard.find('.driver-status-badge')
                         .removeClass('bg-warning text-dark bg-info bg-primary text-white')
                         .addClass('bg-danger')
                         .text('Absent');
                    qCard.find('.trip-info').remove();

                    if (selectedDrivers[refId]) {
                        deselectDriver(refId, false);
                    }

                    showToast(res.message, 'Marked Absent', 'warning');
                } else {
                    showToast(res.message, 'Error', 'danger');
                }
            },
            error: function () {
                showToast('Error marking driver absent.', 'Error', 'danger');
            },
            complete: function () {
                $(btn).prop('disabled', false);
            }
        });
    }

    // ============================================
    // REMOVE — confirm + AJAX + UI update
    // ============================================
    function confirmRemoveDriver(refId, fullName) {
        if (!confirm(`Remove "${fullName}" from today's assignment?\n\nThis will fully unassign them and clear their DTR record for today.\nThey will return to the FIFO queue as if never assigned today.`))
            return;

        var row = $(`#assigned-row-${refId}`);
        row.find('.btn').prop('disabled', true);

        $.ajax({
            url: '@Url.Action("RemoveDriverAssignment", "Reserve")',
            type: 'POST',
            data: {
                driverRefId: refId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (res) {
                if (res.success) {
                    row.fadeOut(300, function () {
                        $(this).remove();

                        var remaining = $('#assignedDriverList .assigned-driver-row').length;
                        $('#driverAssignedCountBadge').text(remaining);

                        if (remaining === 0) {
                            $('#assignedDriverList').html(`
                                <div class="col-12 text-center text-muted py-3" id="noAssignedDriverMsg">
                                    <i class="fas fa-check-circle text-success me-1"></i> No drivers assigned today.
                                </div>`);
                        }
                    });

                    // Reset driver card in Queue panel back to Free
                    var driverCard = $(`.driver-item[data-refid="${refId}"]`);
                    driverCard.attr('data-hastrip', 'false')
                              .attr('data-isabsent', 'false')
                              .removeClass('driver-absent-item');
                    driverCard.find('.driver-card')
                              .removeClass('driver-absent-card driver-top-card');
                    driverCard.find('.driver-status-badge')
                              .removeClass('bg-warning text-dark bg-danger bg-primary')
                              .addClass('bg-info text-white')
                              .text('Free');
                    driverCard.find('.trip-info').remove();

                    unlockDriverCards();
                    if (Object.keys(selectedDrivers).length >= driverLimit) {
                        lockUnselectedDriverCards();
                    }

                    if (selectedDrivers[refId]) {
                        deselectDriver(refId, false);
                    }

                    showToast(res.message, 'Removed', 'success');
                } else {
                    row.find('.btn').prop('disabled', false);
                    showToast(res.message, 'Error', 'danger');
                }
            },
            error: function () {
                row.find('.btn').prop('disabled', false);
                showToast('Error removing driver assignment.', 'Error', 'danger');
            }
        });
    }

    // ============================================
    // ASSIGN DRIVERS — POST with limit check
    // ============================================
    function confirmAssignDrivers(batch) {
        var refIds = Object.keys(selectedDrivers);

        if (refIds.length === 0) {
            alert('Please select at least one driver.');
            return;
        }

        if (refIds.length > driverLimit) {
            alert(`Maximum ${driverLimit} driver(s) allowed for ${driverGuestTotal} guests.\nYou selected ${refIds.length}.`);
            return;
        }

        $('#btnConfirmAssignDriver')
            .prop('disabled', true)
            .html('<span class="spinner-border spinner-border-sm me-1"></span>Assigning...');

        $.ajax({
            url: '@Url.Action("AssignDrivers", "Reserve")',
            type: 'POST',
            traditional: true,
            data: {
                batch        : batch,
                driverRefIds : refIds,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (res) {
                if (res.success) {
                    $(document).trigger('driverAssigned', [batch]);
                    bootstrap.Modal.getInstance(
                        document.getElementById('assignDriverModal')
                    ).hide();
                    showToast(res.message, 'Success', 'success');
                } else {
                    showToast(res.message, 'Error', 'danger');
                    resetAssignDriverBtn(refIds.length);
                }
            },
            error: function () {
                showToast('Error assigning drivers.', 'Error', 'danger');
                resetAssignDriverBtn(refIds.length);
            }
        });
    }

    function resetAssignDriverBtn(count) {
        $('#btnConfirmAssignDriver')
            .prop('disabled', false)
            .html(`<i class="fas fa-car me-1"></i> Assign Selected Drivers (<span id="btnDriverSelectedCount">${count}</span>)`);
    }
</script>
