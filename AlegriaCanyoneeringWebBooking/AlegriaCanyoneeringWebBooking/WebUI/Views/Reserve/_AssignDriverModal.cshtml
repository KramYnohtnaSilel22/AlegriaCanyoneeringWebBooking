@{
    var batch = ViewBag.Batch as string;
    var guestCount = (int)(ViewBag.GuestCount ?? 0);
    var recommendedDrivers = (int)(ViewBag.RecommendedDrivers ?? 0);
    var availableDrivers = ViewBag.AvailableDrivers as IEnumerable<dynamic>;
    var busyDrivers = ViewBag.BusyDrivers as IEnumerable<dynamic>;
}

<div class="modal-header bg-info text-white">
    <h5 class="modal-title">
        <i class="fas fa-car me-2"></i> Assign Drivers
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <!-- Batch Info -->
    <div class="mb-3 p-3 bg-light rounded border">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="fas fa-layer-group me-1 text-info"></i><strong>Batch:</strong> @batch</span>
            <span><i class="fas fa-users me-1 text-primary"></i><strong>Guests:</strong> @guestCount</span>
            <span class="badge bg-info text-white">
                <i class="fas fa-car me-1"></i> Recommended: @recommendedDrivers driver@(recommendedDrivers != 1 ? "s" : "")
            </span>
            <span class="badge bg-primary">
                <i class="fas fa-car me-1"></i> Selected: <span id="selectedCount">0</span>
            </span>
        </div>
    </div>

    <!-- Search Box -->
    <div class="mb-3">
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input type="text" id="driverSearch" class="form-control"
                   placeholder="Search driver by name or ref ID..."
                   oninput="filterDrivers()" />
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link active" id="tab-available" onclick="switchTab('available')">
                <i class="fas fa-check-circle text-success me-1"></i>
                Drivers
                <span class="badge bg-success ms-1">@(availableDrivers?.Count() ?? 0)</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="tab-busy" onclick="switchTab('busy')">
                <i class="fas fa-clock text-warning me-1"></i>
                On Trip
                <span class="badge bg-warning text-dark ms-1">@(busyDrivers?.Count() ?? 0)</span>
            </button>
        </li>
    </ul>

    <!-- Drivers Panel — all drivers, cycle order -->
    <div id="panel-available">
        <p class="text-muted small mb-2">
            <i class="fas fa-sync-alt me-1"></i>
            Drivers are ordered by cycle — most recently assigned appears at the bottom.
        </p>
        <div class="row g-2" id="availableDriverList">
            @if (availableDrivers != null && availableDrivers.Any())
            {
                int cyclePos = 1;
                foreach (var d in availableDrivers)
                {
                    bool hasTrip = (bool)(d.hasTrip ?? false);
                    <div class="col-md-6 driver-item"
                         data-name="@d.fullName.ToLower()"
                         data-ref="@d.RefId.ToLower()"
                         data-panel="available"
                         data-refid="@d.RefId"
                         data-fullname="@d.fullName"
                         data-image="@(d.Image ?? "")">
                        <div class="card driver-card border-2 h-100"
                             style="cursor:pointer;"
                             onclick="toggleSelectDriver(this)">
                            <div class="card-body d-flex align-items-center gap-3 p-2">
                                <div class="text-muted fw-bold" style="font-size:13px; min-width:24px;">
                                    @cyclePos
                                </div>
                                @if (!string.IsNullOrEmpty((string)d.Image))
                                {
                                    <img src="@d.Image"
                                         style="width:48px;height:48px;object-fit:cover;"
                                         class="rounded-circle border" />
                                }
                                else
                                {
                                    <div style="width:48px;height:48px;"
                                         class="rounded-circle border bg-secondary d-flex align-items-center justify-content-center">
                                        <i class="fas fa-user text-white"></i>
                                    </div>
                                }
                                <div class="flex-grow-1">
                                    <div class="fw-semibold small">@d.fullName</div>
                                    <div class="text-muted" style="font-size:11px;">
                                        <i class="fas fa-id-card me-1"></i>Ref: @d.RefId
                                    </div>
                                    @if (hasTrip)
                                    {
                                        <div style="font-size:10px;" class="text-warning">
                                            <i class="fas fa-users me-1"></i>Last trip: @d.passengers pax
                                        </div>
                                    }
                                </div>
                                @if (hasTrip)
                                {
                                    <span class="badge bg-warning text-dark status-badge">On Trip</span>
                                }
                                else
                                {
                                    <span class="badge bg-success status-badge">Free</span>
                                }
                            </div>
                        </div>
                    </div>
                    cyclePos++;
                }
            }
            else
            {
                <div class="col-12 text-center text-muted py-3">
                    <i class="fas fa-info-circle me-1"></i> No drivers found.
                </div>
            }
        </div>

        <!-- Selected Drivers Section -->
        <div id="selectedDriversSection" class="mt-3" style="display:none;">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h6 class="fw-bold text-primary mb-0">
                    <i class="fas fa-check-double me-1"></i> Selected Drivers
                </h6>
                <button class="btn btn-outline-danger btn-sm" onclick="clearAllSelected()">
                    <i class="fas fa-times me-1"></i> Clear All
                </button>
            </div>
            <div class="row g-2" id="selectedDriverList"></div>
        </div>
    </div>

    <!-- On Trip Panel — info only -->
    <div id="panel-busy" style="display:none;">
        <div class="alert alert-info py-2 small mb-2">
            <i class="fas fa-info-circle me-1"></i>
            Drivers currently on a trip today. Select from the <strong>Drivers</strong> tab to re-assign.
        </div>
        <div class="row g-2" id="busyDriverList">
            @if (busyDrivers != null && busyDrivers.Any())
            {
                int queuePos = 1;
                foreach (var d in busyDrivers)
                {
                    <div class="col-md-6 driver-item"
                         data-name="@d.fullName.ToLower()"
                         data-ref="@d.RefId.ToLower()"
                         data-panel="busy">
                        <div class="card border-warning h-100">
                            <div class="card-body d-flex align-items-center gap-2 p-2">
                                <div class="text-warning fw-bold" style="font-size:16px; min-width:24px;">
                                    #@queuePos
                                </div>
                                @if (!string.IsNullOrEmpty((string)d.Image))
                                {
                                    <img src="@d.Image"
                                         style="width:45px;height:45px;object-fit:cover;"
                                         class="rounded-circle border border-warning" />
                                }
                                else
                                {
                                    <div style="width:45px;height:45px;"
                                         class="rounded-circle border border-warning bg-light d-flex align-items-center justify-content-center">
                                        <i class="fas fa-user text-warning"></i>
                                    </div>
                                }
                                <div class="flex-grow-1">
                                    <div class="fw-semibold small">@d.fullName</div>
                                    <div class="text-muted" style="font-size:10px;">
                                        <i class="fas fa-id-card me-1"></i>Ref: @d.RefId
                                    </div>
                                    <div style="font-size:10px;" class="text-info">
                                        <i class="fas fa-users me-1"></i>Passengers: @d.passengers
                                    </div>
                                </div>
                                <span class="badge bg-warning text-dark">On Trip</span>
                            </div>
                        </div>
                    </div>
                    queuePos++;
                }
            }
            else
            {
                <div class="col-12 text-center text-muted py-3">
                    <i class="fas fa-check-circle text-success me-1"></i> No drivers on trip today.
                </div>
            }
        </div>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <i class="fas fa-times me-1"></i> Cancel
    </button>
    <button type="button" class="btn btn-info text-white" id="btnConfirmAssignDriver"
            onclick="confirmAssignDriver('@batch')">
        <i class="fas fa-car me-1"></i> Assign Selected Drivers
        (<span id="btnSelectedCount">0</span>)
    </button>
</div>

<style>
    .driver-card {
        transition: all 0.2s;
    }

        .driver-card:hover {
            border-color: #0dcaf0 !important;
            background-color: #f0fdff;
        }

        .driver-card.selected {
            border-color: #0d6efd !important;
            background-color: #cfe2ff;
        }

    .selected-driver-card {
        border-left: 4px solid #0d6efd !important;
    }

    .nav-link {
        cursor: pointer;
        border: none;
        background: none;
    }

        .nav-link.active {
            border-bottom: 2px solid #0dcaf0 !important;
            color: #0dcaf0 !important;
        }
</style>

<script>
    var selectedDrivers = {};

    function toggleSelectDriver(card) {
        var wrapper  = $(card).closest('.driver-item');
        var refId    = wrapper.data('refid');
        var fullName = wrapper.data('fullname');
        var image    = wrapper.data('image');

        if (selectedDrivers[refId]) {
            deselectDriver(refId);
        } else {
            selectedDrivers[refId] = { refId, fullName, image };
            $(card).addClass('selected');
            $(card).find('.status-badge')
                   .removeClass('bg-success bg-warning text-dark').addClass('bg-primary').text('Selected');
            addToSelectedPanel(refId, fullName, image);
        }
        updateSelectedCount();
    }

    function addToSelectedPanel(refId, fullName, image) {
        var imgHtml = image
            ? `<img src="${image}" style="width:40px;height:40px;object-fit:cover;" class="rounded-circle border" />`
            : `<div style="width:40px;height:40px;" class="rounded-circle border bg-secondary d-flex align-items-center justify-content-center"><i class="fas fa-user text-white"></i></div>`;

        $('#selectedDriverList').append(`
            <div class="col-md-6" id="selected-card-${refId}">
                <div class="card selected-driver-card border h-100">
                    <div class="card-body d-flex align-items-center gap-2 p-2">
                        ${imgHtml}
                        <div class="flex-grow-1">
                            <div class="fw-semibold small">${fullName}</div>
                            <div class="text-muted" style="font-size:11px;">Ref: ${refId}</div>
                        </div>
                        <button class="btn btn-outline-danger btn-sm py-0 px-1"
                                style="font-size:11px;"
                                onclick="deselectDriver('${refId}')">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            </div>`);
        $('#selectedDriversSection').show();
    }

    function deselectDriver(refId) {
        delete selectedDrivers[refId];
        $(`.driver-item[data-refid="${refId}"] .driver-card`).removeClass('selected');
        var hasTrip = $(`.driver-item[data-refid="${refId}"] .status-badge`).hasClass('bg-warning');
        if (hasTrip) {
            $(`.driver-item[data-refid="${refId}"] .status-badge`)
                .removeClass('bg-primary').addClass('bg-warning text-dark').text('On Trip');
        } else {
            $(`.driver-item[data-refid="${refId}"] .status-badge`)
                .removeClass('bg-primary').addClass('bg-success').text('Free');
        }
        $(`#selected-card-${refId}`).remove();
        if ($('#selectedDriverList').children().length === 0)
            $('#selectedDriversSection').hide();
        updateSelectedCount();
    }

    function clearAllSelected() {
        Object.keys(selectedDrivers).forEach(function(refId) { deselectDriver(refId); });
    }

    function updateSelectedCount() {
        var count = Object.keys(selectedDrivers).length;
        $('#selectedCount').text(count);
        $('#btnSelectedCount').text(count);
    }

    function switchTab(tab) {
        $('#panel-available, #panel-busy').hide();
        $('#tab-available, #tab-busy').removeClass('active');
        $(`#panel-${tab}`).show();
        $(`#tab-${tab}`).addClass('active');
        $('#driverSearch').val('');
        $('.driver-item').show();
    }

    function filterDrivers() {
        var q = $('#driverSearch').val().toLowerCase();
        var activePanel = $('#panel-available').is(':visible') ? 'available' : 'busy';
        $(`.driver-item[data-panel="${activePanel}"]`).each(function () {
            var name = $(this).data('name');
            var ref  = $(this).data('ref');
            $(this).toggle(name.includes(q) || ref.includes(q));
        });
    }

    function confirmAssignDriver(batch) {
        var refIds = Object.keys(selectedDrivers);
        if (refIds.length === 0) {
            alert('Please select at least one driver.');
            return;
        }

        // ✅ Warn if selected count doesn't match recommended
        var recommended = @recommendedDrivers;
        if (refIds.length !== recommended) {
            if (!confirm(`Recommended drivers for this batch is ${recommended}, but you selected ${refIds.length}. Continue anyway?`)) {
                return;
            }
        }

        $('#btnConfirmAssignDriver')
            .prop('disabled', true)
            .html('<span class="spinner-border spinner-border-sm me-1"></span>Assigning...');

        $.ajax({
            url: '@Url.Action("AssignDrivers", "Reserve")',
            type: 'POST',
            traditional: true,
            data: {
                batch        : batch,
                driverRefIds : refIds,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (res) {
                if (res.success) {
                    $(document).trigger('driverAssigned', [batch]);
                    bootstrap.Modal.getInstance(
                        document.getElementById('assignDriverModal')
                    ).hide();
                    showToast(res.message, 'Success', 'success');
                } else {
                    showToast(res.message, 'Error', 'danger');
                    $('#btnConfirmAssignDriver')
                        .prop('disabled', false)
                        .html(`<i class="fas fa-car me-1"></i> Assign Selected Drivers (<span id="btnSelectedCount">${refIds.length}</span>)`);
                }
            },
            error: function () {
                showToast('Error assigning drivers.', 'Error', 'danger');
                $('#btnConfirmAssignDriver')
                    .prop('disabled', false)
                    .html(`<i class="fas fa-car me-1"></i> Assign Selected Drivers (<span id="btnSelectedCount">${refIds.length}</span>)`);
            }
        });
    }
</script>