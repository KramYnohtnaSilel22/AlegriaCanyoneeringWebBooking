@using System.Linq
@model IEnumerable<dynamic>
@{
    Layout = null;

    // safe count without relying on LINQ extensions
    int totalTickets = 0;
    if (Model != null)
    {
        foreach (var _ in Model) { totalTickets++; }
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Batch Guest Print</title>
    <link href="/css/Printwristbond.css" rel="stylesheet" />
    <link rel="icon" href="/images/alegrialogo2025.jpeg" type="image/png" />
</head>
<body>

    <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;">
        <div><strong>Total Tickets:</strong> @totalTickets</div>
        <div>
            <button id="printBtn" onclick="window.print()">🖨️ Print Wristbands</button>
        </div>
    </div>

    <div id="ticketsContainer">
        @foreach (var g in Model ?? Enumerable.Empty<dynamic>())
        {
            var batchId = Guid.NewGuid().ToString("N");
            <div class="ticket">
                <div class="ticket-left">
                    <div class="logo-qr-container">
                        <div class="logo">
                            <img src="/images/alegrialogo2025.jpeg" alt="Alegria Canyoneering Logo"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <div class="logo-placeholder" style="display: none;"></div>
                        </div>

                        @if (!string.IsNullOrEmpty(g.QRBase64))
                        {
                            <div class="qr">
                                <img src="@g.QRBase64"
                                     alt="QR Code"
                                     onload="markLoaded('@batchId')"
                                     onerror="markError('@batchId')" />
                            </div>
                        }
                        else
                        {
                            <div class="qr-fallback">
                                @ViewBag.BatchCode
                            </div>
                        }
                    </div>
                </div>

                <div class="ticket-right">
                    <div class="operator-name">@g.Operators</div>
                    <div class="guest-info">
                        <div class="guest-name">@g.FullName</div>
                        <div class="date-time">
                            @{
                                string arrivalText = "N/A";
                                try
                                {
                                    if (g.ArrivalDate != null)
                                    {
                                        DateTime? dtNullable = g.ArrivalDate as DateTime?;
                                        if (dtNullable.HasValue)
                                        {
                                            arrivalText = dtNullable.Value.ToLocalTime().ToString("M/d/yyyy h:mm tt");
                                        }
                                        else
                                        {
                                            var s = Convert.ToString(g.ArrivalDate);
                                            long unixVal = 0;
                                            if (!string.IsNullOrEmpty(s) && long.TryParse(s, out unixVal))
                                                arrivalText = DateTimeOffset.FromUnixTimeSeconds(unixVal).LocalDateTime.ToString("M/d/yyyy h:mm tt");
                                            else if (!string.IsNullOrEmpty(s))
                                                arrivalText = s;
                                        }
                                    }
                                }
                                catch { arrivalText = "N/A"; }
                            }
                            @arrivalText
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <script>
            window.onload = function () {
                window.print();
            };
            let totalImages = 0;
            let loadedImages = 0;
            let erroredImages = 0;

            window.addEventListener("DOMContentLoaded", () => {
                totalImages = document.querySelectorAll(".qr img").length;
                console.log(`🧾 Total tickets: ${document.querySelectorAll('.ticket').length}`);
            });

            function markLoaded(id) {
                loadedImages++;
                console.log(`✅ QR loaded (${loadedImages}/${totalImages})`);
            }

            function markError(id) {
                erroredImages++;
                console.warn(`❌ QR failed to load (${erroredImages}/${totalImages})`);
            }
    </script>

</body>
</html>