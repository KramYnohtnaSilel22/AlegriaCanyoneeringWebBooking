@model IEnumerable<dynamic>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Batch Guest Print</title>
    <!-- External CSS -->
    <link href="/css/Printwristbond.css" rel="stylesheet" />
    <link rel="icon" href="/images/alegrialogo2025.jpeg" type="image/png" />
</head>
<body>

    <!-- Print Button - Visible on screen, hidden during print -->
    <button id="printBtn" onclick="window.print()">🖨️ Print Tickets</button>


    <div id="ticketsContainer">
        @foreach (var g in Model)
        {
            var batchId = Guid.NewGuid().ToString("N");
            <div class="ticket">
                <!-- Left Section: Light Blue Background with Logo and QR Side by Side (40mm) -->
                <div class="ticket-left">
                    <div class="logo-qr-container">
                        <!-- Logo with Border Radius -->
                        <div class="logo">
                            <img src="/images/alegrialogo2025.jpeg" alt="Alegria Canyoneering Logo"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <div class="logo-placeholder" style="display: none;">
                                ALEGRIA<br>CANYONEERING
                            </div>
                        </div>

                        <!-- QR Code Section with Border Radius -->
                        @if (!string.IsNullOrEmpty(g.QRBase64))
                        {
                            <div class="qr">
                                <img src="@g.QRBase64"
                                     alt="QR Code"
                                     onload="markLoaded('@batchId')"
                                     onerror="markError('@batchId')" />
                            </div>
                        }
                        else
                        {
                            <div class="qr-fallback">
                                @ViewBag.BatchCode
                            </div>
                        }
                    </div>
                </div>

                <!-- Right Section: White Background for Guest Info (220mm) -->

                <div class="ticket-right">
                    <div class="operator-name">@g.Operators</div>
                    <div class="guest-info">
                        <div class="guest-name">@g.FullName</div>
                        <div class="date-time">
                            @DateTime.Now.ToLocalTime().ToString("M/d/yyyy h:mm tt")
                        </div>
                    </div>
                </div>

            </div>
        }
    </div>

        <script>
            let totalImages = 0;
            let loadedImages = 0;
            let erroredImages = 0;

            window.addEventListener("DOMContentLoaded", () => {
                totalImages = document.querySelectorAll(".qr img").length;
                console.log(`🧾 Total tickets: ${document.querySelectorAll('.ticket').length}`);
            });

            function markLoaded(id) {
                loadedImages++;
                console.log(`✅ QR loaded (${loadedImages}/${totalImages})`);
            }

            function markError(id) {
                erroredImages++;
                console.warn(`❌ QR failed to load (${erroredImages}/${totalImages})`);
            }

        </script>

</body>
</html>