@model GuestListViewModel
@{
    ViewData["Title"] = "Booked Guests";
    var startDate = Context.Request.Query["startDate"].FirstOrDefault();
    var endDate = Context.Request.Query["endDate"].FirstOrDefault();
}

<div class="toast-container position-fixed top-0 end-0 p-3"></div>

<div class="container-fluid px-3 px-md-4 my-4">

    <!-- Title & Guest of the Day -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary m-0 d-flex align-items-center gap-2 fs-5 fs-md-2">
            <i class="fas fa-user-check"></i> Booked Guests
        </h2>
        @if (User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Operator") || User.IsInRole("Staff"))
        {
            <button id="btnViewGuestOfDay" class="btn btn-primary btn-sm shadow-sm">
                <i class="fas fa-calendar-day me-1 text-warning"></i>
                <span class="d-none d-sm-inline">Guest of the Day</span>
                <span class="d-sm-none">Today</span>
            </button>
        }
    </div>

    <!-- Filter Form — fits content, sticky below header -->
    <form id="filterForm"
          class="booked-filter-form card shadow-sm border-0 px-3 py-2 mb-3 d-inline-flex"
          style="position:sticky; top:calc(var(--header-height, 50px) + 8px); z-index:1020;">
        @Html.AntiForgeryToken()

        <div class="d-flex flex-wrap align-items-center gap-2">
            <label for="startDate" class="fw-semibold mb-0" style="font-size:0.875rem;">Start Date</label>
            <input type="date" class="form-control form-control-sm" style="width:auto;"
                   id="startDate" name="startDate" value="@startDate" required />

            <label for="endDate" class="fw-semibold mb-0" style="font-size:0.875rem;">End Date</label>
            <input type="date" class="form-control form-control-sm" style="width:auto;"
                   id="endDate" name="endDate" value="@endDate" required />

            <button type="submit" class="btn btn-success btn-sm d-flex align-items-center gap-1">
                <i class="fas fa-search"></i> Search
            </button>
        </div>
    </form>

    <!-- Table Container -->
    <div id="batchesTableContainer" class="card shadow-sm border-0" style="display:none;">
        <div class="card-body p-2 p-md-3 position-relative">

            <div id="tableLoader"
                 class="position-absolute top-50 start-50 translate-middle"
                 style="z-index:1050;display:none;">
                <div class="spinner-border text-primary" role="status"
                     style="width:3rem;height:3rem;"></div>
            </div>

            <div class="table-responsive">
                <table id="batchesTable"
                       class="table table-hover align-middle w-100"
                       style="font-size:0.875rem;">
                    <thead class="table-light">
                        <tr>
                            <th>Batch</th>
                            <th>Total Guests</th>
                            <th>Operator</th>
                            <th>Arrival Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>

            <div id="emptyState" class="text-center text-muted py-4"
                 style="display:none;opacity:0;transition:opacity 0.5s;">
                <i class="fas fa-user-slash fa-3x mb-3"></i>
                <p class="mb-0 fs-5">No guest batches found for the selected date range.</p>
            </div>
        </div>
    </div>

    <!-- Modal Injection Container -->
    <div id="guestDetailsModalContainer"></div>

    <!-- Assign Driver Modal -->
    <div class="modal fade" id="assignDriverModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content" id="assignDriverModalContent"></div>
        </div>
    </div>

    <!-- Assign Guide Modal -->
    <div class="modal fade" id="assignGuideModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content" id="assignGuideModalContent"></div>
        </div>
    </div>

    <!-- Assign Outside Guide Modal -->
    <div class="modal fade" id="assignOutsideGuideModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content" id="assignOutsideGuideModalContent"></div>
        </div>
    </div>

    <!-- Assign Outside Driver Modal -->
    <div class="modal fade" id="assignOutsideDriverModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content" id="assignOutsideDriverModalContent"></div>
        </div>
    </div>

</div>

<!-- Toast -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index:1100;">
    <div id="liveToast" class="toast align-items-center text-white bg-danger border-0"
         role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<style>
    /* Filter form — shrinks to fit content */
    .booked-filter-form {
        display: inline-flex !important;
        width: auto !important;
        max-width: 100%;
    }

    @@media (max-width: 768px) {
        .booked-filter-form {
            position: static !important;
            display: flex !important;
            width: 100% !important;
        }

            .booked-filter-form > div {
                flex-wrap: wrap;
            }
    }
</style>

@section Scripts {
    <script>
        // ================================
        // Toast Utility
        // ================================
        function showToast(message, title = 'Notification', type = 'danger') {
            const toastTypes = {
                success: { icon: 'bi-check-circle-fill',        bg: 'bg-success text-white' },
                danger:  { icon: 'bi-exclamation-triangle-fill', bg: 'bg-danger text-white'  },
                warning: { icon: 'bi-exclamation-circle-fill',  bg: 'bg-warning text-dark'  },
                info:    { icon: 'bi-info-circle-fill',          bg: 'bg-info text-dark'     }
            };
            const { icon, bg } = toastTypes[type] || toastTypes.info;
            const toastId   = 'toast-' + Date.now();
            const toastHtml = `
                <div id="${toastId}" class="toast border-0 shadow-sm ${bg}" role="alert"
                     aria-live="assertive" aria-atomic="true" data-bs-delay="4000">
                    <div class="toast-header ${bg}">
                        <i class="bi ${icon} me-2"></i>
                        <strong class="me-auto">${title}</strong>
                        <small>Now</small>
                        <button type="button" class="btn-close btn-close-white"
                                data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                    <div class="toast-body">${message}</div>
                </div>`;
            const $toast = $(toastHtml).appendTo('.toast-container');
            new bootstrap.Toast($toast[0]).show();
            $toast.on('hidden.bs.toast', () => $toast.remove());
        }

        // ================================
        // Guest of the Day
        // ================================
        $('#btnViewGuestOfDay').on('click', function () {
            const today = new Date().toISOString().split('T')[0];
            $('#startDate').val(today);
            $('#endDate').val(today);
            $('#filterForm').trigger('submit');
        });

        // ================================
        // DataTable
        // ================================
        $(document).ready(function () {
            var table = null;

            $('#filterForm').on('submit', function (e) {
                e.preventDefault();
                const startDate = $('#startDate').val();
                const endDate   = $('#endDate').val();

                if (!startDate || !endDate) { showToast('Please select both start and end dates.'); return; }

                $('#btnViewGuestOfDay').hide();
                $('#tableLoader').show();

                if ($.fn.DataTable.isDataTable('#batchesTable')) {
                    table.destroy();
                    $('#batchesTable').empty().append(`
                        <thead class="table-light">
                            <tr>
                                <th>Batch</th><th>Total Guests</th><th>Operator</th>
                                <th>Arrival Date</th><th>Status</th><th>Actions</th>
                            </tr>
                        </thead>`);
                }

                table = $('#batchesTable').DataTable({
                    processing: true,
                    serverSide: true,
                    ajax: {
                        url:  '@Url.Action("GetGuestsData", "Reserve")',
                        type: 'POST',
                        data: function (d) {
                            d.startDate = startDate;
                            d.endDate   = endDate;
                            d.__RequestVerificationToken =
                                $('input[name="__RequestVerificationToken"]').val();
                        },
                        error: function (xhr) {
                            $('#tableLoader').hide();
                            showToast('Error loading data.');
                            console.error(xhr.responseText);
                        },
                        dataSrc: function (json) {
                            $('#tableLoader').hide();
                            $('#btnViewGuestOfDay').show();
                            $('#batchesTableContainer').show();
                            if (json.data && json.data.length > 0) {
                                $('#emptyState').hide().css('opacity', 0);
                            } else {
                                $('#emptyState').show().css('opacity', 1);
                            }
                            return json.data;
                        }
                    },
                    columns: [
                        { data: 'batch' },
                        { data: 'totalGuests' },
                        {
                            data: 'operatorName',
                            render: d => d && d.trim()
                                ? d
                                : '<span class="text-muted">No Operator</span>'
                        },
                        {
                            data: 'arrivalDate',
                            render: function (data) {
                                if (!data) return '<span class="text-muted">N/A</span>';
                                if (!isNaN(data)) {
                                    return new Date(parseInt(data) * 1000).toLocaleString('en-US', {
                                        timeZone:  'Asia/Manila',
                                        year:      'numeric',
                                        month:     'long',
                                        day:       'numeric',
                                        hour:      '2-digit',
                                        minute:    '2-digit',
                                        hour12:    true
                                    });
                                }
                                return data;
                            }
                        },
                        {
                            data: 'status',
                            render: function (data) {
                                if (!data) return '';
                                const map = {
                                    confirmed:   'success',
                                    anticipated: 'info',
                                    cancelled:   'danger'
                                };
                                return `<span class="badge bg-${map[data.toLowerCase()] || 'secondary'} text-uppercase">${data}</span>`;
                            }
                        },
                        {
                            data:       'batch',
                            orderable:  false,
                            searchable: false,
                            render: function (data) {
                                var actions = `<div class="d-flex flex-wrap gap-1">`;

                                @if (User.IsInRole("Staff"))
                                {
                                        <text>
                                        actions += `
                                            <button type="button" class="btn btn-sm btn-primary view-guest-details" data-batch="${data}">
                                                <i class="fas fa-eye me-1"></i> View
                                            </button>
                                            <button type="button" class="btn btn-sm btn-warning print-batch-details" data-batch="${data}">
                                                <i class="fas fa-print me-1"></i> Print
                                            </button>
                                            <div class="btn-group">
                                                <button type="button" class="btn btn-sm btn-secondary dropdown-toggle"
                                                        data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="fas fa-user-cog me-1"></i> Assign
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <li>
                                                        <button class="dropdown-item assign-guide" data-batch="${data}">
                                                            <i class="fas fa-user-tie me-1 text-success"></i> Guide
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item assign-driver" data-batch="${data}">
                                                            <i class="fas fa-car me-1 text-info"></i> Driver
                                                        </button>
                                                    </li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <button class="dropdown-item assign-outside-guide" data-batch="${data}">
                                                            <i class="fas fa-user-tie me-1" style="color:#6f42c1;"></i> Outside Guide
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item assign-outside-driver" data-batch="${data}">
                                                            <i class="fas fa-car me-1 text-info"></i> Outside Driver
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>`;
                                        </text>
                                }
                                else
                                {
                                        <text>
                                        actions += `
                                            <button type="button" class="btn btn-sm btn-primary view-guest-details" data-batch="${data}">
                                                <i class="fas fa-eye me-1"></i> View
                                            </button>
                                            <button type="button" class="btn btn-sm btn-warning print-batch-details" data-batch="${data}">
                                                <i class="fas fa-print me-1"></i> Print
                                            </button>`;
                                        </text>
                                }

                                @if (User.IsInRole("Super Admin"))
                                {
                                        <text>
                                        actions += `
                                            <div class="btn-group">
                                                <button type="button" class="btn btn-sm btn-secondary dropdown-toggle"
                                                        data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="fas fa-user-cog me-1"></i> Assign
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <li>
                                                        <button class="dropdown-item assign-guide" data-batch="${data}">
                                                            <i class="fas fa-user-tie me-1 text-success"></i> Guide
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item assign-driver" data-batch="${data}">
                                                            <i class="fas fa-car me-1 text-info"></i> Driver
                                                        </button>
                                                    </li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <button class="dropdown-item assign-outside-guide" data-batch="${data}">
                                                            <i class="fas fa-user-tie me-1" style="color:#6f42c1;"></i> Outside Guide
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item assign-outside-driver" data-batch="${data}">
                                                            <i class="fas fa-car me-1 text-info"></i> Outside Driver
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>`;
                                        </text>
                                }

                                actions += `</div>`;
                                return actions;
                            }
                        }
                    ],
                    pageLength:  10,
                    responsive:  true,
                    autoWidth:   false,
                    language:    { emptyTable: "No guest batches found." }
                });
            });

            // ================================
            // View Guest Details
            // ================================
            $('#batchesTableContainer').on('click', '.view-guest-details', function () {
                const batchCode      = $(this).data('batch');
                const modalContainer = $('#guestDetailsModalContainer');
                modalContainer.html(`
                    <div class="text-center my-4">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>`);

                $.get('@Url.Action("GetGuestsByBatch", "Reserve")', { batchCode })
                    .done(function (html) {
                        modalContainer.html(html);
                        const modal = new bootstrap.Modal(
                            document.getElementById('guestDetailsModal')
                        );
                        modal.show();
                        $('#guestDetailsModal').on('hidden.bs.modal', function () {
                            modalContainer.empty();
                        });
                    })
                    .fail(function () { showToast('Failed to load guest details.'); });
            });

            // ================================
            // Print
            // ================================
            $('#batchesTableContainer').on('click', '.print-batch-details', function () {
                const batchCode = $(this).data('batch');
                const form = $('<form>', {
                    action: '@Url.Action("PrintBatchGuests", "Reserve")',
                    method: 'POST',
                    target: '_blank'
                });
                $('<input>').attr({ type: 'hidden', name: 'batchCode', value: batchCode }).appendTo(form);
                form.appendTo('body').submit().remove();
            });

            // ================================
            // Assign Driver
            // ================================
            $('#batchesTableContainer').on('click', '.assign-driver', function () {
                const batch = $(this).data('batch');
                $('#assignDriverModalContent').html(`
                    <div class="text-center p-4">
                        <div class="spinner-border text-info" role="status"></div>
                        <p class="mt-2 text-muted">Loading drivers...</p>
                    </div>`);
                new bootstrap.Modal(document.getElementById('assignDriverModal')).show();
                $.get('@Url.Action("GetAssignDriverModal", "Reserve")', { batch })
                    .done(html => $('#assignDriverModalContent').html(html))
                    .fail(xhr  => $('#assignDriverModalContent').html(errorHtml(xhr, 'Drivers', 'bg-danger')));
            });
            $('#assignDriverModal').on('hidden.bs.modal', () => table && table.ajax.reload(null, false));

            // ================================
            // Assign Guide
            // ================================
            $('#batchesTableContainer').on('click', '.assign-guide', function () {
                const batch = $(this).data('batch');
                $('#assignGuideModalContent').html(`
                    <div class="text-center p-4">
                        <div class="spinner-border text-success" role="status"></div>
                        <p class="mt-2 text-muted">Loading guides...</p>
                    </div>`);
                new bootstrap.Modal(document.getElementById('assignGuideModal')).show();
                $.get('@Url.Action("GetAssignGuideModal", "Reserve")', { batch })
                    .done(html => $('#assignGuideModalContent').html(html))
                    .fail(xhr  => $('#assignGuideModalContent').html(errorHtml(xhr, 'Guides', 'bg-danger')));
            });
            $('#assignGuideModal').on('hidden.bs.modal', () => table && table.ajax.reload(null, false));

            // ================================
            // Assign Outside Guide
            // ================================
            $('#batchesTableContainer').on('click', '.assign-outside-guide', function () {
                const batch = $(this).data('batch');
                $('#assignOutsideGuideModalContent').html(`
                    <div class="text-center p-4">
                        <div class="spinner-border" style="color:#6f42c1;" role="status"></div>
                        <p class="mt-2 text-muted">Loading outside guides...</p>
                    </div>`);
                new bootstrap.Modal(document.getElementById('assignOutsideGuideModal')).show();
                $.get('@Url.Action("GetAssignOutsideGuideModal", "Reserve")', { batch })
                    .done(html => $('#assignOutsideGuideModalContent').html(html))
                    .fail(xhr  => $('#assignOutsideGuideModalContent').html(errorHtml(xhr, 'Outside Guides', 'bg-purple')));
            });
            $('#assignOutsideGuideModal').on('hidden.bs.modal', () => table && table.ajax.reload(null, false));

            // ================================
            // Assign Outside Driver
            // ================================
            $('#batchesTableContainer').on('click', '.assign-outside-driver', function () {
                const batch = $(this).data('batch');
                $('#assignOutsideDriverModalContent').html(`
                    <div class="text-center p-4">
                        <div class="spinner-border text-info" role="status"></div>
                        <p class="mt-2 text-muted">Loading outside drivers...</p>
                    </div>`);
                new bootstrap.Modal(document.getElementById('assignOutsideDriverModal')).show();
                $.get('@Url.Action("GetAssignOutsideDriverModal", "Reserve")', { batch })
                    .done(html => $('#assignOutsideDriverModalContent').html(html))
                    .fail(xhr  => $('#assignOutsideDriverModalContent').html(errorHtml(xhr, 'Outside Drivers', 'bg-info')));
            });
            $('#assignOutsideDriverModal').on('hidden.bs.modal', () => table && table.ajax.reload(null, false));

            // ================================
            // Shared error modal HTML helper
            // ================================
            function errorHtml(xhr, label, bg) {
                return `
                    <div class="modal-header ${bg} text-white">
                        <h5 class="modal-title">Error Loading ${label}</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger">
                            <strong>HTTP ${xhr.status}:</strong> ${xhr.statusText}
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>`;
            }

        }); // end document.ready
    </script>
}
