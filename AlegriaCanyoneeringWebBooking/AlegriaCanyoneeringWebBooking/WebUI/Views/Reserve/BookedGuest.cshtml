@model GuestListViewModel
@{
    ViewData["Title"] = "Booked Guests";
    var startDate = Context.Request.Query["startDate"].FirstOrDefault();
    var endDate = Context.Request.Query["endDate"].FirstOrDefault();
}

<div class="toast-container position-fixed top-0 end-0 p-3"></div>

<div class="container my-4">
    <!-- Title & Guest of the Day Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary m-0 d-flex align-items-center gap-2">
            <i class="fas fa-user-check"></i> Booked Guests
        </h2>

        @if (User.IsInRole("Super Admin") || User.IsInRole("Admin"))
        {
            <button id="btnViewGuestOfDay" class="btn btn-primary shadow-sm">
                <i class="fas fa-calendar-day me-1 text-warning"></i> Guest of the Day
            </button>
        }
    </div>

    <!-- Filter Form -->
    <form id="filterForm" class="row row-cols-1 row-cols-md-auto g-3 align-items-end mb-4 sticky-top bg-white py-3 shadow-sm rounded" style="top: 80px; z-index: 1020;">
        @Html.AntiForgeryToken()

        <div>
            <label for="startDate" class="form-label fw-semibold">Start Date</label>
            <input type="date" class="form-control" id="startDate" name="startDate" value="@startDate" required />
        </div>
        <div>
            <label for="endDate" class="form-label fw-semibold">End Date</label>
            <input type="date" class="form-control" id="endDate" name="endDate" value="@endDate" required />
        </div>
        <div>
            <label class="form-label invisible">Search</label>
            <button type="submit" class="btn btn-success w-100 d-flex align-items-center justify-content-center gap-2">
                <i class="fas fa-search"></i> Search
            </button>
        </div>
    </form>

    <!-- Table Container -->
    <div id="batchesTableContainer" class="card shadow-sm border-0" style="display: none;">
        <div class="card-body p-3 position-relative">
            <!-- Loader -->
            <div id="tableLoader" class="position-absolute top-50 start-50 translate-middle" style="z-index: 1050; display:none;">
                <div class="spinner-border text-primary" role="status" style="width:3rem; height:3rem;"></div>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table id="batchesTable" class="table table-hover align-middle w-100">
                    <thead class="table-light">
                        <tr>
                            <th>Batch</th>
                            <th>Total Guests</th>
                            <th>Operator</th>
                            <th>Arrival Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="text-center text-muted py-4" style="display: none; opacity: 0; transition: opacity 0.5s;">
                <i class="fas fa-user-slash fa-3x mb-3"></i>
                <p class="mb-0 fs-5">No guest batches found for the selected date range.</p>
            </div>
        </div>
    </div>

    <!-- Modal Injection Container -->
    <div id="guestDetailsModalContainer"></div>
</div>

<!-- Toast -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
    <div id="liveToast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
            // ================================
        // 🔔 Toast Utility
        // ================================
                  function showToast(message, title = 'Notification', type = 'danger') {
            const toastTypes = {
                success: { icon: 'bi-check-circle-fill', bg: 'bg-success text-white' },
                danger: { icon: 'bi-exclamation-triangle-fill', bg: 'bg-danger text-white' },
                warning: { icon: 'bi-exclamation-circle-fill', bg: 'bg-warning text-dark' },
                info: { icon: 'bi-info-circle-fill', bg: 'bg-info text-dark' }
            };

            const { icon, bg } = toastTypes[type] || toastTypes.info;
            const toastId = 'toast-' + Date.now();

            const toastHtml = `
                <div id="${toastId}" class="toast border-0 shadow-sm ${bg}" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000">
                    <div class="toast-header ${bg}">
                        <i class="bi ${icon} me-2"></i>
                        <strong class="me-auto">${title}</strong>
                        <small>Now</small>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                    <div class="toast-body">${message}</div>
                </div>
            `;

            const $toast = $(toastHtml).appendTo('.toast-container');
            const bsToast = new bootstrap.Toast($toast[0]);
            bsToast.show();

            $toast.on('hidden.bs.toast', () => $toast.remove());
        }


        // ================================
        // 🧭 Guest of the Day Modal
        // ================================
        $('#btnViewGuestOfDay').on('click', function () {
            const modalContainer = $('#guestDetailsModalContainer');
            modalContainer.html('<div class="text-center my-4"><div class="spinner-border text-primary"></div><p>Loading...</p></div>');

            $.get('@Url.Action("GetGuestOfTheDay", "Reserve")')
                .done(function (res) {
                    if (res.success === false && res.message) {
                        showToast(res.message);
                        modalContainer.empty();
                        return;
                    }
                    modalContainer.html(res);
                    const modal = new bootstrap.Modal(document.getElementById('guestOfTheDayModal'));
                    modal.show();
                })
                .fail(function () {
                    modalContainer.html('<p class="text-danger text-center mt-4">Error fetching data. Please try again.</p>');
                });
        });

        // ================================
        // 🧾 DataTable Initialization
        // ================================
        $(document).ready(function () {
            var table = null;
            var toast = new bootstrap.Toast(document.getElementById('liveToast'));

            $('#filterForm').on('submit', function (e) {
                e.preventDefault();
                const startDate = $('#startDate').val();
                const endDate = $('#endDate').val();

                if (!startDate || !endDate) {
                    showToast('Please select both start and end dates.');
                    return;
                }

                $('#btnViewGuestOfDay').fadeOut();
                $('#tableLoader').show();

                if ($.fn.DataTable.isDataTable('#batchesTable')) {
                    table.destroy();
                    $('#batchesTable').empty().append(`
                        <thead class="table-light">
                            <tr>
                                <th>Batch</th>
                                <th>Total Guests</th>
                                <th>Operator</th>
                                <th>Arrival Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>`);
                }

                table = $('#batchesTable').DataTable({
                    processing: true,
                    serverSide: true,
                    ajax: {
                        url: '@Url.Action("GetGuestsData", "Reserve")',
                        type: 'POST',
                        data: function (d) {
                            d.startDate = startDate;
                            d.endDate = endDate;
                            d.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();
                        },
                        error: function (xhr) {
                            $('#tableLoader').hide();
                            showToast('Error loading data.');
                            console.error(xhr.responseText);
                        },
                        dataSrc: function (json) {
                            $('#tableLoader').hide();
                            if (json.data && json.data.length > 0) {
                                $('#batchesTableContainer').show();
                                $('#emptyState').hide().css('opacity', 0);
                            } else {
                                $('#batchesTableContainer').show();
                                $('#emptyState').show().css('opacity', 1);
                            }
                            return json.data;
                        }
                    },
                    columns: [
                        { data: 'batch' },
                        { data: 'totalGuests' },
                        {
                            data: 'operatorName',
                            render: function (data) {
                                return data && data.trim()
                                    ? data
                                    : '<span class="text-muted">No Operator</span>';
                            }
                        },
                        {
                            data: 'arrivalDate',
                            render: function (data) {
                                if (!data) return '<span class="text-muted">N/A</span>';
                                if (!isNaN(data)) {
                                    const date = new Date(parseInt(data) * 1000);
                                    return date.toLocaleString('en-US', {
                                        timeZone: 'Asia/Manila',
                                        year: 'numeric', month: 'long', day: 'numeric',
                                        hour: '2-digit', minute: '2-digit', hour12: true
                                    });
                                } else {
                                    return data;
                                }
                            }
                        },
                        {
                            data: 'status',
                            render: function (data) {
                                if (!data) return '';
                                const badgeMap = { confirmed: 'success', anticipated: 'info', cancelled: 'danger' };
                                return `<span class="badge bg-${badgeMap[data.toLowerCase()] || 'secondary'} text-uppercase">${data}</span>`;
                            }
                        },
                        {
                            data: 'batch',
                            orderable: false,
                            searchable: false,
                            render: function (data) {
                                return `
                                    <button type="button" class="btn btn-sm btn-primary view-guest-details" data-batch="${data}">
                                        <i class="fas fa-eye me-1"></i> View
                                    </button>
                                    <button type="button" class="btn btn-sm btn-warning print-batch-details" data-batch="${data}">
                                        <i class="fas fa-print me-1"></i> Print
                                    </button>`;
                            }
                        }
                    ],
                    pageLength: 10,
                    responsive: true,
                    autoWidth: false,
                    language: { emptyTable: "No guest batches found." }
                });
            });

            // ================================
            // 👁️ View Guest Details Modal
            // ================================
            $('#batchesTableContainer').on('click', '.view-guest-details', function () {
                const batchCode = $(this).data('batch');
                const modalContainer = $('#guestDetailsModalContainer');
                modalContainer.html('<div class="text-center my-4"><div class="spinner-border text-primary" role="status"></div></div>');

                $.get('@Url.Action("GetGuestsByBatch", "Reserve")', { batchCode })
                    .done(function (html) {
                        modalContainer.html(html);
                        const modal = new bootstrap.Modal(document.getElementById('guestDetailsModal'));
                        modal.show();
                        $('#guestDetailsModal').on('hidden.bs.modal', function () { modalContainer.empty(); });
                    })
                    .fail(function () { showToast('Failed to load guest details.'); });
            });

        $('#batchesTableContainer').on('click', '.print-batch-details', function () {
            const batchCode = $(this).data('batch');

            // Temporary form nga mo-submit gamit POST
            const form = $('<form>', {
                action: '@Url.Action("PrintBatchGuests", "Reserve")',
                method: 'POST',
                target: '_blank' // mo-open sa bag-ong tab
            });

            // Hidden input para sa batchCode
            $('<input>').attr({
                type: 'hidden',
                name: 'batchCode',
                value: batchCode
            }).appendTo(form);

            // I-append sa body, i-submit, dayon i-remove
            form.appendTo('body').submit().remove();
        });


        });
    </script>
}