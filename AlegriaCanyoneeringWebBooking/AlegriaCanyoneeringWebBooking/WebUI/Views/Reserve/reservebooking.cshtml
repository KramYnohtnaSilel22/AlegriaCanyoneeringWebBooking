@model GuestListViewModel
@{
    ViewData["Title"] = "Reserved Booking";
}
<link href="/css/reservebooking.css" rel="stylesheet" />
<style>
    .toast-container .position-fixed {
        transition: opacity 1s ease-in-out !important;
    }
</style>
<section class="container py-4">
    <h2 class="fw-bold mb-4 text-primary">
        <i class="fas fa-calendar-check me-2 text-primary"></i>
        Reserved Booking
    </h2>

    <div class="d-flex justify-content-between mb-3">
        <input type="text" id="globalScannerInput" class="form-control form-control-sm"
               placeholder="Enter or scan batch QR here...">
    </div>

    <!-- ✅ DataTables Container -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table id="reservedGuestsTable" class="table table-hover w-100">
                    <thead class="table-light">
                        <tr>
                            <th>Operator</th>
                            <th>Date of Registration</th>
                            <th>Total Guests</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Data will be loaded via AJAX -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- ✅ Booking Details Modal -->
<div class="modal fade" id="bookingDetailsModal" tabindex="-1" aria-labelledby="bookingDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="bookingDetailsLabel">
                    <i class="fas fa-clipboard-list me-2"></i> Booking Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="bookingDetailsModalBody">
                <!-- Content will be loaded dynamically -->
            </div>
        </div>
    </div>
</div>

<!-- ✅ Required Libraries -->
<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/html5-qrcode/minified/html5-qrcode.min.js"></script>

<script>
    // Add fade CSS
    const style = document.createElement('style');
    style.textContent = `
        .toast-container .position-fixed {
            transition: opacity 1s ease-in-out !important;
        }
    `;
    document.head.appendChild(style);

    const input = document.getElementById('globalScannerInput');
    let typingTimer;
    const typingDelay = 1000;
    let currentScannedBatch = '';
    let dataTable;

    // ✅ FIXED: Enhanced Toast Notification System with 1-second fade
    let activeToasts = 0;
    const MAX_TOASTS = 1;
    const TOAST_TIMEOUT = 2000; // 5 seconds total (4s display + 1s fade)

    function showToast(message, type = 'info') {
        // Limit simultaneous toasts
        if (activeToasts >= MAX_TOASTS) {
            return;
        }

        const toastId = 'toast-' + Date.now();
        activeToasts++;

        const icons = {
            'success': 'fa-check-circle',
            'error': 'fa-exclamation-triangle',
            'danger': 'fa-exclamation-triangle',
            'warning': 'fa-exclamation-circle',
            'info': 'fa-info-circle'
        };

        const toastHtml = `
            <div id="${toastId}" class="position-fixed top-0 end-0 p-3" style="z-index: 1055; margin-top: ${(activeToasts - 1) * 80}px;">
                <div class="toast align-items-center text-white bg-${type} border-0 show" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="fas ${icons[type] || 'fa-info-circle'} me-2"></i>
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="removeToastWithFade('${toastId}')"></button>
                    </div>
                </div>
            </div>
        `;

        // Create toast container if it doesn't exist
        if ($('.toast-container').length === 0) {
            $('body').append('<div class="toast-container"></div>');
        }

        $('.toast-container').append(toastHtml);

        // Auto remove after timeout with 1-second fade
        setTimeout(() => {
            removeToastWithFade(toastId);
        }, TOAST_TIMEOUT);
    }

    // ✅ Function to remove specific toast with 1-second fade
    function removeToastWithFade(toastId) {
        const $toast = $(`#${toastId}`);
        if ($toast.length === 0) return;

        // Start fade out
        $toast.css('opacity', '0');

        // Remove after 1 second (fade duration)
        setTimeout(() => {
            $toast.remove();
            activeToasts = Math.max(0, activeToasts - 1);

            // Re-position remaining toasts
            $('.toast-container .position-fixed').each(function(index) {
                $(this).css('margin-top', (index * 80) + 'px');
            });
        }, 1000); // 1-second fade duration
    }

    // ✅ Function to clear all toasts
    function clearAllToasts() {
        $('.toast-container .position-fixed').each(function() {
            const toastId = $(this).attr('id');
            removeToastWithFade(toastId);
        });
    }

    input.addEventListener('keyup', () => {
        clearTimeout(typingTimer);
        typingTimer = setTimeout(() => {
            processInput(input.value);
            input.value = '';
        }, typingDelay);
    });

    input.addEventListener('keydown', () => {
        clearTimeout(typingTimer);
    });

    // ✅ FIXED: Process scanned input - NO BATCH PREFIX
    function processInput(value) {
        if(value.trim() !== '') {
            console.log("Processing scanned QR:", value);

            // ✅ JUST USE THE NUMBERS - No BATCH- prefix
            let processedBatch = value.trim();

            // Remove "BATCH-" if user accidentally types it
            if (processedBatch.startsWith("BATCH-")) {
                processedBatch = processedBatch.substring(6);
                console.log("🔧 Removed BATCH- prefix:", processedBatch);
            }

            currentScannedBatch = processedBatch;

            // Try multiple approaches
            verifyBatchExistence(currentScannedBatch);
        }
    }

    // ✅ FIXED: Enhanced batch verification
    function verifyBatchExistence(batch) {
        console.log('Verifying batch:', batch);

        $.ajax({
            url: '/Reserve/VerifyBatchExistence',
            type: 'POST',
            data: { Batch: batch },
            success: function(response) {
                console.log('Verify response:', response);
                if (response.exists) {
                    // ✅ BATCH FOUND - Show Confirm Button
                    console.log('✅ Batch found, showing confirm button');
                    showScanConfirmButton(batch, 'Found in system', 0);
                } else {
                    // ❌ BATCH NOT FOUND
                    console.log('❌ Batch not found in backend');
                    showToast(`Batch not found in reserved bookings.`, 'warning');
                    currentScannedBatch = '';
                }
            },
            error: function(xhr, status, error) {
                console.error('AJAX Error:', {
                    status: xhr.status,
                    statusText: xhr.statusText,
                    error: error,
                    responseText: xhr.responseText
                });

                // ✅ FIXED: Show error toast
                showToast('Error verifying batch. Please try again.', 'error');

                // Fallback: Try to search in current DataTables data
                fallbackBatchSearch(batch);
            }
        });
    }

    // ✅ FIXED: Fallback search if API fails
    function fallbackBatchSearch(batch) {
        console.log('Using fallback search for:', batch);

        if (!dataTable) {
            showToast('System temporarily unavailable. Please try again.', 'danger');
            return;
        }

        // Search in currently loaded data
        const currentData = dataTable.rows().data().toArray();
        const foundRow = currentData.find(row => row.batch === batch);

        if (foundRow) {
            console.log('Batch found in fallback search:', foundRow);
            // ✅ BATCH FOUND IN TABLE - Show Confirm Button
            showScanConfirmButton(batch, foundRow.operatorName, foundRow.totalGuests);
            highlightTableRow(batch);
            // ✅ FIXED: Show success toast
            showToast(`Batch ${batch} found!`, 'success');
        } else {
            // Try searching via DataTables API
            dataTable.search(batch).draw();

            setTimeout(() => {
                const searchedData = dataTable.rows({ search: 'applied' }).data().toArray();
                const searchedRow = searchedData.find(row => row.batch === batch);

                if (searchedRow) {
                    // ✅ BATCH FOUND AFTER SEARCH - Show Confirm Button
                    showScanConfirmButton(batch, searchedRow.operatorName, searchedRow.totalGuests);
                    highlightTableRow(batch);
                    // ✅ FIXED: Show success toast
                    showToast(`Batch ${batch} found!`, 'success');
                } else {
                    // ❌ BATCH NOT FOUND ANYWHERE
                    showToast(`Batch ${batch} not found. Please check the QR code.`, 'warning');
                    currentScannedBatch = '';
                }
            }, 1000);
        }
    }

    // ✅ FIXED: Show confirm button with Batch Code only
    function showScanConfirmButton(batch, operatorName, totalGuests) {
        // Remove any existing scan confirm buttons
        $('.scan-confirm-btn').remove();

        const confirmButtonHtml = `
            <div class="position-fixed top-50 start-50 translate-middle scan-confirm-btn" style="z-index: 1060;">
                <div class="card shadow-lg border-0" style="min-width: 300px;">
                    <div class="card-header bg-success text-white text-center">
                        <h6 class="mb-0">
                            <i class="fas fa-qrcode me-2"></i>Scanned Batch Found
                        </h6>
                    </div>
                    <div class="card-body text-center">
                        <p class="mb-3"><strong>Batch Code:</strong><br>
                           <span class="h5 text-primary">${batch}</span>
                        </p>

                        <div class="alert alert-info mb-3">
                            <i class="fas fa-info-circle me-2"></i>
                            Batch ready for confirmation
                        </div>

                        <div class="d-grid gap-2">
                            <button class="btn btn-success btn-lg"
                                    onclick="confirmScannedBatch('${batch.replace(/'/g, "\\'")}')">
                                <i class="fas fa-check-circle me-2"></i>Yes
                            </button>
                            <button class="btn btn-outline-danger btn-sm"
                                    onclick="closeScanConfirm()">
                                <i class="fas fa-times me-1"></i>No
                            </button>
                        </div>
                    </div>
                </div>  
            </div>
        `;

        $('body').append(confirmButtonHtml);
        // ✅ FIXED: Show success toast when button appears
        showToast(`Batch ready for confirmation!`, 'success');
    }

    // ✅ FIXED: Confirm the scanned batch - USE 'BatchCode' parameter
    function confirmScannedBatch(batch) {
        console.log('🔍 [FRONTEND] Confirming batch:', batch);

        if (!confirm(`Are you sure you want to confirm batch?`)) {
            return;
        }

        const confirmBtn = $('.scan-confirm-btn .btn-success');
        const originalHtml = confirmBtn.html();
        confirmBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Confirming...');

        // ✅ FIXED: Use 'BatchCode' parameter name to match backend
        $.ajax({
            url: '/Reserve/BookedGuest',
            type: 'POST',
            data: { BatchCode: batch },
            success: function(response) {
                console.log('✅ [FRONTEND] Confirm response:', response);
                if (response.success) {
                    // ✅ FIXED: Show success toast
                    showToast(response.message, 'success');
                    if (dataTable) {
                        dataTable.ajax.reload(null, false);
                    }
                    closeScanConfirm();
                    currentScannedBatch = '';
                } else {
                    // ✅ FIXED: Show warning toast
                    showToast(response.message, 'warning');
                    confirmBtn.prop('disabled', false).html(originalHtml);
                }
            },
            error: function(xhr, status, error) {
                console.error('💥 [FRONTEND] Error confirming batch:', error);
                console.error('Response:', xhr.responseText);
                // ✅ FIXED: Show error toast
                showToast('Error confirming batch. Please try again.', 'error');
                confirmBtn.prop('disabled', false).html(originalHtml);
            }
        });
    }

    // ✅ Function to close the scan confirm button/modal
    function closeScanConfirm() {
        $('.scan-confirm-btn').remove();
        currentScannedBatch = '';
        removeTableHighlight();
        if (dataTable) {
            dataTable.search('').draw();
        }
        // ✅ FIXED: Show info toast
        showToast('Batch confirmation cancelled.', 'danger');
    }

    // ✅ Function to highlight table row
    function highlightTableRow(batch) {
        removeTableHighlight();
        if (dataTable) {
            dataTable.rows().every(function() {
                const data = this.data();
                if (data.batch === batch) {
                    $(this.node()).addClass('table-success');
                    this.node().scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            });
        }
    }

    // ✅ Function to remove table highlight
    function removeTableHighlight() {
        $('#reservedGuestsTable tr').removeClass('table-success');
    }

    // ✅ DataTables Initialization for Grouped Data
    $(document).ready(function () {
        dataTable = $('#reservedGuestsTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/Reserve/GetReservedGuestsData',
                type: 'POST',
                data: function (d) {
                    return d;
                },
                error: function(xhr, error, thrown) {
                    console.error('DataTables error:', error);
                    console.error('Server response:', xhr.responseText);
                }
            },
            columns: [
                {
                    data: 'operatorName',
                    name: 'OperatorName',
                    className: 'text-center',
                    render: function(data) {
                        if (!data || !data.trim()) {
                            return '<span class="px-2 py-1">No Operator</span>';
                        }
                        return `<span class="px-2 py-1">${data}</span>`;
                    }
                },
                {
                    data: 'registrationDate',
                    name: 'RegistrationDate',
                    className: 'text-center'
                },
                {
                    data: 'totalGuests',
                    name: 'TotalGuests',
                    className: 'text-center',
                    render: function(data, type, row) {
                        return `<span>${data}</span>`;
                    }
                },
                {
                    data: 'bookingStatus',
                    name: 'BookingStatus',
                    className: 'text-center',
                    render: function(data, type, row) {
                        return `<span class="badge bg-success text-uppercase px-2 py-1">${data}</span>`;
                    }
                },
                {
                    data: 'batch',
                    name: 'Batch',
                    orderable: false,
                    searchable: false,
                    className: 'text-center',
                    render: function(data, type, row) {
                        let batchCode = data.replace(/'/g, "\\'");
                        let operatorName = (row.operatorName || '').replace(/'/g, "\\'");
                        let totalGuests = row.totalGuests || 0;
                        let qrBase64 = (row.qrBase64 || '').replace(/'/g, "\\'");
                        let guestId = row.id;

                        let actions = `
                            <div class="d-flex flex-column flex-md-row justify-content-center align-items-center gap-2">
                                <!-- 🔍 View Batch Details -->
                                <button class="btn btn-sm btn-primary d-flex align-items-center px-3 py-2"
                                        onclick="loadBatchDetails(${guestId})">
                                    <i class="fas fa-eye me-1"></i> View
                                </button>
                        `;

    @if (!User.IsInRole("Admin"))
    {
        <text>
                                    actions += `
                                        <!-- 📷 View QR Code -->
                                        <button type="button"
                                                class="btn btn-sm btn-info d-flex align-items-center px-3 py-2"
                                                onclick="showQrModal('${batchCode}', '${operatorName}', ${totalGuests}, '${qrBase64}')">
                                            <i class="fas fa-qrcode me-1"></i> QR
                                        </button>

                                        <!-- ✅ Confirm Entire Batch -->
                                        <button type="button"
                                                class="btn btn-sm btn-success d-flex align-items-center px-3 py-2 confirm-batch-btn"
                                                data-batch="${batchCode}">
                                            <i class="fas fa-check me-1"></i> Confirm
                                        </button>
                                    `;
        </text>
    }

                        actions += `</div>`;
                        return actions;
                    }
                }
            ],
            language: {
                emptyTable: "No reserved batches found",
                zeroRecords: "No matching batches found",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                infoEmpty: "Showing 0 to 0 of 0 entries",
                infoFiltered: "(filtered from _MAX_ total entries)",
                search: "Search:",
                paginate: {
                    previous: "Previous",
                    next: "Next"
                }
            },
            responsive: true,
            order: [[1, 'desc']],
            pageLength: 10,
            drawCallback: function () {
                const headers = $('#reservedGuestsTable thead th').map(function () {
                    return $(this).text().trim();
                }).get();

                $('#reservedGuestsTable tbody tr').each(function () {
                    $(this).find('td').each(function (i) {
                        $(this).attr('data-label', headers[i]);
                    });
                });
            }
        });

        // ✅ EVENT DELEGATION FOR CONFIRM BATCH BUTTONS
        $(document).on('click', '.confirm-batch-btn', function() {
            var batchCode = $(this).data('batch');
            confirmBatchBooking(batchCode, dataTable);
        });
    });

    // ✅ CONFIRM BATCH VIA AJAX - FIXED
    function confirmBatchBooking(batchCode, table) {
        if (!confirm(`Are you sure you want to confirm batch?`)) {
            return;
        }

        // Show loading state
        const button = $(`.confirm-batch-btn[data-batch="${batchCode}"]`);
        const originalHtml = button.html();
        button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Confirming...');

        $.ajax({
            url: '/Reserve/BookedGuest',
            type: 'POST',
            data: { BatchCode: batchCode },
            success: function(response) {
                if (response.success) {
                    showToast(response.message, 'success');
                    // Reload DataTables data
                    table.ajax.reload(null, false);
                } else {
                    showToast(response.message, 'warning');
                    button.prop('disabled', false).html(originalHtml);
                }
            },
            error: function(xhr, status, error) {
                console.error('Error confirming batch:', error);
                showToast('Error confirming batch. Please try again.', 'error');
                button.prop('disabled', false).html(originalHtml);
            }
        });
    }

    // ✅ Load Batch Details - SINGLE FIXED VERSION
    function loadBatchDetails(guestId) {
        console.log('Loading batch details for guest ID:', guestId);

        $('#bookingDetailsModalBody').html('<div class="text-center p-3"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">Loading batch details...</p></div>');

        const modal = new bootstrap.Modal(document.getElementById('bookingDetailsModal'));
        modal.show();

        // Use the GetBookingDetails method that expects a guest ID
        $.get('/Reserve/GetBookingDetails?id=' + guestId)
            .done(function (data) {
                console.log('Successfully loaded batch details');
                $('#bookingDetailsModalBody').html(data);

                // Re-initialize DataTables for the companions table after content is loaded
                setTimeout(() => {
                    if ($('#companionsTable').length) {
                        console.log('Initializing DataTables for companions table');
                        $('#companionsTable').DataTable({
                            responsive: true,
                            pageLength: 5,
                            lengthMenu: [5, 10, 25],
                            columnDefs: [
                                { orderable: false, targets: 0 }
                            ],
                            language: {
                                searchPlaceholder: "Search companion...",
                                search: ""
                            },
                            destroy: true // Important: destroy existing instance if any
                        });
                    }
                }, 100);
            })
            .fail(function(xhr, status, error) {
                console.error('Failed to load batch details:', error);
                $('#bookingDetailsModalBody').html(`
                    <div class="text-center p-4">
                        <i class="fas fa-exclamation-triangle fa-2x text-danger mb-3"></i>
                        <h5 class="text-danger">Error Loading Details</h5>
                        <p class="text-muted">Failed to load batch details: ${error}</p>
                        <p class="text-muted small">Status: ${xhr.status} - ${xhr.statusText}</p>
                        <button class="btn btn-primary mt-2" onclick="loadBatchDetails(${guestId})">Try Again</button>
                    </div>
                `);
            });
    }

    // ✅ QR Modal Function for Batch - COMPLETELY FIXED
    function showQrModal(batchCode, operatorName, totalGuests, qrBase64) {
        console.log('QR Modal Data:', {
            batchCode: batchCode,
            operatorName: operatorName,
            totalGuests: totalGuests,
            qrBase64: qrBase64 ? 'EXISTS' : 'MISSING'
        });

        const modalId = 'dynamicQrModal';

        // Remove existing modal if any
        $('#' + modalId).remove();

        // ✅ FIXED: Check if QR data is valid (URL or base64)
        let qrImageHtml = '';
        let downloadButtonHtml = '';

        // Check if we have valid QR data (URL starting with http or base64)
        if (qrBase64 && (qrBase64.startsWith('http') || qrBase64.startsWith('data:image'))) {
            qrImageHtml = `
                <div class="text-center mb-3">
                    <img src="${qrBase64}"
                         alt="QR Code for Batch ${batchCode}"
                         style="width:200px;height:200px;border:2px solid #dee2e6;border-radius:8px;padding:10px;background:white;"
                         onload="console.log('✅ QR image loaded successfully')"
                         onerror="console.error('❌ QR image failed to load'); this.style.display='none'; document.getElementById('qrError').style.display='block';" />
                    <div id="qrError" style="display:none;" class="text-center p-3 mt-2 border rounded bg-light">
                        <i class="fas fa-exclamation-triangle text-warning mb-2"></i>
                        <p class="text-muted small mb-2">QR image failed to load</p>
                        <button class="btn btn-sm btn-outline-primary" onclick="retryQrImage('${batchCode}')">
                            <i class="fas fa-redo me-1"></i> Retry
                        </button>
                    </div>
                </div>
            `;

            downloadButtonHtml = `
                <button class="btn btn-success btn-sm"
                        onclick="downloadBatchQRCode('${batchCode.replace(/'/g, "\\'")}', '${operatorName.replace(/'/g, "\\'")}', ${totalGuests})">
                    <i class="fas fa-download me-1"></i> Download QR
                </button>
            `;
        } else {
            // No QR code available
            qrImageHtml = `
                <div class="text-center p-4 border rounded bg-light">
                    <i class="fas fa-qrcode fa-4x text-muted mb-3"></i>
                    <p class="text-muted mb-2">QR Code not available</p>
                    <p class="text-muted small mb-3">The system could not generate a QR code for this batch.</p>
                    <button class="btn btn-primary btn-sm" onclick="generateQrCode('${batchCode}')">
                        <i class="fas fa-sync me-1"></i> Generate QR Code
                    </button>
                </div>
            `;
        }

        // Create new modal
        const modalHtml = `
            <div class="modal fade" id="${modalId}" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header bg-primary text-white">
                            <h6 class="modal-title w-100">
                                <i class="fas fa-qrcode me-2"></i>Batch QR Code
                            </h6>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <p class="mb-2"><strong><i class="fas fa-building me-2"></i>Operator:</strong><br>${operatorName}</p>

                                        <p class="mb-3"><strong><i class="fas fa-users me-2"></i>Total Guests:</strong><br>${totalGuests}</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    ${qrImageHtml}
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer justify-content-center">
                            ${downloadButtonHtml}
                        </div>
                    </div>
                </div>
            </div>
        `;

        $('body').append(modalHtml);
        const modal = new bootstrap.Modal(document.getElementById(modalId));
        modal.show();

        // Clean up on modal close
        $('#' + modalId).on('hidden.bs.modal', function () {
            $(this).remove();
        });
    }

    // ✅ Function to retry loading QR image
    function retryQrImage(batchCode) {
        const img = document.querySelector('#dynamicQrModal img');
        if (img) {
            // Add timestamp to bypass cache
            const originalSrc = img.src.split('?')[0]; // Remove existing parameters
            const newSrc = originalSrc + '?t=' + new Date().getTime();
            img.src = newSrc;
            document.getElementById('qrError').style.display = 'none';
            img.style.display = 'block';
            console.log('🔄 Retrying QR image load...');
        }
    }

    // ✅ Function to generate QR code dynamically
    function generateQrCode(batchCode) {
        showToast('Generating QR code...', 'info');

        // Close current modal
        $('#dynamicQrModal').modal('hide');

        // Reload the table data to get new QR codes
        setTimeout(() => {
            const table = $('#reservedGuestsTable').DataTable();
            table.ajax.reload(null, false);

            // Reopen modal after data reload
            setTimeout(() => {
                const row = table.rows().data().toArray().find(row => row.batch === batchCode);
                if (row) {
                    showQrModal(row.batch, row.operatorName, row.totalGuests, row.qrBase64);
                    showToast('QR code generated successfully!', 'success');
                }
            }, 1000);
        }, 500);
    }

    // ✅ Download Batch QR Code - COMPLETELY FIXED
    function downloadBatchQRCode(batchCode, operator, totalGuests) {
        const modal = document.getElementById('dynamicQrModal');
        if (!modal) {
            showToast('Modal not found', 'danger');
            return;
        }

        const img = modal.querySelector('img');
        if (!img) {
            showToast('QR image not found', 'warning');
            return;
        }

        // Create a new image to handle cross-origin issues
        const downloadImage = new Image();
        downloadImage.crossOrigin = "Anonymous";

        // Add cache busting parameter
        const imgSrc = img.src + (img.src.includes('?') ? '&' : '?') + 'download=' + new Date().getTime();
        downloadImage.src = imgSrc;

        downloadImage.onload = function() {
            try {
                const canvas = document.createElement('canvas');
                canvas.width = 300;
                canvas.height = 350;
                const ctx = canvas.getContext("2d");

                // White background
                ctx.fillStyle = "#ffffff";
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                // Draw QR code (centered)
                ctx.drawImage(downloadImage, 50, 30, 200, 200);

                // Add header
                ctx.fillStyle = "#2c3e50";
                ctx.font = "bold 18px Arial";
                ctx.textAlign = "center";

                // Add details
                ctx.fillStyle = "#34495e";
                ctx.font = "14px Arial";

                ctx.fillText("Operator: " + operator, canvas.width / 2, 305);
                ctx.fillText("Total Guests: " + totalGuests, canvas.width / 2, 325);

                // Add footer
                ctx.fillStyle = "#7f8c8d";
                ctx.font = "10px Arial";
                ctx.fillText("Generated on: " + new Date().toLocaleDateString(), canvas.width / 2, 340);

                // Download
                const link = document.createElement("a");
                link.download = `BatchQR-${batchCode}.png`;
                link.href = canvas.toDataURL("image/png");
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                showToast('QR Code downloaded successfully!', 'success');
            } catch (error) {
                console.error('Error downloading QR:', error);
                showToast('Error downloading QR code', 'danger');
            }
        };

        downloadImage.onerror = function() {
            showToast('Failed to load QR image for download', 'danger');
        };
    }

    // ✅ Bootstrap toast auto-show
    document.addEventListener("DOMContentLoaded", function () {
        var toastElement = document.getElementById('toastMessage');
        if (toastElement) {
            var toast = new bootstrap.Toast(toastElement);
            toast.show();
        }
    });
</script>