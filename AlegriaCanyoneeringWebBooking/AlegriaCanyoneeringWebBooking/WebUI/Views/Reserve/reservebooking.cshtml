@model GuestListViewModel
@{
    ViewData["Title"] = "Reserved Booking";
}

<form id="reservedBookingAntiForgeryForm" class="d-none">
    @Html.AntiForgeryToken()
</form>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

    .rb-wrap {
        font-family: 'Outfit', sans-serif;
    }

    /* ── Page Header ──────────────────────────────────────── */
    .rb-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

        .rb-header h2 {
            font-size: 1.35rem;
            font-weight: 700;
            color: #0f3460;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    /* ── Scanner Input ────────────────────────────────────── */
    .scanner-wrap {
        background: #fff;
        border-radius: 14px;
        border: 1.5px solid #e8edf5;
        box-shadow: 0 2px 16px rgba(15,52,96,0.07);
        padding: 1rem 1.25rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .scanner-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: rgba(26,110,245,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #1a6ef5;
        font-size: 1rem;
    }

    .scanner-wrap input {
        flex: 1;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.6rem 1rem;
        font-family: 'Outfit', sans-serif;
        font-size: 0.9rem;
        color: #1e293b;
        background: #fafbff;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .scanner-wrap input:focus {
            border-color: #1a6ef5;
            box-shadow: 0 0 0 3px rgba(26,110,245,0.1);
            background: #fff;
        }

        .scanner-wrap input::placeholder {
            color: #b0bec5;
        }

    /* ── Table Card ───────────────────────────────────────── */
    .rb-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 20px rgba(15,52,96,0.08);
        border: 1px solid #e8edf5;
        overflow: hidden;
    }

    .rb-card-body {
        padding: 1.25rem;
    }

    #reservedGuestsTable thead th {
        background: #f8faff;
        color: #0f3460;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-bottom: 2px solid #e8edf5;
        white-space: nowrap;
        padding: 0.8rem 1rem;
    }

    #reservedGuestsTable tbody td {
        vertical-align: middle;
        font-size: 0.875rem;
        color: #334155;
        padding: 0.75rem 1rem;
    }

    #reservedGuestsTable tbody tr:hover {
        background: #f0f6ff;
    }

    #reservedGuestsTable tbody tr.row-highlight {
        background: rgba(22,163,74,0.07);
    }

    /* ── Booking Details Modal ────────────────────────────── */
    .modal-header-blue {
        background: linear-gradient(135deg, #1a6ef5, #0f3460);
        color: #fff;
        padding: 1rem 1.5rem;
        border-radius: 16px 16px 0 0;
    }

        .modal-header-blue h5 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0;
        }

    .modal-content {
        border-radius: 16px;
        border: 0;
        box-shadow: 0 8px 40px rgba(15,52,96,0.18);
    }

    /* ── Scan Confirm Card ────────────────────────────────── */
    .scan-confirm-btn {
        position: fixed;
        top: 80px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1060;
        width: min(420px, 92vw);
        animation: popIn 0.3s cubic-bezier(.17,.67,.4,1.3) both;
    }

    @@keyframes popIn {
        from {
            transform: translateX(-50%) scale(0.85);
            opacity: 0;
        }

        to {
            transform: translateX(-50%) scale(1);
            opacity: 1;
        }
    }

    .scan-confirm-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 12px 48px rgba(15,52,96,0.2);
        border: 1px solid #e8edf5;
        overflow: hidden;
    }

    .scan-confirm-header {
        background: linear-gradient(135deg, #1a6ef5, #0f3460);
        color: #fff;
        padding: 0.9rem 1.25rem;
        text-align: center;
        font-weight: 700;
        font-size: 0.95rem;
    }

    .scan-confirm-body {
        padding: 1.25rem;
        text-align: center;
    }

    .scan-batch-code {
        font-size: 1.75rem;
        font-weight: 800;
        color: #1a6ef5;
        letter-spacing: 0.05em;
        margin: 0.5rem 0 1.25rem;
    }

    .btn-confirm-yes {
        padding: 0.65rem 1.75rem;
        background: linear-gradient(135deg, #16a34a, #15803d);
        color: #fff;
        border: none;
        border-radius: 50px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s;
        box-shadow: 0 4px 14px rgba(22,163,74,0.3);
    }

        .btn-confirm-yes:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    .btn-confirm-no {
        padding: 0.65rem 1.75rem;
        background: none;
        color: #ef4444;
        border: 1.5px solid #fca5a5;
        border-radius: 50px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s, color 0.2s;
    }

        .btn-confirm-no:hover {
            background: #ef4444;
            color: #fff;
            border-color: #ef4444;
        }

    /* ── Mobile table ─────────────────────────────────────── */
    @@media (max-width: 640px) {
        #reservedGuestsTable thead {
            display: none;
        }

        #reservedGuestsTable tbody tr {
            display: block;
            margin-bottom: 0.75rem;
            border: 1px solid #e8edf5;
            border-radius: 12px;
            padding: 0.5rem 0.75rem;
            background: #fff;
        }

        #reservedGuestsTable tbody td {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.4rem 0;
            border: none;
            border-bottom: 1px solid #f1f5f9;
            font-size: 0.83rem;
        }

            #reservedGuestsTable tbody td:last-child {
                border-bottom: none;
            }

            #reservedGuestsTable tbody td::before {
                content: attr(data-label);
                font-weight: 600;
                font-size: 0.7rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: #94a3b8;
                flex-shrink: 0;
                margin-right: 0.5rem;
            }
    }

    /* ── Update Button ────────────────────────────────────── */
    .btn-update {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.55rem 1.75rem;
        background: linear-gradient(135deg, #1a6ef5, #0f3460);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s;
        box-shadow: 0 4px 12px rgba(26,110,245,0.25);
    }

        .btn-update:hover {
            opacity: 0.9;
            transform: translateY(-1px);
            color: #fff;
        }
</style>

<div class="rb-wrap">

    <!-- Header -->
    <div class="rb-header">
        <h2>
            <i class="bi bi-calendar-check-fill" style="color:#1a6ef5;"></i>
            Reserved Bookings
        </h2>
    </div>

    <!-- Scanner Input -->
    <div class="scanner-wrap">
        <div class="scanner-icon"><i class="bi bi-qr-code-scan"></i></div>
        <input type="text" id="globalScannerInput"
               placeholder="Scan or enter batch QR code here..." />
    </div>

    <!-- Table Card -->
    <div class="rb-card">
        <div class="rb-card-body">
            <div class="table-responsive">
                <table id="reservedGuestsTable" class="table table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Operator</th>
                            <th>Date of Registration</th>
                            <th>Total Guests</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Booking Details Modal -->
<div class="modal fade" id="bookingDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header-blue d-flex align-items-center justify-content-between">
                <h5><i class="bi bi-clipboard-check me-2"></i>Booking Details</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3" id="bookingDetailsModalBody"></div>
        </div>
    </div>
</div>

<!-- Edit Guest Modal -->
<div class="modal fade" id="editGuestModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: 0; box-shadow: 0 8px 40px rgba(15,52,96,0.18);">
            <div class="modal-header-blue d-flex align-items-center justify-content-between">
                <h5><i class="bi bi-pencil-square me-2"></i>Edit Guest</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editGuestForm">
                    <input type="hidden" id="editGuestId" name="Id" />
                    <div class="mb-3">
                        <label class="form-label text-muted" style="font-size: 0.85rem;">Full Name</label>
                        <input type="text" class="form-control" id="editGuestFullname" name="Fullname" required style="border-radius: 8px;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted" style="font-size: 0.85rem;">Age</label>
                        <input type="number" class="form-control" id="editGuestAge" name="Age" style="border-radius: 8px;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted" style="font-size: 0.85rem;">Gender</label>
                        <select class="form-select" id="editGuestGender" name="Gender" style="border-radius: 8px;">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted" style="font-size: 0.85rem;">Nationality Type</label>
                        <select class="form-select" id="editGuestNationalityType" name="NationalityType" style="border-radius: 8px;">
                            <option value="Local">Local</option>
                            <option value="Foreign">Foreign</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted" style="font-size: 0.85rem;">Nationality</label>
                        <select class="form-select" id="editGuestNationality" name="NationalityId" style="border-radius: 8px;"></select>
                    </div>
                    <div class="text-end mt-4">
                        <button type="button" class="btn btn-outline-secondary px-4 me-2" style="border-radius: 10px; font-weight: 500;" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-update">
                            <i class="bi bi-pencil-fill me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Batch Modal -->
<div class="modal fade" id="editBatchModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: 0; box-shadow: 0 8px 40px rgba(15,52,96,0.18);">
            <div class="modal-header-blue d-flex align-items-center justify-content-between">
                <h5><i class="bi bi-pencil-square me-2"></i>Edit Batch</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editBatchForm">
                    <input type="hidden" id="editBatchCode" name="BatchCode" />
                    <input type="hidden" id="editBatchGuestsJson" name="GuestsJson" />
                    
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted" style="font-size: 0.85rem;">Operator</label>
                            <select class="form-select" id="editBatchOperator" name="OperatorId" style="border-radius: 8px;"></select>
                        </div>
                    </div>
                    
                    <h6 class="mb-3 text-primary"><i class="bi bi-people me-2"></i>Guests in this Batch</h6>
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Full Name</th>
                                    <th style="width: 100px;">Age</th>
                                    <th style="width: 150px;">Gender</th>
                                    <th style="width: 150px;">Nat. Type</th>
                                    <th>Nationality</th>
                                </tr>
                            </thead>
                            <tbody id="editBatchGuestsBody">
                                <!-- Dynamic rows go here -->
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="text-end mt-4">
                        <button type="button" class="btn btn-outline-secondary px-4 me-2" style="border-radius: 10px; font-weight: 500;" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-update">
                            <i class="bi bi-pencil-fill me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Toast container -->
<div id="rbToastContainer"
     class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090;"></div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html5-qrcode/2.3.8/html5-qrcode.min.js"></script>
    <script>
        // ── Toast utility ──────────────────────────────────────
        function showToast(message, type = 'info', title = '') {
        const map = {
        success: { bg: '#22c55e', icon: 'bi-check-circle-fill',        label: 'Success' },
        error:   { bg: '#ef4444', icon: 'bi-exclamation-triangle-fill', label: 'Error'   },
        danger:  { bg: '#ef4444', icon: 'bi-exclamation-triangle-fill', label: 'Error'   },
        warning: { bg: '#f0a500', icon: 'bi-exclamation-circle-fill',   label: 'Warning' },
        info:    { bg: '#1a6ef5', icon: 'bi-info-circle-fill',          label: 'Info'    }
        };
        const { bg, icon, label } = map[type] || map.info;
        const id   = 'rbt-' + Date.now();
        const html = `
        <div id="${id}" class="toast border-0 text-white"
        style="background:${bg};border-radius:12px;box-shadow:0 4px 16px rgba(0,0,0,0.15);"
        role="alert" aria-atomic="true" data-bs-delay="4000">
        <div class="toast-header border-0 text-white" style="background:transparent;">
        <i class="bi ${icon} me-2"></i>
        <strong class="me-auto">${title || label}</strong>
        <button type="button" class="btn-close btn-close-white"
        data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body" style="padding-top:0;">${message}</div>
        </div>`;
        const container = document.getElementById('rbToastContainer');
        container.insertAdjacentHTML('beforeend', html);
        const el = document.getElementById(id);
        new bootstrap.Toast(el).show();
        el.addEventListener('hidden.bs.toast', () => el.remove());
        }

        // ── Scanner input ──────────────────────────────────────
        const input = document.getElementById('globalScannerInput');
        let typingTimer, currentScannedBatch = '', dataTable;

        input.addEventListener('keyup', () => {
        clearTimeout(typingTimer);
        typingTimer = setTimeout(() => {
        const val = input.value.trim();
        input.value = '';
        if (val) processInput(val);
        }, 1000);
        });
        input.addEventListener('keydown', () => clearTimeout(typingTimer));

        function processInput(value) {
        let batch = value.trim();
        if (batch.startsWith('BATCH-')) batch = batch.substring(6);
        currentScannedBatch = batch;
        verifyBatchExistence(batch);
        }

        function verifyBatchExistence(batch) {
        $.ajax({
        url: '/Reserve/VerifyBatchExistence', type: 'POST',
        data: { Batch: batch },
        success: function (r) {
        if (r.exists) showScanConfirmCard(batch);
        else { showToast('Batch not found in reserved bookings.', 'warning'); currentScannedBatch = ''; }
        },
        error: function () {
        showToast('Error verifying batch. Please try again.', 'error');
        fallbackBatchSearch(batch);
        }
        });
        }

        function fallbackBatchSearch(batch) {
        if (!dataTable) { showToast('System unavailable. Please try again.', 'danger'); return; }
        const found = dataTable.rows().data().toArray().find(r => r.batch === batch);
        if (found) { showScanConfirmCard(batch); highlightTableRow(batch); }
        else { showToast(`Batch ${batch} not found.`, 'warning'); currentScannedBatch = ''; }
        }

        // ── Scan confirm card ──────────────────────────────────
        function showScanConfirmCard(batch) {
        batch = String(batch);   // ✅ guarantee string regardless of caller
        $('.scan-confirm-btn').remove();
        const html = `
        <div class="scan-confirm-btn">
        <div class="scan-confirm-card">
        <div class="scan-confirm-header">
        <i class="bi bi-qr-code-scan me-2"></i>Batch Found
        </div>
        <div class="scan-confirm-body">
        <p style="color:#64748b;font-size:0.85rem;margin-bottom:0.25rem;">Batch Code</p>
        <div class="scan-batch-code">${batch}</div>
        <p style="color:#64748b;font-size:0.85rem;margin-bottom:1rem;">
        Confirm this batch booking?
        </p>
        <div style="display:flex;gap:0.75rem;justify-content:center;">
        <button class="btn-confirm-yes"
        onclick="confirmScannedBatch('${batch.replace(/'/g,"\\'")}')">
        <i class="bi bi-check-lg me-1"></i> Yes, Confirm
        </button>
        <button class="btn-confirm-no" onclick="closeScanConfirm()">
        <i class="bi bi-x-lg me-1"></i> No
        </button>
        </div>
        </div>
        </div>
        </div>`;
        $('body').append(html);
        showToast(`Batch <strong>${batch}</strong> ready for confirmation.`, 'info');
        }

        function confirmScannedBatch(batch) {
        const $btn = $('.scan-confirm-btn .btn-confirm-yes');
        $btn.prop('disabled', true).html(
        '<span class="spinner-border spinner-border-sm me-1"></span> Confirming...'
        );
        $.ajax({
        url: '/Reserve/BookedGuest', type: 'POST',
        data: { BatchCode: batch },
        success: function (r) {
        closeScanConfirm();
        if (r.success) { showToast(r.message, 'success'); if (dataTable) dataTable.ajax.reload(null, false); }
        else { showToast(r.message, 'warning'); }
        },
        error: function () {
        showToast('Error confirming batch. Please try again.', 'error');
        $btn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i> Yes, Confirm');
        }
        });
        }

        function closeScanConfirm() {
        $('.scan-confirm-btn').remove();
        currentScannedBatch = '';
        removeTableHighlight();
        if (dataTable) dataTable.search('').draw();
        }

        function highlightTableRow(batch) {
        removeTableHighlight();
        if (!dataTable) return;
        dataTable.rows().every(function () {
        if (this.data().batch === batch) {
        $(this.node()).addClass('row-highlight');
        this.node().scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        });
        }
        function removeTableHighlight() {
        $('#reservedGuestsTable tr').removeClass('row-highlight');
        }

        // ── DataTable ──────────────────────────────────────────
        $(document).ready(function () {
        dataTable = $('#reservedGuestsTable').DataTable({
        processing: true,
        serverSide: true,
        ajax: {
        url: '/Reserve/GetReservedGuestsData', type: 'POST',
        error: (xhr, err) => console.error('DataTable error:', err)
        },
        columns: [
        {
        data: 'operatorName',
        render: d => d?.trim()
        ? `<span class="fw-semibold">${d}</span>`
        : `<span class="text-muted">No Operator</span>`
        },
        { data: 'registrationDate' },
        {
        data: 'totalGuests',
        render: d => `<span style="background:rgba(26,110,245,0.08);color:#1a6ef5;
        font-size:0.8rem;font-weight:600;padding:0.2rem 0.6rem;
        border-radius:20px;">${d}</span>`
        },
        {
        data: 'bookingStatus',
        render: d => `<span style="background:rgba(22,163,74,0.08);color:#16a34a;
        font-size:0.72rem;font-weight:700;padding:0.25rem 0.65rem;
        border-radius:20px;text-transform:uppercase;
        letter-spacing:0.05em;">${d}</span>`
        },
        {
        data: 'batch', orderable: false, searchable: false,
        className: 'text-center',
        render: function (data, type, row) {
        const b   = data.replace(/'/g, "\\'");
        const op  = (row.operatorName || '').replace(/'/g, "\\'");
        const qr  = (row.qrBase64 || '').replace(/'/g, "\\'");
        const id  = row.id;

        let html = `
        <div class="d-flex flex-wrap justify-content-center gap-1">
        <button class="btn btn-sm btn-primary"
        style="border-radius:8px;font-size:0.8rem;"
        onclick="loadBatchDetails(${id})">
        <i class="bi bi-eye me-1"></i> View
        </button>`;

        @if (User.IsInRole("Super Admin"))
        {
            <text>
                html += `
                <button type="button" class="btn btn-sm btn-info"
                        style="border-radius:8px;font-size:0.8rem;"
                        onclick="showQrModal('${b}','${op}',${row.totalGuests},'${qr}')">
                    <i class="bi bi-qr-code me-1"></i> QR
                </button>
                <button type="button"
                        class="btn btn-sm btn-success confirm-batch-btn"
                        style="border-radius:8px;font-size:0.8rem;"
                        data-batch="${b}">
                    <i class="bi bi-check-lg me-1"></i> Confirm
                </button>
                <button type="button"
                        class="btn btn-sm btn-primary edit-batch-btn"
                        style="border-radius:8px;font-size:0.8rem;"
                        data-batch="${b}">
                    <i class="bi bi-pencil-square me-1"></i> Edit
                </button>
                <button type="button"
                        class="btn btn-sm btn-danger delete-batch-btn"
                        style="border-radius:8px;font-size:0.8rem;"
                        data-batch="${b}">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>`;
            </text>
        }

        html += '</div>';
        return html;
        }
        }
        ],
        language: { emptyTable: 'No reserved batches found.' },
        responsive: true,
        order: [[1, 'desc']],
        pageLength: 10,
        drawCallback: function () {
        const headers = $('#reservedGuestsTable thead th')
        .map(function () { return $(this).text().trim(); }).get();
        $('#reservedGuestsTable tbody tr').each(function () {
        $(this).find('td').each(function (i) {
        $(this).attr('data-label', headers[i]);
        });
        });
        }
        });

        // Confirm batch via table button
        $(document).on('click', '.confirm-batch-btn', function () {
        const batch = $(this).data('batch');
        confirmBatchBooking(batch);
        });

        // Edit batch via table button
        $(document).on('click', '.edit-batch-btn', function () {
        const batch = String($(this).data('batch'));
        editBatch(batch);
        });

        // Delete batch via table button
        $(document).on('click', '.delete-batch-btn', function () {
        const batch = String($(this).data('batch'));
        showDeleteConfirmModal(
        'Delete Batch',
        `Are you sure you want to delete <strong>all guests</strong> in batch <strong>${batch}</strong>? This action cannot be undone.`,
        function () { performDeleteBatch(batch); }
        );
        });
        });

        // ── Confirm batch (table button) ───────────────────────
        function confirmBatchBooking(batchCode) {
        showScanConfirmCard(String(batchCode));   // ✅ coerce to string — data-* can come back as number
        }

        // ── Load batch details modal ───────────────────────────
        function loadBatchDetails(guestId) {
        const $body = $('#bookingDetailsModalBody');
        $body.html(`
        <div class="text-center py-5 text-muted">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <div style="font-size:0.875rem;">Loading details...</div>
        </div>`);

        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('bookingDetailsModal'));
        modal.show();

        $.get('/Reserve/GetBookingDetails?id=' + guestId)
        .done(function (html) {
        $body.html(html);
        setTimeout(() => {
        if ($('#companionsTable').length && !$.fn.dataTable.isDataTable('#companionsTable')) {
        $('#companionsTable').DataTable({
        responsive: true, pageLength: 5,
        lengthMenu: [5, 10, 25],
        columnDefs: [{ orderable: false, targets: 0 }],
        language: { searchPlaceholder: 'Search guest...', search: '' }
        });
        }
        }, 100);
        })
        .fail(function (xhr) {
        $body.html(`
        <div class="text-center p-4">
        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:2rem;"></i>
        <h6 class="mt-2" style="color:#0f3460;">Failed to Load</h6>
        <p class="text-muted" style="font-size:0.875rem;">
        HTTP ${xhr.status}: ${xhr.statusText}
        </p>
        <button class="btn btn-sm btn-primary rounded-pill mt-1"
        onclick="loadBatchDetails(${guestId})">
        <i class="bi bi-arrow-clockwise me-1"></i> Retry
        </button>
        </div>`);
        });
        }

        // ── QR Modal ───────────────────────────────────────────
        function showQrModal(batchCode, operatorName, totalGuests, qrBase64) {
        $('#dynamicQrModal').remove();

        const hasQr = qrBase64 && (qrBase64.startsWith('http') || qrBase64.startsWith('data:image'));
        const qrHtml = hasQr
        ? `<img src="${qrBase64}" alt="QR Code"
        style="width:180px;height:180px;border:1.5px solid #e8edf5;
        border-radius:12px;padding:8px;background:#fff;"
        onerror="this.style.display='none'" />`
        : `<div style="width:180px;height:180px;border:1.5px dashed #e2e8f0;border-radius:12px;
        display:flex;flex-direction:column;align-items:center;justify-content:center;
        color:#94a3b8;font-size:0.8rem;gap:0.5rem;">
        <i class="bi bi-qr-code" style="font-size:2rem;"></i>
        QR not available
        </div>`;

        const downloadBtn = hasQr
        ? `<button class="btn btn-sm btn-success rounded-pill"
        onclick="downloadBatchQRCode('${batchCode.replace(/'/g,"\\'")}','${operatorName.replace(/'/g,"\\'")}',${totalGuests})">
        <i class="bi bi-download me-1"></i> Download
        </button>`
        : '';

        const html = `
        <div class="modal fade" id="dynamicQrModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content">
        <div class="modal-header-blue d-flex align-items-center justify-content-between">
        <h5><i class="bi bi-qr-code me-2"></i>Batch QR Code</h5>
        <button type="button" class="btn-close btn-close-white"
        data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
        <div class="d-flex gap-3 align-items-center">
        <div>${qrHtml}</div>
        <div>
        <div style="font-size:0.75rem;color:#94a3b8;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.25rem;">Operator</div>
        <div style="font-weight:600;color:#0f3460;margin-bottom:0.75rem;">${operatorName || '—'}</div>
        <div style="font-size:0.75rem;color:#94a3b8;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.25rem;">Total Guests</div>
        <div style="font-size:1.5rem;font-weight:800;color:#1a6ef5;">${totalGuests}</div>
        </div>
        </div>
        </div>
        <div class="modal-footer border-0 justify-content-center pb-3">${downloadBtn}</div>
        </div>
        </div>
        </div>`;

        $('body').append(html);
        const modal = new bootstrap.Modal(document.getElementById('dynamicQrModal'));
        modal.show();
        $('#dynamicQrModal').on('hidden.bs.modal', function () { $(this).remove(); });
        }

        // ── Download QR ────────────────────────────────────────
        function downloadBatchQRCode(batchCode, operator, totalGuests) {
        const img = document.querySelector('#dynamicQrModal img');
        if (!img) { showToast('QR image not found.', 'warning'); return; }

        const dl = new Image();
        dl.crossOrigin = 'Anonymous';
        dl.src = img.src + (img.src.includes('?') ? '&' : '?') + 't=' + Date.now();
        dl.onload = function () {
        const canvas = document.createElement('canvas');
        canvas.width = 300; canvas.height = 340;
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, 300, 340);
        ctx.drawImage(dl, 50, 20, 200, 200);
        ctx.fillStyle = '#0f3460'; ctx.font = 'bold 13px Arial'; ctx.textAlign = 'center';
        ctx.fillText('Operator: ' + operator, 150, 245);
        ctx.fillText('Total Guests: ' + totalGuests, 150, 265);
        ctx.fillStyle = '#94a3b8'; ctx.font = '10px Arial';
        ctx.fillText('Generated: ' + new Date().toLocaleDateString(), 150, 285);
        const link = document.createElement('a');
        link.download = `BatchQR-${batchCode}.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();
        showToast('QR Code downloaded!', 'success');
        };
        dl.onerror = () => showToast('Failed to load image for download.', 'danger');
        }

        // ── Delete confirm modal ──────────────────────────────────
        let pendingDeleteCallback = null;

        function showDeleteConfirmModal(title, bodyHtml, onConfirm) {
        $('#deleteConfirmModal').remove();
        const html = `
        <div class="modal fade" id="deleteConfirmModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content" style="border-radius:16px;border:0;box-shadow:0 8px 40px rgba(15,52,96,0.18);">
        <div style="background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;padding:1rem 1.5rem;border-radius:16px 16px 0 0;">
        <h5 style="font-size:1rem;font-weight:700;margin:0;"><i class="bi bi-exclamation-triangle-fill me-2"></i>${title}</h5>
        </div>
        <div class="modal-body p-4" style="text-align:center;">
        <i class="bi bi-trash" style="font-size:2.5rem;color:#ef4444;margin-bottom:0.75rem;display:block;"></i>
        <p style="color:#334155;font-size:0.9rem;margin-bottom:1.25rem;">${bodyHtml}</p>
        <div style="display:flex;gap:0.75rem;justify-content:center;">
        <button type="button" class="btn btn-danger px-4" id="deleteConfirmYes"
        style="border-radius:50px;font-weight:600;font-size:0.9rem;">
        <i class="bi bi-trash me-1"></i> Yes, Delete
        </button>
        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal"
        style="border-radius:50px;font-weight:600;font-size:0.9rem;">
        Cancel
        </button>
        </div>
        </div>
        </div>
        </div>
        </div>`;
        $('body').append(html);
        pendingDeleteCallback = onConfirm;
        const modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
        modal.show();
        $('#deleteConfirmYes').on('click', function () {
        modal.hide();
        if (pendingDeleteCallback) pendingDeleteCallback();
        });
        $('#deleteConfirmModal').on('hidden.bs.modal', function () { $(this).remove(); pendingDeleteCallback = null; });
        }

        // ── Delete batch ──────────────────────────────────────────
        function performDeleteBatch(batchCode) {
        const antiForgeryToken = $('#reservedBookingAntiForgeryForm input[name="__RequestVerificationToken"]').val();
        $.ajax({
        url: '@Url.Action("DeleteReservedBatch", "Reserve")',
        type: 'POST',
        headers: { 'RequestVerificationToken': antiForgeryToken },
        data: {
        batchCode: batchCode,
        __RequestVerificationToken: antiForgeryToken
        },
        success: function (r) {
        if (r.success) {
        showToast(r.message, 'success');
        if (dataTable) dataTable.ajax.reload(null, false);
        } else {
        showToast(r.message, 'warning');
        }
        },
        error: function () {
        showToast('Error deleting batch. Please try again.', 'error');
        }
        });
        }

        // ── Delete single guest (from modal) ─────────────────────
        function deleteGuest(guestId, guestName) {
        showDeleteConfirmModal(
        'Delete Guest',
        `Are you sure you want to delete <strong>${guestName}</strong>? This action cannot be undone.`,
        function () {
        const antiForgeryToken = $('#reservedBookingAntiForgeryForm input[name="__RequestVerificationToken"]').val();
        $.ajax({
        url: '@Url.Action("DeleteReservedGuest", "Reserve")',
        type: 'POST',
        headers: { 'RequestVerificationToken': antiForgeryToken },
        data: {
        id: guestId,
        __RequestVerificationToken: antiForgeryToken
        },
        success: function (r) {
        if (r.success) {
        showToast(r.message, 'success');
        // Remove row from modal table
        const $row = $(`tr[data-guest-row="${guestId}"]`);
        if ($row.length) {
        if ($.fn.dataTable.isDataTable('#companionsTable')) {
        $('#companionsTable').DataTable().row($row).remove().draw();
        } else {
        $row.fadeOut(300, function () { $(this).remove(); });
        }
        }
        // Refresh main table too
        if (dataTable) dataTable.ajax.reload(null, false);
        } else {
        showToast(r.message, 'warning');
        }
        },
        error: function () {
        showToast('Error deleting guest. Please try again.', 'error');
        }
        });
        }
        );
        }

        // ── Edit Guest ──────────────────────────────────────────
        let globalForeignNats = [];
        
        function getNatOptions(type) {
            if (type === 'Local') {
                return '<option value="1">Within Cebu Province</option><option value="2">Outside Cebu Province</option>';
            } else {
                let opts = '';
                globalForeignNats.forEach(n => {
                    opts += `<option value="${n.id}">${n.natName}</option>`;
                });
                return opts;
            }
        }

        $('#editGuestNationalityType').on('change', function() {
            $('#editGuestNationality').html(getNatOptions($(this).val()));
        });
        
        $(document).on('change', '.batch-guest-nationality-type', function() {
            $(this).closest('tr').find('.batch-guest-nationality').html(getNatOptions($(this).val()));
        });

        function editGuest(guestId) {
            $.get('/Reserve/GetNationalities', function (nats) {
                globalForeignNats = nats;
                
                $.get('/Reserve/GetGuestForEdit?id=' + guestId, function (res) {
                    if (res.success) {
                        $('#editGuestId').val(res.data.id);
                        $('#editGuestFullname').val(res.data.fullname);
                        $('#editGuestAge').val(res.data.age);
                        $('#editGuestGender').val(res.data.gender);
                        
                        const natType = res.data.nationalityType || 'Local';
                        $('#editGuestNationalityType').val(natType);
                        $('#editGuestNationality').html(getNatOptions(natType));
                        
                        setTimeout(() => {
                            $('#editGuestNationality').val(res.data.nationalityId);
                        }, 50);
                        
                        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('editGuestModal'));
                        modal.show();
                    } else {
                        showToast('Guest not found.', 'warning');
                    }
                });
            });
        }

        $('#editGuestForm').on('submit', function (e) {
            e.preventDefault();
            const btn = $(this).find('button[type="submit"]');
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Saving...');
            
            $.ajax({
                url: '/Reserve/EditGuest',
                type: 'POST',
                data: $(this).serialize(),
                success: function (res) {
                    if (res.success) {
                        bootstrap.Modal.getInstance(document.getElementById('editGuestModal')).hide();
                        showToast(res.message, 'success');
                        const guestId = $('#editGuestId').val();
                        loadBatchDetails($(`tr[data-guest-row="${guestId}"]`).closest('tbody').find('tr').first().data('guest-row') || guestId);
                    } else {
                        showToast(res.message, 'warning');
                    }
                },
                error: function () {
                    showToast('Error saving guest.', 'error');
                },
                complete: function () {
                    btn.prop('disabled', false).html('<i class="bi bi-pencil-fill me-1"></i> Save Changes');
                }
            });
        });

        // ── Edit Batch ──────────────────────────────────────────
        function editBatch(batchCode) {
            $.when(
                $.get('/Reserve/GetOperators'),
                $.get('/Reserve/GetNationalities'),
                $.get('/Reserve/GetBatchForEdit?batchCode=' + batchCode)
            ).done(function (opsRes, natsRes, batchRes) {
                const ops = opsRes[0];
                const nats = natsRes[0];
                const res = batchRes[0];

                if (!res.success) {
                    showToast('Batch not found.', 'warning');
                    return;
                }

                let opsOptions = '<option value="">Select Operator</option>';
                ops.forEach(o => { opsOptions += `<option value="${o.id}">${o.name}</option>`; });
                $('#editBatchOperator').html(opsOptions);
                $('#editBatchOperator').val(res.data.operatorId);
                
                $('#editBatchCode').val(batchCode);
                
                globalForeignNats = nats;
                
                let natOptions = '<option value="">Select</option>';
                nats.forEach(n => { natOptions += `<option value="${n.id}">${n.natName}</option>`; });

                let tbodyHtml = '';
                res.data.guests.forEach(g => {
                    const natType = g.nationalityType || 'Local';
                    const natHtml = getNatOptions(natType);
                    tbodyHtml += `
                        <tr class="batch-guest-row" data-id="${g.id}">
                            <td><input type="text" class="form-control batch-guest-fullname" value="${g.fullname || ''}" required style="border-radius: 8px;" /></td>
                            <td><input type="number" class="form-control batch-guest-age" value="${g.age || ''}" style="border-radius: 8px;" /></td>
                            <td>
                                <select class="form-select batch-guest-gender" style="border-radius: 8px;">
                                    <option value="Male" ${g.gender === 'Male' ? 'selected' : ''}>Male</option>
                                    <option value="Female" ${g.gender === 'Female' ? 'selected' : ''}>Female</option>
                                </select>
                            </td>
                            <td>
                                <select class="form-select batch-guest-nationality-type" style="border-radius: 8px;">
                                    <option value="Local" ${natType === 'Local' ? 'selected' : ''}>Local</option>
                                    <option value="Foreign" ${natType === 'Foreign' ? 'selected' : ''}>Foreign</option>
                                </select>
                            </td>
                            <td>
                                <select class="form-select batch-guest-nationality" style="border-radius: 8px;">
                                    ${natHtml}
                                </select>
                            </td>
                        </tr>
                    `;
                });
                
                $('#editBatchGuestsBody').html(tbodyHtml);
                
                // set selected nationalities
                $('#editBatchGuestsBody tr').each(function(index) {
                    $(this).find('.batch-guest-nationality').val(res.data.guests[index].nationalityId);
                });
                
                const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('editBatchModal'));
                modal.show();
            }).fail(function () {
                showToast('Failed to load batch data.', 'error');
            });
        }

        $('#editBatchForm').on('submit', function (e) {
            e.preventDefault();
            
            // Gather guests
            const guests = [];
            $('#editBatchGuestsBody tr').each(function() {
                guests.push({
                    Id: $(this).data('id'),
                    Fullname: $(this).find('.batch-guest-fullname').val(),
                    Age: $(this).find('.batch-guest-age').val(),
                    Gender: $(this).find('.batch-guest-gender').val(),
                    NationalityType: $(this).find('.batch-guest-nationality-type').val(),
                    NationalityId: $(this).find('.batch-guest-nationality').val() ? parseInt($(this).find('.batch-guest-nationality').val()) : null
                });
            });
            $('#editBatchGuestsJson').val(JSON.stringify(guests));
            
            const btn = $(this).find('button[type="submit"]');
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Saving...');
            
            $.ajax({
                url: '/Reserve/EditBatch',
                type: 'POST',
                data: $(this).serialize(),
                success: function (res) {
                    if (res.success) {
                        bootstrap.Modal.getInstance(document.getElementById('editBatchModal')).hide();
                        showToast(res.message, 'success');
                        if (dataTable) dataTable.ajax.reload(null, false);
                    } else {
                        showToast(res.message, 'warning');
                    }
                },
                error: function () {
                    showToast('Error saving batch.', 'error');
                },
                complete: function () {
                    btn.prop('disabled', false).html('<i class="bi bi-pencil-fill me-1"></i> Save Changes');
                }
            });
        });
    </script>
}
