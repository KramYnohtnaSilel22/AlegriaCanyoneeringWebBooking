@using AlegriaCanyoneeringWebBooking.Models
@model GuestDetailsViewModel
@{
    var allGuests = new List<Guest>();
    if (Model.Guest != null) allGuests.Add(Model.Guest);
    if (Model.GuestsInBatch != null)
        allGuests.AddRange(Model.GuestsInBatch.Where(g => g.BookingStatus != 4));
}

@Html.AntiForgeryToken()

@{
    string FormatArrivalDate(string unixTimestamp)
    {
        if (string.IsNullOrEmpty(unixTimestamp)) return "N/A";
        if (long.TryParse(unixTimestamp, out var unix))
        {
            var dateTime = DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime();
            return dateTime.ToString("MMMM dd, yyyy hh:mm tt");
        }
        return unixTimestamp;
    }
}

<div class="container py-5">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Guest List</h5>

        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="companionsTable" class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>

                            <th>Full Name</th>
                            <th>Age</th>
                            <th>Gender</th>
                            <th>Nationality</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var guest in allGuests)
                        {
                            <tr data-guest-row="@guest.Id" class="@(guest.Id == Model.Guest.Id ? "table-primary" : "")">

                                <td>@guest.Fullname</td>
                                <td>@guest.Age</td>
                                <td>@guest.Gender</td>
                                <td>@(guest.NationalityEntity?.NatName ?? "N/A")</td>
                                <td>
                                    <span class="badge @(guest.Id == Model.Guest.Id ? "badge-primary" : "badge-info") text-capitalize px-3 py-2 rounded-pill">
                                        @(guest.Id == Model.Guest.Id ? "Primary ✦" : "Companion")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            style="border-radius:8px;font-size:0.78rem;"
                                            onclick="deleteGuest(@guest.Id, '@guest.Fullname?.Replace("'", "\\'")')">
                                        <i class="bi bi-trash me-1"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<style>
    #companionsTable {
    border-radius: 0.5rem;
    overflow: hidden;
    }

    #companionsTable tbody tr:hover {
    background-color: #f2f7ff;
    }

    #companionsTable thead {
    background-color: #f8f9fa;
    font-weight: 600;
    }

    .badge-primary {
    background-color: #0d6efd;
    color: #fff;
    }

    .badge-info {
    background-color: #cfe2ff;
    color: #0d6efd;
    }

    .cancel-btn:hover {
    background-color: #dc3545;
    color: #fff;
    transition: 0.2s;
    cursor: pointer;
    }

    @@media (max-width: 576px) {
    #companionsTable td:nth-child(3), #companionsTable th:nth-child(3) {
    display: none;
    }
    }
</style>



