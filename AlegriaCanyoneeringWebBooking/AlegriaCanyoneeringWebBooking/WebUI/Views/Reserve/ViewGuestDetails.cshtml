@model List<GuestWithOperatorVM>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background: #ffffff;
        color: #000000;
        font-family: "Segoe UI", sans-serif;
    }

    .modal-content {
        background: #ffffff !important;
        color: #000000 !important;
        border-radius: 12px;
    }

    .modal-header {
        background: #ffffff;
        border-bottom: 1px solid #ddd;
    }

    .modal-title {
        font-weight: 600;
    }

    table {
        background: #ffffff;
        color: #000000;
    }

    th {
        background: #f8f9fa;
        color: #000;
    }

    tr.table-success {
        background: #e6ffe6 !important;
    }

    .btn {
        border-radius: 6px;
        font-size: 0.9rem;
    }

        .btn i {
            margin-right: 4px;
        }
</style>
@{
    // Helper function to format ArrivalDate
    string FormatArrivalDate(string unixTimestamp)
    {
        if (string.IsNullOrEmpty(unixTimestamp))
            return "N/A";

        if (long.TryParse(unixTimestamp, out var unix))
        {
            // Convert Unix timestamp to local time
            var dateTime = DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime();
            return dateTime.ToString("MMMM dd, yyyy hh:mm tt"); // human-readable format
        }

        return unixTimestamp;
    }
}

<div class="modal fade" id="guestDetailsModal" tabindex="-1" aria-labelledby="guestDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content shadow-sm">
            <div class="modal-header">
                <h5 class="modal-title" id="guestDetailsModalLabel">
                    Booking Details - Batch: @Model.FirstOrDefault()?.Guest.Batch
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Download PDF Button -->
            <div class="px-3 py-2 border-bottom bg-light d-flex justify-content-end">
       
                <button class="btn btn-success ms-2" onclick="downloadGuestDetailsExcel()">
                    <i class="fas fa-file-excel"></i> Download Excel
                </button>
                <button class="btn btn-warning" id="printButton">
                    <i class="fas fa-print"></i> Print
                </button>

            </div>

            <!-- PDF Content Wrapper -->
            <div class="modal-body" id="guestDetailsContent">
                @if (Model != null && Model.Any())
                {
                    var primaryGuestVM = Model.First();
                    var companionsVM = Model.Skip(1).ToList();

                    <h6 class="text-dark fw-bold mb-3 mt-3"><i class="fas fa-user"></i> Primary Guest</h6>
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Operator</th>
                                    <th>Full Name</th>
                                    <th>Age</th>
                                    <th>Contact No.</th>
                                    <th>Gender</th>
                                    <th>Nationality</th>
                                    <th>Area</th>
                                    <th>Arrival Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="table-success">
                                    <td>@(string.IsNullOrWhiteSpace(primaryGuestVM.OperatorName) ? "No Operator" : primaryGuestVM.OperatorName)</td>
                                    <td>@primaryGuestVM.Guest.Fullname</td>
                                    <td>@primaryGuestVM.Guest.Age</td>
                                    <td>@primaryGuestVM.Guest.ContactNumber</td>
                                    <td>@primaryGuestVM.Guest.Gender</td>
                                    <td>@(primaryGuestVM.Guest.NationalityEntity?.NatName ?? "N/A")</td>
                                    <td>@primaryGuestVM.Guest.Area</td>
                                    <td>@FormatArrivalDate(primaryGuestVM.Guest.ArrivalDate)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    @if (companionsVM.Any())
                    {
                        <h6 class="text-dark fw-bold mt-4 mb-3"><i class="fas fa-users"></i> Companion Guests</h6>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th>Full Name</th>
                                        <th>Age</th>
                                        <th>Contact No.</th>
                                        <th>Gender</th>
                                        <th>Nationality</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var vm in companionsVM)
                                    {
                                        <tr>
                                            <td>@vm.Guest.Fullname</td>
                                            <td>@vm.Guest.Age</td>
                                            <td>@vm.Guest.ContactNumber</td>
                                            <td>@vm.Guest.Gender</td>
                                            <td>@(vm.Guest.NationalityEntity?.NatName ?? "N/A")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No companion guests for this booking.</p>
                    }
                }
                else
                {
                    <p class="text-muted">No guests found for this batch.</p>
                }
            </div>
            <!-- End PDF Content Wrapper -->
        </div>
    </div>
</div>

<!-- PDF Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>

<script src="~/js/ViewGuestDetails.js" asp-append-version="true" defer></script>
<script>
    document.getElementById('printButton').addEventListener('click', function () {
        // Get the batchCode from the model or another source
        var batchCode = '@Model.FirstOrDefault()?.Guest.Batch';

        if (batchCode) {
            // Redirect to the PrintBatchGuests action with the batchCode parameter
            window.location.href = '/Reserve/PrintBatchGuests?batchCode=' + batchCode;
        } else {
            alert('Batch code is not available.');
        }
    });
</script>
