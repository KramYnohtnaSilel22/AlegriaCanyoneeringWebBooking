@model List<GuestWithOperatorVM>

@{
    var assignedGuides = ViewBag.AssignedGuides as IEnumerable<dynamic>;
    var assignedDrivers = ViewBag.AssignedDrivers as IEnumerable<dynamic>;
    var assignedOutsideGuides = ViewBag.AssignedOutsideGuides as IEnumerable<dynamic>;

    string FormatArrivalDate(string unixTimestamp)
    {
        if (string.IsNullOrEmpty(unixTimestamp)) return "N/A";
        if (long.TryParse(unixTimestamp, out var unix))
            return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("MMMM dd, yyyy hh:mm tt");
        return unixTimestamp;
    }
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

    .gb-modal * {
        font-family: 'Outfit', sans-serif;
        box-sizing: border-box;
    }

    /* ── Modal shell ──────────────────────────────────────── */
    .gb-modal .modal-dialog {
        max-width: min(1100px, 96vw);
        margin: 1rem auto;
        height: calc(100vh - 2rem);
    }

    .gb-modal .modal-content {
        border-radius: 16px;
        border: 0;
        box-shadow: 0 8px 40px rgba(15,52,96,0.18);
        overflow: hidden;
        max-height: 100%;
    }

    /* ── Header ───────────────────────────────────────────── */
    .gb-modal-header {
        background: linear-gradient(135deg, #1a6ef5, #0f3460);
        color: #fff;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .gb-modal-header h5 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0;
        }

    /* ── Action bar ───────────────────────────────────────── */
    .gb-action-bar {
        background: #f8faff;
        border-bottom: 1px solid #e8edf5;
        padding: 0.6rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.5rem;
        position: sticky;
        top: 0;
        z-index: 10;
    }

        .gb-action-bar .btn {
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: 600;
        }

    /* ── Body ─────────────────────────────────────────────── */
    .gb-modal-body {
        padding: 1.25rem;
        background: #fff;
        overflow-y: auto;
        overflow-x: hidden;
        max-height: calc(100vh - 180px);
        scroll-behavior: smooth;
    }

        .gb-modal-body::-webkit-scrollbar {
            width: 10px;
        }

        .gb-modal-body::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 999px;
        }

        .gb-modal-body::-webkit-scrollbar-track {
            background: #f8fafc;
        }

    /* ── Staff cards ──────────────────────────────────────── */
    .staff-section-card {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #e8edf5;
        box-shadow: 0 1px 8px rgba(15,52,96,0.06);
        height: 100%;
    }

    .staff-section-header {
        padding: 0.65rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 700;
        font-size: 0.85rem;
        color: #fff;
    }

    .staff-section-body {
        padding: 0.75rem;
        background: #fff;
    }

    .staff-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.55rem 0.65rem;
        border-radius: 10px;
        border: 1px solid #e8edf5;
        margin-bottom: 0.4rem;
        transition: background 0.15s;
    }

        .staff-item:last-child {
            margin-bottom: 0;
        }

        .staff-item:hover {
            background: #f8faff;
        }

    .staff-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
    }

    .staff-avatar-placeholder {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 0.9rem;
    }

    .staff-name {
        font-size: 0.85rem;
        font-weight: 600;
        color: #0f3460;
    }

    .staff-sub {
        font-size: 0.72rem;
        color: #94a3b8;
        margin-top: 1px;
    }

    .staff-empty {
        text-align: center;
        padding: 1.25rem 0;
        color: #94a3b8;
        font-size: 0.85rem;
    }

        .staff-empty i {
            font-size: 1.5rem;
            display: block;
            margin-bottom: 0.35rem;
        }

    .staff-count {
        background: rgba(255,255,255,0.25);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.15rem 0.55rem;
        border-radius: 20px;
    }

    /* ── Section titles ───────────────────────────────────── */
    .gb-section-title {
        font-size: 0.8rem;
        font-weight: 700;
        color: #0f3460;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin: 1.25rem 0 0.75rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #e8edf5;
    }

        .gb-section-title i {
            color: #1a6ef5;
        }

    /* ── Tables ───────────────────────────────────────────── */
    .gb-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }

        .gb-table thead th {
            background: #f8faff;
            color: #0f3460;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            padding: 0.65rem 0.85rem;
            border-bottom: 2px solid #e8edf5;
            white-space: nowrap;
        }

        .gb-table tbody td {
            padding: 0.65rem 0.85rem;
            color: #334155;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .gb-table tbody tr:last-child td {
            border-bottom: none;
        }

        .gb-table tbody tr:hover {
            background: #f0f6ff;
        }

        .gb-table tbody tr.primary-row {
            background: rgba(26,110,245,0.04);
        }

    .btn-delete-guest { white-space: nowrap; border-radius: 7px; font-size: 0.75rem; font-weight: 600; }

    /* ── Empty state ──────────────────────────────────────── */
    .gb-empty {
        text-align: center;
        padding: 2rem 1rem;
        color: #94a3b8;
        font-size: 0.875rem;
    }

        .gb-empty i {
            font-size: 2rem;
            display: block;
            margin-bottom: 0.5rem;
        }

    @@media (max-width: 768px) {
        .gb-modal .modal-dialog {
            height: calc(100vh - 1rem);
            margin: 0.5rem auto;
        }

        .gb-modal-body {
            max-height: calc(100vh - 160px);
            padding: 1rem;
        }
    }
</style>

<!-- Modal -->
<div class="modal fade gb-modal" id="guestDetailsModal" tabindex="-1"
     aria-labelledby="guestDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">

            <!-- Header -->
            <div class="gb-modal-header">
                <h5 id="guestDetailsModalLabel">
                    <i class="bi bi-clipboard-check me-2"></i>
                    Booking Details — Batch: @Model?.FirstOrDefault()?.Guest.Batch
                </h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Action Bar -->
            <div class="gb-action-bar">
                <button class="btn btn-outline-success btn-sm"
                        onclick="downloadGuestDetailsExcel()">
                    <i class="bi bi-file-earmark-excel me-1"></i> Excel
                </button>
                <button class="btn btn-warning btn-sm" id="printButton">
                    <i class="bi bi-printer me-1"></i> Print
                </button>
            </div>

            <!-- Body -->
            <div class="gb-modal-body" id="guestDetailsContent">

                <!-- ── Staff Section ────────────────────────── -->
                <div class="row g-3 mb-3">

                    <!-- Guides -->
                    <div class="col-md-4">
                        <div class="staff-section-card">
                            <div class="staff-section-header"
                                 style="background:linear-gradient(135deg,#16a34a,#15803d);">
                                <span><i class="bi bi-person-badge me-2"></i>Tour Guides</span>
                                <span class="staff-count">@(assignedGuides?.Count() ?? 0)</span>
                            </div>
                            <div class="staff-section-body">
                                @if (assignedGuides != null && assignedGuides.Any())
                                {
                                    @foreach (var g in assignedGuides)
                                    {
                                        <div class="staff-item">
                                            @if (!string.IsNullOrEmpty((string)g.Image))
                                            {
                                                <img src="@g.Image" class="staff-avatar"
                                                     style="border:2px solid #16a34a;" />
                                            }
                                            else
                                            {
                                                <div class="staff-avatar-placeholder"
                                                     style="border:2px solid #16a34a;">
                                                    <i class="bi bi-person" style="color:#16a34a;"></i>
                                                </div>
                                            }
                                            <div>
                                                <div class="staff-name">@g.fullName</div>
                                                <div class="staff-sub">
                                                    <i class="bi bi-upc me-1"></i>RFID: @g.Rfid
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="staff-empty">
                                        <i class="bi bi-person-x"></i>
                                        No guides assigned
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Drivers -->
                    <div class="col-md-4">
                        <div class="staff-section-card">
                            <div class="staff-section-header"
                                 style="background:linear-gradient(135deg,#0ea5e9,#0369a1);">
                                <span><i class="bi bi-car-front me-2"></i>Drivers</span>
                                <span class="staff-count">@(assignedDrivers?.Count() ?? 0)</span>
                            </div>
                            <div class="staff-section-body">
                                @if (assignedDrivers != null && assignedDrivers.Any())
                                {
                                    @foreach (var d in assignedDrivers)
                                    {
                                        <div class="staff-item">
                                            @if (!string.IsNullOrEmpty((string)d.Image))
                                            {
                                                <img src="@d.Image" class="staff-avatar"
                                                     style="border:2px solid #0ea5e9;" />
                                            }
                                            else
                                            {
                                                <div class="staff-avatar-placeholder"
                                                     style="border:2px solid #0ea5e9;">
                                                    <i class="bi bi-car-front" style="color:#0ea5e9;"></i>
                                                </div>
                                            }
                                            <div>
                                                <div class="staff-name">@d.fullName</div>
                                                <div class="staff-sub">
                                                    <i class="bi bi-upc me-1"></i>Ref: @d.RefId
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="staff-empty">
                                        <i class="bi bi-car-front"></i>
                                        No drivers assigned
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Outside Guides -->
                    <div class="col-md-4">
                        <div class="staff-section-card">
                            <div class="staff-section-header"
                                 style="background:linear-gradient(135deg,#7c3aed,#4c1d95);">
                                <span><i class="bi bi-compass me-2"></i>Outside Guides</span>
                                <span class="staff-count">@(assignedOutsideGuides?.Count() ?? 0)</span>
                            </div>
                            <div class="staff-section-body">
                                @if (assignedOutsideGuides != null && assignedOutsideGuides.Any())
                                {
                                    @foreach (var og in assignedOutsideGuides)
                                    {
                                        <div class="staff-item">
                                            @if (!string.IsNullOrEmpty((string)og.Image))
                                            {
                                                <img src="@og.Image" class="staff-avatar"
                                                     style="border:2px solid #7c3aed;" />
                                            }
                                            else
                                            {
                                                <div class="staff-avatar-placeholder"
                                                     style="border:2px solid #7c3aed;">
                                                    <i class="bi bi-compass" style="color:#7c3aed;"></i>
                                                </div>
                                            }
                                            <div>
                                                <div class="staff-name">@og.fullName</div>
                                                <div class="staff-sub">
                                                    <i class="bi bi-upc me-1"></i>RFID: @og.Rfid
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="staff-empty">
                                        <i class="bi bi-compass"></i>
                                        No outside guides assigned
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model != null && Model.Any())
                {
                    var primaryVM = Model.First();
                    var companionsVM = Model.Skip(1).ToList();

                    <!-- ── Primary Guest ──────────────────────── -->
                    <div class="gb-section-title">
                        <i class="bi bi-person-fill"></i> Primary Guest
                    </div>

                    <div class="table-responsive mb-3">
                        <table class="gb-table">
                            <thead>
                                <tr>
                                    <th>Operator</th>
                                    <th>Full Name</th>
                                    <th>Age</th>
                                    <th>Contact</th>
                                    <th>Gender</th>
                                    <th>Nationality</th>
                                    <th>Area</th>
                                    <th>Arrival</th>
                                    @if (User.IsInRole("Super Admin"))
                                    {
                                        <th class="text-center">Action</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="primary-row">
                                    <td>
                                        <span class="fw-semibold">
                                            @(string.IsNullOrWhiteSpace(primaryVM.OperatorName)
                                                                                    ? "No Operator" : primaryVM.OperatorName)
                                        </span>
                                    </td>
                                    <td><span class="fw-semibold">@primaryVM.Guest.Fullname</span></td>
                                    <td>@primaryVM.Guest.Age</td>
                                    <td>@primaryVM.Guest.ContactNumber</td>
                                    <td>@primaryVM.Guest.Gender</td>
                                    <td>@(primaryVM.Guest.NationalityEntity?.NatName ?? "N/A")</td>
                                    <td>@primaryVM.Guest.Area</td>
                                    <td style="white-space:nowrap;font-size:0.8rem;">
                                        @FormatArrivalDate(primaryVM.Guest.ArrivalDate)
                                    </td>
                                    @if (User.IsInRole("Super Admin"))
                                    {
                                        <td class="text-center">
                                            <button type="button" class="btn btn-outline-danger btn-sm btn-delete-guest delete-booked-guest"
                                                    data-guest-id="@primaryVM.Guest.Id" data-guest-name="@primaryVM.Guest.Fullname">
                                                <i class="bi bi-trash me-1"></i>Delete
                                            </button>
                                        </td>
                                    }
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- ── Companions ─────────────────────────── -->
                    @if (companionsVM.Any())
                    {
                        <div class="gb-section-title">
                            <i class="bi bi-people-fill"></i>
                            Companion Guests
                            <span style="background:rgba(26,110,245,0.08);color:#1a6ef5;
                                font-size:0.7rem;font-weight:700;padding:0.15rem 0.55rem;
                                border-radius:20px;text-transform:none;letter-spacing:0;">
                                @companionsVM.Count
                            </span>
                        </div>

                        <div class="table-responsive">
                            <table class="gb-table">
                                <thead>
                                    <tr>
                                        <th>Full Name</th>
                                        <th>Age</th>
                                        <th>Contact</th>
                                        <th>Gender</th>
                                        <th>Nationality</th>
                                        @if (User.IsInRole("Super Admin"))
                                        {
                                            <th class="text-center">Action</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var vm in companionsVM)
                                    {
                                        <tr>
                                            <td>@vm.Guest.Fullname</td>
                                            <td>@vm.Guest.Age</td>
                                            <td>@vm.Guest.ContactNumber</td>
                                            <td>@vm.Guest.Gender</td>
                                            <td>@(vm.Guest.NationalityEntity?.NatName ?? "N/A")</td>
                                            @if (User.IsInRole("Super Admin"))
                                            {
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-outline-danger btn-sm btn-delete-guest delete-booked-guest"
                                                            data-guest-id="@vm.Guest.Id" data-guest-name="@vm.Guest.Fullname">
                                                        <i class="bi bi-trash me-1"></i>Delete
                                                    </button>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted" style="font-size:0.875rem;">
                            No companion guests for this booking.
                        </p>
                    }
                }
                else
                {
                    <div class="gb-empty">
                        <i class="bi bi-inbox"></i>
                        No guests found for this batch.
                    </div>
                }

            </div><!-- /modal-body -->
        </div>
    </div>
</div>

<!-- JS deps -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<script src="~/js/ViewGuestDetails.js" asp-append-version="true" defer></script>

<script>
    document.getElementById('printButton').addEventListener('click', function () {
    const batchCode = '@Model?.FirstOrDefault()?.Guest.Batch';
    if (!batchCode) { alert('Batch code is not available.'); return; }
    const form    = document.createElement('form');
    form.method   = 'POST';
    form.action   = '/Reserve/PrintBatchGuests';
    form.target   = '_blank';
    const input   = document.createElement('input');
    input.type    = 'hidden';
    input.name    = 'batchCode';
    input.value   = batchCode;
    form.appendChild(input);
    document.body.appendChild(form);
    form.submit();
    document.body.removeChild(form);
    });
</script>
