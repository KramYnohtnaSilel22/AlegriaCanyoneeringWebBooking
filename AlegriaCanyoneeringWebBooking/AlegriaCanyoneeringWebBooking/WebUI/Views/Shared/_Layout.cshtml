    </a>

    <div class="collapse" id="settingsSubmenu">

        @* ── Super Admin only ── *@
        @if (User.IsInRole("Super Admin"))
        {
          @*   <a class="d-block py-1 text-white text-decoration-none"
               asp-controller="OutsideDriverFromOperator" asp-action="Index">
                <i class="bi bi-car-front-fill me-2"></i><span>Outside Driver</span>
            </a> *@

            <a class="d-block py-1 text-white text-decoration-none"
                  asp-controller="OutsideGuides" asp-action="Index">
                <i class="bi bi-clipboard-check-fill me-2"></i><span>Assign Guide From Operator</span>
           </a>

            <a class="d-block py-1 text-white text-decoration-none"
