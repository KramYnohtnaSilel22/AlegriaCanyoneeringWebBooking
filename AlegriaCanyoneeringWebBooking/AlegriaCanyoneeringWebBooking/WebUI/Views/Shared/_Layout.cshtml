@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alegria Canyoneering</title>

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="icon" href="/images/alegrialogo2025.jpeg" type="image/png" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- DataTables -->
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="/css/layout.css" rel="stylesheet" />
</head>

<body>

    <!-- ══════════════════════════════════════════════════════
         HEADER  —  always full-width, highest z-index
         ══════════════════════════════════════════════════════ -->
    <header id="mainHeader">
        <button class="header_toggle"
                aria-label="Toggle sidebar"
                aria-expanded="false"
                aria-controls="sidebar">
            <i class="bi bi-list"></i>
        </button>

        <!-- Right side: user dropdown -->
        <div class="header-user ms-auto dropdown">
            <button class="btn d-flex align-items-center gap-2 px-2 py-1 rounded-3 header-user-btn"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    title="Account options">
                <i class="bi bi-person-circle header-avatar-icon"></i>
                <div class="lh-sm text-start d-none d-sm-block">
                    <div class="fw-semibold text-dark" style="font-size:0.875rem;">@User.Identity?.Name</div>
                </div>
                <i class="bi bi-chevron-down text-muted" style="font-size:0.65rem;"></i>
            </button>

            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-1 header-dropdown">
                <!-- User info header -->
                <li class="px-3 py-2 border-bottom">
                    <div class="text-muted" style="font-size:0.7rem;">Signed in as</div>
                    <div class="fw-semibold text-dark" style="font-size:0.875rem;">@User.Identity?.Name</div>
                </li>
                <!-- Update Info -->
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2 py-2"
                       asp-controller="Authentication" asp-action="Update">
                        <i class="bi bi-pencil-square text-primary"></i>
                        <span>Update Info</span>
                    </a>
                </li>
                <!-- Change Password -->
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2 py-2"
                       asp-controller="Authentication" asp-action="ChangePassword">
                        <i class="bi bi-shield-lock-fill text-warning"></i>
                        <span>Change Password</span>
                    </a>
                </li>
                <!-- Divider -->
                <li><hr class="dropdown-divider my-1"></li>
                <!-- Logout — triggers modal instead of direct navigate -->
                <li>
                    <button type="button"
                            class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#logoutModal">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>
                    </button>
                </li>
            </ul>
        </div>
    </header>

    <!-- ══════════════════════════════════════════════════════
         LOGOUT CONFIRMATION MODAL
         ══════════════════════════════════════════════════════ -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:360px;">
            <div class="modal-content border-0 rounded-4 shadow">

                <!-- Icon + Title -->
                <div class="modal-header border-0 pb-0 flex-column text-center pt-4">
                    <div class="logout-modal-icon mb-2">
                        <i class="bi bi-box-arrow-right"></i>
                    </div>
                    <h5 class="modal-title fw-bold" id="logoutModalLabel">Confirm Logout</h5>
                </div>

                <!-- Body -->
                <div class="modal-body text-center text-muted pb-0" style="font-size:0.9rem;">
                    Are you sure you want to log out?
                </div>

                <!-- Buttons -->
                <div class="modal-footer border-0 justify-content-center gap-2 pb-4">
                    <!-- No — stay -->
                    <button type="button"
                            class="btn btn-outline-secondary px-4 rounded-pill"
                            data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i> No, Stay
                    </button>
                    <!-- Yes — logout -->
                    <a asp-controller="Authentication" asp-action="Logout"
                       class="btn btn-danger px-4 rounded-pill">
                        <i class="bi bi-box-arrow-right me-1"></i> Yes, Logout
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════
         SIDEBAR
         ══════════════════════════════════════════════════════ -->
    <nav class="sidebar" id="sidebar" role="navigation" aria-label="Sidebar Navigation">

        <!-- Logo -->
        <div class="text-center mb-4">
            @if (User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Operator") || User.IsInRole("Staff"))
            {
                <span class="navbar-brand fw-bold text-white" style="display:inline-block;text-decoration:none;cursor:default;">
                    <img src="~/images/alegrialogo2025.jpeg" alt="Alegria Logo" />
                    <span class="fs-6 d-block">Alegria Canyoneering</span>
                </span>
            }
            else
            {
                <a class="navbar-brand fw-bold text-white" asp-area="" asp-controller="Dashboard" asp-action="Index"
                   style="display:inline-block;text-decoration:none;">
                    <img src="/images/alegrialogo2025.jpeg" alt="Alegria Logo" />
                    <span class="fs-6 d-block">Alegria Canyoneering</span>
                </a>
            }
        </div>

        <!-- ── MAIN (Super Admin / Operator) ────────────────── -->
        @if (User.IsInRole("Super Admin") || User.IsInRole("Operator"))
        {
            <div class="section-title">Main</div>
            <a asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-speedometer2 me-2"></i><span>Dashboard</span>
            </a>
            <a asp-controller="Guest" asp-action="NewBooking">
                <i class="bi bi-calendar-plus-fill me-2"></i><span>New Booking</span>
            </a>
        }

        <!-- ── MAIN (Admin ────────────────── -->
        @if (User.IsInRole("Admin"))
        {
            <div class="section-title">Main</div>
            <a asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-speedometer2 me-2"></i><span>Dashboard</span>
            </a>
         
        }



        <!-- ── MAIN (Admin / Super Admin / Operator) ─────────── -->
        @if (User.IsInRole("Admin") || User.IsInRole("Super Admin") || User.IsInRole("Operator"))
        {
   
            <a asp-controller="Guest" asp-action="SaveGuest">
                <i class="bi bi-person-plus-fill me-2"></i><span>Save Guest</span>
            </a>
            <a asp-controller="Reserve" asp-action="ReserveBooking">
                <i class="bi bi-journal-check me-2"></i><span>Reserve Bookings</span>
            </a>
            <a asp-controller="Reserve" asp-action="BookedGuest">
                <i class="bi bi-clipboard-check me-2"></i><span>Booked Guest</span>
            </a>
        }

        @if (User.IsInRole("Admin") || User.IsInRole("Super Admin"))
        {
            <a asp-controller="Reserve" asp-action="ScanGuestInfo">
                <i class="bi bi-person-check-fill me-2"></i><span>Guest Check-In</span>
            </a>
        }

      



        <!-- ── MAIN (Staff) ───────────────────────────────────── -->
        @if (User.IsInRole("Staff"))
        {
            <div class="section-title">Main</div>
            <a asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-speedometer2 me-2"></i><span>Dashboard</span>
            </a>
            <a asp-controller="Reserve" asp-action="BookedGuest">
                <i class="bi bi-clipboard-check me-2"></i><span>Booked Guest</span>
            </a>
        }

     
        <!-- ── SETTINGS ───────────────────────────────────────── -->
