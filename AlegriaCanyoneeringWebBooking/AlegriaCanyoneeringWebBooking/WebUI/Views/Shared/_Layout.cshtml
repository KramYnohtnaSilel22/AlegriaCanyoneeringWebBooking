           </a>
        }

        @* ── Admin only ── *@
        @if (User.IsInRole("Admin"))
        {
            <a class="d-block py-1 text-white text-decoration-none"
               asp-controller="Operators" asp-action="Index">
                <i class="bi bi-person-workspace me-2"></i><span>User</span>
            </a>
        }

        @* ── Operator only ── *@
        @if (User.IsInRole("Operator"))
        {
          @*   <a class="d-block py-1 text-white text-decoration-none"
               asp-controller="OutsideDriverFromOperator" asp-action="Index">
                <i class="bi bi-car-front-fill me-2"></i><span>Outside Driver</span>
            </a> *@


            <a class="d-block py-1 text-white text-decoration-none"
                  asp-controller="OutsideGuides" asp-action="Index">
                <i class="bi bi-clipboard-check-fill me-2"></i><span>Assign Guide From Operator</span>
            </a>


            <a class="d-block py-1 text-white text-decoration-none"
               asp-controller="OutsideGuideFromOperator" asp-action="Index">
                <i class="bi bi-compass-fill me-2"></i><span>Outside Guide</span>
            </a>
        }


    </div>

                  
                
       

            <!-- ── REPORTS ─────────────────────────────────────── -->
            @if (User.IsInRole("Admin") || User.IsInRole("Super Admin"))
            {
                <div class="section-title">Reports</div>
                <div class="nav-item mt-2">
                    <a class="nav-link d-flex justify-content-between align-items-center text-white fw-semibold"
                       href="#reportsSubmenu"
                       data-bs-toggle="collapse"
                       role="button"
                       aria-expanded="false"
                       aria-controls="reportsSubmenu"
                       id="reportsToggle">
                        <span><i class="bi bi-bar-chart-line-fill me-2"></i>Reports</span>
                        <i class="bi bi-chevron-down small toggle-icon"></i>
                    </a>

                    <div class="collapse ms-3 mt-1" id="reportsSubmenu">
                        <a class="d-block py-1 text-white text-decoration-none d-flex align-items-center"
                           asp-controller="Reports" asp-action="DriverAttendance">
                            <i class="bi bi-calendar-check me-2"></i><span class="submenu-text">Driver Attendance</span>
                        </a>
                        <a class="d-block py-1 text-white text-decoration-none d-flex align-items-center"
                           asp-controller="Reports" asp-action="GuideAttendance">
                            <i class="bi bi-calendar-check me-2"></i><span class="submenu-text">Guide Attendance</span>
                        </a>
