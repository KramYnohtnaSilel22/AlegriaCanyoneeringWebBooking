                        JustClick Integrated Solutions Inc.
                    </a>
                </div>
            </div>
        </footer>
    </main>

    <!-- ══════════════════════════════════════════════════════
         SCRIPTS
         ══════════════════════════════════════════════════════ -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        // ── DataTable ──────────────────────────────────────────────
        $(function () {
            $("#example1").DataTable({
                responsive: true,
                lengthChange: true,
                autoWidth: false,
                pageLength: 10,
                lengthMenu: [[10, 20, 30, 40, 50, 60], [10, 20, 30, 40, 50, 60, 70, 80]],
                order: [[1, "desc"]],
                language: {
                    paginate: { previous: "Previous", next: "Next" },
                    info: "Showing _START_ to _END_ of _TOTAL_ entries"
                }
            });
        });

        // ── Sidebar elements ───────────────────────────────────────
        const sidebar   = document.getElementById("sidebar");
        const header    = document.getElementById("mainHeader");
        const toggleBtn = document.querySelector(".header_toggle");

        // Backdrop (mobile overlay tap-to-close)
        const backdrop = document.createElement("div");
        backdrop.className = "sidebar-backdrop";
        document.body.appendChild(backdrop);

        const isMobile = () => window.innerWidth <= 768;

        // Track whether sidebar was collapsed before going mobile
        let wasCollapsed = false;

        // ── Close all Bootstrap dropdowns inside sidebar ───────────
        function closeAllDropdowns() {
            sidebar.querySelectorAll(".collapse.show").forEach(el => {
                const bs = bootstrap.Collapse.getInstance(el);
                if (bs) bs.hide();
                else el.classList.remove("show");
            });
            sidebar.querySelectorAll("[aria-expanded='true']").forEach(el => {
                el.setAttribute("aria-expanded", "false");
                el.classList.remove("expanded");
            });
        }

        // ── Hamburger click ────────────────────────────────────────
        toggleBtn.addEventListener("click", () => {
            if (isMobile()) {
                const isOpen = sidebar.classList.toggle("mobile-open");
                if (isOpen) {
                    // Opening: strip collapsed so full text shows
                    wasCollapsed = sidebar.classList.contains("collapsed");
                    sidebar.classList.remove("collapsed");
                    header.classList.remove("collapsed");
                } else {
                    // Closing: restore collapsed state if it was set
                    if (wasCollapsed) {
                        sidebar.classList.add("collapsed");
                        header.classList.add("collapsed");
                    }
                }
                backdrop.classList.toggle("active", isOpen);
                toggleBtn.setAttribute("aria-expanded", String(isOpen));
            } else {
                // Desktop: collapse to icon-only rail
                const isCollapsing = !sidebar.classList.contains("collapsed");
                sidebar.classList.toggle("collapsed");
                header.classList.toggle("collapsed");

                if (isCollapsing) closeAllDropdowns();

                const expanded = toggleBtn.getAttribute("aria-expanded") === "true";
                toggleBtn.setAttribute("aria-expanded", String(!expanded));
            }
        });

        // ── Tap backdrop → close mobile sidebar ───────────────────
        backdrop.addEventListener("click", () => {
            sidebar.classList.remove("mobile-open");
            backdrop.classList.remove("active");
            toggleBtn.setAttribute("aria-expanded", "false");
            if (wasCollapsed) {
                sidebar.classList.add("collapsed");
                header.classList.add("collapsed");
            }
        });

        // ── Resize: desktop → clean up mobile state ───────────────
        window.addEventListener("resize", () => {
            if (!isMobile()) {
                sidebar.classList.remove("mobile-open");
                backdrop.classList.remove("active");
                if (wasCollapsed) {
                    sidebar.classList.add("collapsed");
                    header.classList.add("collapsed");
                }
            }
        });

        // ── Settings chevron rotation ──────────────────────────────
        const settingsToggle  = document.getElementById("settingsToggle");
        const settingsSubmenu = document.getElementById("settingsSubmenu");

        if (settingsSubmenu && settingsToggle) {
            settingsSubmenu.addEventListener("shown.bs.collapse", () => {
                settingsToggle.classList.add("expanded");
                settingsToggle.setAttribute("aria-expanded", "true");
            });
            settingsSubmenu.addEventListener("hidden.bs.collapse", () => {
                settingsToggle.classList.remove("expanded");
                settingsToggle.setAttribute("aria-expanded", "false");
            });
        }

        // ── Reports chevron rotation ───────────────────────────────
        const reportsToggle  = document.getElementById("reportsToggle");
        const reportsSubmenu = document.getElementById("reportsSubmenu");

        if (reportsSubmenu && reportsToggle) {
            reportsSubmenu.addEventListener("shown.bs.collapse", () => {
                reportsToggle.classList.add("expanded");
                reportsToggle.setAttribute("aria-expanded", "true");
            });
            reportsSubmenu.addEventListener("hidden.bs.collapse", () => {
                reportsToggle.classList.remove("expanded");
                reportsToggle.setAttribute("aria-expanded", "false");
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
