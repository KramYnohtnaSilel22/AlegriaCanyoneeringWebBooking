@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alegria Canyoneering</title>

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="icon" href="/images/alegrialogo2025.jpeg" type="image/png" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- DataTables -->
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="/css/layout.css" rel="stylesheet" />

</head>

<body class="d-flex flex-column min-vh-100">

    <header>
        <button class="header_toggle" aria-label="Toggle sidebar" aria-expanded="true" aria-controls="sidebar">
            <i class="bi bi-list"></i>
        </button>



    </header>

    <nav class="sidebar" id="sidebar" role="navigation" aria-label="Sidebar Navigation">
        <div class="text-center mb-4">

            <a class="navbar-brand fw-bold text-white" asp-area="" asp-controller="Dashboard" asp-action="Index" style="display: inline-block; text-decoration: none;">
                <img src="~/images/alegrialogo2025.jpeg" alt="Alegria Logo" />
                <span class="fs-6 d-block">Alegria Canyoneering</span>
            </a>
        </div>

        <!-- Para sa Super Admin ug Operator -->
        @if (User.IsInRole("Super Admin") || User.IsInRole("Operator"))
        {
            <div class="section-title">Main</div>
            <a asp-controller="Guest" asp-action="NewBooking"><i class="bi bi-calendar-plus-fill me-2"></i> <span>New Booking</span></a>
        }
        <!-- Para sa Admin ug Super Admin -->
        @if (User.IsInRole("Admin") || User.IsInRole("Super Admin") || User.IsInRole("Operator"))
        {
            <!-- Admin-specific links -->
            <a asp-controller="Guest" asp-action="saveguest"><i class="bi bi-person-plus-fill me-2"></i> <span>Save Guest</span></a>
            <a asp-controller="Reserve" asp-action="ReserveBooking"><i class="bi bi-journal-check me-2"></i> <span>Reserve Bookings</span></a>
            <!-- Operator -->
            @if (User.IsInRole("Admin") || User.IsInRole("Super Admin") || User.IsInRole("Operator"))
            {
                <a asp-controller="Reserve" asp-action="BookedGuest"><i class="bi bi-clipboard-check me-2"></i> <span>Booked Guest</span></a>
            
            }
        }

        @if (User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Operator"))
        {
            <div class="section-title">Settings</div>

            <a href="#settingsSubmenu"
               class="settings-toggle text-white text-decoration-none"
               data-bs-toggle="collapse"
               role="button"
               aria-expanded="false"
               aria-controls="settingsSubmenu"
               id="settingsToggle">
                <span><i class="bi bi-gear-fill me-2"></i> <span>Settings</span></span>
                <i class="bi bi-chevron-down toggle-icon"></i>
            </a>

            <div class="collapse" id="settingsSubmenu">
                @* ✅ For Super Admin only *@
                @if (User.IsInRole("Super Admin"))
                {
               @*      <a class="d-block py-1 text-white text-decoration-none" asp-controller="Batches" asp-action="Index">
                        <i class="bi bi-layers-half me-2"></i> <span>Batch</span>
                    </a> *@
                 @*    <a class="d-block py-1 text-white text-decoration-none" asp-controller="Guides" asp-action="Index">
                        <i class="bi bi-person-badge me-2"></i> <span>Guide Details</span>
                    </a> *@
                    <a class="d-block py-1 text-white text-decoration-none" asp-controller="Operators" asp-action="Index">
                        <i class="bi bi-person-workspace me-2"></i> <span>User</span>
                    </a>
              @*       <a class="d-block py-1 text-white text-decoration-none" asp-controller="Drivers" asp-action="Index">
                        <i class="bi bi-truck-front me-2"></i> <span>Driver Details</span>
                    </a> *@
                    <a class="d-block py-1 text-white text-decoration-none" asp-controller="OperatorList" asp-action="Operators">
                        <i class="bi bi-people-fill me-2"></i> <span>OperatorsList</span>
                    </a>
                    <a class="d-block py-1 text-white text-decoration-none" asp-controller="Nationalities" asp-action="Index">
                        <i class="bi bi-flag-fill me-2"></i> <span>Nationality</span>
                    </a>
                    <a class="d-block py-1 text-white text-decoration-none" asp-controller="Roles" asp-action="Index">
                        <i class="bi bi-person-badge-fill me-2"></i> <span>Roles</span>
                    </a>
                }

                @* ✅ For Super Admin and Admin - Change Password & Update Info *@
                @if (User.IsInRole("Admin") || User.IsInRole("Super Admin") || User.IsInRole("Operator"))
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="d-block py-1 text-white text-decoration-none" asp-controller="Operators" asp-action="Index">
                            <i class="bi bi-person-workspace me-2"></i> <span>User</span>
                        </a>
                    }

                    <a class="d-block py-1 text-white text-decoration-none" asp-controller="Authentication" asp-action="Edit">
                        <i class="bi bi-pencil-square me-2"></i> <span>Update Info</span>
                    </a>


                    <a class="d-block py-1 text-white text-decoration-none" asp-controller="Authentication" asp-action="ChangePassword">
                        <i class="bi bi-shield-lock-fill me-2"></i> <span>Change Password</span>
                    </a>
                 
            
                }


             
               
            </div>

            @* ✅ For Super Admin and Admin - Report For Nationality & Tourist *@
            @if (User.IsInRole("Admin") || User.IsInRole("Super Admin"))
            {
                <div class="section-title">Reports </div>
                <a asp-controller="Reports" asp-action="Tourist"><i class="bi bi-people-fill me-2"></i> <span>Tourist</span></a>
                <a asp-controller="Reports" asp-action="Nationality"><i class="bi bi-globe2 me-2"></i> <span>Nationality</span></a>

            }
        }

     
      
        <div class="section-title">Account</div>
        <a asp-controller="Home" asp-action="About"><i class="bi bi-info-circle-fill me-2"></i> <span>About Us</span></a>
        <a asp-controller="Authentication" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> <span>Logout</span></a>
    </nav>

    <!-- Main content -->
    <main class="main-content" role="main">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
        <footer class="border-top pt-3 mt-5 text-muted bg-light" id="siteFooter">
            <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center py-3">
                <div>
                    &copy; 2025 - <strong>Alegria Canyoneering WebBooking</strong>. All rights reserved.
                </div>
                <div class="small mt-2 mt-md-0">
                    Published by
                    <a href="https://www.facebook.com/jcit2015" class="text-decoration-none text-primary fw-semibold">
                        JustClick Integrated Solutions Inc.
                    </a>
                </div>
            </div>
        </footer>



    </main>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js" ></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <!-- _Layout.cshtml or the parent view -->
    <script src="~/js/GuestPDF.js" asp-append-version="true"></script>
    <script src="~/js/GuestExcel.js" asp-append-version="true"></script>

    <script>
        $(function () {
            $("#example1").DataTable({
                responsive: true,
                lengthChange: true,
                autoWidth: false,
                pageLength: 10,
                lengthMenu: [[10, 20, 30, 40, 50, 60], [10, 20, 30, 40, 50, 60, 70, 80]],
                order: [[1, "desc"]],
                language: {
                    paginate: {
                        previous: "Previous",
                        next: "Next"
                    },
                    info: "Showing _START_ to _END_ of _TOTAL_ entries"
                }
            });
        });

        // Sidebar toggle
        const sidebar = document.getElementById("sidebar");
        const toggleBtn = document.querySelector(".header_toggle");

        toggleBtn.addEventListener("click", () => {
            sidebar.classList.toggle("collapsed");
            document.querySelector("header").classList.toggle("collapsed");

            // Update aria-expanded attribute on toggle button
            const expanded = toggleBtn.getAttribute("aria-expanded") === "true";
            toggleBtn.setAttribute("aria-expanded", !expanded);
        });

        // Settings submenu toggle icon rotation
        const settingsToggle = document.getElementById("settingsToggle");
        const settingsSubmenu = document.getElementById("settingsSubmenu");

        settingsSubmenu.addEventListener("shown.bs.collapse", () => {
            settingsToggle.setAttribute("aria-expanded", "true");
            settingsToggle.classList.remove("collapsed");
            settingsToggle.classList.add("expanded");
        });

        settingsSubmenu.addEventListener("hidden.bs.collapse", () => {
            settingsToggle.setAttribute("aria-expanded", "false");
            settingsToggle.classList.remove("expanded");
            settingsToggle.classList.add("collapsed");
        });

        // Initialize settings toggle state
        if (settingsSubmenu.classList.contains("show")) {
            settingsToggle.classList.add("expanded");
            settingsToggle.setAttribute("aria-expanded", "true");
        } else {
            settingsToggle.classList.add("collapsed");
            settingsToggle.setAttribute("aria-expanded", "false");
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>



