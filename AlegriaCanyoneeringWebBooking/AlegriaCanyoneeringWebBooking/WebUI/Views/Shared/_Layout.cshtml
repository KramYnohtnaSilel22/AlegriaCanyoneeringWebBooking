            </a>
            <a class="d-block py-1 text-white text-decoration-none"
               asp-controller="Drivers" asp-action="Index">
                <i class="bi bi-layers-half me-2"></i><span>Drivers</span>
            </a>
            <a class="d-block py-1 text-white text-decoration-none"
