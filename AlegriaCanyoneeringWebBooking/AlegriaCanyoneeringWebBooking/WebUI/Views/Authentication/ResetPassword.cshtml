@model ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "Layout_Login";
}

<style>
    body {
        background-attachment: fixed;
        font-family: 'Poppins', sans-serif;
    }

    .reset-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .reset-card {
        background: #fff;
        border-radius: 1.5rem;
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.15);
        width: 100%;
        max-width: 420px;
        animation: fadeIn 0.6s ease-in-out;
    }

    .reset-header {
        background: #007bff;
        color: #fff;
        padding: 1.25rem 1rem;
        border-top-left-radius: 1.5rem;
        border-top-right-radius: 1.5rem;
        text-align: center;
    }

        .reset-header i {
            font-size: 1.8rem;
            margin-bottom: 0.3rem;
        }

    .reset-body {
        padding: 2rem;
    }

    .form-label {
        font-weight: 600;
        color: #333;
    }

    .form-control {
        border-radius: 0.5rem;
        transition: box-shadow 0.2s;
    }

        .form-control:focus {
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }

    .btn-primary {
        background: #007bff;
        border: none;
        border-radius: 50px;
        padding: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: #0069d9;
            transform: translateY(-2px);
            box-shadow: 0 5px 12px rgba(0, 0, 0, 0.15);
        }

    .reset-footer {
        text-align: center;
        padding: 1rem;
        border-top: 1px solid #eee;
        font-size: 0.9rem;
        color: #777;
    }

        .reset-footer a {
            color: #007bff;
            font-weight: 500;
            text-decoration: none;
            transition: color 0.2s;
        }

            .reset-footer a:hover {
                color: #0056b3;
                text-decoration: underline;
            }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="reset-container">
    <div class="reset-card">
        <div class="reset-header">
            <i class="fas fa-key"></i>
            <h4 class="mb-0">Reset Password</h4>
        </div>

        <div class="reset-body">
            <form asp-action="ResetPassword" method="post" class="needs-validation" novalidate>
                <!-- Hidden values -->
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="Enter new password" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-sync-alt me-1"></i> Reset Password
                </button>
            </form>
        </div>

        <div class="reset-footer">
            Remembered your password?
            <a asp-controller="Authentication" asp-action="Login">Back to Login</a>
        </div>
    </div>
</div>
