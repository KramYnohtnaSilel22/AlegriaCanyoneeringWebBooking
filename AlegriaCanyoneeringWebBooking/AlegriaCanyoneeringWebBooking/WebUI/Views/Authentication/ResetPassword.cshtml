@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "Layout_Login";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:wght@700&display=swap');
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --blue-deep: #0f3460;
        --blue-mid: #1a6ef5;
        --blue-light: #4f9cf9;
        --accent: #f0a500;
        --white: #ffffff;
        --gray-soft: #f4f7fe;
        --gray-text: #64748b;
        --danger: #ef4444;
    }

    html, body {
        height: 100%;
        overflow: hidden;
        font-family: 'Outfit', sans-serif;
    }

    .auth-wrap {
        display: grid;
        grid-template-columns: 1fr 1fr;
        height: 100vh;
    }

    .brand-panel {
        background: linear-gradient(145deg,var(--blue-deep) 0%,#1a3a6e 40%,#1557b0 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem;
        position: relative;
        overflow: hidden;
    }

        .brand-panel::before {
            content: '';
            position: absolute;
            width: 420px;
            height: 420px;
            border-radius: 50%;
            border: 60px solid rgba(255,255,255,0.04);
            top: -100px;
            left: -100px;
        }

        .brand-panel::after {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            border: 40px solid rgba(255,255,255,0.06);
            bottom: -80px;
            right: -80px;
        }

    .brand-logo {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid rgba(255,255,255,0.25);
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        margin-bottom: 1.5rem;
        animation: logoFloat 4s ease-in-out infinite;
    }

    @@keyframes logoFloat {
        0%, 100% {
            transform: translateY(0)
        }

        50% {
            transform: translateY(-8px)
        }
    }

    .brand-title {
        font-family: 'Playfair Display',serif;
        font-size: 2rem;
        color: var(--white);
        text-align: center;
        line-height: 1.2;
        margin-bottom: 0.75rem;
    }

    .brand-divider {
        width: 48px;
        height: 3px;
        background: var(--accent);
        border-radius: 2px;
        margin: 1.25rem auto;
    }

    .brand-subtitle {
        font-size: 0.875rem;
        color: rgba(255,255,255,0.6);
        text-align: center;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .brand-tagline {
        font-size: 0.95rem;
        color: rgba(255,255,255,0.75);
        text-align: center;
        max-width: 260px;
        line-height: 1.6;
    }

    .form-panel {
        background: var(--gray-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        animation: slideIn 0.5s ease both;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(30px)
        }

        to {
            opacity: 1;
            transform: translateX(0)
        }
    }

    .auth-card {
        background: var(--white);
        border-radius: 20px;
        padding: 2.5rem 2.25rem;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 4px 40px rgba(15,52,96,0.1);
    }

    .icon-circle {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(26,110,245,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.25rem;
    }

        .icon-circle i {
            font-size: 1.6rem;
            color: var(--blue-mid);
        }

    .card-header-text {
        margin-bottom: 2rem;
        text-align: center;
    }

        .card-header-text h2 {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--blue-deep);
            margin-bottom: 0.35rem;
        }

        .card-header-text p {
            font-size: 0.875rem;
            color: var(--gray-text);
        }

    .field-group {
        margin-bottom: 1.25rem;
    }

        .field-group label {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--blue-deep);
            letter-spacing: 0.04em;
            text-transform: uppercase;
            display: block;
            margin-bottom: 0.4rem;
        }

    .field-wrap {
        position: relative;
    }

    .field-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--blue-light);
        font-size: 0.95rem;
        pointer-events: none;
    }

    .field-wrap input {
        width: 100%;
        padding: 0.75rem 2.75rem;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        font-family: 'Outfit',sans-serif;
        font-size: 0.95rem;
        color: #1e293b;
        background: #fafbff;
        outline: none;
        transition: border-color 0.2s,box-shadow 0.2s;
    }

        .field-wrap input:focus {
            border-color: var(--blue-mid);
            box-shadow: 0 0 0 3px rgba(26,110,245,0.12);
            background: var(--white);
        }

        .field-wrap input::placeholder {
            color: #b0bec5;
        }

    .eye-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: var(--gray-text);
        font-size: 0.95rem;
        padding: 4px;
        transition: color 0.2s;
    }

        .eye-btn:hover {
            color: var(--blue-mid);
        }

    .field-error {
        font-size: 0.78rem;
        color: var(--danger);
        margin-top: 0.3rem;
        display: block;
    }

    .btn-submit {
        width: 100%;
        padding: 0.85rem;
        background: linear-gradient(135deg,var(--blue-mid),var(--blue-deep));
        color: var(--white);
        border: none;
        border-radius: 10px;
        font-family: 'Outfit',sans-serif;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s,transform 0.15s,box-shadow 0.2s;
        box-shadow: 0 4px 16px rgba(26,110,245,0.35);
        margin-top: 0.5rem;
    }

        .btn-submit:hover {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(26,110,245,0.45);
        }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 1.25rem;
        font-size: 0.85rem;
        color: var(--blue-mid);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
    }

        .back-link:hover {
            color: var(--blue-deep);
            text-decoration: underline;
        }

    @@media (max-width:768px) {
        .auth-wrap {
            grid-template-columns: 1fr
        }

        .brand-panel {
            display: none
        }

        .form-panel {
            background: linear-gradient(145deg,var(--blue-deep),#1557b0)
        }
    }
</style>

<div class="auth-wrap">
    <div class="brand-panel">
        <img src="/images/alegrialogo2025.jpeg" alt="Alegria Logo" class="brand-logo" />
        <h1 class="brand-title">Alegria<br>Canyoneering</h1>
        <div class="brand-divider"></div>
        <p class="brand-tagline">Create a new secure password for your account.</p>
        <p class="brand-subtitle" style="margin-top:1.5rem;">Web Booking System</p>
    </div>

    <div class="form-panel">
        <div class="auth-card">
            <div class="icon-circle">
                <i class="bi bi-key"></i>
            </div>
            <div class="card-header-text">
                <h2>Reset Password</h2>
                <p>Enter your new password below.</p>
            </div>

            <form asp-action="ResetPassword" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                <div asp-validation-summary="ModelOnly" class="field-error mb-3"></div>

                <div class="field-group">
                    <label asp-for="NewPassword">New Password</label>
                    <div class="field-wrap">
                        <i class="bi bi-lock field-icon"></i>
                        <input asp-for="NewPassword"
                               type="password"
                               id="newPasswordField"
                               placeholder="Enter new password"
                               autocomplete="new-password" />
                        <button type="button" class="eye-btn" onclick="togglePwd('newPasswordField','eyeNew')">
                            <i class="bi bi-eye" id="eyeNew"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="bi bi-arrow-repeat me-1"></i> Reset Password
                </button>
            </form>

            <a asp-controller="Authentication" asp-action="Login" class="back-link">
                <i class="bi bi-arrow-left me-1"></i> Back to Login
            </a>
        </div>
    </div>
</div>

<script>
    function togglePwd(fieldId, iconId) {
        const f = document.getElementById(fieldId);
        const i = document.getElementById(iconId);
        const showing = f.type === 'text';
        f.type = showing ? 'password' : 'text';
        i.className = showing ? 'bi bi-eye' : 'bi bi-eye-slash';
    }
</script>
