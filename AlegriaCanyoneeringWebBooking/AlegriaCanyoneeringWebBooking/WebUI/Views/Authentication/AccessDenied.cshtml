@{
    ViewData["Title"] = "Access Denied";
    Layout = "Layout_Login";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:wght@700&display=swap');

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --blue-deep: #0f3460;
        --blue-mid: #1a6ef5;
        --accent: #f0a500;
        --danger: #ef4444;
        --white: #ffffff;
        --gray-soft: #f4f7fe;
        --gray-text: #64748b;
    }

    html, body {
        height: 100%;
        overflow: hidden;
        font-family: 'Outfit', sans-serif;
    }

    .denied-wrap {
        display: grid;
        grid-template-columns: 1fr 1fr;
        height: 100vh;
    }

    /* Brand panel — same as login */
    .brand-panel {
        background: linear-gradient(145deg, var(--blue-deep) 0%, #1a3a6e 40%, #1557b0 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem;
        position: relative;
        overflow: hidden;
    }

        .brand-panel::before {
            content: '';
            position: absolute;
            width: 420px;
            height: 420px;
            border-radius: 50%;
            border: 60px solid rgba(255,255,255,0.04);
            top: -100px;
            left: -100px;
        }

        .brand-panel::after {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            border: 40px solid rgba(255,255,255,0.06);
            bottom: -80px;
            right: -80px;
        }

    .brand-logo {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid rgba(255,255,255,0.25);
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        margin-bottom: 1.5rem;
        animation: logoFloat 4s ease-in-out infinite;
    }

    @@keyframes logoFloat {
        0%, 100% {
            transform: translateY(0)
        }

        50% {
            transform: translateY(-8px)
        }
    }

    .brand-title {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        color: var(--white);
        text-align: center;
        line-height: 1.2;
        margin-bottom: 0.75rem;
    }

    .brand-divider {
        width: 48px;
        height: 3px;
        background: var(--accent);
        border-radius: 2px;
        margin: 1.25rem auto;
    }

    .brand-subtitle {
        font-size: 0.875rem;
        color: rgba(255,255,255,0.6);
        text-align: center;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .brand-tagline {
        font-size: 0.95rem;
        color: rgba(255,255,255,0.75);
        text-align: center;
        max-width: 260px;
        line-height: 1.6;
    }

    /* Content panel */
    .content-panel {
        background: var(--gray-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        animation: slideIn 0.5s ease both;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(30px)
        }

        to {
            opacity: 1;
            transform: translateX(0)
        }
    }

    .denied-card {
        background: var(--white);
        border-radius: 20px;
        padding: 2.5rem 2.25rem;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 4px 40px rgba(15,52,96,0.10);
        text-align: center;
    }

    /* Animated shield icon */
    .shield-wrap {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(239,68,68,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        animation: popIn 0.5s cubic-bezier(.17,.67,.4,1.3) both;
    }

    @@keyframes popIn {
        from {
            transform: scale(0);
            opacity: 0
        }

        to {
            transform: scale(1);
            opacity: 1
        }
    }

    .shield-wrap i {
        font-size: 2.25rem;
        color: var(--danger);
    }

    .error-code {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--danger);
        margin-bottom: 0.5rem;
        display: block;
    }

    .denied-card h2 {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--blue-deep);
        margin-bottom: 0.5rem;
    }

    .denied-card p {
        font-size: 0.9rem;
        color: var(--gray-text);
        line-height: 1.65;
        margin-bottom: 1.5rem;
    }

    /* Info box */
    .info-box {
        background: #f8faff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        font-size: 0.8rem;
        color: var(--gray-text);
        margin-bottom: 1.75rem;
        text-align: left;
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
    }

        .info-box i {
            color: var(--blue-mid);
            margin-top: 1px;
            flex-shrink: 0;
        }

    /* Image */
    .denied-img {
        width: 100%;
        max-height: 160px;
        object-fit: contain;
        border-radius: 10px;
        margin-bottom: 1.5rem;
        opacity: 0.9;
    }

    /* Button */
    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.8rem 2rem;
        background: linear-gradient(135deg, var(--danger), #c0392b);
        color: var(--white);
        border: none;
        border-radius: 50px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
        box-shadow: 0 4px 16px rgba(239,68,68,0.3);
    }

        .btn-back:hover {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(239,68,68,0.4);
            color: var(--white);
        }

    @@media (max-width: 768px) {
        .denied-wrap {
            grid-template-columns: 1fr;
        }

        .brand-panel {
            display: none;
        }

        .content-panel {
            background: linear-gradient(145deg, var(--blue-deep), #1557b0);
        }
    }
</style>

<div class="denied-wrap">

    <!-- Brand Panel -->
    <div class="brand-panel">
        <img src="/images/alegrialogo2025.jpeg" alt="Alegria Logo" class="brand-logo" />
        <h1 class="brand-title">Alegria<br>Canyoneering</h1>
        <div class="brand-divider"></div>
        <p class="brand-tagline">This area is restricted. Please contact your administrator.</p>
        <p class="brand-subtitle" style="margin-top:1.5rem;">Web Booking System</p>
    </div>

    <!-- Content Panel -->
    <div class="content-panel">
        <div class="denied-card">

            <div class="shield-wrap">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <span class="error-code">Error 403 — Forbidden</span>
            <h2>Access Denied</h2>
            <p>You don't have permission to view this resource.</p>

            <img src="~/images/noaccess.png"
                 class="denied-img"
                 alt="Access Denied" />

            <div class="info-box">
                <i class="bi bi-info-circle-fill"></i>
                <span>If you believe this is an error, please contact your system administrator.</span>
            </div>

            <a href="@Url.Action("Login", "Authentication")" class="btn-back">
                <i class="bi bi-arrow-left"></i> Back to Login
            </a>

        </div>
    </div>

</div>
