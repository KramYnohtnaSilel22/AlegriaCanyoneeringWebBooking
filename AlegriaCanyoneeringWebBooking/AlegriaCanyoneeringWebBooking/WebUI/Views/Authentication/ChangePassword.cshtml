@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

    :root {
        --blue-deep: #0f3460;
        --blue-mid: #1a6ef5;
        --blue-light: #4f9cf9;
        --white: #ffffff;
        --gray-soft: #f4f7fe;
        --gray-text: #64748b;
        --danger: #ef4444;
        --success: #22c55e;
    }

    .cp-wrap {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        font-family: 'Outfit', sans-serif;
    }

    .cp-card {
        background: var(--white);
        border-radius: 20px;
        box-shadow: 0 4px 40px rgba(15,52,96,0.10);
        padding: 2.5rem 2.25rem;
        width: 100%;
        max-width: 480px;
        animation: slideUp 0.4s ease both;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .cp-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(26,110,245,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.25rem;
    }

        .cp-icon i {
            font-size: 1.6rem;
            color: var(--blue-mid);
        }

    .cp-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--blue-deep);
        text-align: center;
        margin-bottom: 0.35rem;
    }

    .cp-subtitle {
        font-size: 0.875rem;
        color: var(--gray-text);
        text-align: center;
        margin-bottom: 2rem;
    }

    .field-group {
        margin-bottom: 1.25rem;
    }

        .field-group label {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--blue-deep);
            letter-spacing: 0.04em;
            text-transform: uppercase;
            display: block;
            margin-bottom: 0.4rem;
        }

    .field-wrap {
        position: relative;
    }

    .field-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--blue-light);
        font-size: 0.95rem;
        pointer-events: none;
    }

    .field-wrap input {
        width: 100%;
        padding: 0.75rem 2.75rem;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.95rem;
        color: #1e293b;
        background: #fafbff;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .field-wrap input:focus {
            border-color: var(--blue-mid);
            box-shadow: 0 0 0 3px rgba(26,110,245,0.12);
            background: var(--white);
        }

        .field-wrap input::placeholder {
            color: #b0bec5;
        }

    .eye-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: var(--gray-text);
        font-size: 0.95rem;
        padding: 4px;
        transition: color 0.2s;
    }

        .eye-btn:hover {
            color: var(--blue-mid);
        }

    .field-error {
        font-size: 0.78rem;
        color: var(--danger);
        margin-top: 0.3rem;
        display: block;
    }

    .btn-save {
        width: 100%;
        padding: 0.85rem;
        background: linear-gradient(135deg, var(--blue-mid), var(--blue-deep));
        color: var(--white);
        border: none;
        border-radius: 10px;
        font-family: 'Outfit', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
        box-shadow: 0 4px 16px rgba(26,110,245,0.35);
        margin-top: 0.5rem;
    }

        .btn-save:hover {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(26,110,245,0.45);
        }

        .btn-save:active {
            transform: translateY(0);
        }
</style>

<div class="cp-wrap">
    <div class="cp-card">

        <div class="cp-icon">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h2 class="cp-title">Change Password</h2>
        <p class="cp-subtitle">Update your account password below.</p>

        <form asp-action="ChangePassword" method="post" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()

            <!-- Current Password -->
            <div class="field-group">
                <label asp-for="CurrentPassword">Current Password</label>
                <div class="field-wrap">
                    <i class="bi bi-lock field-icon"></i>
                    <input asp-for="CurrentPassword" type="password"
                           id="currentPwd" placeholder="Enter current password" required />
                    <button type="button" class="eye-btn" onclick="togglePwd('currentPwd','eyeCurrent')">
                        <i class="bi bi-eye" id="eyeCurrent"></i>
                    </button>
                </div>
                <span asp-validation-for="CurrentPassword" class="field-error"></span>
            </div>

            <!-- New Password -->
            <div class="field-group">
                <label asp-for="NewPassword">New Password</label>
                <div class="field-wrap">
                    <i class="bi bi-key field-icon"></i>
                    <input asp-for="NewPassword" type="password"
                           id="newPwd" placeholder="Enter new password" required />
                    <button type="button" class="eye-btn" onclick="togglePwd('newPwd','eyeNew')">
                        <i class="bi bi-eye" id="eyeNew"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>

            <!-- Confirm Password -->
            <div class="field-group">
                <label asp-for="ConfirmNewPassword">Confirm New Password</label>
                <div class="field-wrap">
                    <i class="bi bi-check2-circle field-icon"></i>
                    <input asp-for="ConfirmNewPassword" type="password"
                           id="confirmPwd" placeholder="Confirm new password" required />
                    <button type="button" class="eye-btn" onclick="togglePwd('confirmPwd','eyeConfirm')">
                        <i class="bi bi-eye" id="eyeConfirm"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn-save">
                <i class="bi bi-shield-check me-1"></i> Save New Password
            </button>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ── Toggle Password Visibility ──────────────────────────
        function togglePwd(fieldId, iconId) {
            const f = document.getElementById(fieldId);
            const i = document.getElementById(iconId);
            const showing = f.type === 'text';
            f.type = showing ? 'password' : 'text';
            i.className = showing ? 'bi bi-eye' : 'bi bi-eye-slash';
        }

        // ── Toast ────────────────────────────────────────────────
        function showToast(message, type = 'success') {
            const map = {
                success: { bg: '#22c55e', icon: 'bi-check-circle-fill',         title: 'Success' },
                error:   { bg: '#ef4444', icon: 'bi-exclamation-triangle-fill',  title: 'Error'   },
                warning: { bg: '#f0a500', icon: 'bi-exclamation-circle-fill',    title: 'Warning' },
                info:    { bg: '#1a6ef5', icon: 'bi-info-circle-fill',           title: 'Info'    }
            };
            const { bg, icon, title } = map[type] || map.info;
            const id = 'toast-' + Date.now();
            const html = `
                <div id="${id}" class="toast border-0 text-white"
                     style="background:${bg};border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.15);"
                     role="alert" aria-atomic="true" data-bs-delay="4000">
                    <div class="toast-header border-0 text-white" style="background:transparent;">
                        <i class="bi ${icon} me-2"></i>
                        <strong class="me-auto">${title}</strong>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                    </div>
                    <div class="toast-body" style="padding-top:0;">${message}</div>
                </div>`;
            let container = document.getElementById('toastContainer');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toastContainer';
                container.className = 'toast-container position-fixed top-0 end-0 p-3';
                container.style.zIndex = '1090';
                document.body.appendChild(container);
            }
            container.insertAdjacentHTML('beforeend', html);
            const el = document.getElementById(id);
            new bootstrap.Toast(el).show();
            el.addEventListener('hidden.bs.toast', () => el.remove());
        }

        $(document).ready(function () {
            @if (TempData["SuccessMessage"] != null)
            {
                    <text>showToast('@TempData["SuccessMessage"]', 'success');</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                    <text>showToast('@TempData["ErrorMessage"]', 'error');</text>
            }

            document.querySelectorAll('.needs-validation').forEach(form => {
                form.addEventListener('submit', e => {
                    if (!form.checkValidity()) {
                        e.preventDefault();
                        e.stopPropagation();
                        showToast('Please fill in all required fields correctly.', 'warning');
                    }
                    form.classList.add('was-validated');
                });
            });
        });
    </script>
}
