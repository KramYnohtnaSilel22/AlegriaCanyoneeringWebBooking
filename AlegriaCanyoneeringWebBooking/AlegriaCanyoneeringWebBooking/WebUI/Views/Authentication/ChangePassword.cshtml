@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<style>
    /* Styles unchanged */
    .change-password-container {
        padding: 40px 20px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .form-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        padding: 40px;
        width: 100%;
        max-width: 500px;
    }

    .form-title {
        color: #0d6efd;
        font-weight: 700;
        margin-bottom: 30px;
        text-align: center;
        font-size: 2rem;
    }

    .input-group-text {
        background-color: #e9ecef;
        border-radius: 8px 0 0 8px;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        border-radius: 8px;
        border: 1.5px solid #dee2e6;
        padding: 10px 14px;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13,110,253,0.25);
            outline: none;
        }

    .btn {
        border-radius: 8px;
        padding: 10px 25px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .btn-primary {
        background-color: #0d6efd;
        border: none;
    }

        .btn-primary:hover {
            background-color: #0b5ed7;
            transform: translateY(-2px);
        }
</style>

<div class="change-password-container">
    <div class="form-card">
        <h2 class="form-title"><i></i>Change Password</h2>

        <form asp-action="ChangePassword" method="post" class="needs-validation" novalidate>
            <!-- Current Password -->
            <div class="mb-4">
                <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                    <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Enter current password" required />
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>

            <!-- New Password -->
            <div class="mb-4">
                <label asp-for="NewPassword" class="form-label">New Password</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="Enter new password" required />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <!-- Confirm New Password -->
            <div class="mb-4">
                <label asp-for="ConfirmNewPassword" class="form-label">Confirm New Password</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bi bi-check2-square"></i></span>
                    <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Confirm new password" required />
                </div>
                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
            </div>

            <!-- Submit Button -->
            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-primary btn-lg px-4">
                    <i></i> Save
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // ✅ Bootstrap Toast Notification
        function showToast(message, type = 'success') {
            let bgClass = 'bg-success', icon = 'bi-check-circle-fill', title = 'Success';
            if (type === 'error') { bgClass = 'bg-danger'; icon = 'bi-exclamation-triangle-fill'; title = 'Error'; }
            else if (type === 'warning') { bgClass = 'bg-warning'; icon = 'bi-exclamation-circle-fill'; title = 'Warning'; }
            else if (type === 'info') { bgClass = 'bg-info'; icon = 'bi-info-circle-fill'; title = 'Info'; }

            const toastContainer = $('<div></div>')
                .addClass('toast-container position-fixed top-0 end-0 p-3')
                .css('z-index', 1080);

            const toast = $('<div></div>').addClass(`toast text-white ${bgClass} border-0`)
                .attr({ role: 'alert', 'aria-live': 'assertive', 'aria-atomic': 'true', 'data-bs-delay': 4000 });

            const toastHeader = $('<div></div>').addClass(`toast-header ${bgClass} text-white border-0`).html(`
                <i class="bi ${icon} me-2"></i>
                <strong class="me-auto">${title}</strong>
                <small>Now</small>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            `);

            const toastBody = $('<div></div>').addClass('toast-body').text(message);

            toast.append(toastHeader, toastBody);
            toastContainer.append(toast);
            $('body').append(toastContainer);

            var bsToast = new bootstrap.Toast(toast[0]);
            bsToast.show();

            toast.on('hidden.bs.toast', function () { toastContainer.remove(); });
        }

        $(document).ready(function () {
            // Show TempData messages if any
            @if (TempData["SuccessMessage"] != null)
            {
                <text>showToast('@TempData["SuccessMessage"]', 'success');</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>showToast('@TempData["ErrorMessage"]', 'error');</text>
            }

            // Client-side validation + toast warning
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                        showToast('Please fill in all required fields correctly.', 'warning');
                    }
                    form.classList.add('was-validated');
                });
            });
        });
    </script>
}
