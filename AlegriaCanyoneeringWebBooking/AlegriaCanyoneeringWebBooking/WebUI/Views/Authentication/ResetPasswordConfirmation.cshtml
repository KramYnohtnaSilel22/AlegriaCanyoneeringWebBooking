@{
    ViewData["Title"] = "Password Reset Confirmation";
    Layout = "Layout_Login";
}

<style>
    body {
        background-attachment: fixed;
        font-family: 'Poppins', sans-serif;
    }

    .confirmation-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .confirmation-card {
        background: #fff;
        border-radius: 1.5rem;
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.15);
        width: 100%;
        max-width: 420px;
        animation: fadeIn 0.6s ease-in-out;
    }

    .confirmation-header {
        background: #28a745;
        color: #fff;
        padding: 1.25rem 1rem;
        border-top-left-radius: 1.5rem;
        border-top-right-radius: 1.5rem;
        text-align: center;
    }

        .confirmation-header i {
            font-size: 1.8rem;
            margin-bottom: 0.3rem;
        }

    .confirmation-body {
        padding: 2rem;
        text-align: center;
    }

        .confirmation-body p {
            font-size: 1rem;
            color: #333;
            margin-bottom: 1.5rem;
        }

        .confirmation-body a.fw-bold {
            color: #007bff;
            transition: color 0.2s;
        }

            .confirmation-body a.fw-bold:hover {
                color: #0056b3;
                text-decoration: underline;
            }

    .btn-success {
        background: #28a745;
        border: none;
        border-radius: 50px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-success:hover {
            background: #218838;
            transform: translateY(-2px);
            box-shadow: 0 5px 12px rgba(0, 0, 0, 0.15);
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="confirmation-container">
    <div class="confirmation-card">
        <div class="confirmation-header">
            <i class="fas fa-check-circle"></i>
            <h4 class="mb-0">Password Reset Successful</h4>
        </div>

        <div class="confirmation-body">
            <p>
                Your password has been reset successfully. You may now
                <a asp-controller="Authentication" asp-action="Login" class="fw-bold text-decoration-none">log in</a>
                with your new password.
            </p>

            <a asp-controller="Authentication" asp-action="Login" class="btn btn-success rounded-pill">
                <i class="fas fa-sign-in-alt me-1"></i> Go to Login
            </a>
        </div>
    </div>
</div>
