@{
    ViewData["Title"] = "Forgot Password Confirmation";
    Layout = "Layout_Login";
}

<style>
    body {
        background-attachment: fixed;
        font-family: 'Poppins', sans-serif;
    }

    .confirmation-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .confirmation-card {
        background: #fff;
        border-radius: 1.5rem;
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.15);
        width: 100%;
        max-width: 420px;
        text-align: center;
        animation: fadeIn 0.6s ease-in-out;
    }

    .confirmation-header {
        background: #28a745;
        color: #fff;
        padding: 1.25rem 1rem;
        border-top-left-radius: 1.5rem;
        border-top-right-radius: 1.5rem;
    }

        .confirmation-header i {
            font-size: 1.8rem;
            margin-bottom: 0.3rem;
        }

    .confirmation-body {
        padding: 2rem;
    }

        .confirmation-body .lead {
            font-size: 1rem;
            font-weight: 500;
            color: #333;
        }

        .confirmation-body .text-muted {
            font-size: 0.9rem;
            color: #6c757d;
        }

    .btn-primary {
        background: #007bff;
        border: none;
        border-radius: 50px;
        padding: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: #0069d9;
            transform: translateY(-2px);
            box-shadow: 0 5px 12px rgba(0, 0, 0, 0.15);
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="confirmation-container">
    <div class="confirmation-card">
        <div class="confirmation-header">
            <i class="fas fa-check-circle"></i>
            <h4 class="mb-0">Password Reset Email Sent</h4>
        </div>

        <div class="confirmation-body">
            <p class="lead mb-3">
                If an account exists for the email you entered, a password reset link has been sent.
            </p>
            <p class="text-muted">
                Please check your inbox (and spam folder) for further instructions.
            </p>

            <a asp-controller="Authentication" asp-action="Login"
               class="btn btn-primary w-100 mt-3">
                <i class="fas fa-sign-in-alt me-1"></i> Back to Login
            </a>
        </div>
    </div>
</div>
