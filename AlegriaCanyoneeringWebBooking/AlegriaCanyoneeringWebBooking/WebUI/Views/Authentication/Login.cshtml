@model LoginViewModel
@{
    Layout = "Layout_Login";
    ViewData["Title"] = "Login";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:wght@700&display=swap');

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --blue-deep: #0f3460;
        --blue-mid: #1a6ef5;
        --blue-light: #4f9cf9;
        --accent: #f0a500;
        --white: #ffffff;
        --gray-soft: #f4f7fe;
        --gray-text: #64748b;
        --danger: #ef4444;
    }

    html, body {
        height: 100%;
        overflow: hidden;
        font-family: 'Outfit', sans-serif;
    }

    /* ── Split Layout ──────────────────────────────── */
    .login-wrap {
        display: grid;
        grid-template-columns: 1fr 1fr;
        height: 100vh;
    }

    /* ── Left Panel — Brand ────────────────────────── */
    .brand-panel {
        background: linear-gradient(145deg, var(--blue-deep) 0%, #1a3a6e 40%, #1557b0 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem;
        position: relative;
        overflow: hidden;
    }

        /* Decorative circles */
        .brand-panel::before {
            content: '';
            position: absolute;
            width: 420px;
            height: 420px;
            border-radius: 50%;
            border: 60px solid rgba(255,255,255,0.04);
            top: -100px;
            left: -100px;
        }

        .brand-panel::after {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            border: 40px solid rgba(255,255,255,0.06);
            bottom: -80px;
            right: -80px;
        }

    .brand-logo {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid rgba(255,255,255,0.25);
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        margin-bottom: 1.5rem;
        animation: logoFloat 4s ease-in-out infinite;
    }

    @@keyframes logoFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }

    .brand-title {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        color: var(--white);
        text-align: center;
        line-height: 1.2;
        margin-bottom: 0.75rem;
    }

    .brand-subtitle {
        font-size: 0.875rem;
        color: rgba(255,255,255,0.6);
        text-align: center;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .brand-divider {
        width: 48px;
        height: 3px;
        background: var(--accent);
        border-radius: 2px;
        margin: 1.25rem auto;
    }

    .brand-tagline {
        font-size: 0.95rem;
        color: rgba(255,255,255,0.75);
        text-align: center;
        max-width: 260px;
        line-height: 1.6;
    }

    /* ── Right Panel — Form ────────────────────────── */
    .form-panel {
        background: var(--gray-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        animation: slideIn 0.5s ease both;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(30px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .login-card {
        background: var(--white);
        border-radius: 20px;
        padding: 2.5rem 2.25rem;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 4px 40px rgba(15,52,96,0.1);
    }

    .card-header-text {
        margin-bottom: 2rem;
    }

        .card-header-text h2 {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--blue-deep);
            margin-bottom: 0.35rem;
        }

        .card-header-text p {
            font-size: 0.875rem;
            color: var(--gray-text);
        }

    /* ── Form Fields ───────────────────────────────── */
    .field-group {
        margin-bottom: 1.25rem;
    }

        .field-group label {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--blue-deep);
            letter-spacing: 0.04em;
            text-transform: uppercase;
            display: block;
            margin-bottom: 0.4rem;
        }

    .field-wrap {
        position: relative;
    }

    .field-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--blue-light);
        font-size: 0.95rem;
        pointer-events: none;
    }

    .field-wrap input {
        width: 100%;
        padding: 0.75rem 2.75rem;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.95rem;
        color: #1e293b;
        background: #fafbff;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .field-wrap input:focus {
            border-color: var(--blue-mid);
            box-shadow: 0 0 0 3px rgba(26,110,245,0.12);
            background: var(--white);
        }

        .field-wrap input::placeholder {
            color: #b0bec5;
        }

    .eye-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: var(--gray-text);
        font-size: 0.95rem;
        padding: 4px;
        transition: color 0.2s;
    }

        .eye-btn:hover {
            color: var(--blue-mid);
        }

    .field-error {
        font-size: 0.78rem;
        color: var(--danger);
        margin-top: 0.3rem;
        display: block;
    }

    /* ── Login Button ──────────────────────────────── */
    .btn-login {
        width: 100%;
        padding: 0.85rem;
        background: linear-gradient(135deg, var(--blue-mid), var(--blue-deep));
        color: var(--white);
        border: none;
        border-radius: 10px;
        font-family: 'Outfit', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
        box-shadow: 0 4px 16px rgba(26,110,245,0.35);
        margin-top: 0.5rem;
    }

        .btn-login:hover:not(:disabled) {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(26,110,245,0.45);
        }

        .btn-login:active:not(:disabled) {
            transform: translateY(0);
        }

        .btn-login:disabled {
            cursor: not-allowed;
            opacity: 0.75;
        }

    .spinner-sm {
        display: inline-block;
        width: 1rem;
        height: 1rem;
        border: 2px solid rgba(255,255,255,0.4);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        vertical-align: middle;
        margin-right: 0.4rem;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ── Forgot Link ───────────────────────────────── */
    .forgot-link {
        display: block;
        text-align: center;
        margin-top: 1.25rem;
        font-size: 0.85rem;
        color: var(--blue-mid);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
    }

        .forgot-link:hover {
            color: var(--blue-deep);
            text-decoration: underline;
        }

    /* ── Responsive ────────────────────────────────── */
    @@media (max-width: 768px) {
        .login-wrap {
            grid-template-columns: 1fr;
        }

        .brand-panel {
            display: none;
        }

        .form-panel {
            background: linear-gradient(145deg, var(--blue-deep), #1557b0);
        }

        .login-card {
            box-shadow: 0 8px 40px rgba(0,0,0,0.25);
        }
    }
</style>

<div class="login-wrap">

    <!-- ── Left: Brand Panel ── -->
    <div class="brand-panel">
        <img src="/images/alegrialogo2025.jpeg" alt="Alegria Logo" class="brand-logo" />
        <h1 class="brand-title">Alegria<br>Canyoneering</h1>
        <div class="brand-divider"></div>
        <p class="brand-tagline">Adventure awaits. Sign in to manage your bookings and guests.</p>
        <p class="brand-subtitle" style="margin-top:1.5rem;">Web Booking System</p>
    </div>

    <!-- ── Right: Form Panel ── -->
    <div class="form-panel">
        <div class="login-card">

            <div class="card-header-text">
                <h2>Welcome back 👋</h2>
                <p>Sign in to your account to continue</p>
            </div>

            <form asp-action="Login" asp-controller="Authentication"
                  method="post" novalidate id="loginForm">
                @Html.AntiForgeryToken()

                <!-- Username -->
                <div class="field-group">
                    <label asp-for="Username">Username</label>
                    <div class="field-wrap">
                        <i class="bi bi-person field-icon"></i>
                        <input asp-for="Username"
                               placeholder="Enter your username"
                               autocomplete="username"
                               required />
                    </div>
                    <span asp-validation-for="Username" class="field-error"></span>
                </div>

                <!-- Password -->
                <div class="field-group">
                    <label asp-for="Password">Password</label>
                    <div class="field-wrap">
                        <i class="bi bi-lock field-icon"></i>
                        <input asp-for="Password"
                               type="password"
                               id="passwordField"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />
                        <button type="button" class="eye-btn" id="eyeBtn"
                                onclick="togglePassword()" title="Toggle password">
                            <i class="bi bi-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <!-- Submit -->
                <button type="submit" class="btn-login" id="loginBtn">
                    Sign In
                </button>

                <a asp-action="ForgotPassword" asp-controller="Authentication"
                   class="forgot-link">
                    Forgot your password?
                </a>
            </form>

        </div>
    </div>

</div>

<!-- Toast container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090;" id="toastContainer"></div>

<script>
    // ── Toggle Password ──────────────────────────────
    function togglePassword() {
        const field   = document.getElementById('passwordField');
        const icon    = document.getElementById('eyeIcon');
        const showing = field.type === 'text';
        field.type    = showing ? 'password' : 'text';
        icon.className = showing ? 'bi bi-eye' : 'bi bi-eye-slash';
    }

    // ── Toast ────────────────────────────────────────
    function showToast(message, type = 'danger') {
        const map = {
            danger:  { bg: '#ef4444', icon: 'bi-exclamation-circle-fill', title: 'Error'   },
            warning: { bg: '#f0a500', icon: 'bi-exclamation-triangle-fill', title: 'Warning' },
            success: { bg: '#22c55e', icon: 'bi-check-circle-fill',        title: 'Success' }
        };
        const { bg, icon, title } = map[type] || map.danger;
        const id = 'toast-' + Date.now();

        const html = `
            <div id="${id}" class="toast border-0 text-white"
                 style="background:${bg};border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.15);"
                 role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4500">
                <div class="toast-header border-0 text-white" style="background:transparent;">
                    <i class="bi ${icon} me-2"></i>
                    <strong class="me-auto">${title}</strong>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                </div>
                <div class="toast-body" style="padding-top:0;">${message}</div>
            </div>`;

        const container = document.getElementById('toastContainer');
        container.insertAdjacentHTML('beforeend', html);
        const el = document.getElementById(id);
        new bootstrap.Toast(el).show();
        el.addEventListener('hidden.bs.toast', () => el.remove());
    }

    // ── Login Button State ───────────────────────────
    function setLoading(on) {
        const btn = document.getElementById('loginBtn');
        btn.disabled = on;
        btn.innerHTML = on
            ? '<span class="spinner-sm"></span> Signing in...'
            : 'Sign In';
    }

    // ── Form Submit ──────────────────────────────────
    const form = document.getElementById('loginForm');
    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!form.checkValidity()) { form.classList.add('was-validated'); return; }
        setLoading(true);
        form.classList.add('was-validated');
        setTimeout(() => form.submit(), 100);
    });

    // ── Server Messages ──────────────────────────────
    document.addEventListener('DOMContentLoaded', function () {
        @if (TempData["ErrorMessage"] != null)
        {
                <text>
                showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"])), 'danger');
                setLoading(false);
                </text>
        }
        else if (TempData["WarningMessage"] != null)
        {
                <text>
                showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["WarningMessage"])), 'warning');
                setLoading(false);
                </text>
        }
    });
</script>
