@model AlegriaCanyoneeringWebBooking.WebUI.Models.OutsideGuideFromOperator
@{
    var action = ViewData["Action"]?.ToString() ?? (Model.Id > 0 ? "Edit" : "Create");
    var formAction = action == "Edit"
        ? "/OutsideGuideFromOperator/Edit"
        : "/OutsideGuideFromOperator/Create";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');
    .ogf-form * {
        font-family: 'Outfit', sans-serif;
    }

    .ogf-field {
        margin-bottom: 1.1rem;
    }

    .ogf-label {
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #0f3460;
        display: block;
        margin-bottom: 0.4rem;
    }

        .ogf-label .req {
            color: #ef4444;
            margin-left: 2px;
        }

    .field-wrap {
        position: relative;
    }

    .field-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 0.85rem;
        pointer-events: none;
    }

    .ogf-select {
        width: 100%;
        padding: 0.7rem 0.75rem 0.7rem 2.4rem;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.9rem;
        color: #1e293b;
        background: #fafbff;
        outline: none;
        appearance: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .ogf-select:focus {
            border-color: #1a6ef5;
            box-shadow: 0 0 0 3px rgba(26,110,245,0.1);
            background: #fff;
        }

    /* chevron */
    .select-wrap::after {
        content: '\F282';
        font-family: 'bootstrap-icons';
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        pointer-events: none;
        font-size: 0.8rem;
    }

    /* preview chip */
    .preview-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(26,110,245,0.06);
        border: 1px solid #bfdbfe;
        border-radius: 8px;
        padding: 0.25rem 0.65rem;
        font-size: 0.75rem;
        color: #1e40af;
        margin-top: 0.4rem;
        animation: fadeIn 0.2s ease;
    }

        .preview-chip .chip-id {
            background: rgba(26,110,245,0.12);
            color: #1a6ef5;
            padding: 0.05rem 0.45rem;
            border-radius: 6px;
            font-weight: 700;
            font-size: 0.68rem;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-4px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* footer */
    .ogf-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        padding-top: 0.75rem;
        border-top: 1.5px solid #f1f5f9;
        margin-top: 0.5rem;
    }

    .btn-ogf-cancel {
        padding: 0.6rem 1.25rem;
        background: #f1f5f9;
        color: #475569;
        border: none;
        border-radius: 10px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-ogf-cancel:hover {
            background: #e2e8f0;
        }

    .btn-ogf-save {
        padding: 0.6rem 1.5rem;
        background: linear-gradient(135deg, #1a6ef5, #0f3460);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s;
        box-shadow: 0 3px 12px rgba(26,110,245,0.3);
    }

        .btn-ogf-save:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }
</style>

<form action="@formAction" method="post" novalidate class="ogf-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="hidden" id="fieldOperatorId" name="operatorId" />
    <input type="hidden" id="fieldOperatorName" name="operatorName" />
    <input type="hidden" id="fieldGuideId" name="guideId" />
    <input type="hidden" id="fieldGuideName" name="guideName" />

    <!-- Operator -->
    <div class="ogf-field">
        <label class="ogf-label">
            <i class="bi bi-person-workspace me-1"></i>Operator<span class="req">*</span>
        </label>
        <div class="field-wrap select-wrap">
            <i class="bi bi-buildings field-icon"></i>
            <select id="selectOperator" class="ogf-select" required>
                <option value="">— Select Operator —</option>
            </select>
        </div>
        <div id="operatorPreview"></div>
    </div>

    <!-- Guide -->
    <div class="ogf-field">
        <label class="ogf-label">
            <i class="bi bi-compass me-1"></i>Guide<span class="req">*</span>
        </label>
        <div class="field-wrap select-wrap">
            <i class="bi bi-person-badge field-icon"></i>
            <select id="selectGuide" class="ogf-select" required>
                <option value="">— Select Guide —</option>
            </select>
        </div>
        <div id="guidePreview"></div>
    </div>

    <!-- Footer -->
    <div class="ogf-footer">
        <button type="button" class="btn-ogf-cancel" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i>Cancel
        </button>
        <button type="submit" class="btn-ogf-save">
            <i class="bi bi-@(action == "Edit" ? "pencil" : "save") me-1"></i>
            @(action == "Edit" ? "Update" : "Save")
        </button>
    </div>
</form>

<script>
    (function () {
        var presetOperatorId = '@Model.OperatorId';
        var presetGuideId    = '@Model.GuideId';
        var operatorsData    = [];
        var guidesData       = [];

        function renderChip(container, label, value) {
            var el = document.getElementById(container);
            if (!value) { el.innerHTML = ''; return; }
            el.innerHTML = `
                <div class="preview-chip">
                    <span class="chip-id">${label}</span>
                    <span>${value}</span>
                </div>`;
        }

        fetch('/OutsideGuideFromOperator/GetDropdowns')
            .then(r => r.json())
            .then(function (data) {
                operatorsData = data.operators;
                guidesData    = data.guides;

                var opSel = document.getElementById('selectOperator');
                operatorsData.forEach(o => opSel.add(new Option(o.businessName, o.id)));

                var guSel = document.getElementById('selectGuide');
                guidesData.forEach(g => guSel.add(new Option(g.fullName, g.rfid)));

                if (presetOperatorId) { opSel.value = presetOperatorId; resolveOperator(presetOperatorId); }
                if (presetGuideId)    { guSel.value = presetGuideId;    resolveGuide(presetGuideId);       }
            })
            .catch(() => console.error('Could not load dropdowns.'));

        document.getElementById('selectOperator').addEventListener('change', function () {
            resolveOperator(this.value);
        });

        function resolveOperator(val) {
            var op = operatorsData.find(o => o.id === val);
            document.getElementById('fieldOperatorId').value   = op ? op.id           : '';
            document.getElementById('fieldOperatorName').value = op ? op.businessName : '';
            renderChip('operatorPreview', 'ID: ' + (op?.id ?? ''), op?.businessName ?? '');
        }

        document.getElementById('selectGuide').addEventListener('change', function () {
            resolveGuide(this.value);
        });

        function resolveGuide(val) {
            var g = guidesData.find(x => x.rfid === val);
            document.getElementById('fieldGuideId').value   = g ? g.rfid    : '';
            document.getElementById('fieldGuideName').value = g ? g.fullName : '';
            renderChip('guidePreview', 'RFID: ' + (g?.rfid ?? ''), g?.fullName ?? '');
        }
    })();
</script>
