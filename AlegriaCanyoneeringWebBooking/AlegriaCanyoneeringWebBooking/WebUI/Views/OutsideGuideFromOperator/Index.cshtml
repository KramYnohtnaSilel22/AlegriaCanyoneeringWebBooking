@{
    ViewData["Title"] = "Outside Guides From Operator";
    var isSuperAdmin = User.IsInRole("Super Admin");
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');
    .og-wrap * { font-family: 'Outfit', sans-serif; }

    .og-header {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem;
    }
    .og-header h2 {
        font-size: 1.35rem; font-weight: 700; color: #0f3460;
        margin: 0; display: flex; align-items: center; gap: 0.5rem;
    }
    .btn-create {
        display: inline-flex; align-items: center; gap: 0.4rem;
        padding: 0.6rem 1.25rem;
        background: linear-gradient(135deg, #1a6ef5, #0f3460);
        color: #fff; border: none; border-radius: 10px;
        font-family: 'Outfit', sans-serif; font-size: 0.875rem;
        font-weight: 600; cursor: pointer;
        transition: opacity 0.2s, transform 0.15s;
        box-shadow: 0 3px 12px rgba(26,110,245,0.3);
    }
    .btn-create:hover { opacity: 0.9; transform: translateY(-1px); }

    .og-card {
        background: #fff; border-radius: 16px;
        box-shadow: 0 2px 20px rgba(15,52,96,0.08);
        border: 1px solid #e8edf5; overflow: hidden;
    }
    .og-card-body { padding: 1.25rem; }

    #outsideGuideFromOpTable thead th {
        background: #eff6ff; color: #0f3460;
        font-size: 0.72rem; font-weight: 700;
        letter-spacing: 0.06em; text-transform: uppercase;
        border-bottom: 2px solid #bfdbfe;
        white-space: nowrap; padding: 0.75rem 1rem;
    }
    #outsideGuideFromOpTable tbody td {
        vertical-align: middle; font-size: 0.875rem;
        color: #334155; padding: 0.7rem 1rem;
    }
    #outsideGuideFromOpTable tbody tr:hover { background: #eff6ff; }

    .badge-operator {
        font-size: 0.7rem; font-weight: 600; padding: 0.2rem 0.6rem;
        border-radius: 20px; background: rgba(26,110,245,0.1);
        color: #1a6ef5; border: 1px solid #bfdbfe;
    }
    .badge-guide {
        font-size: 0.7rem; font-weight: 600; padding: 0.2rem 0.6rem;
        border-radius: 20px; background: rgba(16,185,129,0.1);
        color: #059669; border: 1px solid #6ee7b7;
    }

    .btn-act {
        padding: 0.28rem 0.65rem; border-radius: 7px;
        font-size: 0.78rem; font-weight: 600; border: none;
        cursor: pointer; transition: opacity 0.15s;
        display: inline-flex; align-items: center; gap: 0.3rem;
    }
    .btn-act:hover { opacity: 0.82; }
    .btn-edit-act   { background: rgba(240,165,0,0.1); color: #b45309; border: 1px solid #fde68a; }
    .btn-delete-act { background: rgba(239,68,68,0.08); color: #ef4444; border: 1px solid #fca5a5; }

    #ogFromOpModal .modal-content {
        border-radius: 16px; border: 0;
        box-shadow: 0 8px 40px rgba(15,52,96,0.18); overflow: hidden;
    }
    .og-modal-header {
        background: linear-gradient(135deg, #1a6ef5, #0f3460);
        color: #fff; padding: 1rem 1.5rem;
        display: flex; align-items: center; justify-content: space-between;
    }
    .og-modal-header h5 { font-size: 1rem; font-weight: 700; margin: 0; }

    .del-icon {
        width: 56px; height: 56px; border-radius: 50%;
        background: rgba(239,68,68,0.08);
        display: flex; align-items: center; justify-content: center; margin: 0 auto 0.75rem;
    }
    .del-icon i { font-size: 1.4rem; color: #ef4444; }
</style>


<form id="__AjaxAntiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<div class="og-wrap">
    <div class="og-header">
        <h2>
            <i class="bi bi-person-badge-fill" style="color:#1a6ef5;"></i>
            Outside Guides From Operator
        </h2>
        <button type="button" id="btnCreate" class="btn-create">
            <i class="bi bi-plus-lg"></i> Add Record
        </button>
    </div>

    <div class="og-card">
        <div class="og-card-body">
            <div class="table-responsive">
                <table id="outsideGuideFromOpTable" class="table table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>#</th>
                            @if (isSuperAdmin)
                            {
                                <th>Operator</th>
                            }
                            <th>Guide RFID</th>
                            <th>Guide Name</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Form Modal -->
<div class="modal fade" id="ogFromOpModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="og-modal-header">
                <h5 id="ogFromOpModalLabel">
                    <i class="bi bi-person-badge me-2"></i>Outside Guide From Operator
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3" id="ogFromOpModalContent" style="min-height:200px;"></div>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="ogDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:340px;">
        <div class="modal-content shadow">
            <div class="modal-body text-center pt-4 pb-3 px-4">
                <div class="del-icon"><i class="bi bi-trash3-fill"></i></div>
                <h6 class="fw-bold mb-1" style="color:#0f3460;">Delete Record?</h6>
                <p class="text-muted mb-0" style="font-size:0.875rem;">
                    Are you sure you want to remove
                    <strong id="deleteGuideName"></strong> from this operator?
                    This cannot be undone.
                </p>
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2 pb-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger rounded-pill px-4">
                    <i class="bi bi-trash3 me-1"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

<div id="ogToastContainer"
     class="toast-container position-fixed top-0 end-0 p-3"
     style="z-index:1090;"></div>

@section Scripts {
<script>
    const isSuperAdmin = @(isSuperAdmin ? "true" : "false");

    // ── Toast helper ─────────────────────────────────────────────────────────
    function showToast(message, type = 'success') {
        const map = {
            success: { bg: '#22c55e', icon: 'bi-check-circle-fill',        title: 'Success' },
            error:   { bg: '#ef4444', icon: 'bi-exclamation-triangle-fill', title: 'Error'   },
            warning: { bg: '#f0a500', icon: 'bi-exclamation-circle-fill',   title: 'Warning' }
        };
        const { bg, icon, title } = map[type] ?? map.success;
        const id   = 'ogt-' + Date.now();
        const html = `
            <div id="${id}" class="toast border-0 text-white"
                 style="background:${bg};border-radius:12px;box-shadow:0 4px 16px rgba(0,0,0,0.15);"
                 role="alert" aria-atomic="true" data-bs-delay="4000">
                <div class="toast-header border-0 text-white" style="background:transparent;">
                    <i class="bi ${icon} me-2"></i>
                    <strong class="me-auto">${title}</strong>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                </div>
                <div class="toast-body" style="padding-top:0;">${message}</div>
            </div>`;
        const c = document.getElementById('ogToastContainer');
        c.insertAdjacentHTML('beforeend', html);
        const el = document.getElementById(id);
        new bootstrap.Toast(el).show();
        el.addEventListener('hidden.bs.toast', () => el.remove());
    }

    $(function () {

        // ── DataTable columns ─────────────────────────────────────────────────
        const columns = [
            {
                data: null, orderable: false, searchable: false,
                render: (d, t, r, m) => m.row + 1
            }
        ];

        if (isSuperAdmin) {
            columns.push({
                data: 'operatorName', orderable: false, searchable: false,
                defaultContent: '—',
                render: d => `<span class="badge-operator">${d ?? '—'}</span>`
            });
        }

        columns.push(
            {
                data: 'guideId', orderable: false, searchable: false,
                defaultContent: '—',
                render: d => `<span class="badge-guide">${d ?? '—'}</span>`
            },
            {
                data: 'guideName', orderable: false, searchable: false,
                defaultContent: '—',
                render: d => `<span class="fw-semibold">${d ?? '—'}</span>`
            },
            {
                data: 'id', orderable: false, searchable: false,
                className: 'text-center',
                render: (data, type, row) => `
                    <div class="d-flex gap-1 justify-content-center">
                        <button class="btn-act btn-edit-act btn-edit" data-id="${data}">
                            <i class="bi bi-pencil"></i> Edit
                        </button>
                        <button class="btn-act btn-delete-act btn-delete"
                                data-id="${data}"
                                data-name="${row.guideName ?? ''}">
                            <i class="bi bi-trash3"></i> Delete
                        </button>
                    </div>`
            }
        );

        const table = $('#outsideGuideFromOpTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url:  '/OutsideGuideFromOperator/GetOutsideGuideData',
                type: 'POST',
                data: d => {
                    d.__RequestVerificationToken =
                        $('#__AjaxAntiForgeryForm input[name="__RequestVerificationToken"]').val();
                },
                error: (xhr) => {
                    let msg = 'Error loading data.';
                    try { const r = JSON.parse(xhr.responseText); if (r.error) msg = r.error; } catch {}
                    showToast(msg, 'error');
                }
            },
            columns,
            responsive: true,
            language: { emptyTable: 'No records found.' }
        });

        // ── Modal loader ──────────────────────────────────────────────────────
        function openModal(url, title) {
            // Dispose any lingering instance first
            bootstrap.Modal.getInstance(document.getElementById('ogFromOpModal'))?.dispose();

            $('#ogFromOpModalContent').html(`
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <div style="font-size:0.875rem;">Loading form...</div>
                </div>`);
            $('#ogFromOpModalLabel').html(
                `<i class="bi bi-person-badge me-2"></i>${title}`);

            new bootstrap.Modal(document.getElementById('ogFromOpModal')).show();

            $.get(url)
                .done(res => $('#ogFromOpModalContent').html(res))
                .fail(xhr => {
                    $('#ogFromOpModalContent').html(
                        `<div class="alert alert-danger m-3">
                            <strong>HTTP ${xhr.status}:</strong> ${xhr.statusText}
                         </div>`);
                    showToast('Error loading form.', 'error');
                });
        }

        // ── Create ────────────────────────────────────────────────────────────
        $('#btnCreate').on('click', () =>
            openModal('/OutsideGuideFromOperator/Create', 'Add Record'));

        // ── Edit ──────────────────────────────────────────────────────────────
        $('#outsideGuideFromOpTable').on('click', '.btn-edit', function () {
            openModal(`/OutsideGuideFromOperator/Edit/${$(this).data('id')}`, 'Edit Record');
        });

        // ── Delete ────────────────────────────────────────────────────────────
        let pendingDeleteId = null;
        const deleteModal   = new bootstrap.Modal(document.getElementById('ogDeleteModal'));

        $('#outsideGuideFromOpTable').on('click', '.btn-delete', function () {
            pendingDeleteId = $(this).data('id');
            $('#deleteGuideName').text($(this).data('name'));
            deleteModal.show();
        });

        $('#confirmDeleteBtn').on('click', function () {
            if (!pendingDeleteId) return;
            const $btn = $(this);
            $btn.prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm me-1"></span>Deleting...');

            $.post('/OutsideGuideFromOperator/DeleteAjax', {
                id: pendingDeleteId,
                __RequestVerificationToken:
                    $('#__AjaxAntiForgeryForm input[name="__RequestVerificationToken"]').val()
            })
            .done(res => {
                deleteModal.hide();
                if (res.success) {
                    showToast(res.message, 'success');
                    table.ajax.reload(null, false);
                } else {
                    showToast(res.message, 'error');
                }
            })
            .fail(() => {
                deleteModal.hide();
                showToast('Error deleting record.', 'error');
            })
            .always(() => {
                $btn.prop('disabled', false)
                    .html('<i class="bi bi-trash3 me-1"></i>Delete');
                pendingDeleteId = null;
            });
        });

        // ── Form submit ───────────────────────────────────────────────────────
        $('#ogFromOpModal').on('submit', 'form', function (e) {
            e.preventDefault();
            const form     = $(this);
            const formData = new FormData(form[0]);

            // Always pull the token from the dedicated hidden form — the
            // partial's own token may be stale after modal reuse.
            formData.set(
                '__RequestVerificationToken',
                $('#__AjaxAntiForgeryForm input[name="__RequestVerificationToken"]').val()
            );

            const isEdit   = form.attr('action').toLowerCase().includes('edit');
            const $btn     = form.find('[type="submit"]');
            const resetBtn = () =>
                $btn.prop('disabled', false)
                    .html(isEdit
                        ? '<i class="bi bi-pencil me-1"></i>Update'
                        : '<i class="bi bi-save me-1"></i>Save');

            $btn.prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');

            $.ajax({
                url:         form.attr('action'),
                type:        'POST',
                data:        formData,
                processData: false,
                contentType: false
            })
            .done(res => {
                if (res.success) {
                    bootstrap.Modal.getInstance(
                        document.getElementById('ogFromOpModal'))?.hide();
                    table.ajax.reload(null, false);
                    showToast(res.message, 'success');
                } else {
                    showToast(res.message || 'Validation error.', 'error');
                    resetBtn();
                }
            })
            .fail(xhr => {
                showToast(`Error saving (HTTP ${xhr.status}).`, 'error');
                resetBtn();
            });
        });
    });
</script>
}
