@model AlegriaCanyoneeringWebBooking.ViewModel.GuestListViewModel

@{
    ViewData["Title"] = "Guest Management";
}


<div class="overlay" id="loadingOverlay">
    <div class="spinner"></div> <!-- Spinner for loading effect -->
    <div class="success-message" id="successMessage"></div>
</div>


@if (TempData["ToastMessage"] != null)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055;">
        <div id="toastMessage" class="toast align-items-center text-white bg-@TempData["ToastType"] border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="fas fa-check-circle me-2"></i> @TempData["ToastMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

<div class="container py-4">
    <ul class="nav nav-tabs mb-4" id="guestTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="add-tab" data-bs-toggle="tab" data-bs-target="#addGuestTab" type="button">Add Guest</button>
        </li>
      
    </ul>

    <div class="tab-content">
        <!-- TAB 1: Add Guest -->
        <div class="tab-pane fade show active" id="addGuestTab" role="tabpanel">
            <div class="card shadow-lg rounded-4 border-0">
                <div class="card-body p-4">
                    <h4 class="text-center text-primary mb-4 fw-semibold">Add New Guest</h4>

                    <form asp-action="NewBooking" method="post" id="guestForm" enctype="multipart/form-data">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <fieldset class="mb-4">
                            <legend class="h5">Guest Info</legend>

                            <div class="mb-3">
                                <label asp-for="NewGuest.OperatorId" class="form-label fw-medium">Operator</label>
                                <select asp-for="NewGuest.OperatorId" class="form-select form-select-lg" asp-items="ViewBag.OperatorList"></select>
                                <span asp-validation-for="NewGuest.OperatorId" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewGuest.Fullname" class="form-label fw-medium">Full Name (as on ID)</label>
                                <input asp-for="NewGuest.Fullname" class="form-control form-control-lg" placeholder="e.g., Juan Dela Cruz" />
                                <span asp-validation-for="NewGuest.Fullname" class="text-danger"></span>
                            </div>

                            <div class="mb-3 row">
                                <div class="col-md-6">
                                    <label asp-for="NewGuest.Age" class="form-label fw-medium">Age</label>
                                    <input asp-for="NewGuest.Age" type="number" class="form-control form-control-lg" placeholder="e.g., 25" />
                                    <span asp-validation-for="NewGuest.Age" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="NewGuest.Gender" class="form-label fw-medium">Gender</label>
                                    <select asp-for="NewGuest.Gender" class="form-select form-select-lg">
                                        <option disabled selected>Select Gender</option>
                                        <option>Male</option>
                                        <option>Female</option>
                                    </select>
                                    <span asp-validation-for="NewGuest.Gender" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewGuest.ContactNumber" class="form-label fw-medium">Mobile Number</label>
                                <input asp-for="NewGuest.ContactNumber" type="tel" class="form-control form-control-lg" placeholder="e.g., 09171234567" />
                            </div>
                        </fieldset>
                   
                        <fieldset class="mb-4">
                            <legend class="h5">Nationality & Booking</legend>

                            <div class="mb-3 row">
                                <div class="col-md-6">
                                    <label asp-for="NewGuest.NationalityType" class="form-label fw-medium">Nationality</label>
                                    <select asp-for="NewGuest.NationalityType"
                                            class="form-select form-select-lg"
                                            id="NationalityType">
                                        <option value="Local">Local</option>
                                        <option value="Foreign">Foreign</option>
                                    </select>

                                </div>

                                <div class="col-md-6">
                                    <label asp-for="NewGuest.NationalityId" class="form-label fw-medium">Status</label>
                                    <select asp-for="NewGuest.Nationality.NatName"
                                            class="form-select form-select-lg"
                                            id="NationalityId">
                                        <option value="">-- Select --</option>
                                    </select>

                                    <span asp-validation-for="NewGuest.NationalityId" class="text-danger"></span>
                                </div>

                            </div>

                  

                            <div class="mb-3 row guest-date-fields">
                                <div class="col-md-6">
                                    <label asp-for="NewGuest.Date" class="form-label fw-medium">Booking Date</label>
                                    <input asp-for="NewGuest.Date" type="date" class="form-control form-control-lg" id="BookingDate" />
                                    <span asp-validation-for="NewGuest.Date" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="NewGuest.ArrivalDate" class="form-label fw-medium">Arrival Date</label>
                                    <input asp-for="NewGuest.ArrivalDate" type="date" class="form-control form-control-lg" id="ArrivalDate" />
                                    <span asp-validation-for="NewGuest.ArrivalDate" class="text-danger"></span>
                                </div>
                            </div>


                            <div class="mb-3">
                                <label asp-for="NewGuest.Area" class="form-label fw-medium">Tour Area</label>
                                <select asp-for="NewGuest.Area" class="form-select form-select-lg">
                                    <option disabled selected>Select Area</option>
                                    <option>Wonder Falls</option>
                                    <option>Kanlaob</option>
                                    <option>Kawasan Exit</option>
                                </select>
                                <span asp-validation-for="NewGuest.Area" class="text-danger"></span>
                            </div>
                        </fieldset>

                        <input asp-for="NewGuest.Batch" type="hidden" />

                        <button id="addGuestBtn" class="btn btn-primary mb-3">
                            <i class="fas fa-user-plus me-1"></i> Add Guest
                        </button>

                        <button type="submit" id="saveBtn" class="btn btn-primary w-100 py-2 fw-semibold" >
                            <span class="spinner-border spinner-border-sm d-none" id="loadingSpinner" role="status" aria-hidden="true"></span>
                            <span id="btnText">Save Guest</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>

     
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Include Bootstrap JS -->
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<script>
          $(document).ready(function () {
            // Show loading overlay and success message
            const successMessage = '@TempData["LoginSuccess"]'; // Get success message
            $('#successMessage').text(successMessage); // Set the success message
            $('#loadingOverlay').addClass('active'); // Show overlay

            // Automatically close the loading overlay and redirect after a few seconds (e.g., 2 seconds)
            setTimeout(function () {
                $('#loadingOverlay').removeClass('active'); // Hide overlay

            }, 2000); // 3000 milliseconds = 3 seconds
        });

    const bookingDateInput = document.getElementById("BookingDate");
     const arrivalDateInput = document.getElementById("ArrivalDate");

     let guestCount = localStorage.getItem("guestCount") ? parseInt(localStorage.getItem("guestCount")) : 0;

     function loadSavedDates() {
         const savedBookingDate = localStorage.getItem("savedBookingDate");
         const savedArrivalDate = localStorage.getItem("savedArrivalDate");

         if (savedBookingDate) bookingDateInput.value = savedBookingDate;
         if (savedArrivalDate) arrivalDateInput.value = savedArrivalDate;
     }

     function handleDateFields() {
         if (guestCount % 5 === 0) {
             // Start of batch — allow editing
             bookingDateInput.readOnly = false;
             arrivalDateInput.readOnly = false;

             localStorage.removeItem("savedBookingDate");
             localStorage.removeItem("savedArrivalDate");
         } else {
             // Lock the values
             bookingDateInput.readOnly = true;
             arrivalDateInput.readOnly = true;

             loadSavedDates();
         }
     }

     document.addEventListener("DOMContentLoaded", function () {
         handleDateFields();

         const form = document.getElementById("guestForm");
         form.addEventListener("submit", function () {
             if (guestCount % 5 === 0) {
                 localStorage.setItem("savedBookingDate", bookingDateInput.value);
                 localStorage.setItem("savedArrivalDate", arrivalDateInput.value);
             }

             guestCount++;
             localStorage.setItem("guestCount", guestCount);
         });
     });

     function resetGuestBatch() {
         localStorage.removeItem("guestCount");
         localStorage.removeItem("savedBookingDate");
         localStorage.removeItem("savedArrivalDate");
         location.reload();
     }
     $(function () {
        const $type = $('#NationalityType');
        const $list = $('#NationalityId');
        const getNationalitiesUrl = '@Url.Action("GetNationalities", "Guest")';

        function updateNationalityIdOptions(choice) {
            $list.empty();

            if (choice === 'Local') {
                $list.append(new Option('Within Cebu Province', 'Within Cebu Province'));
                $list.append(new Option('Outside Cebu Province', 'Outside Cebu Province'));
            } else if (choice === 'Foreign') {
                $list.append(new Option('Loading...', ''));
                $.getJSON(getNationalitiesUrl)
                    .done(function (data) {
                        $list.empty();
                        data.forEach(function (name) {
                            $list.append(new Option(name, name));
                        });
                    })
                    .fail(function () {
                        $list.empty().append(new Option('Error loading', ''));
                    });
            } else {
                $list.append(new Option('-- Select --', ''));
            }
        }

        // Bind change event
        $type.on('change', function () {
            const selected = $(this).val();
            updateNationalityIdOptions(selected);
        });

        // Trigger on load if value exists (like in Edit)
        if ($type.val()) {
            updateNationalityIdOptions($type.val());
        }
    });
            window.onload = () => {
                const form = document.getElementById("guestForm");
                const spinner = document.getElementById("loadingSpinner");
                const btn = document.getElementById("saveBtn");
                const btnText = document.getElementById("btnText");

                form.addEventListener("submit", () => {
                    btn.disabled = true;
                    spinner.classList.remove("d-none");
                    btnText.textContent = "Saving...";
                });
            };

    $(document).ready(function() {
        $('#addGuestBtn').click(function() {
            $('#add-tab').tab('show');
            // Optionally scroll to the Add Guest form
            $('html, body').animate({
                scrollTop: $('#addGuestTab').offset().top - 70 // adjust as needed
            }, 500);
        });
    });
</script>
