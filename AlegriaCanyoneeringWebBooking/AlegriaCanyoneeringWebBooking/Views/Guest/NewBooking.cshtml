@model AlegriaCanyoneeringWebBooking.ViewModel.GuestListViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Guest Management";
    var batchDetails = ViewBag.BatchDetails ?? new { };
    var serializedBatch = JsonSerializer.Serialize(batchDetails);
    bool isReadonly = ViewBag.IsReadonly ?? false;
}

<!-- Modal -->
<div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="feedbackModalLabel">Notification</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- The message from TempData will be inserted here -->
                <p id="modalMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Ok</button>
            </div>
        </div>
    </div>
</div>

<div class="overlay" id="loadingOverlay">
    <div class="spinner"></div>
    <div class="success-message" id="successMessage"></div>
</div>

@if (TempData["ToastMessage"] != null)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055;">
        <div id="toastMessage" class="toast align-items-center text-white bg-@TempData["ToastType"] border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="fas fa-check-circle me-2"></i> @TempData["ToastMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}


<div class="card shadow-lg rounded-4 border-0">
    <div class="card-body p-4">
        <h4 class="text-primary mb-4 fw-semibold border-bottom pb-2 d-flex align-items-center">
            <i class="bi bi-person-plus-fill me-2"></i> Add New Guest
        </h4>


        <!-- Guest Info Header -->
        <div class="mb-3">
            <h5 class="text-primary">
                <i class="fas fa-users me-2"></i>
                Total Guests: <span id="totalGuestsCount">0</span>
            </h5>
        </div>

        <!-- Form for Guest Info -->
        <form asp-action="NewBooking" method="post" id="guestForm" enctype="multipart/form-data" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" id="BatchGuestsJson" name="BatchGuestsJson" value="@Model.BatchGuestsJson" />
            <input type="hidden" id="CurrentBatch" name="batch" value="@ViewBag.CurrentBatch" readonly />
            <input type="hidden" id="MainGuestId" name="id" value="@ViewBag.MainGuestId" />

            <div class="row">
                <!-- Guest Info Section -->
                <div class="col-md-6">
                    <fieldset>
                        <legend>Guest Info</legend>
                      
                        <div class="mb-3">
                            <label asp-for="NewGuest.OperatorId" class="form-label">Operator</label>
                            <select asp-for="NewGuest.OperatorId" asp-items="ViewBag.OperatorList" class="form-select"
                                    id="OperatorInput"
                                    disabled="@(isReadonly ? "disabled" : null)">
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.Fullname" class="form-label">Full Name</label>
                            <input asp-for="NewGuest.Fullname" class="form-control" placeholder="e.g., Juan Dela Cruz" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.Age" class="form-label">Age</label>
                            <input asp-for="NewGuest.Age" type="number" class="form-control" placeholder="e.g., 25" pattern="\d*" inputmode="numeric" />

                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.Gender" class="form-label">Gender</label>
                            <select asp-for="NewGuest.Gender" class="form-select">

                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.ContactNumber" class="form-label">Mobile Number</label>
                            <input asp-for="NewGuest.ContactNumber" type="tel" class="form-control" placeholder="e.g., 09171234567" />
                        </div>
                    </fieldset>
                </div>

                <!-- Nationality & Booking Section -->
                <div class="col-md-6">
                    <fieldset>
                        <legend>Nationality & Booking</legend>
                        <div class="mb-3">
                            <label asp-for="NewGuest.NationalityType" class="form-label">Nationality Type</label>
                            <select asp-for="NewGuest.NationalityType" class="form-select" id="NationalityType">

                                <option value="Local">Local</option>
                                <option value="Foreign">Foreign</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.NationalityId" class="form-label">Nationality</label>
                            <select asp-for="NewGuest.NationalityId" class="form-select" id="NationalityId"></select>
                            <span asp-validation-for="NewGuest.NationalityId" class="text-danger"></span>



                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.Date" class="form-label">Booking Date</label>
                            <input type="date"
                                   name="NewGuest.Date"
                                   class="form-control"
                                   id="BookingDateInput"
                                   value="@Model.Html5BookingDate"
                                   readonly="@(isReadonly ? "readonly" : null)" />
                            <span asp-validation-for="NewGuest.Date" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.ArrivalDate" class="form-label">Arrival Date</label>
                            <input type="date"
                                   name="NewGuest.ArrivalDate"
                                   class="form-control"
                                   id="ArrivalDateInput"
                                   value="@Model.Html5ArrivalDate"
                                   readonly="@(isReadonly ? "readonly" : null)" />
                            <span asp-validation-for="NewGuest.ArrivalDate" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.Area" class="form-label">Tour Area</label>
                            <select asp-for="NewGuest.Area" class="form-select" id="TourAreaInput"
                                    disabled="@(isReadonly ? "disabled" : null)">

                                <option value="Wonder Falls">Wonder Falls</option>
                                <option value="Kanlaob">Kanlaob</option>
                                <option value="Kawasan Exit">Kawasan Exit</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="photoInput" class="form-label fw-semibold text-secondary">Upload Guest Photo</label>
                            <input type="file"
                                   name="Photo"
                                   id="photoInput"
                                   class="form-control"
                                   accept="image/jpeg,image/png,image/webp,image/jpg"
                                   capture="environment"
                                   onchange="validateImage(this)" />
                            <div id="fileError" class="text-danger small mt-1"></div>
                        </div>

                    </fieldset>
                </div>
            </div>

            <!-- Buttons Section -->
            <div class="d-flex justify-content-between mt-4">
                <button id="addGuestBtn" type="button" class="btn btn-primary">Add Guest</button>
                <button type="submit" id="saveBtn" class="btn btn-success" disabled>Save All Guests</button>
            </div>
        </form>

    </div>
</div>
<!-- Add these before your existing scripts -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css">
<!-- Bootstrap Datepicker JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<!-- Add Bootstrap Datepicker -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css">

<script>
 
    function validateImage(input) {
         const file = input.files[0];
         const errorDiv = document.getElementById("fileError");
         errorDiv.textContent = ""; // Clear previous error

         if (!file) return;

         const maxSizeMB = 1; // Set to 1MB
         const maxSizeBytes = maxSizeMB * 1024 * 1024;

         if (file.size > maxSizeBytes) {
             errorDiv.textContent = `The selected image is too large. Maximum allowed size is ${maxSizeMB}MB.`;
             input.value = ""; // Clear the input
         }
     }

    $(function () {
        const $type = $('#NationalityType');
        const $list = $('#NationalityId');
        const $operatorInput = $('#OperatorInput');
        const $tourAreaInput = $('#TourAreaInput');
        const $bookingDateInput = $('#BookingDateInput');
        const $arrivalDateInput = $('#ArrivalDateInput');
        const $batchGuestsJson = $('#BatchGuestsJson');
        const $saveBtn = $('#saveBtn');
        const $totalGuestsCount = $('#totalGuestsCount');
        const $currentBatch = $('#CurrentBatch');

        let foreignNationalitiesCache = null;
        const getNationalitiesUrl = '@Url.Action("GetNationalities", "Guest")';
        const selectedNationalityId = '@Model.NewGuest.NationalityId';

        function updateNationalityIdOptions(choice) {
            $list.empty();
            if (choice === 'Local') {
                // ✅ CHANGED: Use 1 and 2 instead of 1000 and 1001
                $list.append(new Option('Within Cebu Province', '1'));
                $list.append(new Option('Outside Cebu Province', '2'));

                // Set selected value if matches
                if (selectedNationalityId === '1' || selectedNationalityId === '2') {
                    $list.val(selectedNationalityId);
                }
            } else if (choice === 'Foreign') {
                $list.append(new Option('Loading...', ''));
                $.getJSON(getNationalitiesUrl)
                    .done(function (data) {
                        $list.empty();
                        $list.append(new Option('-- Select Nationality --', ''));
                        data.forEach(function (item) {
                            const option = new Option(item.natName, item.id);
                            if (selectedNationalityId === item.id.toString()) option.selected = true;
                            $list.append(option);
                        });
                    })
                    .fail(function () {
                        $list.empty().append(new Option('Error loading', ''));
                    });
            } else {
                $list.append(new Option('-- Select --', ''));
            }
        }

        // Initialize nationalities
        updateNationalityIdOptions($type.val());

        // Debounce for nationality type switch
        let nationalityTypeChangeTimeout;
        $type.on('change', function () {
            clearTimeout(nationalityTypeChangeTimeout);
            nationalityTypeChangeTimeout = setTimeout(() => {
                updateNationalityIdOptions($(this).val());
            }, 250);
        });

        // Apply readonly if set from ViewBag
        const isReadonly = '@((ViewBag.IsReadonly ?? false).ToString().ToLower())' === 'true';
        if (isReadonly) {
            $operatorInput.prop('disabled', true).css({ 'background-color': '#f5f5f5', color: '#888' });
            $tourAreaInput.prop('disabled', true).css({ 'background-color': '#f5f5f5', color: '#888' });
            $bookingDateInput.prop('readonly', true).css({ 'background-color': '#f5f5f5', color: '#888' });
            $arrivalDateInput.prop('readonly', true).css({ 'background-color': '#f5f5f5', color: '#888' });
        }

        // ===============================
        // ✅ LOCAL STORAGE LOGIC START
        // ===============================

        let guestsBatch = JSON.parse(localStorage.getItem('guestsBatch')) || [];

        function updateTotalGuestsDisplay() {
            $totalGuestsCount.text(guestsBatch.length);
            $saveBtn.prop('disabled', guestsBatch.length < 1);
        }

        $('#addGuestBtn').click(function () {
            const guest = {
                OperatorId: parseInt($('[name="NewGuest.OperatorId"]').val()) || null,
                Fullname: $('[name="NewGuest.Fullname"]').val(),
                Age: $('[name="NewGuest.Age"]').val(),
                Gender: $('[name="NewGuest.Gender"]').val(),
                ContactNumber: $('[name="NewGuest.ContactNumber"]').val(),
                NationalityType: $('[name="NewGuest.NationalityType"]').val(),
                // ✅ FIXED: Now uses 1 and 2 for Local nationalities
                NationalityId: parseInt($('[name="NewGuest.NationalityId"]').val()) || null,
                Area: $('[name="NewGuest.Area"]').val(),
                Date: $('[name="NewGuest.Date"]').val(),
                ArrivalDate: $('[name="NewGuest.ArrivalDate"]').val()
            };

            if (!guest.Fullname || !guest.OperatorId || !guest.Age || !guest.Gender ||
                !guest.NationalityType || !guest.NationalityId || !guest.Date || !guest.ArrivalDate || !guest.Area) {
                alert('Please fill in all required fields.');
                return;
            }

            guestsBatch.push(guest);
            localStorage.setItem('guestsBatch', JSON.stringify(guestsBatch));
            updateTotalGuestsDisplay();

            // Lock inputs after adding first guest
            $bookingDateInput.prop('readonly', true).css({ 'background-color': '#f5f5f5', color: '#888' });
            $arrivalDateInput.prop('readonly', true).css({ 'background-color': '#f5f5f5', color: '#888' });
            $operatorInput.prop('disabled', true).css({ 'background-color': '#f5f5f5', color: '#888' });
            $tourAreaInput.prop('disabled', true).css({ 'background-color': '#f5f5f5', color: '#888' });
            $currentBatch.prop('readonly', true).css({ 'background-color': '#f5f5f5', color: '#888' });
        });

        $('#guestForm').on('submit', function () {
            $batchGuestsJson.val(JSON.stringify(guestsBatch));
            localStorage.removeItem('guestsBatch');
        });

        updateTotalGuestsDisplay();

        // Hide overlay after load
        $('#loadingOverlay').fadeOut(300);
    });
</script>
