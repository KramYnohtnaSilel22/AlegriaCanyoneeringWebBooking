@model AlegriaCanyoneeringWebBooking.ViewModel.GuestListViewModel
@{
    ViewData["Title"] = "Guest Management";
}
<div class="overlay" id="loadingOverlay">
    <div class="spinner"></div>
    <div class="success-message" id="successMessage"></div>
</div>

@if (TempData["ToastMessage"] != null)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055;">
        <div id="toastMessage" class="toast align-items-center text-white bg-@TempData["ToastType"] border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="fas fa-check-circle me-2"></i> @TempData["ToastMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

<div class="card shadow-lg rounded-4 border-0">
    <div class="card-body p-4">
        <h4 class=" text-primary mb-4 fw-semibold">Add New Guest</h4>

        <!-- Guest Info Header -->
        <div class="mb-3 ">
            <h5 class="text-primary">
                <i class="fas fa-users me-2"></i>
                Total Guests: <span id="totalGuestsCount">0</span>
            </h5>
        </div>

        <!-- Form for Guest Info -->
        <form asp-action="NewBooking" method="post" id="guestForm">
            <input type="hidden" id="BatchGuestsJson" name="BatchGuestsJson" value="@Model.BatchGuestsJson" />
            <input type="hidden" id="CurrentBatch" name="batch" value="@ViewBag.CurrentBatch" readonly />
            <input type="hidden" id="MainGuestId" name="id" value="@ViewBag.MainGuestId" />


            <div class="row">
                <!-- Guest Info Section -->
                <div class="col-md-6">
                    <fieldset>
                        <legend>Guest Info</legend>
                        <div class="mb-3">
                            <label asp-for="NewGuest.OperatorId" class="form-label">Operator</label>
                            <select asp-for="NewGuest.OperatorId" asp-items="ViewBag.OperatorList" class="form-select" id="OperatorInput"></select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.Fullname" class="form-label">Full Name</label>
                            <input asp-for="NewGuest.Fullname" class="form-control" placeholder="e.g., Juan Dela Cruz" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.Age" class="form-label">Age</label>
                            <input asp-for="NewGuest.Age" type="number" class="form-control" placeholder="e.g., 25" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.Gender" class="form-label">Gender</label>
                            <select asp-for="NewGuest.Gender" class="form-select">
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.ContactNumber" class="form-label">Mobile Number</label>
                            <input asp-for="NewGuest.ContactNumber" type="tel" class="form-control" placeholder="e.g., 09171234567" />
                        </div>
                    </fieldset>
                </div>

                <!-- Nationality & Booking Section -->
                <div class="col-md-6">
                    <fieldset>
                        <legend>Nationality & Booking</legend>
                        <div class="mb-3">
                            <label asp-for="NewGuest.NationalityType" class="form-label">Nationality Type</label>
                            <select asp-for="NewGuest.NationalityType" class="form-select">
                                <option value="Local">Local</option>
                                <option value="Foreign">Foreign</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.NationalityId" class="form-label">Nationality</label>
                            <select asp-for="NewGuest.NationalityId" asp-items="ViewBag.NationalityList" class="form-select"></select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.Date" class="form-label">Booking Date</label>
                            <input asp-for="NewGuest.Date" type="date" class="form-control" id="BookingDateInput" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.ArrivalDate" class="form-label">Arrival Date</label>
                            <input asp-for="NewGuest.ArrivalDate" type="date" class="form-control" id="ArrivalDateInput" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewGuest.Area" class="form-label">Tour Area</label>
                            <select asp-for="NewGuest.Area" class="form-select" id="TourAreaInput">
                                <option value="">Select Area</option>
                                <option value="Wonder Falls">Wonder Falls</option>
                                <option value="Kanlaob">Kanlaob</option>
                                <option value="Kawasan Exit">Kawasan Exit</option>
                            </select>
                        </div>
                    </fieldset>
                </div>
            </div>

            <!-- Buttons Section -->
            <div class="d-flex justify-content-between mt-4">
                <button id="addGuestBtn" type="button" class="btn btn-primary">Add Guest</button>
                <button type="submit" id="saveBtn" class="btn btn-success" disabled>Save All Guests</button>
            </div>
        </form>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<script>
     // Trigger the toast when the page loads and TempData has a message
    $(document).ready(function () {
        // Check if the toast element exists
        var toastElement = document.getElementById('toastMessage');
        if (toastElement) {
            var toast = new bootstrap.Toast(toastElement);
            toast.show(); // Show the toast message
        }
    });
    $(function () {
        const $type = $('#NationalityType');
        const $list = $('#NationalityId');
        const getNationalitiesUrl = '@Url.Action("GetNationalities", "Guest")';

        function updateNationalityIdOptions(choice) {
            $list.empty();
            if (choice === 'Local') {
                $list.append(new Option('Within Cebu Province', 'Within Cebu Province'));
                $list.append(new Option('Outside Cebu Province', 'Outside Cebu Province'));
            } else if (choice === 'Foreign') {
                $list.append(new Option('Loading...', ''));
                $.getJSON(getNationalitiesUrl)
                    .done(function (data) {
                        $list.empty();
                        if (data.length === 0) {
                            $list.append(new Option('No nationalities found', ''));
                        } else {
                            data.forEach(function (name) {
                                $list.append(new Option(name, name));
                            });
                        }
                    })
                    .fail(function () {
                        $list.empty().append(new Option('Error loading', ''));
                    });
            } else {
                $list.append(new Option('-- Select --', ''));
            }
        }

        $type.on('change', function () {
            updateNationalityIdOptions($(this).val());
        });
        if ($type.val()) {
            updateNationalityIdOptions($type.val());
        }
    });

    let guestsBatch = [];
    function updateTotalGuestsDisplay() {
        $('#totalGuestsCount').text(guestsBatch.length);
        $('#saveBtn').prop('disabled', guestsBatch.length === 0);
    }

    $('#addGuestBtn').click(function () {
        const guest = {
            OperatorId: parseInt($('[name="NewGuest.OperatorId"]').val()) || null,
            Fullname: $('[name="NewGuest.Fullname"]').val(),
            Age: $('[name="NewGuest.Age"]').val(),
            Gender: $('[name="NewGuest.Gender"]').val(),
            ContactNumber: $('[name="NewGuest.ContactNumber"]').val(),
            NationalityType: $('[name="NewGuest.NationalityType"]').val(),
            NationalityId: parseInt($('[name="NewGuest.NationalityId"]').val()) || null,
            Area: $('[name="NewGuest.Area"]').val(),
            Date: $('[name="NewGuest.Date"]').val(),
            ArrivalDate: $('[name="NewGuest.ArrivalDate"]').val()
        };

        if (!guest.Fullname || !guest.OperatorId || !guest.Age || !guest.Gender ||
            !guest.NationalityType || !guest.NationalityId || !guest.Date || !guest.ArrivalDate || !guest.Area) {
            alert('Please fill in all required fields.');
            return;
        }
        guestsBatch.push(guest);
        updateTotalGuestsDisplay();
          // Set Batch field to readonly, but DO NOT clear value!

    // Apply readonly to required fields, but don't reset
      $('#BookingDateInput').prop('readonly', true);
      $('#ArrivalDateInput').prop('readonly', true);
      $('#OperatorInput').on('mousedown', function (e) { e.preventDefault(); });
      $('#TourAreaInput').on('mousedown', function (e) { e.preventDefault(); });

      $('#OperatorInput, #TourAreaInput, #BookingDateInput, #ArrivalDateInput').css({
          'background-color': '#f5f5f5',
          'color': '#888'
      });

    $('#CurrentBatch').prop('readonly', true).css({'background-color':'#f5f5f5','color':'#888'});
    $('#CurrentBatch').css({'background-color':'#f5f5f5','color':'#888'});
    });

    $('#guestForm').on('submit', function () {
        $('#BatchGuestsJson').val(JSON.stringify(guestsBatch));
    });

    updateTotalGuestsDisplay();


</script>
