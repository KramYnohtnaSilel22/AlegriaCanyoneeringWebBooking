@model AlegriaCanyoneeringWebBooking.ViewModel.GuestDetailsViewModel

@{
    ViewData["Title"] = "Booking Details";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- Primary Information -->
            <h4 class="fw-bold text-primary border-bottom pb-2 mb-4">
                <i class="fas fa-user-circle me-2"></i> Primary Information
            </h4>

            <!-- Main Guest Info -->
            <div class="card shadow-lg border-0 mb-5 rounded-4 overflow-hidden">
                <div class="card-header text-white d-flex justify-content-between align-items-center rounded-top-4"
                     style="background: linear-gradient(135deg, #007bff, #00c6ff);">
                    <h5 class="mb-0 fw-semibold">Booking Details</h5>
                    <span class="badge
                        @(Model.Guest.BookingStatus == "confirmed" ? "bg-success" :
                          Model.Guest.BookingStatus == "anticipated" ? "bg-warning text-dark" :
                          "bg-info text-dark")
                          text-capitalize fw-semibold px-3 py-2 shadow-sm rounded-pill">
                        @Model.Guest.BookingStatus
                    </span>
                </div>

                <div class="card-body p-4">
                    <h2 class="fw-bold text-dark mb-4">@Model.Guest.Fullname</h2>

                    <div class="row g-3 mb-4">
                        @*   <div class="col-md-6"><strong>Guest ID:</strong> @Model.Guest.GuestId</div> *@
                        <div class="col-md-6"><i class="fas fa-venus-mars me-2 text-muted"></i><strong>Gender:</strong> @Model.Guest.Gender</div>
                        <div class="col-md-6"><i class="fas fa-user-clock me-2 text-muted"></i><strong>Age:</strong> @Model.Guest.Age</div>
                        <div class="col-md-6"><i class="fas fa-phone me-2 text-muted"></i><strong>Contact #:</strong> @Model.Guest.ContactNumber</div>
                        <div class="col-md-6"><i class="fas fa-flag me-2 text-muted"></i><strong>Nationality:</strong> @Model.Guest.NationalityType</div>
                        <div class="col-md-6"><i class="fas fa-passport me-2 text-muted"></i><strong>National Status:</strong> @(Model.Guest.Nationality?.NatName ?? "N/A")</div>
                        @*      <div class="col-md-6"><strong>Operator:</strong> @Model.Guest.OperatorList?.BusinessName</div>
                        <div class="col-md-6"><strong>Booking Date:</strong> @Model.Guest.Date</div> *@
                        <div class="col-md-6"><i class="fas fa-calendar-alt me-2 text-muted"></i><strong>Arrival Date:</strong> @Model.Guest.ArrivalDate</div>
                        @*  <div class="col-md-6"><strong>Month:</strong> @Model.Guest.Month</div>
                        <div class="col-md-6"><strong>Batch:</strong> @Model.Guest.Batch</div>
                        <div class="col-md-6"><strong>No. of Guests:</strong> @Model.Guest.NumberOfGuests</div>
                        <div class="col-md-6"><strong>Short Date:</strong> @Model.Guest.DateShort</div>
                        <div class="col-md-6"><strong>RFID:</strong> @Model.Guest.RFID</div> *@
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Guest.QrCode))
                    {
                        <hr />
                        <div class="text-center mt-4">
                            <h6 class="fw-semibold text-secondary mb-3">QR Code</h6>
                            <img src="@Model.Guest.QrCode" alt="QR code for @Model.Guest.Fullname"
                                 class="img-fluid shadow rounded-3" style="max-width: 200px;" />
                        </div>
                    }
                </div>

                <div class="card-footer bg-white d-flex justify-content-between rounded-bottom-4 p-3">
                    <a asp-action="EditReserve" asp-route-id="@Model.Guest.GuestId"
                       class="btn btn-warning shadow-sm rounded-pill px-4">
                        <i class="fas fa-edit me-2"></i> Edit
                    </a>
                    <a asp-action="reservebooking"
                       class="btn btn-outline-secondary shadow-sm rounded-pill px-4">
                        <i class="fas fa-arrow-left me-2"></i> Back
                    </a>
                </div>
            </div>





            <!-- Companion Information -->
            <h4 class="fw-bold text-secondary border-bottom pb-2 mb-4">
                <i class="fas fa-users me-2"></i> Companion Information (@Model.GuestsInBatch?.Count(g => g.BookingStatus != "canceled"))
            </h4>

            @if (Model.GuestsInBatch != null && Model.GuestsInBatch.Any(g => g.BookingStatus != "canceled"))
            {
                <div class="row g-4">
                    @foreach (var guest in Model.GuestsInBatch.Where(g => g.BookingStatus != "canceled"))
                    {
                        <div class="col-md-6">
                            <div class="card h-100 shadow-sm border-0 rounded-4 hover-shadow transition">
                                <div class="card-body p-4">
                                    <h6 class="fw-bold text-dark mb-1">@guest.Fullname</h6>

                                    <div class="mb-3">
                                        <span class="badge
                                @(guest.BookingStatus == "confirmed" ? "bg-success" :
                                  guest.BookingStatus == "anticipated" ? "bg-warning text-dark" :
                                  "bg-info text-dark")
                                fw-semibold text-capitalize px-3 py-1 rounded-pill shadow-sm">
                                            @guest.BookingStatus
                                        </span>
                                    </div>

                                    <p class="mb-1"><i class="fas fa-user me-2 text-muted"></i><strong>Age:</strong> @guest.Age</p>
                                    <p class="mb-1"><i class="fas fa-venus-mars me-2 text-muted"></i><strong>Gender:</strong> @guest.Gender</p>
                                    <p class="mb-1"><i class="fas fa-flag me-2 text-muted"></i><strong>Nationality:</strong> @guest.NationalityType</p>

                                    <!-- Cancel Guest Button -->
                                    <form asp-action="CancelGuest" asp-controller="Guest" method="post" class="mt-3" onsubmit="return confirm('Are you sure you want to cancel this guest?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="GuestId" value="@guest.GuestId" />
                                        <button type="submit" class="btn btn-danger btn-sm shadow-sm rounded-pill">
                                            <i class="fas fa-user-times me-1"></i> Cancel
                                        </button>
                                    </form>
                                    <a asp-action="NewBooking" asp-route-batch="@Model.Guest.Batch" asp-route-id="@Model.Guest.GuestId"
                                       class="btn btn-success rounded-pill shadow-sm">
                                        <i class="fas fa-user-plus me-1"></i> Add New Guest
                                    </a>


                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info text-center rounded-3 shadow-sm">
                    <i class="fas fa-info-circle me-2"></i>No active companions in this booking.
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <!-- Font Awesome (optional if already in _Layout) -->
    <script src="https://kit.fontawesome.com/a2d0507b9c.js" crossorigin="anonymous"></script>
    <style>
        .hover-shadow:hover {
            transform: translateY(-5px);
            transition: 0.3s ease;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
        }
    </style>
}
