@model AlegriaCanyoneeringWebBooking.ViewModel.BatchBookingViewModel

<section class="container py-5">
    <h2 class="fw-bold mb-3">Booking Details</h2>
    <div class="card mb-4">
        <div class="card-body">
            <h4 class="fw-bold">@Model.MainGuest.Fullname</h4>
            <div><strong>Guest ID:</strong> @Model.MainGuest.GuestId</div>
            <div><strong>Gender:</strong> @Model.MainGuest.Gender</div>
            <div><strong>Age:</strong> @Model.MainGuest.Age</div>
            <div><strong>Contact #:</strong> @Model.MainGuest.ContactNumber</div>
            <div><strong>Nationality:</strong> @Model.MainGuest.NationalityType</div>
            <div><strong>National Status:</strong> @Model.MainGuest.Nationality?.NatName</div>
            <div><strong>Operator:</strong> @Model.MainGuest.OperatorList?.BusinessName</div>
            <div><strong>Booking Date:</strong> @Model.MainGuest.Date</div>
            <div><strong>Arrival Date:</strong> @Model.MainGuest.ArrivalDate</div>
            <div><strong>Month:</strong> @Model.MainGuest.Month</div>
            <div><strong>Batch:</strong> @Model.MainGuest.Batch</div>
            <div><strong>No. of Guests:</strong> @Model.MainGuest.NumberOfGuests</div>
            <div><strong>RFID:</strong> @Model.MainGuest.RFID</div>
            <div><strong>Status:</strong> @Model.MainGuest.BookingStatus</div>
        </div>
    </div>

    <h5 class="mb-2 text-primary">Other Guests in Booking (@Model.OtherGuests.Count)</h5>
    @foreach (var guest in Model.OtherGuests)
    {
        <div class="card mb-2">
            <div class="card-body">
                <h6 class="fw-bold">@guest.Fullname <span class="badge bg-info text-white">@guest.BookingStatus</span></h6>
                <div><strong>Age:</strong> @guest.Age</div>
                <div><strong>Gender:</strong> @guest.Gender</div>
                <div><strong>Nationality:</strong> @guest.NationalityType</div>
                <div><strong>Contact:</strong> @guest.ContactNumber</div>
                <div><strong>Arrival:</strong> @guest.ArrivalDate</div>
            </div>
        </div>
    }
</section>
