@model AlegriaCanyoneeringWebBooking.ViewModel.GuestListViewModel
@{
    ViewData["Title"] = "Reserved Booking";
}
<section class="container py-4">
    <h2 class="fw-bold mb-4">Reserved Booking</h2>
@*     @if (!string.IsNullOrEmpty(Model.BatchQrBase64))
    {
        <div class="mb-4 d-flex align-items-center gap-3">
            <div>
                <strong>Batch QR Code:</strong><br />
                <img src="@Model.BatchQrBase64" alt="Batch QR" style="width:120px;" />
            </div>
        </div>
    } *@
    @if (Model.ReservedGuests != null && Model.ReservedGuests.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Full Name</th>
                        <th>Status</th>
                        <th>Operator</th>
                        <th>Nationality</th>
                        <th>Batch</th>
                        <th>No. Guests</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var guest in Model.ReservedGuests)
                    {
                        var badgeClass = guest.BookingStatus switch
                        {
                            "anticipated" => "info",
                            "reserved" => "success",
                            "confirmed" => "success",
                            _ => "secondary"
                        };
                        <tr>
                            <td class="fw-semibold">@guest.Fullname</td>
                            <td><span class="badge bg-@badgeClass text-uppercase px-2 py-1">@guest.BookingStatus</span></td>
                            <td>@(guest.OperatorList?.BusinessName ?? "N/A")</td>
                            <td>@(guest.Nationality?.NatName ?? "N/A")</td>
                            <td>@guest.Batch</td>
                            <td>
                                @guest.NumberOfGuests
                                @if (guest.NumberOfGuests >= 5)
                                {
                                    <span class="badge bg-warning text-dark ms-1">Group of @guest.NumberOfGuests</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="ReserveDetails" asp-route-id="@guest.GuestId" class="btn btn-light btn-sm border"><i class="fas fa-eye"></i></a>
                                <a asp-action="EditReserve" asp-route-id="@guest.GuestId" class="btn btn-warning btn-sm text-dark border"><i class="fas fa-edit"></i></a>
                                <!-- View QR Button -->
                                <button type="button" class="btn btn-info btn-sm"
                                        onclick="showQrModal('@guest.GuestId')">
                                    <i class="fas fa-qrcode"></i> View QR
                                </button>
                                <form method="post" asp-action="FinalBookingBatch">
                                    <input type="hidden" name="BatchCode" value="@Model.ReservedGuests.First().Batch" />
                                    <button type="submit" class="btn btn-success mb-3">
                                        <i class="fas fa-check"></i> Finalize & Show All Guests
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <i class="fas fa-exclamation-triangle fa-2x text-warning mb-3"></i>
            <p class="lead fw-semibold text-muted">No reserved or confirmed guests yet.</p>
        </div>
    }
</section>

@section Scripts {
    <script>
        function showQrModal(guestId) {
            const modal = new bootstrap.Modal(document.getElementById('qrViewModal-' + guestId));
            modal.show();
        }
    </script>
    <!-- QR View Modal for each guest -->
    @foreach (var guest in Model.ReservedGuests ?? Enumerable.Empty<dynamic>())
    {
        <div class="modal fade" id="qrViewModal-@guest.GuestId" tabindex="-1"
             aria-labelledby="qrViewModalLabel-@guest.GuestId" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content text-center">
                    <div class="modal-header">
                        <h5 class="modal-title">QR Code for @guest.Fullname</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(guest.QRBase64))
                        {
                            <img src="@guest.QRBase64" alt="QR for @guest.Fullname" style="width:180px;height:180px;" />
                        }
                        else
                        {
                            <div class="text-muted">No QR image generated.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
