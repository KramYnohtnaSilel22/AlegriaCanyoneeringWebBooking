@model AlegriaCanyoneeringWebBooking.ViewModel.FinalBookingViewModel

<section class="container py-4">
    <h2 class="fw-bold mb-4 text-success">Final Booking Details</h2>
    <div class="card shadow-sm p-3">
        <h3>@Model.Fullname</h3>
        <p><strong>Status:</strong> @Model.BookingStatus</p>
        <p><strong>Operator:</strong> @Model.OperatorName</p>
        <p><strong>Nationality:</strong> @Model.Nationality</p>
        <p><strong>Batch:</strong> @Model.Batch</p>
        <p><strong>Number of Guests:</strong> @Model.NumberOfGuests</p>
        <p><strong>Booking Date:</strong> @Model.BookingDate</p>
        <p><strong>Arrival Date:</strong> @Model.ArrivalDate</p>
        <p><strong>Contact Number:</strong> @Model.ContactNumber</p>

        @if (!string.IsNullOrEmpty(Model.QRCodeBase64))
        {
            <img src="data:image/png;base64,@Model.QRCodeBase64" alt="QR Code" />
        }

        <a asp-action="List" asp-controller="Guest" class="btn btn-primary mt-3">Back to Guest List</a>
    </div>
</section>
