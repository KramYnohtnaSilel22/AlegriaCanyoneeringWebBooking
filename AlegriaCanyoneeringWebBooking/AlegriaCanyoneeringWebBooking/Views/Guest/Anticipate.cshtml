@model AlegriaCanyoneeringWebBooking.ViewModel.GuestListViewModel

@{
    ViewData["Title"] = "Guest Management";
}

@if (TempData["ToastMessage"] != null)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055;">
        <div id="toastMessage" class="toast align-items-center text-white bg-@TempData["ToastType"] border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="fas fa-check-circle me-2"></i> @TempData["ToastMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}



<div class="container">


    <div class="row g-4">
        <!-- LEFT: Add New Guest -->
        <div class="col-md-5">
            <div class="card shadow-lg rounded-4 border-0">
                <div class="card-body p-4">
                    <h4 class="text-center text-primary mb-4 fw-semibold">Add New Guest</h4>

                    <form asp-action="Anticipate" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.NumberOfGuests" class="form-label fw-medium">Number of Guests</label>
                            <input asp-for="NewGuest.NumberOfGuests" type="number" min="1" class="form-control form-control-lg" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.OperatorId" class="form-label fw-medium">Operator</label>
                            <select asp-for="NewGuest.OperatorId" class="form-select form-select-lg" asp-items="ViewBag.OperatorList">
                            </select>
                            <span asp-validation-for="NewGuest.OperatorId" class="text-danger"></span>
                        </div>


                        <div class="mb-3">
                            <label asp-for="NewGuest.Fullname" class="form-label fw-medium">Guest Name</label>
                            <input asp-for="NewGuest.Fullname" class="form-control form-control-lg" placeholder="Enter Guest Name" />
                            <span asp-validation-for="NewGuest.Fullname" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.Age" class="form-label fw-medium">Age</label>
                            <input asp-for="NewGuest.Age" type="number" class="form-control form-control-lg" placeholder="Enter age" />
                            <span asp-validation-for="NewGuest.Age" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.Gender" class="form-label fw-medium">Gender</label>
                            <select asp-for="NewGuest.Gender" class="form-select form-select-lg">
                          
                                <option>Male</option>
                                <option>Female</option>
                            
                            </select>
                            <span asp-validation-for="NewGuest.Gender" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.ContactNumber" class="form-label fw-medium">Contact #</label>
                            <input asp-for="NewGuest.ContactNumber" type="number" min="1" class="form-control form-control-lg" />
                        </div>


                        <div class="mb-3">
                            <label asp-for="NewGuest.NationalityType" class="form-label fw-medium">Nationality</label>
                            <select asp-for="NewGuest.NationalityType"
                                    class="form-select form-select-lg"
                                    id="NationalityType">
                                <option value="Local">Local</option>
                                <option value="Foreign">Foreign</option>
                            </select>
                            <span asp-validation-for="NewGuest.NationalityType" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.NationalityId" class="form-label fw-medium">Status</label>
                            <select asp-for="NewGuest.NationalityId"
                                    class="form-select form-select-lg"
                                    id="NationalityId">
                                <option value=""></option>
                            </select>
                            <span asp-validation-for="NewGuest.NationalityId" class="text-danger"></span>
                        </div>
                 

                        <div class="mb-3 row g-3">
                            <div class="col">
                                <label asp-for="NewGuest.Date" class="form-label fw-medium">Booking Date</label>
                                <input asp-for="NewGuest.Date" type="date" class="form-control form-control-lg" />
                            </div>
                            <div class="col">
                                <label asp-for="NewGuest.ArrivalDate" class="form-label fw-medium">Arrival Date</label>
                                <input asp-for="NewGuest.ArrivalDate" type="date" class="form-control form-control-lg" />
                            </div>
                        </div>

                 @*        <div class="mb-3 row g-3">
                            <div class="col">
                                <label asp-for="NewGuest.Month" class="form-label fw-medium">Month</label>
                                <input asp-for="NewGuest.Month" type="month" class="form-control form-control-lg" />
                            </div>
                            <div class="col">
                                <label asp-for="NewGuest.DateShort" class="form-label fw-medium">Short Date</label>
                                <input asp-for="NewGuest.DateShort" type="date" class="form-control form-control-lg" />
                            </div>
                        </div>
 *@

                  @*       <div class="mb-3">
                            <label asp-for="NewGuest.RFID" class="form-label fw-medium">RFID</label>
                            <input asp-for="NewGuest.RFID" class="form-control form-control-lg" />
                        </div> *@

                        <div class="mb-3">
                            <label asp-for="NewGuest.Area" class="form-label fw-medium">Area</label>
                            <select asp-for="NewGuest.Area" class="form-select form-select-lg">

                                <option>Wonder Falls</option>
                                <option>Kanlaob</option>
                                <option>Kawasan Exit</option>

                            </select>
                            <span asp-validation-for="NewGuest.Area" class="text-danger"></span>
                        </div>

                        <!-- Hidden Auto Fields -->
                        <input asp-for="NewGuest.Batch" type="hidden" />

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Save Guest</button>
                    </form>
                </div>
            </div>
    
        </div>
        <!-- RIGHT: Reserved Guests -->
        <div class="col-md-7">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white">
                    <h4 class="mb-0 fw-semibold">Saved Guests</h4>
                    <a asp-action="Accept" class="btn btn-success btn-sm">
                        <i class="fas fa-check-circle"></i> View Reserved Bookings
                    </a>
                </div>

                <div class="card-body">
                    @if (Model.ReservedGuests != null && Model.ReservedGuests.Any())
                    {
                        <div class="table-responsive rounded-3" style="max-height: 600px; overflow-y: auto;">
                            <table class="table table-striped table-hover table-bordered align-middle mb-0" style="width: 1100px;">
                                <thead class="table-dark text-center">
                                    <tr>
                                        <th>Actions</th>
                                        <th>ID</th>
                                        <th>Full Name</th>
                                        <th>Age</th>
                                        <th>Gender</th>
                                        <th>Contact #</th>
                                        <th>Nationality</th>
                                        <th>Nat. Status</th>
                                        <th>Operator</th>
                                        <th>Date</th>
                                        <th>Arrival Date</th>
                                        <th>Month</th>
                                        <th>Date Short</th>
                                        <th>Batch</th>
                                        <th>No. Guests</th>
                                        <th>RFID</th>
                                        <th>Area</th>
                                        <th>Status</th>
                                  
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var guest in Model.ReservedGuests)
                                    {
                                       <tr>
                                            <td>
                                                <div class="d-flex flex-wrap gap-1">
                                                    <!-- View Button -->
                                                    <a asp-action="ReserveDetails" asp-route-id="@guest.GuestId" class="btn btn-sm btn-secondary text-white">
                                                        <i class="fas fa-eye me-1"></i> View
                                                    </a>

                                                    <!-- Edit Button -->
                                                    <a asp-action="EditReserve" asp-route-id="@guest.GuestId" class="btn btn-sm btn-warning text-dark">
                                                        <i class="fas fa-edit me-1"></i> Edit
                                                    </a>

                                                    <!-- Submit/Confirm Button (only if anticipated) -->
                                                    @if (guest.BookingStatus == "anticipated")
                                                    {
                                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                            <input type="hidden" name="id" value="@guest.GuestId" />
                                                            <input type="hidden" name="status" value="reserved" />
                                                            <button type="submit" class="btn btn-sm btn-success">
                                                                <i class="fas fa-check me-1"></i> Confirm
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>

                                            <td>@guest.GuestId</td>
                                            <td>@guest.Fullname</td>
                                            <td>@guest.Age</td>
                                            <td>@guest.Gender</td>
                                            <td>@guest.ContactNumber</td>
                                            <td>@guest.NationalityType</td>
                                            <td>@guest.Nationality.NatName</td>
                                            <td>@guest.Operator.BusinessName</td>
                                            <td>@guest.Date</td>
                                            <td>@guest.ArrivalDate</td>
                                            <td>@guest.Month</td>
                                            <td>@guest.DateShort</td>
                                            <td>@guest.Batch</td>
                                            <td>@guest.NumberOfGuests</td>
                                            <td>@guest.RFID</td>
                                            <td>@guest.Area</td>
                                            <td>
                                                        <span class="badge bg-@(guest.BookingStatus == "anticipated" ? "info" :
                       guest.BookingStatus == "reserved" ? "success" :
                           guest.BookingStatus == "confirmed" ? "success" : "secondary")">
                                                                @guest.BookingStatus
                                                    </span>

                                            </td>
                                      
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center shadow-sm rounded-3 py-4 mt-3">
                            <i class="fas fa-exclamation-triangle fa-lg me-2"></i>No Guests Found
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
  

        <script src="~/js/site.js"></script>

@section Scripts {
    <script>
        $(function () {
            const $type = $('#NationalityType');
            const $list = $('#NationalityId');

            $type.on('change', function () {
                const choice = $(this).val();
                $list.empty();

                if (choice === 'Local') {
                  
                    $list.append(new Option('Within Cebu Province', 'Within Cebu Province'));
                    $list.append(new Option('Outside Cebu Province', 'Outside Cebu Province'));
                }
                else if (choice === 'Foreign') {
                    $list.append(new Option('Loading...', ''));
                    $.getJSON('@Url.Action("GetNationalities", "Guest")')
                     .done(function (data) {
                         data.forEach(function (name) {
                             $list.append(new Option(name, name));
                         });
                     })
                     .fail(function () {
                         $list.empty().append(new Option('Error loading', ''));
                     });
                }
                else {
                    $list.append(new Option('-- Select --', ''));
                }
            });
        });
    </script>
}
