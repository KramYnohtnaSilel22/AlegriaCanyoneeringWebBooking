@model AlegriaCanyoneeringWebBooking.ViewModel.GuestListViewModel

@{
    ViewData["Title"] = "Guest Management";
}

@if (TempData["ToastMessage"] != null)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055;">
        <div id="toastMessage" class="toast align-items-center text-white bg-@TempData["ToastType"] border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="fas fa-check-circle me-2"></i> @TempData["ToastMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

<div class="container">
    <div class="row g-4">
        <!-- LEFT: Add New Guest Form -->
        <div class="col-md-5">
            <div class="card shadow-lg rounded-4 border-0">
                <div class="card-body p-4">
                    <h4 class="text-center text-primary mb-4 fw-semibold" id="btnAddGuest">Add New Guest</h4>

                    <form asp-action="Anticipate" method="post" id="guestForm" enctype="multipart/form-data">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                     

                        <div class="mb-3">
                            <label asp-for="NewGuest.OperatorId" class="form-label fw-medium">Operator</label>
                            <select asp-for="NewGuest.OperatorId" class="form-select form-select-lg" asp-items="ViewBag.OperatorList"></select>
                            <span asp-validation-for="NewGuest.OperatorId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.Fullname" class="form-label fw-medium">Guest Name</label>
                            <input asp-for="NewGuest.Fullname" class="form-control form-control-lg" placeholder="Enter Guest Name" />
                            <span asp-validation-for="NewGuest.Fullname" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.Age" class="form-label fw-medium">Age</label>
                            <input asp-for="NewGuest.Age" type="number" class="form-control form-control-lg" placeholder="Enter age" />
                            <span asp-validation-for="NewGuest.Age" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.Gender" class="form-label fw-medium">Gender</label>
                            <select asp-for="NewGuest.Gender" class="form-select form-select-lg">
                                <option>Male</option>
                                <option>Female</option>
                            </select>
                            <span asp-validation-for="NewGuest.Gender" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.ContactNumber" class="form-label fw-medium">Contact #</label>
                            <input asp-for="NewGuest.ContactNumber" type="number" min="1" class="form-control form-control-lg" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.NationalityType" class="form-label fw-medium">Nationality</label>
                            <select asp-for="NewGuest.NationalityType" class="form-select form-select-lg" id="NationalityType">
                                <option value="Local">Local</option>
                                <option value="Foreign">Foreign</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.NationalityId" class="form-label fw-medium">Status</label>
                            <select asp-for="NewGuest.NationalityId" class="form-select form-select-lg" asp-items="ViewBag.NationalityList"></select>
                            <span asp-validation-for="NewGuest.NationalityId" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row g-3">
                            <div class="col">
                                <label asp-for="NewGuest.Date" class="form-label fw-medium">Booking Date</label>
                                <input asp-for="NewGuest.Date" type="date" class="form-control form-control-lg" />
                            </div>
                            <div class="col">
                                <label asp-for="NewGuest.ArrivalDate" class="form-label fw-medium">Arrival Date</label>
                                <input asp-for="NewGuest.ArrivalDate" type="date" class="form-control form-control-lg" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewGuest.Area" class="form-label fw-medium">Area</label>
                            <select asp-for="NewGuest.Area" class="form-select form-select-lg">
                                <option>Wonder Falls</option>
                                <option>Kanlaob</option>
                                <option>Kawasan Exit</option>
                            </select>
                            <span asp-validation-for="NewGuest.Area" class="text-danger"></span>
                        </div>

                        <!-- Hidden Auto Fields -->
                        <input asp-for="NewGuest.Batch" type="hidden" />

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Save Guest</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- RIGHT: Reserved Guests List -->
        <div class="col-md-7">
            <h4 class="text-primary fw-semibold mb-3">Saved Guests</h4>

            @if (Model.ReservedGuests != null && Model.ReservedGuests.Any())
            {
                <div id="savedGuestsSection" class="d-flex flex-column gap-3" style="max-height: 600px; overflow-y: auto;">
                    @foreach (var guest in Model.ReservedGuests)
                    {
                        <div class="card shadow-sm border-0">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h5 class="fw-bold text-primary mb-2">@guest.Fullname</h5>
                                    <span class="badge bg-@(guest.BookingStatus == "anticipated" ? "info" :
                                        guest.BookingStatus == "reserved" ? "success" :
                                        guest.BookingStatus == "confirmed" ? "success" : "secondary")">
                                        @guest.BookingStatus
                                    </span>
                                </div>

                                <div class="row g-2">
                                    <div class="col-md-6"><strong>Age:</strong> @guest.Age</div>
                                    <div class="col-md-6"><strong>Gender:</strong> @guest.Gender</div>
                                    <div class="col-md-6"><strong>Contact #:</strong> @guest.ContactNumber</div>
                                    <div class="col-md-6"><strong>Nationality:</strong> @guest.NationalityType</div>
                                    <div class="col-md-6"><strong>Operator:</strong> @(guest.Operator?.BusinessName ?? "N/A")</div>
                                    <div class="col-md-6"><strong>Status:</strong> @(guest.Nationality?.NatName ?? "N/A")</div>
                                    <div class="col-md-6"><strong>Booking Date:</strong> @guest.Date</div>
                                    <div class="col-md-6"><strong>Arrival Date:</strong> @guest.ArrivalDate</div>
                                    <div class="col-md-6"><strong>Area:</strong> @guest.Area</div>
                                    <div class="col-md-6"><strong>Batch:</strong> @guest.Batch</div>
                                    <div class="col-md-6">
                                        <strong>No. Guests:</strong> @guest.NumberOfGuests
                                        @if (guest.NumberOfGuests >= 5)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Group of @guest.NumberOfGuests guests</span>
                                        }
                                    </div>
                                    <div class="col-md-6"><strong>RFID:</strong> @guest.RFID</div>
                                </div>

                                <div class="mt-3 d-flex gap-2">
                                    <a asp-action="ReserveDetails" asp-route-id="@guest.GuestId" class="btn btn-sm btn-secondary">
                                        <i class="fas fa-eye me-1"></i> View
                                    </a>
                                    <a asp-action="EditReserve" asp-route-id="@guest.GuestId" class="btn btn-sm btn-warning text-dark">
                                        <i class="fas fa-edit me-1"></i> Edit
                                    </a>
                                    @if (guest.BookingStatus == "anticipated")
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@guest.GuestId" />
                                            <input type="hidden" name="status" value="reserved" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="fas fa-check me-1"></i> Confirm
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>

                        @* Show group only once per batch *@
                        @if (guest.NumberOfGuests >= 5 &&
                       guest.GuestId == Model.ReservedGuests
                       .Where(g => g.Batch == guest.Batch)
                       .OrderBy(g => g.GuestId)
                       .Select(g => g.GuestId)
                       .FirstOrDefault())
                        {
                            var relatedGuests = Model.ReservedGuests
                            .Where(g => g.Batch == guest.Batch && g.GuestId != guest.GuestId)
                            .ToList();

                            if (relatedGuests.Any())
                            {
                              @*   <div class="ms-4 mb-3">
                                    <h6>Other guests in this group:</h6>
                                    <ul class="list-group">
                                        @foreach (var relatedGuest in relatedGuests)
                                        {
                                            <li class="list-group-item">
                                                @relatedGuest.Fullname - @relatedGuest.Age years old - @relatedGuest.Gender
                                            </li>
                                        }
                                    </ul>
                                </div> *@
                            }
                        }
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center shadow-sm rounded-3 py-4 mt-3">
                    <i class="fas fa-exclamation-triangle fa-lg me-2"></i>No Guests Found
                </div>
            }
        </div>
    </div>
</div>

<script src="~/js/site.js"></script>
<script>
    window.onload = function () {
        const section = document.getElementById('savedGuestsSection');
        if (section) {
            section.scrollIntoView({ behavior: 'smooth' });
        }
    };
</script>
