@model AlegriaCanyoneeringWebBooking.ViewModel.GuestListViewModel
@{
    ViewData["Title"] = "Saved Batch Leaders";
}

@if (TempData["ToastMessage"] != null)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055;">
        <div id="toastMessage" class="toast align-items-center text-white bg-@TempData["ToastType"] border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="fas fa-check-circle me-2"></i> @TempData["ToastMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

@if (Model.ReservedGuests != null && Model.ReservedGuests.Any())
{
    <h2 class="fw-bold mb-4 text-success">Save Guests</h2>
    <table id="example1" class="table text-truncate">
        <thead class="table-dark">
            <tr>
                @*    <th>Batch</th> *@
                <th>Operator</th>
                <th>Arrival Date</th>
                <th>Total of Guests</th>
                <th>Booking Status</th>
                @*     <th>Full Name</th> *@
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var guest in Model.ReservedGuests)
            {
                <tr>
                    @*       <td>@guest.Batch</td> *@
                    <td>@(guest.OperatorList?.BusinessName ?? "N/A")</td>
                    <td>@guest.ArrivalDate</td>
                    <td>@guest.NumberOfGuests</td>
                    <td>
                        <span class="badge bg-@(guest.BookingStatus == "reserved" ? "success" : "info")">
                            @guest.BookingStatus
                        </span>
                    </td>

                    @*        <td>@guest.Fullname</td> *@
                    <td>
                        <a asp-controller="Reserve" asp-action="ReserveDetails" asp-route-id="@guest.GuestId" class="btn btn-sm btn-primary" title="View">
                            View <i class="fas fa-users me-2"></i>
                        </a>

                  @*       <a asp-action="EditReserve" asp-route-id="@guest.GuestId" class="btn btn-sm btn-warning text-dark" title="Edit">
                            <i class="fas fa-edit"></i>
                        </a> *@
                        @if (guest.BookingStatus == "anticipated")
                        {
                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@guest.GuestId" />
                                <input type="hidden" name="status" value="reserved" />
                                <button type="submit" class="btn btn-sm btn-success" title="Submit">Submit
                                    <i class="fas fa-check"></i>
                                </button>
                            </form>
                        }
                    </td>

                </tr>
            }
        </tbody>
    </table>
}
else
{

    <div class="d-flex flex-column align-items-center justify-content-center py-5">
        <i class="fas fa-exclamation-triangle fa-2x text-warning mb-3"></i>
        <p class="lead fw-semibold text-muted">No save guest.</p>
    </div>
}

 <script>
        // Trigger the toast when the page loads and TempData has a message
    $(document).ready(function () {
        // Check if the toast element exists
        var toastElement = document.getElementById('toastMessage');
        if (toastElement) {
            var toast = new bootstrap.Toast(toastElement);
            toast.show(); // Show the toast message
        }
    });
 </script>