@{
    ViewData["Title"] = "Saved Batch Leaders";

}

<h2 class="fw-bold mb-4 text-primary">
    <i class="bi bi-bookmark-check-fill me-2"></i> Saved Guests
</h2>

<!-- Booking Details Modal -->
<div class="modal fade" id="bookingDetailsModal" tabindex="-1" aria-labelledby="bookingDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="bookingDetailsLabel">
                    <i class="fas fa-clipboard-list me-2"></i> Booking Details
                </h5>
              
            </div>

            <div class="modal-body" id="bookingDetailsBody">
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    Loading...
                </div>
            </div>
        </div>
    </div>
</div>


<table id="guestsTable" class="table table-bordered table-striped">
    <thead class="table-light">
        <tr>
            <th>Operator</th>
            <th>Total Guests</th>
            <th>Arrival Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
</table>

<!-- ✅ Toast Message -->
@if (TempData["ToastMessage"] != null)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055;">
        <div id="toastMessage" class="toast align-items-center text-white bg-@TempData["ToastType"] border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="fas fa-check-circle me-2"></i> @TempData["ToastMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
              const bookingDetailsUrl = '@Url.Action("GetBookingDetails", "Guest")';

        function loadBookingDetails(id) {
            const $body = $('#bookingDetailsBody');
            $body.html(`
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    Loading...
                </div>
            `);

            $.get(`${bookingDetailsUrl}/${id}`)
                .done(function (html) {
                    $body.html(html);
                })
                .fail(function () {
                    $body.html(`<div class="alert alert-danger">Failed to load booking details. Please try again.</div>`);
                });
        }
            const isAdmin = @User.IsInRole("Admin").ToString().ToLower(); // true/false in JS
        $(document).ready(function () {
            $('#guestsTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetGuestsData", "Guest")',
                    type: 'POST'
                },
                columns: [
                    { data: 'operatorName', title: 'Operator' },
                    { data: 'totalGuests', title: 'Total Guests' },
                {
            data: 'arrivalDate',
            title: 'Arrival Date',
            render: function(data) {
                if (!data) return '';
                const d = new Date(data);
                if (isNaN(d.getTime())) return ''; // returns blank if invalid
                const options = { year: 'numeric', month: 'long', day: 'numeric' };
                return d.toLocaleDateString('en-US', options);
            }
        },

                    {
                        data: 'bookingStatus',
                        title: 'Status',
                        render: function (data) {
                            let badge = data === "reserved" ? "success" : "info";
                            return `<span class="badge bg-${badge}">${data}</span>`;
                        }
                    },
                    {
                        data: 'id',
                        title: 'Actions',
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            return `
                              <button type="button" class="btn btn-sm btn-primary me-1"
                onclick="loadBookingDetails(${data})"
                data-bs-toggle="modal" data-bs-target="#bookingDetailsModal">
            <i class="fas fa-eye me-1"></i> View
        </button>
                             ${row.bookingStatus === 'anticipated' && !isAdmin ? `
            <form method="post" action="/Guest/UpdateStatus" style="display:inline">
                <input type="hidden" name="id" value="${data}" />
                <input type="hidden" name="status" value="reserved" />
                <button type="submit" class="btn btn-sm btn-success">Submit</button>
            </form>
        ` : ''}
                            `;
                        }
                    }
                ],
                pageLength: 10,
                lengthMenu: [[10, 20, 30, 50, 100], [10, 20, 30, 50, 100]],
                responsive: true,
                autoWidth: false,
                language: {
                    emptyTable: "No guests found."
                }
            });

            // ✅ Toast Message Handling
            var toastElement = document.getElementById('toastMessage');
            if (toastElement) {
                var toast = new bootstrap.Toast(toastElement);
                toast.show();
            }
        });
    </script>
}
