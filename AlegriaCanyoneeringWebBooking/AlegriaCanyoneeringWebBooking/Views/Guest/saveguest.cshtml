@model AlegriaCanyoneeringWebBooking.ViewModel.GuestListViewModel
@{
    ViewData["Title"] = "Guest List";
}
<h4 class="text-primary fw-semibold mb-3">Saved Guests</h4>
@if (Model.ReservedGuests != null && Model.ReservedGuests.Any())
{
    <div id="savedGuestsSection" class="d-flex flex-column gap-3" style="max-height: 600px; overflow-y: auto;">
        @foreach (var guest in Model.ReservedGuests)
        {
            var badgeClass = guest.BookingStatus switch
            {
                "anticipated" => "info", 
                "reserved" => "success",
                "confirmed" => "success",
                _ => "secondary"
            };
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                       @*  <h5 class="fw-bold text-primary mb-2">@guest.Fullname</h5> *@
                        <span class="badge bg-@badgeClass">@guest.BookingStatus</span>
                    </div>
                    <div class="row g-2">
              @*           <div class="col-md-6"><strong>Age:</strong> @guest.Age</div>
                        <div class="col-md-6"><strong>Gender:</strong> @guest.Gender</div>
                        <div class="col-md-6"><strong>Contact #:</strong> @guest.ContactNumber</div> *@
                       @*  <div class="col-md-6"><strong>Nationality:</strong> @guest.NationalityType</div> *@
                        <div class="col-md-6"><strong>Operator:</strong> @(guest.OperatorList?.BusinessName ?? "N/A")</div>
      @*                   <div class="col-md-6"><strong>Status:</strong> @(guest.Nationality?.NatName ?? "N/A")</div> *@
               @*          <div class="col-md-6"><strong>Booking Date:</strong> @guest.Date</div>
                        <div class="col-md-6"><strong>Arrival Date:</strong> @guest.ArrivalDate</div> *@
              @*           <div class="col-md-6"><strong>Area:</strong> @guest.Area</div> *@
                        <div class="col-md-6"><strong>Batch:</strong> @guest.Batch</div>
                        <div class="col-md-6">
                            <strong>No. Guests:</strong> @guest.NumberOfGuests
                            @if (guest.NumberOfGuests >= 5)
                            {
                                <span class="badge bg-warning text-dark ms-1">Group of @guest.NumberOfGuests guests</span>
                            }
                        </div>
     @*                    <div class="col-md-6"><strong>RFID:</strong> @guest.RFID</div> *@
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <a asp-action="ReserveDetails" asp-route-id="@guest.GuestId" class="btn btn-sm btn-secondary">
                            <i class="fas fa-eye me-1"></i> View
                        </a>
                        <a asp-action="EditReserve" asp-route-id="@guest.GuestId" class="btn btn-sm btn-warning text-dark">
                            <i class="fas fa-edit me-1"></i> Edit
                        </a>
                        @if (guest.BookingStatus == "anticipated")
                        {
                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@guest.GuestId" />
                                <input type="hidden" name="status" value="reserved" />
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="fas fa-check me-1"></i> Submit
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-warning text-center shadow-sm rounded-3 py-4 mt-3">
        <i class="fas fa-exclamation-triangle fa-lg me-2"></i>No save guests
    </div>
}
