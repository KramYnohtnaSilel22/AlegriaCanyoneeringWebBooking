@model AlegriaCanyoneeringWebBooking.ViewModel.GuestDetailsViewModel

@{
    ViewData["Title"] = "Booking Details";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- Page Header -->
            <div class="mb-4">
                <h1 class="h3 fw-bold text-primary">Booking Overview</h1>
                <p class="text-muted">Guest information and booking details.</p>
            </div>

            <!-- Guest Info Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-5">
                <div class="card-header bg-primary text-white rounded-top-4 d-flex justify-content-between align-items-center py-3 px-4">
                    <h5 class="mb-0 fw-semibold">Primary Guest Info</h5>
                    <span class="badge
                        @(Model.Guest.BookingStatus == "anticipated" ? "bg-warning text-dark" :
                        
                          "bg-secondary")
                        text-capitalize px-3 py-2 rounded-pill">
                        @Model.Guest.BookingStatus
                    </span>
                </div>

                <div class="card-body p-4">
                    <h2 class="fw-bold text-dark mb-3">@Model.Guest.Fullname</h2>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <small class="text-muted">Gender</small>
                            <div>@Model.Guest.Gender</div>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">Age</small>
                            <div>@Model.Guest.Age</div>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">Contact Number</small>
                            <div>@Model.Guest.ContactNumber</div>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">Nationality</small>
                            <div>@Model.Guest.NationalityType</div>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">Residency</small>
                            <div>@(Model.Guest.NationalityEntity?.NatName ?? "N/A")</div>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">Arrival Date</small>
                            <div>@Model.Guest.ArrivalDate</div>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="card-footer bg-white d-flex justify-content-between rounded-bottom-4 p-3">
                    <a asp-action="saveguest"
                       class="btn btn-outline-secondary rounded-pill px-4 d-flex align-items-center gap-2"
                       title="Go back to booking list">
                        <i class="fas fa-arrow-left"></i> Back
                    </a>

                    @if (!User.IsInRole("Admin"))
                    {
                        <a asp-controller="Guest"
                           asp-action="NewBooking"
                           asp-route-batch="@Model.Guest.Batch"
                           asp-route-id="@Model.Guest.Id"
                           class="btn btn-primary rounded-pill d-flex align-items-center gap-2"
                           title="Add another guest">
                            <i class="fas fa-user-plus"></i> Add Guest
                        </a>
                    }
                    else
                    {
                        <span class="text-danger fw-bold d-flex align-items-center">
                            <i class="fas fa-ban me-2"></i> Admins only
                        </span>
                    }
                </div>
            </div>


            <!-- Companions Section -->
            <h3 class="fw-bold text-secondary border-bottom pb-2 mb-4 d-flex align-items-center">
                <i class="fas fa-users me-2"></i> Companions
                <span class="text-muted fs-6 ms-2">(@Model.GuestsInBatch?.Count(g => g.BookingStatus != "canceled"))</span>
            </h3>

            @if (Model.GuestsInBatch != null && Model.GuestsInBatch.Any(g => g.BookingStatus != "canceled"))
            {
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table id="companionsTable" class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-center" style="width: 70px;">Action</th>
                                        <th>Full Name</th>
                                        <th>Age</th>
                                        <th>Gender</th>
                                        <th>Nationality</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var guest in Model.GuestsInBatch.Where(g => g.BookingStatus != "canceled"))
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <form asp-action="CancelGuest" asp-controller="Guest" method="post"
                                                      onsubmit="return confirm('Are you sure you want to cancel this guest?');"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="GuestId" value="@guest.Id" />
                                                    <button type="submit"
                                                            class="btn btn-outline-danger btn-sm rounded-circle"
                                                            title="Cancel this companion"
                                                            aria-label="Cancel companion @guest.Fullname">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                            <td>@guest.Fullname</td>
                                            <td>@guest.Age</td>
                                            <td>@guest.Gender</td>
                                            <td>@(guest.NationalityEntity?.NatName ?? "N/A")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center rounded-3 shadow-sm py-4 fs-5">
                    <i class="fas fa-info-circle me-2"></i>
                    No active companions in this booking yet.
                </div>
            }

            <!-- DataTables CSS & JS -->
            <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
            <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
            <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
            <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

            <script>
                $(document).ready(function () {
                    $('#companionsTable').DataTable({
                        responsive: true,
                        pageLength: 5,
                        lengthMenu: [5, 10, 25],
                        columnDefs: [
                            { orderable: false, targets: 0 }
                        ],
                        language: {
                            searchPlaceholder: "Search companion...",
                            search: ""
                        }
                    });
                });
            </script>

            <style>
                /* Table Styling */
                table.dataTable td,
                table.dataTable th {
                    vertical-align: middle;
                }

                /* Buttons */
                .btn-outline-danger:hover {
                    background-color: #dc3545;
                    color: #fff;
                    border-color: #dc3545;
                }

                .btn-outline-danger:focus {
                    box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
                }

                /* Card Enhancement */
                .card {
                    border-radius: 1rem;
                }

                /* Smooth Hover Row Highlight */
                .table-hover tbody tr:hover {
                    background-color: #f1f3f5;
                }
            </style>
