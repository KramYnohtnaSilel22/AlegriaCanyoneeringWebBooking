@model AlegriaCanyoneeringWebBooking.ViewModel.GuestDetailsViewModel

@{
    ViewData["Title"] = "Booking Details";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- Primary Information -->
            <h3 class="fw-bold text-primary border-bottom pb-2 mb-4">
                <i class="fas fa-user-circle me-2"></i> Primary Information
            </h3>

            <!-- Main Guest Info -->
            <div class="card shadow-sm border rounded-4 mb-5">
                <div class="card-header d-flex justify-content-between align-items-center bg-gradient-primary rounded-top-4 py-3 px-4">
                    <h5 class="mb-0 fw-semibold text-white">Booking Details</h5>
                    <span class="badge
                        @(Model.Guest.BookingStatus == "confirmed" ? "bg-success" :
                          Model.Guest.BookingStatus == "anticipated" ? "bg-warning text-dark" :
                          "bg-info text-dark")
                          text-capitalize fw-semibold px-3 py-2 shadow-sm rounded-pill">
                        @Model.Guest.BookingStatus
                    </span>
                </div>

                <div class="card-body p-4">
                    <h2 class="fw-bold text-dark mb-4">@Model.Guest.Fullname</h2>

                    <div class="row g-4 mb-4 fs-6">
                        <div class="col-md-6 d-flex align-items-center">
                            <i class="fas fa-venus-mars text-muted me-2" aria-hidden="true"></i>
                            <strong class="me-1">Gender:</strong> <span>@Model.Guest.Gender</span>
                        </div>
                        <div class="col-md-6 d-flex align-items-center">
                            <i class="fas fa-user-clock text-muted me-2" aria-hidden="true"></i>
                            <strong class="me-1">Age:</strong> <span>@Model.Guest.Age</span>
                        </div>
                        <div class="col-md-6 d-flex align-items-center">
                            <i class="fas fa-phone text-muted me-2" aria-hidden="true"></i>
                            <strong class="me-1">Contact #:</strong> <span>@Model.Guest.ContactNumber</span>
                        </div>
                        <div class="col-md-6 d-flex align-items-center">
                            <i class="fas fa-flag text-muted me-2" aria-hidden="true"></i>
                            <strong class="me-1">Nationality:</strong> <span>@Model.Guest.NationalityType</span>
                        </div>
                        <div class="col-md-6 d-flex align-items-center">
                            <i class="fas fa-passport text-muted me-2" aria-hidden="true"></i>
                            <strong class="me-1">National Status:</strong> <span>@(Model.Guest.NationalityEntity?.NatName ?? "N/A")</span>
                        </div>
                        <div class="col-md-6 d-flex align-items-center">
                            <i class="fas fa-calendar-alt text-muted me-2" aria-hidden="true"></i>
                            <strong class="me-1">Arrival Date:</strong> <span>@Model.Guest.ArrivalDate</span>
                        </div>
                    </div>

           

                <div class="card-footer bg-white d-flex justify-content-between rounded-bottom-4 p-3">
                    <a asp-action="saveguest"
                       class="btn btn-outline-secondary shadow-sm rounded-pill px-4 d-flex align-items-center gap-2"
                       title="Go back to booking list">
                        <i class="fas fa-arrow-left"></i> Back
                    </a>
                        @if (!User.IsInRole("Admin"))
                        {
                            <a asp-controller="Guest"
                               asp-action="NewBooking"
                               asp-route-batch="@Model.Guest.Batch"
                               asp-route-id="@Model.Guest.Id"
                               class="btn btn-primary rounded-pill d-flex align-items-center gap-2"
                               title="Add another guest to this booking">
                                <i class="fas fa-user-plus"></i> Add Guest
                            </a>
                        }
                        else
                        {
                            <span class="text-danger fw-bold">
                                <i class="fas fa-ban me-1"></i> Authorized Only
                            </span>
                        }

                </div>
            </div>

            <h3 class="fw-bold text-secondary border-bottom pb-2 mb-4 d-flex align-items-center">
                <i class="fas fa-users me-2"></i> Companions
                <span class="text-muted fs-6 ms-2">(@Model.GuestsInBatch?.Count(g => g.BookingStatus != "canceled"))</span>
            </h3>

                @if (Model.GuestsInBatch != null && Model.GuestsInBatch.Any(g => g.BookingStatus != "canceled"))
                {
                    <div class="table-responsive">
                        <table id="companionsTable" class="table table-striped table-bordered table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Action</th>
                                    <th>Full Name</th>
                                    <th>Age</th>
                                    <th>Gender</th>
                                    <th>Nationality</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var guest in Model.GuestsInBatch.Where(g => g.BookingStatus != "canceled"))
                                {
                                    <tr>
                                        <td>
                                            <form asp-action="CancelGuest" asp-controller="Guest" method="post"
                                                  onsubmit="return confirm('Are you sure you want to cancel this guest?');"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="GuestId" value="@guest.Id" />
                                                <button type="submit"
                                                        class="btn btn-danger btn-sm rounded-circle"
                                                        title="Cancel this companion"
                                                        aria-label="Cancel companion @guest.Fullname">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                        <td>@guest.Fullname</td>
                                        <td>@guest.Age</td>
                                        <td>@guest.Gender</td>
                                        <td>@(guest.NationalityEntity?.NatName ?? "N/A")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info text-center rounded-3 shadow-sm py-4 fs-5">
                        <i class="fas fa-info-circle me-2"></i>
                        No active companions in this booking yet.
                    </div>
                }

        </div>
    </div>
</div>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <style>
        /* Colors */
        .bg-gradient-primary {
            background: linear-gradient(135deg, #007bff, #00c6ff);
        }

        /* Shadows & Transitions */
        .shadow-sm {
            box-shadow: 0 1px 5px rgba(0, 0, 0, 0.12);
        }

        .hover-shadow:hover {
            transform: translateY(-6px) scale(1.02);
            box-shadow: 0 14px 32px rgba(0, 0, 0, 0.18) !important;
            transition: 0.25s ease;
        }

        .transition-fast {
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        /* Typography */
        h2, h3, h4, h5, h6 {
            letter-spacing: 0.3px;
        }

        /* Button Enhancements */
        .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
        }

            .btn-primary:hover, .btn-primary:focus {
                background-color: #0056b3;
                border-color: #004085;
            }

        .btn-outline-secondary {
            color: #6c757d;
            border-color: #6c757d;
        }

            .btn-outline-secondary:hover, .btn-outline-secondary:focus {
                color: #343a40;
                border-color: #343a40;
                background-color: #e2e6ea;
            }

        /* Badge */
        .badge {
            letter-spacing: 0.5px;
            font-size: 0.85rem;
        }

        /* Card Border Radius */
        .card {
            border-radius: 1.25rem;
        }
    </style>

            <script>
                $(document).ready(function () {
                    $('#companionsTable').DataTable({
                        responsive: true,
                        pageLength: 10,
                        lengthMenu: [5, 10, 25, 50, 100],
                        columnDefs: [
                            { orderable: false, targets: 0 } // disable sorting for Action column
                        ]
                    });
                });
            </script>
