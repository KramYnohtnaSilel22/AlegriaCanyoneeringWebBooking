@model AlegriaCanyoneeringWebBooking.ViewModel.GuestListViewModel

<section class="container py-4">
    <h2 class="fw-bold mb-4 text-success">Final Booking Batch - Finalized Guests</h2>

    @if (Model.ReservedGuests != null && Model.ReservedGuests.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle shadow-sm">
                <thead class="table-success">
                    <tr>
                        <th>Full Name</th>
                        <th>Status</th>
                        <th>Operator</th>
                        <th>Nationality</th>
                        <th>Batch</th>
                        <th>No. Guests</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var guest in Model.ReservedGuests)
                    {
                        <tr>
                            <td>@guest.Fullname</td>
                            <td>
                                <span class="badge bg-success text-uppercase px-2 py-1">
                                    @guest.BookingStatus
                                </span>
                            </td>
                            <td>@(guest.OperatorList?.BusinessName ?? "N/A")</td>
                            <td>@(guest.Nationality?.NatName ?? "N/A")</td>
                            <td>@guest.Batch</td>
                            <td>@guest.NumberOfGuests</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-5">
            <i class="fas fa-info-circle me-2"></i>
            No finalized guests found!
        </div>
    }
</section>
