@using System.Linq
@model AlegriaCanyoneeringWebBooking.ViewModel.GuestListViewModel

@{
    // All batches from Reserve table (every row has BatchCode)
    var allBatches = ViewBag.AllBatches as List<AlegriaCanyoneeringWebBooking.Models.Reserve> ?? new List<AlegriaCanyoneeringWebBooking.Models.Reserve>();
    var batchGuestsDict = Model?.BatchGuests ?? new Dictionary<string, List<AlegriaCanyoneeringWebBooking.Models.Guest>>();
}

<section class="container py-4">
    <h2 class="fw-bold mb-4 text-success">Final Booking Batch - Finalized Guests</h2>
    @if (allBatches.Any())
    {
        <div class="table-responsive mb-4">
            <table class="table table-bordered table-hover align-middle shadow-sm">
                <thead>
                    <tr>
                        <th>Batch</th>
                        <th>Total Guest</th>
                        <th>Operator</th>
                        <th>Arrival Date</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var batch in allBatches)
                    {
                        // Only show if BatchCode exists (which is always non-null for Reserve table)
                        if (!string.IsNullOrEmpty(batch.BatchCode))
                        {
                            var guests = batchGuestsDict.ContainsKey(batch.BatchCode)
                            ? batchGuestsDict[batch.BatchCode] : new List<AlegriaCanyoneeringWebBooking.Models.Guest>();
                            var operatorName = guests.Any() && guests.FirstOrDefault()?.OperatorList != null
                            ? guests.FirstOrDefault().OperatorList.BusinessName
                            : "N/A";
                            <tr>
                                <td>@batch.BatchCode</td>
                                <td>@batch.TotalGuests</td>
                                <td>@operatorName</td>
                                <td>@batch.ArrivalDate</td>
                                <td>
                                    <span class="badge bg-success text-uppercase px-2 py-1">@batch.Status</span>
                                </td>
                                <td>@batch.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#allGuestsModal-@batch.BatchCode">
                                        <i class="fas fa-eye"></i> View Guests
                                    </button>
                                </td>
                            </tr>
                        
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <i class="fas fa-exclamation-triangle fa-2x text-warning mb-3"></i>
            <p class="lead fw-semibold text-muted">No finalized guests found!</p>
        </div>
    }
</section>
