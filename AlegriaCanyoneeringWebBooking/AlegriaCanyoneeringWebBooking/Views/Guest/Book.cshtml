@model AlegriaCanyoneeringWebBooking.Models.Guest
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Book Guest";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Finalize Booking</h4>
                </div>

                <div class="card-body">
                    <form asp-action="Book" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Full Name</label>
                                <p class="form-control-plaintext">@Model.Fullname</p>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Age</label>
                                <p class="form-control-plaintext">@Model.Age</p>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Gender</label>
                                <p class="form-control-plaintext">@Model.Gender</p>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Nationality</label>
                                <p class="form-control-plaintext">@Model.NationalityType</p>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">National Status</label>
                                <p class="form-control-plaintext">@Model.Nationality?.NatName</p>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Operator</label>
                                <p class="form-control-plaintext">@Model.Operator?.BusinessName</p>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Date</label>
                                <p class="form-control-plaintext">@Model.Date?</p>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Arrival Date</label>
                                <p class="form-control-plaintext">@Model.ArrivalDate?</p>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Month</label>
                                <p class="form-control-plaintext">@Model.Month</p>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Batch</label>
                                <p class="form-control-plaintext">@Model.Batch</p>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Guests</label>
                                <p class="form-control-plaintext">@Model.NumberOfGuests</p>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">RFID</label>
                                <p class="form-control-plaintext">@Model.RFID</p>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Status</label>
                                <p class="form-control-plaintext text-capitalize">@Model.BookingStatus</p>
                            </div>

                            <div class="col-md-12 mt-2">
                                <label class="form-label" for="driverIds">Assign Drivers</label>
                                <select class="form-select multi-select" name="driverIds" multiple size="8" id="driverSelect">
                                    @foreach (var driver in ViewBag.DriverList as List<SelectListItem>)
                                    {
                                        <option value="@driver.Value">@driver.Text</option>
                                    }
                                </select>
                                <small class="form-text text-muted">Hold Ctrl (Windows) or Cmd (Mac) to select multiple drivers</small>
                            </div>

                            <div class="col-md-12 mt-2">
                                <label class="form-label" for="guideIds">Assign Guides</label>
                                <select class="form-select multi-select" name="guideIds" multiple size="8" id="guideSelect">
                                    @foreach (var guide in ViewBag.GuideList as List<SelectListItem>)
                                    {
                                        <option value="@guide.Value">@guide.Text</option>
                                    }
                                </select>
                                <small class="form-text text-muted">Hold Ctrl (Windows) or Cmd (Mac) to select multiple guides</small>
                            </div>

                            <!-- Selected Items Display -->
                            <div class="col-md-6 mt-3">
                                <label class="form-label">Selected Drivers:</label>
                                <div id="selectedDrivers" class="selected-items"></div>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="form-label">Selected Guides:</label>
                                <div id="selectedGuides" class="selected-items"></div>
                            </div>

                            <div class="col-md-12 mt-4 d-flex justify-content-between">
                                <a asp-action="Accept" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left"></i> Back to List
                                </a>
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-check-circle"></i> Confirm Booking
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
       .form-control-plaintext {
            border: 1px solid #dee2e6;
            padding: 0.375rem 0.75rem;
            border-radius: 0.375rem;
            background-color: #f8f9fa;
        }

        .multi-select {
            min-height: 200px;
        }

            .multi-select option {
                padding: 8px 12px;
                margin: 2px 0;
                border-radius: 4px;
            }

                .multi-select option:hover {
                    background-color: #e3f2fd;
                }

                .multi-select option:checked {
                    background-color: #2196f3;
                    color: white;
                }

        .selected-items {
            min-height: 40px;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            padding: 10px;
            background-color: #f8f9fa;
        }

        .selected-item {
            display: inline-block;
            background-color: #007bff;
            color: white;
            padding: 4px 8px;
            margin: 2px;
            border-radius: 15px;
            font-size: 0.875rem;
        }

        .remove-item {
            margin-left: 5px;
            cursor: pointer;
            font-weight: bold;
        }

            .remove-item:hover {
                color: #ffcccc;
            }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const driverSelect = document.getElementById('driverSelect');
            const guideSelect = document.getElementById('guideSelect');
            const selectedDriversDiv = document.getElementById('selectedDrivers');
            const selectedGuidesDiv = document.getElementById('selectedGuides');

            function updateSelectedItems(selectElement, displayDiv) {
                const selectedOptions = Array.from(selectElement.selectedOptions);
                displayDiv.innerHTML = '';

                if (selectedOptions.length === 0) {
                    displayDiv.innerHTML = '<em class="text-muted">None selected</em>';
                    return;
                }

                selectedOptions.forEach(option => {
                    const item = document.createElement('span');
                    item.className = 'selected-item';
                    item.innerHTML = `${option.text} <span class="remove-item" data-value="${option.value}">×</span>`;
                    displayDiv.appendChild(item);

                    // Add remove functionality
                    item.querySelector('.remove-item').addEventListener('click', function() {
                        option.selected = false;
                        updateSelectedItems(selectElement, displayDiv);
                    });
                });
            }

            // Update display when selections change
            driverSelect.addEventListener('change', function() {
                updateSelectedItems(this, selectedDriversDiv);
            });

            guideSelect.addEventListener('change', function() {
                updateSelectedItems(this, selectedGuidesDiv);
            });

            // Initialize display
            updateSelectedItems(driverSelect, selectedDriversDiv);
            updateSelectedItems(guideSelect, selectedGuidesDiv);

            // Add double-click to select/deselect
            function addDoubleClickHandler(selectElement, displayDiv) {
                selectElement.addEventListener('dblclick', function(e) {
                    if (e.target.tagName === 'OPTION') {
                        e.target.selected = !e.target.selected;
                        updateSelectedItems(selectElement, displayDiv);
                    }
                });
            }

            addDoubleClickHandler(driverSelect, selectedDriversDiv);
            addDoubleClickHandler(guideSelect, selectedGuidesDiv);
        });
    </script>
}