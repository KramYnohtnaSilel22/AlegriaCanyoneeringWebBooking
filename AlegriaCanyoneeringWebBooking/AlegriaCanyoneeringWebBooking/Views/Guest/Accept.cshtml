@model IEnumerable<AlegriaCanyoneeringWebBooking.Models.Guest>

@{
    ViewData["Title"] = "Reserved Bookings";
}

<div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <h4 class="mb-0">All Reserved Bookings</h4>
            <small class="text-muted">Detailed view of all pending guest reservations</small>
        </div>
        <span class="badge bg-primary rounded-pill p-2 fs-6 mt-2 mt-md-0">
            @Model.Count() Guests Pending
        </span>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table id="bookingsTable" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center">Actions</th>
                            <th>Guest ID</th>
                            <th>Full Name</th>
                            <th>Age</th>
                            <th>Gender</th>
                            <th>Contact #</th>
                            <th>Nationality</th>
                            <th>Nat. Status</th>
                            <th>Business Name</th>
                            <th>Driver</th>
                            <th>Guide</th>
                            <th>RFID</th>
                            <th>Arrival Date</th>
                            <th>Month</th>
                            <th>Batch</th>
                            <th>Area</th>
                            <th>No. of Guests</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            Actions
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a class="dropdown-item" asp-action="Book" asp-route-id="@item.GuestId">
                                                    <i class="bi bi-pencil-square me-2"></i>Booking
                                                </a>
                                                <a class="dropdown-item" asp-action="ScanQR" asp-route-id="@item.GuestId" class="btn btn-secondary btn-sm">
                                                    <i class="fas fa-qrcode"></i> View QR
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="javascript:void(0)"
                                                   onclick="showGuestQRCode(this)"
                                                   data-qr-base64="@item.QRBase64"
                                                   data-guest-name="@item.Fullname">
                                                    <i class="bi bi-qr-code-scan me-2"></i> Show QR Code
                                                </a>
                                            </li>

                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a class="dropdown-item text-danger" href="#">
                                                    <i class="bi bi-trash me-2"></i>Cancel Booking
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>

                                <td>@item.GuestId</td>
                                <td>@item.Fullname</td>
                                <td>@item.Age</td>
                                <td>@item.Gender</td>
                                <td>@item.ContactNumber</td>
                                <td>@item.NationalityType</td>
                                <td>@(item.Nationality?.NatName ?? "N/A")</td>
                                <td>@(item.Operator?.BusinessName ?? "N/A")</td>
                                <td>@(item.Driver?.FName ?? "No Driver")</td>
                                <td>@(item.Guide?.FName ?? "No Guide")</td>
                                <td>@(item.RFID ?? "Not Assigned")</td>
                                <td>@item.ArrivalDate</td>
                                <td>@item.Month</td>
                                <td>@item.Batch</td>
                                <td>@item.Area</td>
                                <td>@item.NumberOfGuests</td>
                                <td>
                                    <span class="badge rounded-pill
                                      @(item.BookingStatus.ToLower() == "confirmed" ? "bg-primary" :
                                        item.BookingStatus.ToLower() == "reserved" ? "bg-success" : "bg-secondary-subtle text-secondary-emphasis")">
                                        @item.BookingStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center p-5">
                <i class="bi bi-calendar-x-fill display-4 text-muted"></i>
                <h4 class="mt-3">No Reserved Bookings</h4>
                <p class="text-muted">When a new guest makes a reservation, it will appear here.</p>
                <a href="@Url.Action("Anticipate", "Guest")" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-lg me-2"></i>Create New Booking
                </a>
            </div>
        }
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="qrModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center">
            <div class="modal-header">
                <h5 class="modal-title" id="qrModalLabel">QR Code</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <img id="qrImage" src="@ViewBag.QRCodeImage" alt="QR Code" class="img-fluid mb-3" />
                <br />
                <a id="downloadQrBtn" class="btn btn-success" style="display:none;>
                    <i class="bi bi-download"></i> Download QR
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .table th {
            white-space: nowrap; /* Prevents headers from wrapping */
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <script>

             function showGuestQRCode(el) {
            var qrBase64 = el.getAttribute("data-qr-base64");
            var guestName = el.getAttribute("data-guest-name");

            // Set QR image in modal
            document.getElementById("qrImage").src = qrBase64;

            // Update modal title
            document.getElementById("qrModalLabel").innerText = guestName + " - QR Code";

            // Set download link
            var downloadBtn = document.getElementById("downloadQrBtn");
            downloadBtn.href = qrBase64;
            downloadBtn.download = guestName + "_QRCode.png";

            // ✅ Make sure the download button is visible after scan
            downloadBtn.style.display = "inline-block";

            // ✅ OPTIONAL: auto-click the download link (forces download)
            // downloadBtn.click();

            // Show modal (Bootstrap 5)
            var modal = new bootstrap.Modal(document.getElementById("qrModal"));
            modal.show();
        }



        // 🔹 This function triggers automatic download
        function autoDownloadQr(base64) {
            const a = document.createElement('a');
            a.href = base64;
            a.download = "GuestQRCode.png";
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }
        $(document).ready(function () {
            $('#bookingsTable').DataTable({
                // Enable the responsive extension
                responsive: true,
                "order": [[12, 'asc']], // Sort by Arrival Date (column index is now 12)
                "columnDefs": [
                    { "orderable": false, "targets": 0 }, // Disable sorting on the Actions column
                    { "searchable": false, "targets": 0 }
                ]
            });
        });
    </script>
}