@{
    ViewData["Title"] = "Dashboard - Alegria Canyoneering";
    var monthLabels = ViewBag.MonthLabels as List<string>;
    var monthlyGuestCounts = ViewBag.MonthlyGuestCounts as List<int>;
    var yearLabels = ViewBag.YearLabels as List<string>;
    var yearlyGuestCounts = ViewBag.YearlyGuestCounts as List<int>;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">Dashboard Overview</h2>
        <div class="text-end">
            <h6 class="text-muted mb-1">Welcome back</h6>
            <h5 class="fw-semibold text-dark">@User.Identity.Name</h5>
        </div>
    </div>

    <!-- Stats Cards - Cleaner Design -->
    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="card-subtitle text-muted mb-2">Guest Today</h6>
                            <h2 class="card-title fw-bold text-primary">@ViewBag.GuestsToday</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                            <i class="fas fa-users text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="card-subtitle text-muted mb-2">Guests This Month</h6>
                            <h2 class="card-title fw-bold text-success">@ViewBag.GuestsThisMonth</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 p-2 rounded">
                            <i class="fas fa-calendar-alt text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="card-subtitle text-muted mb-2">Previous Month</h6>
                            <h2 class="card-title fw-bold text-warning">@ViewBag.GuestsPrevMonth</h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-2 rounded">
                            <i class="fas fa-chart-line text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row g-4">
        <!-- Monthly Guest Trend Chart -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="card-title mb-0 fw-semibold">Monthly Guest Trend</h5>
                </div>
                <div class="card-body">
                    <canvas id="monthlyGuestTrendChart" height="250"></canvas>
                </div>
            </div>
        </div>

        <!-- Yearly Guest Trend Chart -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="card-title mb-0 fw-semibold">Yearly Guest Trend</h5>
                </div>
                <div class="card-body">
                    <canvas id="yearlyGuestTrendChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>


    <style>
        .card {
            transition: transform 0.2s ease-in-out;
        }

            .card:hover {
                transform: translateY(-2px);
            }

        .card-body {
            padding: 1.5rem;
        }

        .card-title {
            font-size: 1.75rem;
            margin-bottom: 0.5rem;
        }

        .card-subtitle {
            font-size: 0.875rem;
            font-weight: 500;
        }
    </style>


    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://kit.fontawesome.com/your-fontawesome-kit.js" crossorigin="anonymous"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Clean minimal chart options
            const chartOptions = {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        padding: 10,
                        cornerRadius: 6
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(0, 0, 0, 0.05)',
                            drawBorder: false
                        },
                        ticks: {
                            color: '#6c757d',
                            font: {
                                size: 11
                            }
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            color: '#6c757d',
                            font: {
                                size: 11
                            }
                        }
                    }
                },
                elements: {
                    point: {
                        radius: 4,
                        hoverRadius: 6,
                        backgroundColor: '#ffffff',
                        borderWidth: 2
                    }
                }
            };

            // Monthly Chart
            const ctxMonth = document.getElementById('monthlyGuestTrendChart').getContext('2d');
            const gradientMonth = ctxMonth.createLinearGradient(0, 0, 0, 300);
            gradientMonth.addColorStop(0, 'rgba(13, 110, 253, 0.2)');
            gradientMonth.addColorStop(1, 'rgba(13, 110, 253, 0.02)');

            new Chart(ctxMonth, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(monthLabels)),
                    datasets: [{
                        label: 'Guests',
                        data: @Html.Raw(Json.Serialize(monthlyGuestCounts)),
                        fill: true,
                        backgroundColor: gradientMonth,
                        borderColor: '#0d6efd',
                        borderWidth: 2,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#0d6efd',
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        tension: 0.4
                    }]
                },
                options: chartOptions
            });

            // Yearly Chart
            const ctxYear = document.getElementById('yearlyGuestTrendChart').getContext('2d');
            const gradientYear = ctxYear.createLinearGradient(0, 0, 0, 300);
            gradientYear.addColorStop(0, 'rgba(32, 201, 151, 0.2)');
            gradientYear.addColorStop(1, 'rgba(32, 201, 151, 0.02)');

            new Chart(ctxYear, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(yearLabels)),
                    datasets: [{
                        label: 'Guests',
                        data: @Html.Raw(Json.Serialize(yearlyGuestCounts)),
                        fill: true,
                        backgroundColor: gradientYear,
                        borderColor: '#20c997',
                        borderWidth: 2,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#20c997',
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        tension: 0.4
                    }]
                },
                options: chartOptions
            });
        });
    </script>
