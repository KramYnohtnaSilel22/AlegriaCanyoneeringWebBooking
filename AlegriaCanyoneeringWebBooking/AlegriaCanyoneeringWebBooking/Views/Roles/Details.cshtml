@model AlegriaCanyoneeringWebBooking.Models.Role

@{
    ViewData["Title"] = "Role Details";
}

<h1>Role Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.RoleId)</dt>
        <dd class="col-sm-10">@Model.RoleId</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Name)</dt>
        <dd class="col-sm-10">@Model.Name</dd>
    </dl>
</div>
<p>
    <a asp-action="Edit" asp-route-id="@Model.RoleId" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</p>
