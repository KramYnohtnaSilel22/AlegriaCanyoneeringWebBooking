@model IEnumerable<AlegriaCanyoneeringWebBooking.Models.Guide>

@{
    ViewData["Title"] = "Tour Guides";
}

<h2>Tour Guides</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add New Guide</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>RFID</th>
            <th>Name</th>
            <th>Contact</th>
            <th>Address</th>
            <th>Nickname</th>
            <th>Image</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Rfid</td>
                <td>@item.FName @item.MName @item.LName</td>
                <td>@item.CNumber</td>
                <td>@item.Address</td>
                <td>@item.Nickname</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.Image))
                    {
                        <img src="@item.Image" alt="Guide" width="60" class="img-thumbnail" />
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.GuideId" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.GuideId" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.GuideId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
