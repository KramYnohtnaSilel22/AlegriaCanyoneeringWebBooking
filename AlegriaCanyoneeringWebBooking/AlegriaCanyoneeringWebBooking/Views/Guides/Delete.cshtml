@model AlegriaCanyoneeringWebBooking.Models.Guide

@{
    ViewData["Title"] = "Delete Guide";
}

<h2>Delete Guide</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this guide?
</div>

<div class="card p-3 mb-3">
    <h4>@Model.FName @Model.MName @Model.LName</h4>
    <p>@Model.CNumber | @Model.Address</p>
    @if (!string.IsNullOrEmpty(Model.Image))
    {
        <img src="@Model.Image" alt="Guide" width="150" class="img-thumbnail" />
    }
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
