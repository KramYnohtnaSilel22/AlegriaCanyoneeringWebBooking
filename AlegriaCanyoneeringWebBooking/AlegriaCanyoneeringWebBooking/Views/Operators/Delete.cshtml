@model AlegriaCanyoneeringWebBooking.Models.Operator

@{
    ViewData["Title"] = "Delete Operator";
}

<h1>Delete Operator</h1>

<h3>Are you sure you want to delete this operator?</h3>
<div>
    <h4>@Model.Name (@Model.Username)</h4>
    <dl class="row">
        <dt class="col-sm-2">Business Name</dt>
        <dd class="col-sm-10">@Model.BusinessName</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.EmailAddress</dd>

        <dt class="col-sm-2">Role</dt>
        <dd class="col-sm-10">@Model.Roles?.Name</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="OperatorId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
