@{
    ViewData["Title"] = "About Us";
    Layout = "Layout_Login";
}
<link href="~/css/about.css" rel="stylesheet" />

<div class="d-flex justify-content-between align-items-start w-100 pt-3 px-4" style="position:relative; z-index:10;">

    @if (User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Operator"))
    {
        <a asp-area="" asp-controller="Dashboard" asp-action="Index"
           class="btn btn-outline-secondary btn-lg rounded-pill px-4 d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    }
    else
    {
        <a href="/Authentication/Login"
           class="btn btn-outline-primary btn-lg rounded-pill px-4 d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-box-arrow-in-right"></i> Login
        </a>
    }

</div>



<div class="container py-5">
    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="fw-bold display-4 mb-3 animate-fade text-dark">
            Transforming Guest Booking — One Click at a Time.
        </h1>
        <p class="text-muted fs-5 w-lg-75 mx-auto animate-fade-slow">
            Simplifying guest management through seamless online booking — designed for operators, made for convenience.
        </p>
    </div>

    <div class="row justify-content-center g-4">
        <!-- The App Section -->
        <div class="col-lg-10">
            <div class="card p-4 animate-rise">
                <div class="card-body">
                    <h4 class="fw-semibold text-secondary mb-3">
                        <i class="bi bi-window me-2 text-primary"></i> What is This App?
                    </h4>
                    <p class="text-muted fs-5 lh-lg">
                        This app focuses on web booking and helps operators manage <strong>New Bookings</strong>,
                        <strong>Reservations</strong>, and <strong>Guest Booked</strong> efficiently.
                        It bridges the gap between operators and guests — allowing easy coordination, faster response,
                        and better guest experience.
                    </p>
                    <div class="alert alert-primary bg-gradient mt-3 mb-0" style="color:black;">
                        <i class="bi bi-lightbulb me-2"></i>
                        <strong >Did You Know?</strong> Over 90% of guests prefer booking online when the process is quick and user-friendly!
                    </div>
                </div>
            </div>
        </div>

        <!-- Mission & Vision -->
        <div class="col-lg-5">
            <div class="card p-4 animate-rise delay-1">
                <div class="card-body">
                    <h4 class="fw-semibold text-secondary mb-3">
                        <i class="bi bi-bullseye me-2 text-danger"></i> Our Mission
                    </h4>
                    <p class="text-muted fs-5 lh-lg">
                        To deliver a seamless and efficient booking system that empowers operators and enhances the guest journey through technology and reliability.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card p-4 animate-rise delay-2">
                <div class="card-body">
                    <h4 class="fw-semibold text-secondary mb-3">
                        <i class="bi bi-eye me-2 text-info"></i> Our Vision
                    </h4>
                    <p class="text-muted fs-5 lh-lg">
                        To be the most trusted web booking solution across the tourism and hospitality industry — connecting guests and operators effortlessly.
                    </p>
                </div>
            </div>
        </div>

        <!-- Testimonial Carousel -->
        <div class="col-lg-10">
            <div class="card p-4 animate-rise delay-3">
                <div class="card-body text-center">
                    <h4 class="fw-semibold text-secondary mb-4">
                        <i class="bi bi-chat-square-quote me-2 text-success"></i> What Our Users Say
                    </h4>
                    <div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner text-center">
                            <div class="carousel-item active">
                                <blockquote class="blockquote">
                                    <p class="fs-5 fst-italic text-muted">“This app streamlined our entire booking process. It’s so intuitive!”</p>
                                    <footer class="blockquote-footer">Jane Santos, <cite title="Company">Sunset Inn</cite></footer>
                                </blockquote>
                            </div>
                            <div class="carousel-item">
                                <blockquote class="blockquote">
                                    <p class="fs-5 fst-italic text-muted">“Our response time improved by 50%. Highly recommended!”</p>
                                    <footer class="blockquote-footer">Carlos D., <cite title="Company">Eco Adventure Tours</cite></footer>
                                </blockquote>
                            </div>
                            <div class="carousel-item">
                                <blockquote class="blockquote">
                                    <p class="fs-5 fst-italic text-muted">“A guest-friendly platform that actually works. Simple and effective.”</p>
                                    <footer class="blockquote-footer">Maria L., <cite title="Company">BlueWave Beach Resort</cite></footer>
                                </blockquote>
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon bg-dark rounded-circle"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon bg-dark rounded-circle"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

    

        <!-- Contact Section -->
        <div class="col-lg-10">
            <div class="card p-4 animate-rise delay-4">
                <div class="card-body">
                    <h4 class="fw-semibold text-secondary mb-3">
                        <i class="bi bi-chat-dots me-2 text-success"></i> Get in Touch
                    </h4>
                    <p class="text-muted fs-5 lh-lg mb-3">
                        Have an idea to make our app even better? We’d love to hear from you!
                    </p>
                    <ul class="list-unstyled fs-5 text-muted">
                        <li><i class="bi bi-envelope me-2 text-success"></i>Email: <a href="mailto:lelis.markanthony@gmail.com" class="text-decoration-none text-dark fw-semibold">lelis.markanthony@gmail.com</a></li>
                        <li>
                            <i class="bi bi-telephone me-2 text-success"></i>
                            Phone:
                            <a href="tel:+6324175154" class="fw-semibold text-decoration-none text-dark">
                                (032) 417-5154
                            </a>
                        </li>
                    </ul>
                    <div class="mt-3">
                        <a href="https://mail.google.com/mail/?view=cm&fs=1&to=lelis.markanthony@gmail.com&su=Inquiry&body=Hello, I would like to get in touch with you."
                           target="_blank"
                           class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm">
                            <i class="bi bi-chat-dots-fill me-2"></i> Let's Talk
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Imprint -->
        <div class="col-lg-10">
            <div class="card p-4 animate-rise delay-4">
                <div class="card-body">
                    <h4 class="fw-semibold text-secondary mb-3">
                        <i class="bi bi-building me-2 text-warning"></i> Imprint
                    </h4>
                    <p class="text-muted fs-5 lh-lg mb-0">
                        Published by <strong>JustClick Integrated Solutions Inc.</strong><br />
                        171 N. Bacalso Avenue, Cebu City<br />
                        Developed by <strong>Dendo Pulgo</strong> and <strong>Darius Cumpio</strong><br />
                        Responsible: <strong>Mark Anthony P. Lelis</strong><br />
                        On behalf of: <strong>Municipality of Alegria, Cebu</strong>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
