@{
    ViewData["Title"] = "About Us";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <h1 class="text-center mb-4 text-primary">About Us</h1>

            <article class="bg-white shadow rounded p-4">
                <section class="mb-4">
                    <h3 class="text-secondary">Our Mission</h3>
                    <p class="fs-5">
                        To provide a seamless and efficient booking system that simplifies guest management while delivering exceptional service through innovation, accuracy, and reliability.
                    </p>
                </section>

                <section>
                    <h3 class="text-secondary">Our Vision</h3>
                    <p class="fs-5">
                        To become the leading digital platform in the tourism and hospitality industry by empowering operators, enhancing guest experiences, and streamlining operations across all levels.
                    </p>
                </section>
            </article>

        </div>
    </div>
</div>
