@model AlegriaCanyoneeringWebBooking.Models.Driver

@{
    ViewData["Title"] = "Driver Details";
}

<h2>Driver Details</h2>

<div class="card p-3">
    <dl class="row">
        <dt class="col-sm-3">Ref ID</dt>
        <dd class="col-sm-9">@Model.RefId</dd>

        <dt class="col-sm-3">Driver Position</dt>
        <dd class="col-sm-9">@Model.DPosition</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.FName @Model.MName @Model.LName</dd>

        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@Model.PNumber</dd>

        <dt class="col-sm-3">Contact</dt>
        <dd class="col-sm-9">@Model.CNumber</dd>

        <dt class="col-sm-3">Address</dt>
        <dd class="col-sm-9">@Model.Address</dd>

        <dt class="col-sm-3">Image</dt>
        <dd class="col-sm-9">
            <img src="@Model.Image" width="150" class="img-thumbnail" />
        </dd>
    </dl>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.DriverId" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</p>
