@model AlegriaCanyoneeringWebBooking.Models.Driver

<h2>Delete Driver</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this driver?
</div>

<div class="card p-3 mb-3">
    <h5>@Model.FName @Model.MName @Model.LName</h5>
    <p>@Model.PNumber | @Model.CNumber</p>
    <p>@Model.Address</p>
    <img src="@Model.Image" width="120" class="img-thumbnail" />
</div>

<!-- IMPORTANT: use asp-action="Delete" (not DeleteConfirmed) -->
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="DriverId" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
