@model AlegriaCanyoneeringWebBooking.Models.Driver

<h2>Edit Driver</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="RefId" class="form-label"></label>
        <input asp-for="RefId" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FName" class="form-label"></label>
        <input asp-for="FName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="MName" class="form-label"></label>
        <input asp-for="MName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="LName" class="form-label"></label>
        <input asp-for="LName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="PNumber" class="form-label"></label>
        <input asp-for="PNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="CNumber" class="form-label"></label>
        <input asp-for="CNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label>Current Image</label><br />
        <img src="@Model.Image" width="120" class="img-thumbnail mb-2" />
        <input type="file" name="imageFile" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
