<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] -  AlegriaCanyoneeringWebBooking </title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.1/css/dataTables.bootstrap5.min.css">

    <!-- Your custom styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Render additional styles from views -->
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm py-3">
            <div class="container">
                <!-- Brand -->
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-area="" asp-controller="Guest" asp-action="Anticipate">
                    <i class="fas fa-hotel fa-lg me-2"></i> AlegriaCanyoneeringWebBooking
                    </a>
                <!-- Toggler for mobile -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Collapsible content -->
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto gap-lg-3">
                        <!-- New Booking -->
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Guest" asp-action="Anticipate">
                                <i class="fas fa-plus-circle me-1"></i>New Booking
                            </a>
                        </li>

                        <!-- Reserve Bookings -->
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Guest" asp-action="Accept">
                                <i class="fas fa-check-circle me-1"></i>Reserve Bookings
                            </a>
                        </li>
                       
                        <!-- Settings Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white fw-semibold" href="#" id="navSettings" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-cogs me-1"></i>Settings
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow rounded" aria-labelledby="navSettings">
                                <li><a class="dropdown-item" asp-controller="Batches" asp-action="Index"><i class="fas fa-layer-group me-2"></i>Batch</a></li>
                                <li><a class="dropdown-item" asp-controller="Guides" asp-action="Index"><i class="fas fa-user-tie me-2"></i>Guide Details</a></li>
                                <li><a class="dropdown-item" asp-controller="Drivers" asp-action="Index"><i class="fas fa-id-badge me-2"></i>Driver Details</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Operators"><i class="fas fa-users-cog me-2"></i>Operators</a></li>
                                <li><a class="dropdown-item" asp-controller="Nationalities" asp-action="Index"><i class="fas fa-flag me-2"></i>Nationality</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Home" asp-action="About">
                                <i class="fas fa-info-circle me-1"></i>About Us
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - AlegriaCanyoneeringWebBooking
        </div>
    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.1/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.1/js/dataTables.bootstrap5.min.js"></script>

    <!-- Your custom scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Validation scripts -->
    <partial name="_ValidationScriptsPartial" />

    <!-- Render additional scripts from views -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>