        @model IEnumerable<AlegriaCanyoneeringWebBooking.ViewModel.TourismReportViewModel>

        @{
            var totalMale = ViewBag.TotalMale ?? 0;
            var totalFemale = ViewBag.TotalFemale ?? 0;
            var totalEnding = ViewBag.TotalEnding ?? 0;
            var currentFilter = ViewBag.Filter as string ?? "daily";
        }

            <link rel="stylesheet" href="~/css/NationalityReport.css" asp-append-version="true" />
        

        <div class="container my-5">
            <div class="text-center mb-4">
                <h2 class="fw-bold">Nationality Report</h2>
            </div>

            <!-- Filter Form -->
            <form method="get" asp-action="Nationality" class="filter-form mx-auto mb-4">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label for="filter" class="form-label">Filter</label>
                        <select id="filter" name="filter" class="form-select">
                            <option value="daily" selected="@("daily" == currentFilter)">Daily</option>
                            <option value="weekly" selected="@("weekly" == currentFilter)">Weekly</option>
                            <option value="monthly" selected="@("monthly" == currentFilter)">Monthly</option>
                            <option value="quarterly" selected="@("quarterly" == currentFilter)">Quarterly</option>
                            <option value="yearly" selected="@("yearly" == currentFilter)">Yearly</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="dateFrom" class="form-label">From</label>
                        <input type="date" id="dateFrom" name="dateFrom" class="form-control" value="@ViewBag.DateFrom" />
                    </div>
                    <div class="col-md-3">
                        <label for="dateTo" class="form-label">To</label>
                        <input type="date" id="dateTo" name="dateTo" class="form-control" value="@ViewBag.DateTo" />
                    </div>
                    <div class="col-md-3 d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-filter"></i> Apply Filter
                        </button>
                    </div>
                </div>
            </form>

            <!-- Municipality Header -->
            <div class="text-center mb-3">
                <h5 class="mb-0">Republic of the Philippines</h5>
                <h6 class="mb-0">Province of Cebu</h6>
                <h6 class="mb-0">Municipality of Alegria</h6>
                <h5 class="fw-bold mt-2">CANYONEERING</h5>
                <p class="text-muted">
                    @DateTime.Parse(ViewBag.DateFrom).ToString("MMMM d, yyyy") -
                    @DateTime.Parse(ViewBag.DateTo).ToString("MMMM d, yyyy")
                </p>
            </div>

            @if (Model.Any())
            {
                <div class="d-flex justify-content-center gap-2 mb-3">
                    <button id="exportExcel" class="btn btn-success">
                        <i class="bi bi-file-earmark-excel"></i> Export Excel
                    </button>
                    <button id="exportPdf" class="btn btn-danger">
                        <i class="bi bi-file-earmark-pdf"></i> Export PDF
                    </button>
                </div>

                <div class="table-responsive nationality-table-wrapper">
                    <table id="nationalityReportTable" class="table table-bordered text-center align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Nationality</th>
                                <th>Male</th>
                                <th>Female</th>
                                <th>Ending Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Label</td>
                                    <td>@item.OtherProvinceMale</td>
                                    <td>@item.OtherProvinceFemale</td>
                                    <td>@(item.OtherProvinceMale + item.OtherProvinceFemale)</td>
                                </tr>
                            }
                            <tr class="fw-bold border-top border-dark">
                                <td>Total</td>
                                <td>@totalMale</td>
                                <td>@totalFemale</td>
                                <td>@totalEnding</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    No guest data found for the specified dates.
                </div>
            }
        </div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.7.0/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>


    <script src="~/js/nationality-report.js" asp-append-version="true"></script>
}
