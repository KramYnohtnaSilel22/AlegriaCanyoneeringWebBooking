@model IEnumerable<AlegriaCanyoneeringWebBooking.ViewModel.TourismReportViewModel>
@{
    var totalMale = ViewBag.TotalMale ?? 0;
    var totalFemale = ViewBag.TotalFemale ?? 0;
    var totalEnding = ViewBag.TotalEnding ?? 0;
    var currentFilter = ViewBag.Filter as string ?? "daily";
}

<h2 class="text-center">Nationality Report</h2>

<!-- Filter Form -->
<form method="get" asp-action="Nationality" class="mb-4 text-center" style="width:700px;margin:auto;">
    <label for="filter">Filter: </label>
    <select id="filter" name="filter" class="form-select d-inline-block w-auto mx-2">
        <option value="daily" selected="@(currentFilter == "daily" ? "selected" : null)">Daily</option>
        <option value="weekly" selected="@(currentFilter == "weekly" ? "selected" : null)">Weekly</option>
        <option value="monthly" selected="@(currentFilter == "monthly" ? "selected" : null)">Monthly</option>
        <option value="quarterly" selected="@(currentFilter == "quarterly" ? "selected" : null)">Quarterly</option>
        <option value="yearly" selected="@(currentFilter == "yearly" ? "selected" : null)">Yearly</option>
    </select>

    <label for="dateFrom">From: </label>
    <input type="date" id="dateFrom" name="dateFrom" value="@ViewBag.DateFrom" class="mx-2" />
    <label for="dateTo">To: </label>
    <input type="date" id="dateTo" name="dateTo" value="@ViewBag.DateTo" class="mx-2" />

    <button type="submit" class="btn btn-primary btn-sm mx-2">Apply</button>
</form>

<h3 class="text-center">
    Republic of the Philippines<br />
    Province of Cebu<br />
    Municipality of Alegria
</h3>
<h4 class="text-center">CANYONERING</h4>
<p class="text-center">
    @DateTime.Parse(ViewBag.DateFrom).ToString("MMMM d, yyyy") -
    @DateTime.Parse(ViewBag.DateTo).ToString("MMMM d, yyyy")
</p>

@if (Model.Any())
{
    <div class="mb-3 text-center" style="width:700px;margin:auto;">
        <button type="button" id="exportExcel" class="btn btn-success btn-sm mx-1">Export Excel</button>
        <button type="button" id="exportPdf" class="btn btn-danger btn-sm mx-1">Export PDF</button>
    </div>

    <div class="table-responsive" style="width:700px;margin:auto;">
        <table id="nationalityReportTable" class="table table-bordered">
            <thead>
                <tr style="background:#eee;">
                    <th>NATIONALITY</th>
                    <th>MALE</th>
                    <th>FEMALE</th>
                    <th>ENDING TOTAL</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Label</td>
                        <td class="text-center">@item.OtherProvinceMale</td>
                        <td class="text-center">@item.OtherProvinceFemale</td>
                        <td class="text-center">@(item.OtherProvinceMale + item.OtherProvinceFemale)</td>
                    </tr>
                }
                <tr style="font-weight:bold;border-top:3px double #000;">
                    <td>TOTAL:</td>
                    <td class="text-center">@totalMale</td>
                    <td class="text-center">@totalFemale</td>
                    <td class="text-center">@totalEnding</td>
                </tr>
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info text-center" style="width:700px;margin:auto;">
        No guest data found for the specified dates.
    </div>
}

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<!-- SheetJS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<!-- jsPDF -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.7.0/jspdf.plugin.autotable.min.js"></script>

<script>
    $(function () {
        // Excel Export
        $("#exportExcel").click(function () {
            var table = document.getElementById('nationalityReportTable');
            var wb = XLSX.utils.table_to_book(table, { sheet: "Nationality Report" });
            XLSX.writeFile(wb, "NationalityReport.xlsx");
        });

        // PDF Export
        $("#exportPdf").click(function () {
            const { jsPDF } = window.jspdf;
            var doc = new jsPDF('l', 'pt', 'a4');
            doc.text("Nationality Report", 40, 40);
            doc.autoTable({ html: "#nationalityReportTable", startY: 60 });
            doc.save("NationalityReport.pdf");
        });

        // Set Date Fields Automatically on Filter Change
        function setDateRange(filter) {
            const today = new Date();
            let start, end;
            switch (filter) {
                case "daily":
                    start = end = today;
                    break;
                case "weekly":
                    const weekDay = today.getDay();
                    start = new Date(today);
                    start.setDate(today.getDate() - weekDay + 1); // Monday as first day
                    end = new Date(start);
                    end.setDate(start.getDate() + 6);
                    break;
                case "monthly":
                    start = new Date(today.getFullYear(), today.getMonth(), 1);
                    end = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                    break;
                case "quarterly":
                    const quarter = Math.floor(today.getMonth() / 3);
                    start = new Date(today.getFullYear(), quarter * 3, 1);
                    end = new Date(today.getFullYear(), quarter * 3 + 3, 0);
                    break;
                case "yearly":
                    start = new Date(today.getFullYear(), 0, 1);
                    end = new Date(today.getFullYear(), 11, 31);
                    break;
            }
            $("#dateFrom").val(start.toISOString().slice(0, 10));
            $("#dateTo").val(end.toISOString().slice(0, 10));
        }

        // On page load: if date fields empty, set range for current filter
        const from = $("#dateFrom").val();
        const to = $("#dateTo").val();
        if (!from || !to) {
            setDateRange($("#filter").val());
        }

        // On filter change, update dates
        $("#filter").on("change", function () {
            setDateRange(this.value);
        });
    });
</script>
