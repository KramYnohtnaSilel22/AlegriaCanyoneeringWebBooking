@model AlegriaCanyoneeringWebBooking.Models.Batch

@{
    ViewData["Title"] = "Delete Batch";
}

<h2>Delete Batch</h2>

<h4>Are you sure you want to delete this batch?</h4>
<hr />

<div class="row">
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-4">Batch ID</dt>
            <dd class="col-sm-8">@Model.BatchId</dd>

            <dt class="col-sm-4">Operator</dt>
            <dd class="col-sm-8">@Model.Operator?.OwnerName</dd>

            <dt class="col-sm-4">Local Guests</dt>
            <dd class="col-sm-8">@Model.NoOfLocalGuest</dd>

            <dt class="col-sm-4">Foreign Guests</dt>
            <dd class="col-sm-8">@Model.NoOfForeignGuest</dd>

            <dt class="col-sm-4">Tour Guides</dt>
            <dd class="col-sm-8">@Model.NoOfTGuide</dd>

            <dt class="col-sm-4">Drivers</dt>
            <dd class="col-sm-8">@Model.NoOfMDriver</dd>

            <dt class="col-sm-4">Total Guests</dt>
            <dd class="col-sm-8">@Model.TotalNoOfGuest</dd>

            <dt class="col-sm-4">Arrival Date</dt>
            <dd class="col-sm-8">@Model.ArrivalDate.ToString("yyyy-MM-dd")</dd>
        </dl>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="BatchId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
