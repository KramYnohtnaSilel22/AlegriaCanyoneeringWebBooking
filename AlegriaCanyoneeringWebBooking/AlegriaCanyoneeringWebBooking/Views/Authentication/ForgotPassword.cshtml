@model AlegriaCanyoneeringWebBooking.ViewModel.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "Layout_Login";
}

<style>
    body {
        background-attachment: fixed;
        font-family: 'Poppins', sans-serif;
    }

    .forgot-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .forgot-card {
        background: #fff;
        border-radius: 1.5rem;
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.15);
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 420px;
        animation: fadeIn 0.6s ease-in-out;
    }

    .forgot-header {
        text-align: center;
        margin-bottom: 1.5rem;
    }

        .forgot-header i {
            font-size: 2.5rem;
            color: #007bff;
            background: rgba(0, 123, 255, 0.1);
            padding: 0.8rem;
            border-radius: 50%;
        }

        .forgot-header h4 {
            font-weight: 700;
            color: #333;
            margin-top: 0.8rem;
        }

        .forgot-header p {
            font-size: 0.9rem;
            color: #666;
        }

    .form-label {
        font-weight: 600;
    }

    .input-group-text {
        background: #f0f2f5;
        border-right: 0;
    }

    .form-control {
        border-left: 0;
        border-radius: 0 0.5rem 0.5rem 0;
        transition: box-shadow 0.2s;
    }

        .form-control:focus {
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }

    .btn-primary {
        background: #007bff;
        border: none;
        border-radius: 50px;
        transition: all 0.3s ease;
        font-weight: 600;
        padding: 0.75rem;
    }

        .btn-primary:hover {
            background: #0069d9;
            transform: translateY(-2px);
            box-shadow: 0 5px 12px rgba(0, 0, 0, 0.15);
        }

    .back-link {
        display: inline-block;
        margin-top: 1rem;
        font-weight: 500;
        color: #007bff;
        text-decoration: none;
        transition: color 0.2s;
    }

        .back-link:hover {
            color: #0056b3;
            text-decoration: underline;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="forgot-container">
    <div class="forgot-card">
        <div class="forgot-header">
            <h4>Forgot Your Password?</h4>
            <p>Enter your email below and we’ll send you a reset link.</p>
        </div>

        <form asp-action="ForgotPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i class="fas fa-paper-plane me-1"></i> Send Reset Link
            </button>
        </form>

        <div class="text-center">
            <a asp-controller="Authentication" asp-action="Login" class="back-link">
                <i class="fas fa-arrow-left me-1"></i> Back to Login
            </a>
        </div>
    </div>
</div>
