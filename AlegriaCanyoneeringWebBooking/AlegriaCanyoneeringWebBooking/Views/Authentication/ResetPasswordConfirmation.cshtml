@{
    ViewData["Title"] = "Password Reset Confirmation";
    Layout = "Layout_Login";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-success text-white rounded-top-4">
                <h4 class="mb-0">
                    <i class="fas fa-check-circle me-2"></i>Password Reset Successful
                </h4>
            </div>

            <div class="card-body p-4 text-center">
                <p class="fs-6 mb-4">
                    Your password has been reset. You may now
                    <a asp-controller="Auth" asp-action="Login" class="fw-bold text-decoration-none">log in</a>
                    with your new password.
                </p>
                <a asp-controller="Authentication" asp-action="Login" class="btn btn-success rounded-pill px-4">
                    <i class="fas fa-sign-in-alt me-1"></i> Go to Login
                </a>
            </div>
        </div>
    </div>
</div>
