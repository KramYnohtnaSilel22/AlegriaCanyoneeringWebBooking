@model AlegriaCanyoneeringWebBooking.ViewModel.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "Layout_Login";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-primary text-white rounded-top-4">
                <h4 class="mb-0"><i class="fas fa-key me-2"></i>Reset Password</h4>
            </div>

            <div class="card-body p-4">
                <form asp-action="ResetPassword" method="post" class="needs-validation" novalidate>
                    @* Hidden values *@
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Token" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="Enter new password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 rounded-pill">
                        <i class="fas fa-sync-alt me-1"></i> Reset Password
                    </button>
                </form>
            </div>

            <div class="card-footer text-center text-muted small">
                Remembered your password?
                <a asp-controller="Authentication" asp-action="Login" class="text-decoration-none">Back to Login</a>
            </div>
        </div>
    </div>
</div>
