@{
    ViewData["Title"] = "Access Denied";
    Layout = "Layout_Login";
}

<div class="container">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-body text-center p-5">
                    <!-- Icon -->
                    <div class="mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="#dc3545" class="bi bi-shield-lock" viewBox="0 0 16 16">
                            <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z" />
                            <path d="M9.5 6.5a1.5 1.5 0 0 1-1 1.415l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99a1.5 1.5 0 1 1 2-1.415z" />
                        </svg>
                    </div>

                    <!-- Heading -->
                    <h1 class="display-4 fw-bold text-danger mb-3">Access Denied</h1>

                    <!-- Message -->
                    <p class="lead text-muted mb-4">
                        You do not have permission to view this resource.
                    </p>

                    <!-- Image -->
                    <div class="mb-4">
                        <img src="~/images/noaccess.png"
                             class="img-fluid rounded"
                             style="max-height:250px; max-width:100%; object-fit:contain"
                             alt="Access Denied" />
                    </div>

                    <!-- Additional Info -->
                    <div class="alert alert-light border" role="alert">
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-2"></i>
                            If you believe this is an error, please contact your administrator.
                        </small>
                    </div>

                    <!-- Action Buttons -->
                    <div class="mt-4 d-flex gap-2 justify-content-center flex-wrap">
                        <a class="btn btn-danger btn-lg px-4" href="@Url.Action("Login", "Authentication")">
                            <i class="bi bi-arrow-left me-2"></i>Back to Login
                        </a>
                       
                    </div>
                </div>
            </div>

            <!-- Footer Text -->
            <div class="text-center mt-4">
                <small class="text-muted">Error Code: 403 - Forbidden</small>
            </div>
        </div>
    </div>
</div>

<style>
    .min-vh-100 {
        min-height: 100vh;
    }

    .card {
        border-radius: 15px;
        transition: transform 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .btn {
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
</style>