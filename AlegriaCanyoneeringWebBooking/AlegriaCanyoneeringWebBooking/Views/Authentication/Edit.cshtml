        @model AlegriaCanyoneeringWebBooking.ViewModel.OperatorUpdateViewModel

        @{
            ViewData["Title"] = "Update";
        }

        <h1 class="mb-4">Update User</h1>

        <form asp-action="Edit" method="post" class="needs-validation" novalidate>
            <input type="hidden" asp-for="OperatorId" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" required />
                    <div class="invalid-feedback">
                        Please provide a valid name.
                    </div>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="BusinessName" class="form-label"></label>
                    <input asp-for="BusinessName" class="form-control" required />
                    <div class="invalid-feedback">
                        Please provide a business name.
                    </div>
                    <span asp-validation-for="BusinessName" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Age" class="form-label"></label>
                    <input asp-for="Age" type="number" min="1" max="120" class="form-control" required />
                    <div class="invalid-feedback">
                        Please enter a valid age between 1 and 120.
                    </div>
                    <span asp-validation-for="Age" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Gender" class="form-label"></label>
                    <select asp-for="Gender" class="form-select" required>
                        <option value="">-- Select Gender --</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                    <div class="invalid-feedback">
                        Please select a gender.
                    </div>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" required />
                    <div class="invalid-feedback">
                        Please enter a username.
                    </div>
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="col-md-8">
                    <label asp-for="EmailAddress" class="form-label"></label>
                    <input asp-for="EmailAddress" type="email" class="form-control" required />
                    <div class="invalid-feedback">
                        Please enter a valid email address.
                    </div>
                    <span asp-validation-for="EmailAddress" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Role</label>
                    <input class="form-control" value="@Model.RoleName" readonly />
                    <input type="hidden" asp-for="RoleId" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary mt-4 px-5">Save</button>
        </form>

        @section Scripts {
            <script>
                (() => {
                    'use strict';
                    const forms = document.querySelectorAll('.needs-validation');
                    Array.from(forms).forEach(form => {
                        form.addEventListener('submit', event => {
                            if (!form.checkValidity()) {
                                event.preventDefault();
                                event.stopPropagation();
                            }
                            form.classList.add('was-validated');
                        }, false);
                    });
                })();
            </script>
        }
