@model AlegriaCanyoneeringWebBooking.ViewModel.OperatorUpdateViewModel

@{
    ViewData["Title"] = "Update User";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white py-3 rounded-top-4">
                    <h4 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Update User</h4>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="OperatorId" />

                        <div class="row g-4">
                            <!-- Name -->
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-semibold"></label>
                                <input asp-for="Name" class="form-control form-control-lg" placeholder="Enter full name" required />
                                <div class="invalid-feedback">Please provide a valid name.</div>
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <!-- Business Name -->
                            <div class="col-md-6">
                                <label asp-for="BusinessName" class="form-label fw-semibold"></label>
                                <input asp-for="BusinessName" class="form-control form-control-lg" placeholder="Enter business name" required />
                                <div class="invalid-feedback">Please provide a business name.</div>
                                <span asp-validation-for="BusinessName" class="text-danger small"></span>
                            </div>

                            <!-- Age -->
                            <div class="col-md-4">
                                <label asp-for="Age" class="form-label fw-semibold"></label>
                                <input asp-for="Age" type="number" min="1" max="120" class="form-control form-control-lg" placeholder="Enter age" required />
                                <div class="invalid-feedback">Please enter a valid age between 1 and 120.</div>
                                <span asp-validation-for="Age" class="text-danger small"></span>
                            </div>

                            <!-- Gender -->
                            <div class="col-md-4">
                                <label asp-for="Gender" class="form-label fw-semibold"></label>
                                <select asp-for="Gender" class="form-select form-select-lg" required>
                                    <option value="">-- Select Gender --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                                <div class="invalid-feedback">Please select a gender.</div>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>

                            <!-- Username -->
                            <div class="col-md-4">
                                <label asp-for="Username" class="form-label fw-semibold"></label>
                                <input asp-for="Username" class="form-control form-control-lg" placeholder="Enter username" required />
                                <div class="invalid-feedback">Please enter a username.</div>
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-8">
                                <label asp-for="EmailAddress" class="form-label fw-semibold"></label>
                                <input asp-for="EmailAddress" type="email" class="form-control form-control-lg" placeholder="Enter email address" required />
                                <div class="invalid-feedback">Please enter a valid email address.</div>
                                <span asp-validation-for="EmailAddress" class="text-danger small"></span>
                            </div>

                            <!-- Role -->
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Role</label>
                                <input class="form-control form-control-lg bg-light" value="@Model.RoleName" readonly />
                                <input type="hidden" asp-for="RoleId" />
                            </div>
                        </div>

                        <div class="text-end mt-5">
                            <button type="submit" class="btn btn-primary btn-lg px-5">
                                <i class="bi bi-save2 me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}
