@{
    ViewData["Title"] = "Booked Guest";
    var startDate = Context.Request.Query["startDate"].FirstOrDefault();
    var endDate = Context.Request.Query["endDate"].FirstOrDefault();
}

<div class="container my-4">

    <!-- Page Title and Guest of the Day Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark m-0">📋 Booked Guest</h2>
        <button id="btnViewGuestOfDay" class="btn btn-outline-primary">
            <i class="fas fa-star me-1"></i> Guest of the Day
        </button>
    </div>

    <!-- Date Range Filter Form -->
    <form id="filterForm" class="row row-cols-1 row-cols-md-auto g-3 align-items-end mb-4">
        <div>
            <label for="startDate" class="form-label fw-semibold">Start Date</label>
            <input type="date" class="form-control" id="startDate" name="startDate" value="@startDate" required />
        </div>
        <div>
            <label for="endDate" class="form-label fw-semibold">End Date</label>
            <input type="date" class="form-control" id="endDate" name="endDate" value="@endDate" required />
        </div>
        <div>
            <label class="form-label invisible">Search</label>
            <button type="submit" class="btn btn-success w-100">
                <i class="fas fa-search me-1"></i> Search
            </button>
        </div>
    </form>

    <!-- Table Container -->
    <div id="batchesTableContainer" class="card shadow-sm border-0" style="display: none;">
        <div class="card-body">
            <div class="table-responsive">
                <table id="batchesTable" class="table table-hover align-middle w-100">
                    <thead class="table-light">
                        <tr>
                            <th>Batch</th>
                            <th>Total Guests</th>
                            <th>Operator</th>
                            <th>Arrival Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div id="emptyState" class="text-center text-muted py-4" style="display: none;">
                <i class="fas fa-user-slash fa-2x mb-2"></i>
                <p class="mb-0">No guest batches found for the selected range.</p>
            </div>
        </div>
    </div>

    <!-- Modal Container -->
    <div id="guestDetailsModalContainer"></div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = null;

            // Guest of the Day button
            $('#btnViewGuestOfDay').on('click', function () {
                const modalContainer = $('#guestDetailsModalContainer');
                modalContainer.html('<div class="text-center my-4"><div class="spinner-border text-primary" role="status"></div></div>');

                $.get('@Url.Action("GetGuestOfTheDay", "Reserve")')
                    .done(function (html) {
                        modalContainer.html(html);
                        var modalElement = document.getElementById('guestDetailsModal');
                        var guestModal = new bootstrap.Modal(modalElement, {
                            backdrop: 'static',
                            keyboard: true
                        });
                        guestModal.show();

                        modalElement.addEventListener('hidden.bs.modal', function () {
                            modalContainer.empty();
                        });
                    })
                    .fail(function () {
                        alert('Failed to load guest of the day.');
                    });
            });

            // Filter form submit handler
            $('#filterForm').on('submit', function (e) {
                e.preventDefault();

                const startDate = $('#startDate').val();
                const endDate = $('#endDate').val();

                if (!startDate || !endDate) {
                    alert('Please select both start and end dates.');
                    return;
                }

                // Destroy existing DataTable if exists
                if ($.fn.DataTable.isDataTable('#batchesTable')) {
                    table.destroy();
                    $('#batchesTable').empty().append(`
                        <thead class="table-light">
                            <tr>
                                <th>Batch</th>
                                <th>Total Guests</th>
                                <th>Operator</th>
                                <th>Arrival Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                    `);
                }

                // Initialize DataTable
                table = $('#batchesTable').DataTable({
                    processing: true,
                    serverSide: true,
                    ajax: {
                        url: '@Url.Action("GetGuestsData", "Reserve")',
                        type: 'POST',
                        data: { startDate, endDate },
                        dataSrc: function (json) {
                            if (json.data && json.data.length > 0) {
                                $('#batchesTableContainer').show();
                                $('#emptyState').hide();
                            } else {
                                $('#batchesTableContainer').show();
                                $('#emptyState').show();
                            }
                            return json.data;
                        }
                    },
                    columns: [
                        { data: 'batchCode', title: 'Batch' },
                        { data: 'totalGuests', title: 'Total Guests' },
                        {
                            data: 'operatorName',
                            title: 'Operator',
                            render: function (data) {
                                return data?.trim()?.length > 0 ? data : '<span class="text-muted">N/A</span>';
                            }
                        },
                        {
                            data: 'arrivalDate',
                            title: 'Arrival Date',
                            render: function (data) {
                                return data || '';
                            }
                        },
                        {
                            data: 'status',
                            title: 'Status',
                            render: function (data) {
                                if (!data) return '';
                                let badgeClass = 'secondary';
                                switch (data.toLowerCase()) {
                                    case 'confirmed': badgeClass = 'success'; break;
                                    case 'anticipated': badgeClass = 'info'; break;
                                    case 'cancelled': badgeClass = 'danger'; break;
                                }
                                return `<span class="badge bg-${badgeClass} text-uppercase">${data}</span>`;
                            }
                        },
                        {
                            data: 'batchCode',
                            title: 'Actions',
                            orderable: false,
                            searchable: false,
                            render: function (data) {
                                return `
                                    <button type="button" class="btn btn-outline-primary btn-sm view-guest-details" data-batch="${data}">
                                        <i class="fas fa-eye me-1"></i> View
                                    </button>`;
                            }
                        }
                    ],
                    pageLength: 10,
                    lengthMenu: [[10, 20, 50], [10, 20, 50]],
                    responsive: true,
                    autoWidth: false,
                    language: {
                        emptyTable: "No guest batches found."
                    }
                });
            });

            // View Guests by Batch - Modal
            $('#batchesTableContainer').on('click', '.view-guest-details', function () {
                var batchCode = $(this).data('batch');
                const modalContainer = $('#guestDetailsModalContainer');
                modalContainer.html('<div class="text-center my-4"><div class="spinner-border text-primary" role="status"></div></div>');

                $.get('@Url.Action("GetGuestsByBatch", "Reserve")', { batchCode: batchCode })
                    .done(function (html) {
                        modalContainer.html(html);
                        var modalElement = document.getElementById('guestDetailsModal');
                        var guestModal = new bootstrap.Modal(modalElement, {
                            backdrop: 'static',
                            keyboard: true
                        });
                        guestModal.show();

                        modalElement.addEventListener('hidden.bs.modal', function () {
                            modalContainer.empty();
                        });
                    })
                    .fail(function () {
                        alert('Failed to load guest details.');
                    });
            });
        });
    </script>
}
