@using System.Linq
@model AlegriaCanyoneeringWebBooking.ViewModel.GuestListViewModel

@{
    // All batches from Reserve table (every row has BatchCode)
    var allBatches = ViewBag.AllBatches as List<AlegriaCanyoneeringWebBooking.Models.Reserve> ?? new List<AlegriaCanyoneeringWebBooking.Models.Reserve>();
    var batchGuestsDict = Model?.BatchGuests ?? new Dictionary<string, List<AlegriaCanyoneeringWebBooking.Models.Guest>>();
}

<section class="container py-4">
    <h2 class="fw-bold mb-4 text-success">Final Booking</h2>
    <!-- Filter Section -->

    <div class="col-md-6 mb-3">
            <label for="sortFilter" class="form-label">Sort by Date:</label>
            <select id="sortFilter" class="form-select" onchange="BookingfilterByDate()">
                <option value="all">All</option>
                <option value="latest">Latest</option>
                <option value="oldest">Oldest</option>
            </select>
        </div>
    @if (allBatches.Any())
    {
        <div class="table-responsive">
            <table id="example1" class="table text-truncate">
                <thead class="table-dark" >
                    <tr>
                        <th>Batch</th>
                        <th>Total Guest</th>
                        <th>Operator</th>
                        <th>Arrival Date</th>
                        <th>Status</th>

                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody id="BookingTableBody">
                    @foreach (var batch in allBatches)
                    {
                        // Only show if BatchCode exists (which is always non-null for Reserve table)
                        if (!string.IsNullOrEmpty(batch.BatchCode))
                        {
                            var guests = batchGuestsDict.ContainsKey(batch.BatchCode)
                            ? batchGuestsDict[batch.BatchCode] : new List<AlegriaCanyoneeringWebBooking.Models.Guest>();
                            var operatorName = guests.Any() && guests.FirstOrDefault()?.OperatorList != null
                            ? guests.FirstOrDefault().OperatorList?.BusinessName
                            : "N/A";

                            <tr>
                                <td>@batch.BatchCode</td>
                                <td>@batch.TotalGuests</td>
                                <td>@operatorName</td>
                                <td>@batch.ArrivalDate</td>
                                <td>
                                    <span class="badge bg-primary text-uppercase px-2 py-1">@batch.Status</span>
                                </td>

                                <td class="text-center">
                                    <button type="button"
                                            class="btn btn-primary btn-sm d-inline-flex align-items-center rounded-pill shadow-sm px-3 py-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#allGuestsModal-@batch.BatchCode">
                                        View
                                        <i class="fas fa-users me-2"></i>
                                    </button>

                                </td>
                            </tr>

                        }
                    }
                </tbody>

            </table>
            @foreach (var batch in allBatches)
            {
                if (!string.IsNullOrEmpty(batch.BatchCode) && batchGuestsDict.ContainsKey(batch.BatchCode))
                {
                    var guests = batchGuestsDict[batch.BatchCode];
                    <div class="modal fade" id="allGuestsModal-@batch.BatchCode" tabindex="-1" aria-labelledby="guestModalLabel-@batch.BatchCode" aria-hidden="true">
                        <div class="modal-dialog modal-lg modal-dialog-scrollable">
                            <div class="modal-content">
                                <div class="modal-header bg-primary text-white">
                                    <h5 class="modal-title">Booking Details - Batch: @batch.BatchCode</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    @if (guests.Any())
                                    {
                                        var primaryGuest = guests.FirstOrDefault();
                                        var companions = guests.Skip(1).ToList();

                                        <!-- Primary Guest Section -->
                                        <h6 class="text-primary mb-3"><i class="fas fa-user"></i> Primary Guest</h6>
                                           <table class="table table-bordered table-striped ">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Operator</th>
                                                    <th>Full Name</th>
                                                    <th>Age</th>
                                                    <th>Contact No.:</th>
                                                    <th>Gender</th>
                                                    <th>Nationality</th>
                                                    <th>Area</th>

                                                    <th>Arrival Date</th>


                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (primaryGuest != null)
                                                {
                                                    <tr class="table-success">

                                                        <td>@(primaryGuest.OperatorList?.BusinessName ?? "N/A")</td>
                                                        <td>@primaryGuest.Fullname</td>
                                                        <td>@primaryGuest.Age</td>
                                                        <td>@primaryGuest.ContactNumber</td>
                                                        <td>@primaryGuest.Gender</td>
                                                        <td>@(primaryGuest.Nationality?.NatName ?? "N/A")</td>
                                                        <td>@primaryGuest.Area</td>
                                                        <td>@primaryGuest.ArrivalDate</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>

                                        <!-- Companion Guests Section -->
                                        @if (companions.Any())
                                        {
                                            <h6 class="text-secondary mt-4 mb-3"><i class="fas fa-users"></i> Companion Guests</h6>
                                            <table class="table table-bordered table-hover">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Full Name</th>
                                                        <th>Age</th>
                                                        <th>Contact No.:</th>
                                                        <th>Gender</th>
                                                        <th>Nationality</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var guest in companions)
                                                    {
                                                        <tr>
                                                            <td>@guest.Fullname</td>

                                                            <td>@guest.Age</td>
                                                            <td>@guest.ContactNumber</td>
                                                            <td>@guest.Gender</td>
                                                            <td>@(guest.Nationality?.NatName ?? "N/A")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                        else
                                        {
                                            <p class="text-muted">No companion guests for this booking.</p>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted">No guests found for this batch.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

        </div>
    }
    else
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <i class="fas fa-exclamation-triangle fa-2x text-warning mb-3"></i>
            <p class="lead fw-semibold text-muted">No finalized guests found!</p>
        </div>
    }
</section>
        <script>
            function BookingfilterByDate() {
                var filter = $('#sortFilter').val();
                var rows = $('#BookingTableBody tr').get();

                rows.sort(function (a, b) {
                    var dateA = new Date($(a).find('td').eq(3).text());
                    var dateB = new Date($(b).find('td').eq(3).text());

                    if (filter === 'latest') {
                        return dateB - dateA;
                    } else if (filter === 'oldest') {
                        return dateA - dateB;
                    } else {
                        return 0; // No sorting for "all"
                    }
                });

                $.each(rows, function (index, row) {
                    $('#BookingTableBody').append(row);
                });
            }
        </script>
