@model List<AlegriaCanyoneeringWebBooking.Models.Guest>

<div class="modal fade" id="guestDetailsModal" tabindex="-1" aria-labelledby="guestDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="guestDetailsModalLabel">
                    Booking Details - Batch: @Model.FirstOrDefault()?.Batch 
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (Model != null && Model.Any())
                {
                    var primaryGuest = Model.First();
                    var companions = Model.Skip(1).ToList();

                    <h6 class="text-primary mb-3"><i class="fas fa-user"></i> Primary Guest</h6>
                    <table class="table table-bordered table-striped">
                        <thead class="table-light">
                            <tr>
                                <th>Operator</th>
                                <th>Full Name</th>
                                <th>Age</th>
                                <th>Contact No.</th>
                                <th>Gender</th>
                                <th>Nationality</th>
                                <th>Area</th>
                                <th>Arrival Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="table-success">
                                <td>@(primaryGuest.OperatorList?.BusinessName ?? "N/A")</td>
                                <td>@primaryGuest.Fullname</td>
                                <td>@primaryGuest.Age</td>
                                <td>@primaryGuest.ContactNumber</td>
                                <td>@primaryGuest.Gender</td>
                                <td>@(primaryGuest.NationalityEntity?.NatName ?? "N/A")</td>
                                <td>@primaryGuest.Area</td>
                                <td>
                                    @{
                                        if (DateTime.TryParse(primaryGuest.ArrivalDate, out var arrivalDt))
                                        {
                                            @arrivalDt.ToString("MMM dd, yyyy")
                                        }
                                        else
                                        {
                                            @primaryGuest.ArrivalDate
                                        }
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    @if (companions.Any())
                    {
                        <h6 class="text-secondary mt-4 mb-3"><i class="fas fa-users"></i> Companion Guests</h6>
                        <table class="table table-bordered table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Full Name</th>
                                    <th>Age</th>
                                    <th>Contact No.</th>
                                    <th>Gender</th>
                                    <th>Nationality</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var guest in companions)
                                {
                                    <tr>
                                        <td>@guest.Fullname</td>
                                        <td>@guest.Age</td>
                                        <td>@guest.ContactNumber</td>
                                        <td>@guest.Gender</td>
                                        <td>@(guest.NationalityEntity?.NatName ?? "N/A")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No companion guests for this booking.</p>
                    }
                }
                else
                {
                    <p class="text-muted">No guests found for this batch.</p>
                }
            </div>
        </div>
    </div>
</div>