@model List<AlegriaCanyoneeringWebBooking.ViewModel.GuestWithOperatorVM>
<link href="/css/GuestDetails.css" rel="stylesheet" />

<div class="modal fade" id="guestDetailsModal" tabindex="-1" aria-labelledby="guestDetailsModalLabel" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="guestDetailsModalLabel">
                    🧾 Guests of the Day - @DateTime.Today.ToString("MMMM dd, yyyy")
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
     
        </div>
            <div class="d-flex justify-content-between align-items-center px-3 py-2 bg-light border-bottom">
                <span class="fw-semibold text-muted">
                    Total Guests: <strong class="text-dark">@Model.Count()</strong>
                </span>
                <div>
                    <button class="btn btn-danger btn-sm" onclick="downloadGuestDetailsPdf()">
                        <i class="fas fa-file-pdf"></i> Download PDF
                    </button>
                    <button class="btn btn-success btn-sm ms-2" onclick="downloadGuestDetailsExcel()">
                        <i class="fas fa-file-excel"></i> Download Excel
                    </button>
                </div>
            </div>


            <!-- Modal Body -->
            <div class="modal-body bg-white text-black" id="guestDetailsContent">

                <!-- Batch Search -->
                <div class="mb-3">
                    <input type="text" id="batchSearchInput" class="form-control" placeholder="Search by Batch..." />
                </div>

                @if (Model != null && Model.Any())
                {
                    var grouped = Model.GroupBy(g => g.Guest.Batch);

                    foreach (var batchGroup in grouped)
                    {
                        var primaryGuestVM = batchGroup.First();
                        var companionsVM = batchGroup.Skip(1).ToList();

                        <div class="card border mb-4">
                            <!-- Header -->
                            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-2 px-3">
                                <div>
                                    <strong>Batch:</strong>
                                    <span class="text-muted">@batchGroup.Key</span>
                                    <small class="ms-3">(Operator: @primaryGuestVM.OperatorName)</small>
                                </div>
                                <span class="text-muted">@primaryGuestVM.Guest.ArrivalDate</span>
                            </div>

                            <!-- Body -->
                            <div class="card-body px-3 py-3">
                                <h6 class="fw-bold mb-3">Primary Guest</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover">
                                        <thead>
                                            <tr class="table-light">
                                                <th>Full Name</th>
                                                <th>Age</th>
                                                <th>Contact</th>
                                                <th>Gender</th>
                                                <th>Nationality</th>
                                                <th>Area</th>
                                                <th>Arrival Date</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>@primaryGuestVM.Guest.Fullname</td>
                                                <td>@primaryGuestVM.Guest.Age</td>
                                                <td>@primaryGuestVM.Guest.ContactNumber</td>
                                                <td>@primaryGuestVM.Guest.Gender</td>
                                                <td>@primaryGuestVM.Guest.NationalityType</td>
                                                <td>@primaryGuestVM.Guest.Area</td>
                                                <td>@primaryGuestVM.Guest.ArrivalDate</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                @if (companionsVM.Any())
                                {
                                    <h6 class="fw-bold mt-4 mb-2">Companion Guests</h6>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover" id="example2">
                                            <thead>
                                                <tr class="table-light">
                                                    <th>Full Name</th>
                                                    <th>Age</th>
                                                    <th>Contact</th>
                                                    <th>Gender</th>
                                                    <th>Nationality Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var vm in companionsVM)
                                                {
                                                    <tr>
                                                        <td>@vm.Guest.Fullname</td>
                                                        <td>@vm.Guest.Age</td>
                                                        <td>@vm.Guest.ContactNumber</td>
                                                        <td>@vm.Guest.Gender</td>
                                                        <td>@(vm.Guest.NationalityEntity?.NatName ?? "N/A")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted">No companions in this batch.</p>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No guest arrivals found today.</p>
                }
            </div>

        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <script>
                        $('#example2').DataTable({
                    paging: false,
                    searching: false,
                    info: false
                });

        </script>
    <script src="~/js/GuestPDF.js" asp-append-version="true" defer></script>
    <script src="~/js/GuestExcel.js" asp-append-version="true" defer></script>
