@model List<AlegriaCanyoneeringWebBooking.ViewModel.GuestWithOperatorVM>

<div class="modal fade" id="guestDetailsModal" tabindex="-1" aria-labelledby="guestDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="guestDetailsModalLabel">
                    🧾 Guests of the Day - @DateTime.Today.ToString("MMMM dd, yyyy")
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- Export / Action Buttons -->
            <div class="d-flex justify-content-between align-items-center px-3 py-2 bg-light border-bottom">
                <span class="fw-semibold text-muted">
                    Total Guests: <strong class="text-dark">@Model.Count()</strong>
                </span>
                <button class="btn btn-danger btn-sm" onclick="downloadGuestDetailsPdf()">
                    <i class="fas fa-file-pdf"></i> Download PDF
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body" id="guestDetailsContent">
                @if (Model != null && Model.Any())
                {
                    var grouped = Model.GroupBy(g => g.Guest.Batch);

                    foreach (var batchGroup in grouped)
                    {
                        var primaryGuestVM = batchGroup.First();
                        var companionsVM = batchGroup.Skip(1).ToList();

                        <div class="card shadow-sm mb-4 border-0">
                            <div class="card-header bg-success text-white d-flex justify-content-between">
                                <div>
                                    <i class="fas fa-users me-2"></i>
                                    <strong>Batch:</strong> @batchGroup.Key
                                    <span class="ms-2 small">(Operator: @primaryGuestVM.OperatorName)</span>
                                </div>
                                <span>@primaryGuestVM.Guest.ArrivalDate</span>
                            </div>

                            <div class="card-body">
                                <h6 class="text-primary mb-3"><i class="fas fa-user"></i> Primary Guest</h6>
                                <table class="table table-bordered table-striped align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Full Name</th>
                                            <th>Age</th>
                                            <th>Contact</th>
                                            <th>Gender</th>
                                            <th>Nationality</th>
                                            <th>Area</th>
                                            <th>Arrival Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr class="table-success">
                                            <td>@primaryGuestVM.Guest.Fullname</td>
                                            <td>@primaryGuestVM.Guest.Age</td>
                                            <td>@primaryGuestVM.Guest.ContactNumber</td>
                                            <td>@primaryGuestVM.Guest.Gender</td>
                                            <td>@(primaryGuestVM.Guest.NationalityEntity?.NatName ?? "N/A")</td>
                                            <td>@primaryGuestVM.Guest.Area</td>
                                            <td>@primaryGuestVM.Guest.ArrivalDate</td>
                                        </tr>
                                    </tbody>
                                </table>

                                @if (companionsVM.Any())
                                {
                                    <h6 class="text-secondary mt-4 mb-2"><i class="fas fa-users"></i> Companion Guests</h6>
                                    <table class="table table-bordered table-hover align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Full Name</th>
                                                <th>Age</th>
                                                <th>Contact</th>
                                                <th>Gender</th>
                                                <th>Nationality</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var vm in companionsVM)
                                            {
                                                <tr>
                                                    <td>@vm.Guest.Fullname</td>
                                                    <td>@vm.Guest.Age</td>
                                                    <td>@vm.Guest.ContactNumber</td>
                                                    <td>@vm.Guest.Gender</td>
                                                    <td>@(vm.Guest.NationalityEntity?.NatName ?? "N/A")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <p class="text-muted">No companions for this batch.</p>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-danger">No guest arrivals found today.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Include jsPDF + html2canvas -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<script>
    async function downloadGuestDetailsPdf() {
        const { jsPDF } = window.jspdf;
        const content = document.getElementById("guestDetailsContent");

        if (!content) return alert("No data available to export.");

        html2canvas(content, { scale: 2, useCORS: true }).then(canvas => {
            const pdf = new jsPDF("p", "mm", "a4");
            const width = pdf.internal.pageSize.getWidth();
            const height = (canvas.height * width) / canvas.width;

            pdf.addImage(canvas.toDataURL("image/png"), "PNG", 0, 0, width, height);
            pdf.save("DailyGuestReport.pdf");
        });
    }
</script>
