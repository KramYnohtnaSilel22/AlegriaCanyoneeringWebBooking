@model AlegriaCanyoneeringWebBooking.ViewModel.GuestListViewModel

@{
    ViewData["Title"] = "Reserved Booking";
}

<section class="container py-4">
    <h2 class="fw-bold mb-4 text-success">Reserved Booking</h2>

    @if (TempData["ToastMessage"] != null)
    {
        <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055;">
            <div class="toast align-items-center text-white bg-@TempData["ToastType"] border-0 show"
                 role="alert" aria-live="assertive" aria-atomic="true" id="toastMessage">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="fas fa-info-circle me-2"></i> @TempData["ToastMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"
                            aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.BatchQrBase64))
    {
        <div class="mb-4 text-center">
            <label class="fw-semibold mb-1">Batch QR Code:</label>
            <br />
            <img id="mainBatchQr" src="@Model.BatchQrBase64" alt="Batch QR Code" style="width:180px;height:180px;" />
            <div class="mt-2 text-muted small">
                Scan this QR to confirm all guests in this batch.
            </div>
            <button type="button" class="btn btn-success mt-2"
                    onclick="downloadBatchQR('mainBatchQr')">
                <i class="fas fa-download"></i> Download Batch QR
            </button>
            <canvas id="batchQrCanvas" width="200" height="200" style="display:none;"></canvas>
        </div>
    }

    <div class="d-flex justify-content-between mb-3">
        <button type="button" class="btn btn-secondary btn-sm" onclick="openGlobalScanner()">
            <i class="fas fa-qrcode"></i> Scan Batch QR
        </button>
    </div>

    @if (Model.GuestGroups != null && Model.GuestGroups.Any())
    {
        <div class="table-responsive">
            <table id="example1" class="table text-truncate">
                <thead class="table-dark">
                    <tr>
                        <th>Operator</th>
                        <th>Arrival Date</th>
                        <th>Status</th>
                        <th>Total Guests</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in Model.GuestGroups)
                    {
                        var badgeClass = group.BookingStatus switch
                        {
                            "anticipated" => "info",
                            "reserved" => "success",
                            _ => "secondary"
                        };

                        <tr>
                            <td>@group.OperatorList?.BusinessName</td>
                            <td>@group.ArrivalDate</td>
                            <td>
                                <span class="badge bg-@badgeClass text-uppercase px-2 py-1">
                                    @group.BookingStatus
                                </span>
                            </td>
                            <td>@group.ActiveGuestCount</td>
                            <td class="text-center">
                                <a asp-controller="Reserve" asp-action="ReserveDetails"
                                   asp-route-operatorId="@group.OperatorId"
                                   asp-route-batch="@group.Batch"
                                   class="btn btn-sm btn-primary">
                                    <i class="fas fa-eye"></i> View Guests
                                </a>
                                <form method="post"
                                      asp-action="FinalBookingBatch"
                                      asp-controller="Reserve"
                                      class="d-inline ms-1">
                                    <input type="hidden" name="BatchCode" value="@group.Batch" />
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="fas fa-check"></i> Confirm
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <i class="fas fa-exclamation-triangle fa-2x text-warning mb-3"></i>
            <p class="lead fw-semibold text-muted">No reserved or confirmed guests yet.</p>
        </div>
    }
</section>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://unpkg.com/html5-qrcode@2.3.7/minified/html5-qrcode.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    let globalScanner = null;
    function openGlobalScanner() {
        const modal = new bootstrap.Modal(document.getElementById('globalQrModal'));
        modal.show();
        if (globalScanner) {
            globalScanner.stop().then(() => {
                globalScanner.clear().then(() => startGlobalScanner());
            });
        } else {
            startGlobalScanner();
        }
    }
    function startGlobalScanner() {
        globalScanner = new Html5Qrcode("globalReader");
        const config = { fps: 10, qrbox: 250 };
        globalScanner.start(
            { facingMode: "environment" },
            config,
            onGlobalScanSuccess,
            (err) => { }
        ).catch(err => console.error("Global scanner failed:", err));
    }
    function onGlobalScanSuccess(decodedText, decodedResult) {
        const batchCode = decodedText;
        if (globalScanner) {
            globalScanner.stop().then(() => {
                globalScanner.clear();
                setTimeout(() => {
                    const forms = document.querySelectorAll(`form input[name="BatchCode"][value="${batchCode}"]`);
                    if (forms.length > 0) {
                        forms.forEach(input => {
                            const form = input.closest("form");
                            if (form) {
                                form.submit();
                            }
                        });
                    } else {
                        alert(`No booking found for batch: ${batchCode}`);
                    }
                    const modal = bootstrap.Modal.getInstance(document.getElementById('globalQrModal'));
                    if (modal) modal.hide();
                }, 500);
            });
        }
    }
    document.addEventListener("DOMContentLoaded", function () {
        var toastElement = document.getElementById('toastMessage');
        if (toastElement) {
            var toast = new bootstrap.Toast(toastElement);
            toast.show();
        }
    });

    // Batch QR download for main QR
    function downloadBatchQR(imgId) {
        var img = document.getElementById(imgId);
        var canvas = document.getElementById("batchQrCanvas");
        var ctx = canvas.getContext("2d");
        ctx.fillStyle = "#fff";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 10, 10, 180, 180);
        var link = document.createElement("a");
        link.download = "BatchQR.png";
        link.href = canvas.toDataURL("image/png");
        link.click();
    }
</script>

<!-- Global QR Scanner Modal -->
<div class="modal fade" id="globalQrModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content text-center">
            <div class="modal-header">
                <h5 class="modal-title">Scan Batch QR Code</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="globalReader" style="width:350px; margin:0 auto;"></div>
                <p class="mt-3 text-muted">Point the camera at a QR code to confirm all guests in the same batch.</p>
            </div>
        </div>
    </div>
</div>
