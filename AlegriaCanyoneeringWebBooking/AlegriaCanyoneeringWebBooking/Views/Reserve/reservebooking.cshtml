@model AlegriaCanyoneeringWebBooking.ViewModel.GuestListViewModel
@{
    ViewData["Title"] = "Reserved Booking";
}
<section class="container py-4">
    <h2 class="fw-bold mb-4 text-success">Reserved Booking</h2>
    @if (TempData["ToastMessage"] != null)
    {
        <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055;">
            <div class="toast align-items-center text-white bg-@TempData["ToastType"] border-0 show" role="alert" aria-live="assertive" aria-atomic="true" id="toastMessage">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="fas fa-info-circle me-2"></i> @TempData["ToastMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }
    @if (Model.ReservedGuests != null && Model.ReservedGuests.Any())
    {
        <div class="table-responsive">
            <table id="example1" class="table text-truncate">
                <thead class="table-dark">
                    <tr>
                        @*    <th>Full Name</th> *@
                        <th>Status</th>
                        <th>Operator</th>
                        <th>Nationality</th>
                        @*    <th>Batch</th> *@

                        <th>Total of Guests</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var guest in Model.ReservedGuests)
                    {
                        var badgeClass = guest.BookingStatus switch
                        {
                            "anticipated" => "info",
                            "reserved" => "success",
                            "confirmed" => "success",
                            _ => "secondary"
                        };
                        <tr>
                            @*        <td class="fw-semibold">@guest.Fullname</td> *@
                            <td>
                                <span class="badge bg-@badgeClass text-uppercase px-2 py-1">
                                    @guest.BookingStatus
                                </span>
                            </td>
                            <td>@(guest.OperatorList?.BusinessName ?? "N/A")</td>
                            <td>@(guest.Nationality?.NatName ?? "N/A")</td>
                            @*     <td>@guest.Batch</td> *@
                            <td>@guest.NumberOfGuests</td>
                            <td class="text-center">
                                <a asp-controller="Reserve" asp-action="ReserveDetails" asp-route-id="@guest.GuestId" class="btn btn-sm btn-primary" title="View">
                                    View <i class="fas fa-users me-2"></i>
                                </a>

                                @*  <a asp-action="EditReserve" asp-route-id="@guest.GuestId" class="btn btn-warning btn-sm text-dark border"><i class="fas fa-edit"></i></a> *@
                                <!-- View QR Button -->
                                <button type="button" class="btn btn-info btn-sm"
                                        onclick="showQrModal('@guest.GuestId')">
                                    <i class="fas fa-qrcode"></i>QR CODE
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <i class="fas fa-exclamation-triangle fa-2x text-warning mb-3"></i>
            <p class="lead fw-semibold text-muted">No reserved or confirmed guests yet.</p>
        </div>
    }
</section>
@section Scripts {
    <script>
        function showQrModal(guestId) {
            const modal = new bootstrap.Modal(document.getElementById('qrViewModal-' + guestId));
            modal.show();
        }
    </script>
    <!-- QR View Modal for each guest, now includes CONFIRM button inside -->
    @foreach (var guest in Model.ReservedGuests ?? Enumerable.Empty<dynamic>())
    {
        <div class="modal fade" id="qrViewModal-@guest.GuestId" tabindex="-1"
             aria-labelledby="qrViewModalLabel-@guest.GuestId" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content text-center">
                    <div class="modal-header">
                        <h6 class="modal-title">
                            Operator: @(guest.OperatorList?.BusinessName ?? "N/A")
                        </h6>
                        <h6 class="modal-title">
                            Total Guests: @guest.NumberOfGuests
                        </h6>

                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(guest.QRBase64))
                        {
                            <div>
                                <img src="@guest.QRBase64" alt="QR for @guest.Fullname" style="width:180px;height:180px;" />
                                <a href="@Url.Action("DownloadQRCode", "Guest", new { base64Image = guest.QRBase64, fileName = "QR_Code_" + guest.Fullname + ".png" })" class="btn btn-primary mt-2">
                                    <i class="fas fa-download"></i> Download QR Code
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">No QR image generated.</div>
                        }
                        <form method="post" asp-action="FinalBookingBatch" asp-controller="Reserve" class="mt-3">
                            <input type="hidden" name="BatchCode" value="@guest.Batch" />
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-check"></i> Confirm
                            </button>
                        </form>
                    </div>


                </div>
            </div>
        </div>
    }
}


<script>
    $(document).ready(function () {
        var toastElement = document.getElementById('toastMessage');
        if (toastElement) {
            var toast = new bootstrap.Toast(toastElement);
            toast.show();
        }
    });
</script>