@model AlegriaCanyoneeringWebBooking.ViewModel.GuestListViewModel

@{
    ViewData["Title"] = "Reserved Booking";
}

<section class="container py-4">
    <h2 class="fw-bold mb-4 text-primary">
        <i class="fas fa-calendar-check me-2 text-primary"></i>
        Reserved Booking
    </h2>
    <div class="modal fade" id="bookingDetailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-primary ">
                    <h5 class="modal-title text-light">Booking Details</h5>
     
                </div>
                <div class="modal-body" id="bookingDetailsModalBody">
                    <!-- Partial view will be loaded here -->
                </div>
            </div>
        </div>
    </div>



    <!-- ✅ Global Scan QR Button -->
    <div class="d-flex justify-content-between mb-3">
        <button type="button" class="btn btn-secondary btn-sm" onclick="openGlobalScanner()">
            <i class="fas fa-qrcode"></i> Scan Batch QR
        </button>
    </div>

    <!-- ✅ Toast Notification -->
    @if (TempData["ToastMessage"] != null)
    {
        <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055;">
            <div class="toast align-items-center text-white bg-@TempData["ToastType"] border-0 show"
                 role="alert" aria-live="assertive" aria-atomic="true" id="toastMessage">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="fas fa-info-circle me-2"></i> @TempData["ToastMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    @if (Model.ReservedGuests != null && Model.ReservedGuests.Any())
    {
        <div class="table-responsive">
            <table id="example1" class="table text-truncate">
                <thead class="table-light">
                    <tr>
                        <th>Operator</th>
                        <th>Nationality</th>
                        <th>Date Of Registration</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var guest in Model.ReservedGuests)
                    {
                        var badgeClass = guest.BookingStatus switch
                        {
                            "anticipated" => "info",
                            "reserved" => "success",
                            _ => "secondary"
                        };

                        <tr>
                            <td>@guest.OperatorList?.BusinessName</td>
                            <td>@guest.NationalityEntity?.NatName</td>
                            <td>@guest.Date</td>
                            <td>
                                <span class="badge bg-@badgeClass text-uppercase px-2 py-1">
                                    @guest.BookingStatus
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex flex-column flex-md-row justify-content-center align-items-center gap-1">
                                    <!-- 🔍 View Details -->
                                    <button class="btn btn-primary" onclick="loadBookingDetails(@guest.Id)">
                                        <i class="fas fa-eye"></i> View
                                    </button>


                                    @if (!User.IsInRole("Admin"))
                                    {
                                        <!-- 📷 View QR Code (Per Guest) -->
                                        <button type="button" class="btn btn-sm btn-info d-flex align-items-center"
                                                onclick="showQrModal('@guest.Id')">
                                            <i class="fas fa-qrcode me-1"></i> View QR Code
                                        </button>

                                        <!-- ✅ Confirm Booking (per guest OR batch scan) -->
                                        <form method="post"
                                              asp-action="FinalBookingBatch"
                                              asp-controller="Reserve"
                                              class="m-0 batch-form"
                                              data-batch="@guest.Batch">
                                            <input type="hidden" name="BatchCode" value="@guest.Batch" />
                                            <button type="submit" class="btn btn-sm btn-success d-flex align-items-center">
                                                <i class="fas fa-check me-1"></i> Confirm
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <i class="fas fa-exclamation-triangle fa-2x text-warning mb-3"></i>
            <p class="lead fw-semibold text-muted">No reserved or confirmed guests yet.</p>
        </div>
    }
</section>

<!-- ✅ Global QR Scanner Modal -->
<div class="modal fade" id="globalQrModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Scan Batch QR Code</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div id="globalReader" class="border rounded p-2 mb-3" style="min-height: 250px;">
                    <div class="d-flex align-items-center justify-content-center h-100">
                        <div class="text-center">
                            <div class="spinner-border text-primary mb-2" role="status"></div>
                            <p class="text-muted small">Starting camera...</p>
                        </div>
                    </div>
                </div>
                <div id="scanStatus" class="text-muted small">Point camera at QR code...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="stopGlobalScanner()">Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- ✅ Per-Guest QR Modals -->
@foreach (var guest in Model.ReservedGuests ?? Enumerable.Empty<dynamic>())
{
    <div class="modal fade" id="qrViewModal-@guest.Id" tabindex="-1"
         aria-labelledby="qrViewModalLabel-@guest.Id" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content text-center">
                <div class="modal-header d-flex flex-column">
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1 fw-semibold">Operator: @(guest.OperatorList?.BusinessName ?? "N/A")</p>
                    <p class="mb-2 fw-semibold">Total Guest: @guest.RFID</p>
                    <img id="qrImage-@guest.Id"
                         src="@guest.QRBase64"
                         alt="QR for @guest.Fullname"
                         style="width:180px;height:180px;" />
                </div>
                <div class="modal-footer">
                    <canvas id="qrCanvas-@guest.Id" width="220" height="270" style="display:none;"></canvas>
                    <button class="btn btn-success mt-2"
                            onclick="downloadQRCode('@guest.Id', '@(guest.OperatorList?.BusinessName ?? "N/A")', @guest.RFID)">
                        <i class="fas fa-download"></i> Download QR
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ✅ Required Libraries -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://unpkg.com/html5-qrcode/minified/html5-qrcode.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

                <script>
                                    function loadBookingDetails(id) {
                    $.get('/Reserve/GetBookingDetails', { id: id }, function (data) {
                        $('#bookingDetailsModalBody').html(data);
                        $('#bookingDetailsModal').modal('show');
                    });
                }

                                // ✅ GLOBAL SCANNER
                    let globalScanner = null;
                    let isScanning = false;

                    function openGlobalScanner() {
                        const modal = new bootstrap.Modal(document.getElementById('globalQrModal'));

                        // Reset state
                        document.getElementById('scanStatus').textContent = 'Point camera at QR code...';
                        document.getElementById('scanStatus').className = 'text-muted small';

                        modal.show();

                        // Small delay to ensure modal is fully visible
                        setTimeout(() => {
                            startGlobalScanner();
                        }, 300);
                    }

                    function startGlobalScanner() {
                        if (isScanning) return;

                        const scannerElement = document.getElementById('globalReader');
                        if (!scannerElement) {
                            console.error("❌ Scanner element not found");
                            return;
                        }

                        // Clear previous content but keep loading spinner initially
                        scannerElement.innerHTML = '';

                        globalScanner = new Html5Qrcode("globalReader");
                        isScanning = true;

                        const config = {
                            fps: 10,
                            qrbox: { width: 250, height: 250 },
                            aspectRatio: 1.0
                        };

                        globalScanner.start(
                            { facingMode: "environment" },
                            config,
                            onGlobalScanSuccess,
                            onGlobalScanError
                        ).catch(err => {
                            console.error("❌ Global scanner failed to start:", err);
                            document.getElementById('scanStatus').textContent = 'Failed to start camera: ' + err.message;
                            document.getElementById('scanStatus').className = 'text-danger small';
                            isScanning = false;

                            // Show error in scanner area
                            scannerElement.innerHTML = `
                                <div class="d-flex align-items-center justify-content-center h-100">
                                    <div class="text-center">
                                        <i class="fas fa-camera-slash text-danger fa-2x mb-2"></i>
                                        <p class="text-danger small">Camera access failed</p>
                                    </div>
                                </div>
                            `;
                        });
                    }

                    function onGlobalScanSuccess(decodedText, decodedResult) {
                        if (!isScanning) return;

                        const batchCode = decodedText.trim();
                        console.log("✅ Global scan result:", batchCode);

                        // Update UI
                        document.getElementById('scanStatus').textContent = '✓ QR Code Scanned! Processing...';
                        document.getElementById('scanStatus').className = 'text-success small';

                        stopGlobalScanner().then(() => {
                            processScannedBatchCode(batchCode);
                        });
                    }

                    function onGlobalScanError(error) {
                        // Don't log every error - it's normal during scanning
                        if (!error.includes('No QR code found') && !error.includes('NotFoundException')) {
                            console.log("Scanning...", error);
                        }
                    }

                    async function stopGlobalScanner() {
                        if (globalScanner && isScanning) {
                            try {
                                await globalScanner.stop();
                                await globalScanner.clear();
                                console.log("✅ Scanner stopped successfully");
                            } catch (err) {
                                console.warn("Warning stopping scanner:", err);
                            }
                            isScanning = false;
                        }
                    }

                    function processScannedBatchCode(batchCode) {
                        console.log("🔍 Processing batch code:", batchCode);

                        let formFound = false;

                        // Method 1: Look for forms with BatchCode input
                        const forms = document.querySelectorAll('form.batch-form');
                        forms.forEach(form => {
                            const batchInput = form.querySelector('input[name="BatchCode"]');
                            if (batchInput && form.dataset.batch === batchCode) {
                                console.log("📋 Found matching form for batch:", batchCode);
                                batchInput.value = batchCode;
                                formFound = true;

                                // Submit the form
                                setTimeout(() => {
                                    console.log("🚀 Submitting form for batch:", batchCode);
                                    form.submit();
                                }, 100);
                            }
                        });

                        if (!formFound) {
                            console.warn("❌ No forms found for batch:", batchCode);
                            alert(`No booking form found for batch code: ${batchCode}`);
                        }

                        // Close modal after processing
                        setTimeout(() => {
                            const modal = bootstrap.Modal.getInstance(document.getElementById('globalQrModal'));
                            if (modal) modal.hide();
                        }, 500);
                    }

                    // Clean up when modal closes
                    document.getElementById('globalQrModal')?.addEventListener('hidden.bs.modal', function () {
                        stopGlobalScanner();
                    });

                    // ✅ Bootstrap toast auto-show
                    document.addEventListener("DOMContentLoaded", function () {
                        var toastElement = document.getElementById('toastMessage');
                        if (toastElement) {
                            var toast = new bootstrap.Toast(toastElement);
                            toast.show();
                        }
                    });

                    // ✅ Per-guest QR modal
                    function showQrModal(guestId) {
                        const modal = new bootstrap.Modal(document.getElementById('qrViewModal-' + guestId));
                        modal.show();
                    }

                    // ✅ Download QR Code
                    function downloadQRCode(guestId, operator, totalGuests) {
                        var img = document.getElementById("qrImage-" + guestId);
                        var canvas = document.getElementById("qrCanvas-" + guestId);
                        var ctx = canvas.getContext("2d");

                        // Clear and set white background
                        ctx.fillStyle = "#ffffff";
                        ctx.fillRect(0, 0, canvas.width, canvas.height);

                        // Draw QR code
                        ctx.drawImage(img, 20, 20, 180, 180);

                        // Add text information
                        ctx.fillStyle = "#000000";
                        ctx.font = "bold 14px Arial";
                        ctx.textAlign = "center";
                        ctx.fillText("Operator: " + operator, canvas.width / 2, 220);
                        ctx.fillText("Total Guests: " + totalGuests, canvas.width / 2, 240);

                        // Create download link
                        var link = document.createElement("a");
                        link.download = "BatchQR-" + guestId + ".png";
                        link.href = canvas.toDataURL("image/png");
                        link.click();
                    }
                </script>