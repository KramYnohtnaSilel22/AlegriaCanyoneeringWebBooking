@model AlegriaCanyoneeringWebBooking.ViewModel.GuestListViewModel

@{
    ViewData["Title"] = "Reserved Booking";
}

<section class="container py-4">
    <h2 class="fw-bold mb-4 text-success">Reserved Booking</h2>

    @* Toast Notification *@
    @if (TempData["ToastMessage"] != null)
    {
        <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055;">
            <div class="toast align-items-center text-white bg-@TempData["ToastType"] border-0 show"
                 role="alert" aria-live="assertive" aria-atomic="true" id="toastMessage">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="fas fa-info-circle me-2"></i> @TempData["ToastMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    @if (Model.ReservedGuests != null && Model.ReservedGuests.Any())
    {
        <div class="table-responsive">
            <table id="example1" class="table text-truncate">
                <thead class="table-dark">
                    <tr>
                        <th>Status</th>
                        <th>Operator</th>
                        <th>Total of Guests</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var guest in Model.ReservedGuests)
                    {
                        var badgeClass = guest.BookingStatus switch
                        {
                            "anticipated" => "info",
                            "reserved" => "success",
                            _ => "secondary"
                        };

                        <tr>
                            <td>
                                <span class="badge bg-@badgeClass text-uppercase px-2 py-1">
                                    @guest.BookingStatus
                                </span>
                            </td>
                            <td>@(guest.OperatorList?.BusinessName ?? "N/A")</td>
                            <td>@guest.NumberOfGuests</td>
                            <td class="text-center">
                                <div class="d-flex flex-column flex-md-row justify-content-center align-items-center gap-1">

                                    <a asp-controller="Reserve" asp-action="ReserveDetails" asp-route-id="@guest.Id" class="btn btn-sm btn-primary">
                                        View
                                    </a>

                                    <!-- 📷 View QR Code -->
                                    <button type="button" class="btn btn-sm btn-info d-flex align-items-center"
                                            onclick="showQrModal('@guest.Id')">
                                        <i class="fas fa-qrcode me-1"></i>View QR Code
                                    </button>
                               

                                    <!-- ✅ Confirm Booking -->
                                    <form id="confirmForm-@guest.Id" method="post"
                                          asp-action="FinalBookingBatch" asp-controller="Reserve" class="m-0">
                                        <input type="hidden" name="BatchCode" value="@guest.Batch" />
                                        <button type="submit" class="btn btn-sm btn-success d-flex align-items-center">
                                            <i class="fas fa-check me-1"></i> Confirm
                                        </button>
                                    </form>


                                    <button type="button" class="btn btn-sm btn-secondary"
                                            onclick="toggleQrDisplay('@guest.Id')">
                                        <i class="fas fa-plus"></i>
                                    </button>

                                </div>

                                <div id="qrContainer-@guest.Id" style="display:none; margin-top:10px; text-align:center;">
                                    <p><strong>Scan QR to get Batch Code:</strong></p>
                                    <input type="text" readonly id="batchInput-@guest.Id"
                                           placeholder="Waiting for scan..." class="form-control form-control-sm mb-2 text-center"
                                           style="width: 250px; margin: 0 auto; background: #f8f9fa; border: 1px solid #ccc;" />
                                    <div id="reader-@guest.Id" style="width: 250px; margin: 0 auto;"></div>

                                    <img src="@guest.QRBase64"
                                         alt="QR Code for batch @guest.Batch"
                                         style="width:180px; height:180px;" />
                                </div>



                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <i class="fas fa-exclamation-triangle fa-2x text-warning mb-3"></i>
            <p class="lead fw-semibold text-muted">No reserved or confirmed guests yet.</p>
        </div>
    }
</section>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

        <!-- Scripts: Load in this exact order -->
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> <!-- jQuery -->
        <script src="https://unpkg.com/html5-qrcode@2.3.7/minified/html5-qrcode.min.js"></script> <!-- html5-qrcode -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script> <!-- SignalR -->

        <script>
                 function downloadQRCode(guestId, operatorName, guestCount) {
        const canvas = document.getElementById('qrCanvas-' + guestId);
        const ctx = canvas.getContext('2d');

        // Clear the canvas
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Set white background
        ctx.fillStyle = "#FFFFFF";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Draw text
        ctx.fillStyle = "#000000";
        ctx.font = "14px Arial";
        ctx.textAlign = "center";

        // Exact formatting
        ctx.fillText("Operator: " + operatorName, canvas.width / 2, 20);
        ctx.fillText("Total Guest: " + guestCount, canvas.width / 2, 40);

        // Load and draw QR
        const qrImg = document.getElementById('qrImage-' + guestId);
        const qr = new Image();
        qr.src = qrImg.src;

        qr.onload = function () {
            ctx.drawImage(qr, 20, 60, 180, 180); // Draw QR

            // Download canvas as image
            const imageData = canvas.toDataURL("image/png");

            const link = document.createElement('a');
            const safeOperator = operatorName.replace(/\s+/g, '_').replace(/[^\w\-]/g, '');
            link.download = `QRCode_${guestId}_${safeOperator}_${guestCount}Guests.png`;
            link.href = imageData;
            link.click();
        };
    }
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/batchCodeHub")
                .build();

            connection.start().catch(err => console.error(err.toString()));

            let html5QrcodeScanner = null;
            let currentGuestId = null;

            // SUCCESS: When QR is scanned
            function onScanSuccess(decodedText, decodedResult) {
                console.log("Scanned batch code:", decodedText);

                // Fill batch code into the visible input
                fillBatchInputForCurrentGuest(decodedText.trim());

                // Send to SignalR hub (optional)
                connection.invoke("SendBatchCode", decodedText).catch(err => console.error(err.toString()));

                // Stop scanner after scan
                if (html5QrcodeScanner) {
                    html5QrcodeScanner.stop().then(() => {
                        html5QrcodeScanner.clear();
                    }).catch(err => console.error(err));
                }

                // Hide the QR container after scan
                if (currentGuestId) {
                    const container = document.getElementById('qrContainer-' + currentGuestId);
                    if (container) container.style.display = 'none';
                }
            }

            // ERROR: During scan
            function onScanError(errorMessage) {
                // You can log or ignore errors
                // console.warn("QR scan error:", errorMessage);
            }

            // Fill the specific input for the currently scanned guest
            function fillBatchInputForCurrentGuest(batchCode) {
                if (!currentGuestId) return;

                const input = document.getElementById('batchInput-' + currentGuestId);
                if (input) {
                    input.value = batchCode;
                    console.log(`Batch code "${batchCode}" filled in input: batchInput-${currentGuestId}`);
                } else {
                    console.warn("Input not found for guest:", currentGuestId);
                }
            }

            // Start/Stop QR scanner for guest
            function toggleQrDisplay(guestId) {
                const container = document.getElementById('qrContainer-' + guestId);
                const isVisible = container && window.getComputedStyle(container).display === 'block';

                if (isVisible) {
                    // Hide scanner
                    container.style.display = 'none';
                    if (html5QrcodeScanner) {
                        html5QrcodeScanner.stop().then(() => {
                            html5QrcodeScanner.clear();
                        }).catch(err => console.error(err));
                    }
                    currentGuestId = null;
                } else {
                    // Show and scan
                    container.style.display = 'block';
                    currentGuestId = guestId;

                    // Stop existing scanner if any
                    if (html5QrcodeScanner) {
                        html5QrcodeScanner.stop().then(() => {
                            html5QrcodeScanner.clear().then(() => {
                                startScanner(guestId);
                            });
                        }).catch(() => {
                            startScanner(guestId);
                        });
                    } else {
                        startScanner(guestId);
                    }
                }
            }

            // Start scanner for specific guest
            function startScanner(guestId) {
                const readerElementId = 'reader-' + guestId;
                let readerElement = document.getElementById(readerElementId);

                if (!readerElement) {
                    const container = document.getElementById('qrContainer-' + guestId);
                    readerElement = document.createElement('div');
                    readerElement.id = readerElementId;
                    readerElement.style.width = '250px';
                    readerElement.style.margin = '0 auto';
                    container.appendChild(readerElement);
                }

                html5QrcodeScanner = new Html5Qrcode(readerElementId);

                const config = { fps: 10, qrbox: 250 };
                html5QrcodeScanner.start(
                    { facingMode: "environment" },
                    config,
                    onScanSuccess,
                    onScanError
                ).catch(err => console.error("Scanner start failed:", err));
            }

            // Optional: Keyboard input fallback (for USB scanners)
            let scannedBatch = "";
            let scanTimeout;
            document.addEventListener('keydown', function (e) {
                if (["Shift", "Alt", "Control"].includes(e.key)) return;

                scannedBatch += e.key;
                if (scanTimeout) clearTimeout(scanTimeout);

                scanTimeout = setTimeout(() => {
                    const trimmed = scannedBatch.trim();
                    if (/^\d{4,}$/.test(trimmed)) {
                        fillBatchInputForCurrentGuest(trimmed);
                    }
                    scannedBatch = "";
                }, 2000);
            });

            // Bootstrap toast (optional)
            document.addEventListener("DOMContentLoaded", function () {
                var toastElement = document.getElementById('toastMessage');
                if (toastElement) {
                    var toast = new bootstrap.Toast(toastElement);
                    toast.show();
                }
            });

            // Optional modal view (if using modal for QR code)
            function showQrModal(guestId) {
                const modal = new bootstrap.Modal(document.getElementById('qrViewModal-' + guestId));
                modal.show();
            }


         // Toast for TempData
    $(document).ready(function () {
        var toastElement = document.getElementById('toastMessage');
        if (toastElement) {
            var toast = new bootstrap.Toast(toastElement);
            toast.show();
        }
    });

    // Show QR Modal
    function showQrModal(guestId) {
        const modal = new bootstrap.Modal(document.getElementById('qrViewModal-' + guestId));
        modal.show();
    }

  
        </script>



   
    @foreach (var guest in Model.ReservedGuests ?? Enumerable.Empty<dynamic>())
    {
        <div class="modal fade" id="qrViewModal-@guest.Id" tabindex="-1"
             aria-labelledby="qrViewModalLabel-@guest.Id" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content text-center">
                    <div class="modal-header d-flex flex-column">
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-1 fw-semibold">Operator: @(guest.OperatorList?.BusinessName ?? "N/A")</p>
                        <p class="mb-2 fw-semibold">Total Guest: @guest.NumberOfGuests</p>
                        <img id="qrImage-@guest.Id"
                             src="@guest.QRBase64"
                             alt="QR for @guest.Fullname"
                             style="width:180px;height:180px;" />
                    </div>
                    <div class="modal-footer">

                    <canvas id="qrCanvas-@guest.Id" width="220" height="270" style="display:none;"></canvas>

                    <!-- 🔽 Download QR Button -->
                    <button class="btn btn-success mt-2" onclick="downloadQRCode('@guest.Id', '@(guest.OperatorList?.BusinessName ?? "N/A")', @guest.NumberOfGuests)">
                        <i class="fas fa-download"></i> Download QR
                    </button>

                    </div>
                </div>
            </div>
        </div>
    }

