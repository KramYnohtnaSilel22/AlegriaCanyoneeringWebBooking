@using System.Linq
@model AlegriaCanyoneeringWebBooking.ViewModel.GuestListViewModel

@{
    var allBatches = ViewBag.AllBatches as List<AlegriaCanyoneeringWebBooking.Models.Reserve> ?? new List<AlegriaCanyoneeringWebBooking.Models.Reserve>();
    var batchGuestsDict = Model?.BatchGuests ?? new Dictionary<string, List<AlegriaCanyoneeringWebBooking.Models.Guest>>();
}

<section class="container py-4">
    <h2 class="fw-bold mb-4 text-success">Booked Guests</h2>

    <!-- Date Filter Form -->
    <form method="get" asp-action="SaveGuest" class="row g-3 align-items-end mb-4">
        <div class="col-md-4">
            <label for="startDate" class="form-label">Start Date</label>
            <input type="date" class="form-control" id="startDate" name="startDate" value="@Context.Request.Query["startDate"]" required />
        </div>

        <div class="col-md-4">
            <label for="endDate" class="form-label">End Date</label>
            <input type="date" class="form-control" id="endDate" name="endDate" value="@Context.Request.Query["endDate"]" required />
        </div>

        <div class="col-md-4">
            <button type="submit" class="btn btn-success w-100">
                <i class="fas fa-search me-1"></i> Search
            </button>
        </div>
    </form>

    <!-- Display table only if search dates are provided -->
    @if (Context.Request.Query.ContainsKey("startDate") && Context.Request.Query.ContainsKey("endDate"))
    {
        if (allBatches.Any())
        {
            <div class="table-responsive">
                <table id="example1" class="table text-truncate">
                    <thead class="table-dark">
                        <tr>
                            <th>Batch</th>
                            <th>Total Guest</th>
                            <th>Operator</th>
                            <th>Arrival Date</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="BookingTableBody">
                        @foreach (var batch in allBatches)
                        {
                            if (!string.IsNullOrEmpty(batch.BatchCode))
                            {
                                var guests = batchGuestsDict.ContainsKey(batch.BatchCode)
                                ? batchGuestsDict[batch.BatchCode]
                                : new List<AlegriaCanyoneeringWebBooking.Models.Guest>();

                                var operatorName = guests.Any() && guests.FirstOrDefault()?.OperatorList != null
                                ? guests.FirstOrDefault().OperatorList?.BusinessName
                                : "N/A";

                                <tr>
                                    <td>@batch.BatchCode</td>
                                    <td>@batch.TotalGuests</td>
                                    <td>@operatorName</td>
                                    <td>@batch.ArrivalDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <span class="badge bg-primary text-uppercase px-2 py-1">@batch.Status</span>
                                    </td>
                                    <td class="text-center">
                                        <button type="button"
                                                class="btn btn-primary btn-sm d-inline-flex align-items-center rounded-pill shadow-sm px-3 py-1"
                                                data-bs-toggle="modal"
                                                data-bs-target="#allGuestsModal-@batch.BatchCode">
                                            View
                                            <i class="fas fa-users ms-2"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <!-- Modal for Guest Details -->
                @foreach (var batch in allBatches)
                {
                    if (!string.IsNullOrEmpty(batch.BatchCode) && batchGuestsDict.ContainsKey(batch.BatchCode))
                    {
                        var guests = batchGuestsDict[batch.BatchCode];
                        <div class="modal fade" id="allGuestsModal-@batch.BatchCode" tabindex="-1" aria-labelledby="guestModalLabel-@batch.BatchCode" aria-hidden="true">
                            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                                <div class="modal-content">
                                    <div class="modal-header bg-primary text-white">
                                        <h5 class="modal-title">Booking Details - Batch: @batch.BatchCode</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        @if (guests.Any())
                                        {
                                            var primaryGuest = guests.FirstOrDefault();
                                            var companions = guests.Skip(1).ToList();

                                            <h6 class="text-primary mb-3"><i class="fas fa-user"></i> Primary Guest</h6>
                                            <table class="table table-bordered table-striped">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Operator</th>
                                                        <th>Full Name</th>
                                                        <th>Age</th>
                                                        <th>Contact No.</th>
                                                        <th>Gender</th>
                                                        <th>Nationality</th>
                                                        <th>Area</th>
                                                        <th>Arrival Date</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (primaryGuest != null)
                                                    {
                                                        <tr class="table-success">
                                                            <td>@(primaryGuest.OperatorList?.BusinessName ?? "N/A")</td>
                                                            <td>@primaryGuest.Fullname</td>
                                                            <td>@primaryGuest.Age</td>
                                                            <td>@primaryGuest.ContactNumber</td>
                                                            <td>@primaryGuest.Gender</td>
                                                            <td>@(primaryGuest.NationalityEntity?.NatName ?? "N/A")</td>
                                                            <td>@primaryGuest.Area</td>
                                                            <td>@primaryGuest.ArrivalDate</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>

                                            @if (companions.Any())
                                            {
                                                <h6 class="text-secondary mt-4 mb-3"><i class="fas fa-users"></i> Companion Guests</h6>
                                                <table class="table table-bordered table-hover">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Full Name</th>
                                                            <th>Age</th>
                                                            <th>Contact No.</th>
                                                            <th>Gender</th>
                                                            <th>Nationality</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var guest in companions)
                                                        {
                                                            <tr>
                                                                <td>@guest.Fullname</td>
                                                                <td>@guest.Age</td>
                                                                <td>@guest.ContactNumber</td>
                                                                <td>@guest.Gender</td>
                                                                <td>@(guest.NationalityEntity?.NatName ?? "N/A")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                            else
                                            {
                                                <p class="text-muted">No companion guests for this booking.</p>
                                            }
                                        }
                                        else
                                        {
                                            <p class="text-muted">No guests found for this batch.</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center mt-4">
                <i class="fas fa-info-circle me-2"></i>
                No guest bookings found between the selected dates.
            </div>
        }
    }
</section>
