@{
    ViewData["Title"] = "Confirmed Booking Batches";
}

<h2 class="mb-4 text-success">Booked Guests Batches</h2>

<table id="batchesTable" class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Batch</th>
            <th>Total Guests</th>
            <th>Operator</th>
            <th>Arrival Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
</table>

<!-- Static modal container where we inject partial view -->
<div id="guestDetailsModalContainer"></div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#batchesTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetGuestsData", "Reserve")',
                    type: 'POST'
                },
                columns: [
                    { data: 'batchCode', title: 'Batch' },
                    { data: 'totalGuests', title: 'Total Guests' },
                    { data: 'operatorName', title: 'Operator' },
                    {
                        data: 'arrivalDate',
                        title: 'Arrival Date',
                        render: function (data) {
                            if (!data) return '';
                            const options = { year: 'numeric', month: 'short', day: 'numeric' };
                            return new Date(data).toLocaleDateString(undefined, options);
                        }
                    },
                    {
                        data: 'status',
                        title: 'Status',
                        render: function (data) {
                            if (!data) return '';
                            // You can customize badge color based on status if needed
                            let badgeClass = 'primary';
                            if (data.toLowerCase() === 'confirmed') badgeClass = 'success';
                            else if (data.toLowerCase() === 'anticipated') badgeClass = 'info';
                            else if (data.toLowerCase() === 'cancelled') badgeClass = 'danger';

                            return `<span class="badge bg-${badgeClass} text-uppercase px-2 py-1">${data}</span>`;
                        }
                    },
                    {
                        data: 'batchCode',
                        title: 'Actions',
                        orderable: false,
                        searchable: false,
                        render: function (data) {
                            return `<button type="button" class="btn btn-primary btn-sm view-guest-details" data-batch="${data}">
                                        View <i class="fas fa-users ms-1"></i>
                                    </button>`;
                        }
                    }
                ],
                pageLength: 10,
                lengthMenu: [[10, 20, 30, 50, 100], [10, 20, 30, 50, 100]],
                responsive: true,
                autoWidth: false,
                language: {
                    emptyTable: "No guest batches found."
                }
            });

            // Store modal instance globally
            var guestModal;

            // Handle click on View buttons
            $('#batchesTable').on('click', '.view-guest-details', function () {
                var batchCode = $(this).data('batch');
                var modalContainer = $('#guestDetailsModalContainer');

                // Load partial view via AJAX
                $.get('@Url.Action("GetGuestsByBatch", "Reserve")', { batchCode: batchCode })
                    .done(function (html) {
                        // Inject the partial view HTML into the container
                        modalContainer.html(html);

                        // Initialize Bootstrap modal
                        var modalElement = document.getElementById('guestDetailsModal');
                        guestModal = new bootstrap.Modal(modalElement, {
                            backdrop: 'static', // optional: prevent closing on backdrop click if desired
                            keyboard: true      // allow ESC to close
                        });

                        // Show modal
                        guestModal.show();

                        // Optional: clear modal content on hide to avoid stale data
                        modalElement.addEventListener('hidden.bs.modal', function () {
                            modalContainer.empty();
                        });
                    })
                    .fail(function () {
                        alert('Failed to load guest details.');
                    });
            });
        });
    </script>
}
